
@{
    ViewData["Title"] = "Bước lớn workflow";
}
<link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />
<div class="container-fluid py-3 workflow-page">
    <div class="d-flex justify-content-between align-items-center mb-4"><div><h4 class="page-title mb-1">Bước lớn trong quy trình</h4><div class="subtitle">Quản lý các nhóm nghiệp vụ dùng chung cho workflow.</div></div><button class="btn btn-primary"><i class="fas fa-plus me-2"></i>Thêm bước lớn</button></div>
    <div class="card"><div class="card-header toolbar d-flex gap-2"><input class="form-control" placeholder="Tìm theo mã hoặc tên bước..." /><select class="form-select" style="max-width:180px"><option>Tất cả trạng thái</option><option>Hoạt động</option><option>Không hoạt động</option></select><button class="btn btn-outline-primary"><i class="fas fa-search"></i></button></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Thứ tự</th><th>Mã bước</th><th>Tên bước lớn</th><th>Số bước nhỏ</th><th>Trạng thái</th><th></th></tr></thead><tbody>
        <tr><td><span class="step-number">1</span></td><td><code>SURVEY</code></td><td><strong>Xin khảo sát</strong><div class="small text-muted">Survey request</div></td><td>4</td><td><span class="badge bg-light text-success">Hoạt động</span></td><td><button class="btn btn-sm btn-light"><i class="fas fa-pen"></i></button></td></tr>
        <tr><td><span class="step-number">2</span></td><td><code>QUOTATION</code></td><td><strong>Yêu cầu báo giá</strong><div class="small text-muted">Quotation request</div></td><td>6</td><td><span class="badge bg-light text-success">Hoạt động</span></td><td><button class="btn btn-sm btn-light"><i class="fas fa-pen"></i></button></td></tr>
        <tr><td><span class="step-number">3</span></td><td><code>CUSTOMS_NAME</code></td><td><strong>Xác nhận tên hải quan</strong><div class="small text-muted">Customs name confirmation</div></td><td>3</td><td><span class="badge bg-light text-success">Hoạt động</span></td><td><button class="btn btn-sm btn-light"><i class="fas fa-pen"></i></button></td></tr>
    </tbody></table></div></div>
</div>
