@{
    ViewData["Title"] = "Bước lớn Workflow";
}

<link rel="stylesheet" href="~/css/workflow/workflow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/workflow/WFStages.css" asp-append-version="true" />

<div class="workflow-page workflow-stages-page">
    <header class="page-header">
        <div>
            <div class="page-eyebrow"><i class="fas fa-sitemap me-2"></i>Thiết lập quy trình</div>
            <h1 class="page-title">Bước lớn Workflow</h1>
            <p class="page-subtitle">
                Quản lý các nhóm nghiệp vụ dùng chung trong quy trình phê duyệt.
            </p>
        </div>

        <button id="btnAddStage" type="button" class="btn btn-primary btn-add-stage">
            <i class="fas fa-plus me-2"></i>
            Thêm bước lớn
        </button>
    </header>

    <section class="card workflow-card filter-card" aria-label="Bộ lọc danh sách">
        <div class="card-body">
            <div class="filter-heading">
                <div>
                    <h2 class="section-title">Tra cứu bước lớn</h2>
                    <p class="section-hint">Lọc nhanh theo mã, tên hoặc trạng thái sử dụng.</p>
                </div>
                <span class="filter-icon"><i class="fas fa-filter"></i></span>
            </div>

            <div class="toolbar">
                <div class="search-box">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input id="stageSearch" type="search" aria-label="Tìm kiếm bước lớn"
                           placeholder="Tìm theo mã hoặc tên bước..." autocomplete="off" />
                </div>

                <select id="stageStatus" class="form-select status-filter" aria-label="Lọc theo trạng thái">
                    <option value="">Tất cả trạng thái</option>
                    <option value="true">Hoạt động</option>
                    <option value="false">Không hoạt động</option>
                </select>

                <button id="btnSearchStage" type="button" class="btn btn-outline-primary btn-search">
                    <i class="fas fa-search me-1"></i>
                    Tìm kiếm
                </button>
            </div>
        </div>
    </section>

    <section class="card workflow-card table-card">
        <div class="card-header table-header">
            <div>
                <h2 class="section-title mb-1">Danh sách bước lớn</h2>
                <p class="section-hint mb-0">Các nhóm nghiệp vụ được dùng để cấu hình các bước nhỏ.</p>
            </div>
            <span id="stageCount" class="record-count">0 bản ghi</span>
        </div>

        <div class="table-responsive">
            <table class="table workflow-table align-middle mb-0">
                <caption style="margin-left: 8px;" class="visually-hidden">Danh sách các bước lớn trong workflow</caption>
                <thead>
                    <tr>
                        <th class="text-center" scope="col" width="100">Thứ tự</th>
                        <th class="text-center" scope="col" width="180">Mã bước</th>
                        <th>Tên bước lớn</th>
                        <th class="text-center" scope="col" width="140">Số bước nhỏ</th>
                        <th class="text-center" scope="col" width="160">Trạng thái</th>
                        <th class="text-center" scope="col" width="140">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="stageTableBody"></tbody>
            </table>
        </div>
    </section>
</div>

<div class="modal fade" id="stageModal" tabindex="-1" aria-labelledby="stageModalTitle" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <form id="stageForm" class="modal-content" novalidate>

            <div class="modal-header">

                <div>
                    <h5 id="stageModalTitle"
                        class="modal-title">
                        Thêm bước lớn
                    </h5>

                    <div class="modal-subtitle">
                        Nhập thông tin bước lớn trong workflow
                    </div>
                </div>

                <button type="button" class="stage-modal-close" data-dismiss="modal" aria-label="Đóng">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>

            </div>

            <div class="modal-body">

                <input id="stageId" type="hidden" />

                <div class="mb-3">
                    <label class="form-label" for="stageCode">Mã bước <span class="text-danger">*</span></label>

                    <input id="stageCode"
                           class="form-control"
                           maxlength="50" required />
                    <div class="form-text">Mã duy nhất, tối đa 50 ký tự.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="stageName">Tên bước lớn <span class="text-danger">*</span></label>

                    <input id="stageName"
                           class="form-control"
                           maxlength="200" required />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="stageOrder">Thứ tự hiển thị <span class="text-danger">*</span></label>

                    <input id="stageOrder"
                           class="form-control"
                           type="number"
                           min="1"
                           value="1" required />
                </div>

                <div class="stage-active-setting">
                    <input id="stageIsActive"
                           class="form-check-input"
                           type="checkbox"
                           checked />
                    <div style="margin-left: 22px">
                        <label class="form-check-label"
                               for="stageIsActive">
                            Đang hoạt động
                        </label>
                        <div class="form-text">
                            Cho phép sử dụng bước này trong quy trình mới.
                        </div>
                    </div>
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-dismiss="modal">
                    Hủy
                </button>

                <button id="btnSaveStage"
                        type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-save me-2"></i>
                    Lưu dữ liệu

                </button>

            </div>

        </form>

    </div>

</div>

<div id="stageAlert" class="alert custom-alert d-none" role="alert" aria-live="polite"></div>
@section Scripts {
    <script src="~/js/workflow/workflowStages.js" asp-append-version="true"></script>
    <script>
        (function() {
            var panel = document.getElementById('stageModal');
            if (panel && panel.parentElement !== document.body) {
                document.body.appendChild(panel);
            }
        })();
    </script>
}
