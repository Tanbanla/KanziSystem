
@{
    ViewData["Title"] = "Phân quyền workflow";
}
<link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />
<div class="container-fluid py-3 workflow-page"><div class="d-flex justify-content-between align-items-center mb-4"><div><h4 class="page-title mb-1">Phân quyền theo role</h4><div class="subtitle">Thiết lập quyền xem, xử lý, duyệt và từ chối cho từng bước.</div></div><button class="btn btn-primary"><i class="fas fa-save me-2"></i>Lưu thay đổi</button></div>
<div class="card mb-3"><div class="card-body row g-2"><div class="col-md-5"><label class="small text-muted">Workflow</label><select class="form-select"><option>GOODS · Luồng PUR</option><option>GOODS · Luồng GA</option><option>SERVICE · Luồng PUR</option></select></div><div class="col-md-3"><label class="small text-muted">Hiển thị quyền</label><select class="form-select"><option>Tất cả role</option><option>PUR</option><option>GA</option><option>SHIP</option><option>USER</option><option>ADMIN</option></select></div></div></div>
<div class="card"><div class="card-header d-flex justify-content-between"><strong>Ma trận quyền xử lý</strong><span class="badge bg-light text-primary">8 role permissions</span></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Bước xử lý</th><th class="permission-cell">PUR</th><th class="permission-cell">GA</th><th class="permission-cell">SHIP</th><th class="permission-cell">USER</th><th class="permission-cell">ADMIN</th></tr></thead><tbody>
<tr><td><strong>Tạo yêu cầu báo giá</strong><div class="small text-muted">QUOTATION_CREATE</div></td><td class="permission-cell"><span class="badge bg-primary">Xử lý</span></td><td class="permission-cell"><span class="badge bg-light text-secondary">Xem</span></td><td class="permission-cell">—</td><td class="permission-cell"><span class="badge bg-success">Tạo</span></td><td class="permission-cell"><span class="badge bg-dark">Toàn quyền</span></td></tr>
<tr><td><strong>So sánh báo giá</strong><div class="small text-muted">QUOTATION_COMPARE</div></td><td class="permission-cell"><span class="badge bg-primary">Xử lý</span></td><td class="permission-cell"><span class="badge bg-light text-secondary">Xem</span></td><td class="permission-cell">—</td><td class="permission-cell"><span class="badge bg-light text-secondary">Xem</span></td><td class="permission-cell"><span class="badge bg-dark">Toàn quyền</span></td></tr>
<tr><td><strong>Xác nhận tên hải quan</strong><div class="small text-muted">CUSTOMS_CONFIRM</div></td><td class="permission-cell"><span class="badge bg-light text-secondary">Xem</span></td><td class="permission-cell">—</td><td class="permission-cell"><span class="badge bg-success">Duyệt</span></td><td class="permission-cell">—</td><td class="permission-cell"><span class="badge bg-dark">Toàn quyền</span></td></tr>
</tbody></table></div></div></div>
