@{
    ViewData["Title"] = "Phân quyền workflow";
}

<link rel="stylesheet" href="~/css/workflow/workflow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/workflow/WFRolePessions.css" asp-append-version="true" />

<div class="workflow-page wf-permissions-page">
    <header class="page-header">
        <div>
            <div class="page-eyebrow"><i class="fas fa-user-shield me-2"></i>Thiết lập quy trình</div>
            <h1 class="page-title">Phân quyền theo role</h1>
            <p class="page-subtitle">Cấu hình quyền xem, xử lý, duyệt và từ chối cho từng bước trong workflow.</p>
        </div>
        <button id="btnSavePermissions" type="button" class="btn btn-primary" disabled>
            <i class="fas fa-save me-2"></i><span>Lưu thay đổi</span>
        </button>
    </header>

    <section class="card workflow-card filter-card permission-filter-card">
        <div class="card-body">
            <div class="filter-heading">
                <div>
                    <h2 class="section-title">Ma trận quyền</h2>
                    <p class="section-hint">Chọn workflow và bật quyền tương ứng cho từng role.</p>
                </div>
                <span class="filter-icon"><i class="fas fa-sliders"></i></span>
            </div>
            <div class="permission-toolbar">
                <div class="permission-workflow-select">
                    <label class="form-label" for="workflowSelect">Workflow</label>
                    <select id="workflowSelect" class="form-select">
                        <option value="">Đang tải workflow...</option>
                    </select>
                </div>
                <div class="permission-search">
                    <label class="form-label" for="permissionSearch">Tìm kiếm</label>
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input id="permissionSearch" type="search" placeholder="Tìm mã hoặc tên bước..." autocomplete="off" />
                    </div>
                </div>
                <div class="permission-role-filter">
                    <label class="form-label" for="roleFilter">Hiển thị role</label>
                    <select id="roleFilter" class="form-select">
                        <option value="">Tất cả role</option>
                    </select>
                </div>
                <button id="btnResetPermissions" type="button" class="btn btn-light permission-reset" title="Tải lại dữ liệu">
                    <i class="fas fa-rotate me-1"></i>Làm mới
                </button>
            </div>
            <div class="permission-legend" aria-label="Chú thích quyền">
                <span><i class="legend-dot view"></i>Xem</span>
                <span><i class="legend-dot process"></i>Xử lý</span>
                <span><i class="legend-dot approve"></i>Duyệt</span>
                <span><i class="legend-dot reject"></i>Từ chối</span>
            </div>
        </div>
    </section>

    <section class="card workflow-card table-card permission-table-card">
        <div class="card-header table-header">
            <div>
                <h2 class="section-title mb-1">Ma trận quyền xử lý</h2>
                <p id="permissionWorkflowHint" class="section-hint mb-0">Chưa chọn workflow</p>
            </div>
            <div class="permission-summary">
                <span id="permissionCount" class="record-count">0 quyền</span>
                <span id="permissionChangeState" class="permission-change-state">Chưa có thay đổi</span>
            </div>
        </div>
        <div id="permissionLoading" class="permission-state">
            <span class="spinner-border spinner-border-sm text-primary me-2" role="status"></span>Đang tải dữ liệu...
        </div>
        <div id="permissionError" class="permission-state permission-error d-none"></div>
        <div id="permissionEmpty" class="permission-state d-none">
            <i class="fas fa-inbox mb-2"></i><span>Workflow chưa có bước được kích hoạt.</span>
        </div>
        <div id="permissionTableWrap" class="table-responsive d-none">
            <table class="table workflow-table permission-table align-middle mb-0">
                <thead id="permissionTableHead"></thead>
                <tbody id="permissionTableBody"></tbody>
            </table>
        </div>
    </section>
</div>

<div id="permissionAlert" class="alert d-none" role="alert"></div>

<script>
    window.workflowRolePermissionsUrl = '@Url.Action("GetWorkflowRolePermissions", "Workflow")';
    window.saveWorkflowRolePermissionsUrl = '@Url.Action("SaveWorkflowRolePermissions", "Workflow")';
</script>
@section Scripts {
    <script src="~/js/workflow/wfRolePessions.js" asp-append-version="true"></script>
}