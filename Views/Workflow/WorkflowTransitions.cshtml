@{
    ViewData["Title"] = "Cấu hình chuyển bước";
}
<link rel="stylesheet" href="~/css/workflow/workflow.css" asp-append-version="true" />
<div class="workflow-page container-fluid py-3">
    <header class="page-header d-flex justify-content-between align-items-center mb-3"><div><div class="page-eyebrow"><i class="fas fa-code-branch me-2"></i>Thiết lập quy trình</div><h1 class="page-title">Tuyến chuyển bước</h1><p class="page-subtitle">Khai báo bước tiếp theo theo từng hành động xử lý.</p></div><button id="btnSaveTransition" class="btn btn-primary"><i class="fas fa-save me-2"></i>Lưu transition</button></header>
    <section class="card workflow-card mb-3"><div class="card-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Workflow</label><select id="workflowSelect" class="form-select"></select></div><div class="col-md-4"><label class="form-label">Bước nguồn</label><select id="fromStep" class="form-select"></select></div><div class="col-md-4"><label class="form-label">Action</label><select id="actionCode" class="form-select"><option>APPROVE</option><option>REJECT</option><option>RETURN</option><option>SKIP</option><option>CANCEL</option><option>ESCALATE</option></select></div><div class="col-md-4"><label class="form-label">Bước đích</label><select id="toStep" class="form-select"></select></div><div class="col-md-6"><label class="form-label">Điều kiện tùy chọn</label><input id="condition" class="form-control" maxlength="2000" placeholder="Ví dụ: Amount > 100000000" /></div><div class="col-md-2 d-flex align-items-end"><div class="form-check"><input id="isActive" class="form-check-input" type="checkbox" checked><label class="form-check-label" for="isActive">Hoạt động</label></div></div></div></div></section>
    <section class="card workflow-card"><div class="card-header"><strong>Danh sách transition</strong></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Bước nguồn</th><th>Action</th><th>Bước đích</th><th>Điều kiện</th><th>Trạng thái</th><th></th></tr></thead><tbody id="transitionBody"></tbody></table></div></section>
</div>
<script>window.workflowTransitionsUrl='@Url.Action("GetWorkflowTransitions", "Workflow")';window.saveWorkflowTransitionUrl='@Url.Action("SaveWorkflowTransition", "Workflow")';window.deleteWorkflowTransitionUrl='@Url.Action("DeleteWorkflowTransition", "Workflow")';</script>
@section Scripts { <script src="~/js/workflow/wfTransitions.js" asp-append-version="true"></script> }
