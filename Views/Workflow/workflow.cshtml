@{
    ViewData["Title"] = "Cấu hình workflow";
}
<link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />

<div class="container-fluid py-3 workflow-page">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h4 class="page-title mb-1">Cấu hình workflow</h4>
            <div class="subtitle">Phân chia các bước xử lý theo phòng ban xin hàng và chủng loại hàng.</div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-light border" id="btnReset"><i class="fas fa-undo me-1"></i> Khôi phục</button>
            <button type="button" class="btn btn-primary" id="btnSave"><i class="fas fa-save me-1"></i> Lưu</button>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div><strong>1. Chọn luồng xin hàng</strong><div class="small text-muted">Mỗi luồng có thể có quy trình riêng</div></div>
                    <span class="badge bg-light text-primary" id="currentFlowLabel">GA</span>
                </div>
                <div class="card-body">
                    <div class="btn-group flow-tabs mb-4" role="group" aria-label="Luồng xin hàng">
                        <button class="btn btn-outline-primary active" type="button" data-flow="GA"><i class="fas fa-building me-2"></i>GA</button>
                        <button class="btn btn-outline-primary" type="button" data-flow="PUR"><i class="fas fa-shopping-cart me-2"></i>PUR</button>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2"><strong>2. Chọn chủng loại hàng</strong><span class="small text-muted">Đang chọn: <b id="currentTypeLabel">Hàng hóa</b></span></div>
                    <div class="row row-cols-2 row-cols-md-4 g-2">
                        <div class="col"><div class="type-card active" data-type="goods"><div class="type-icon mb-2"><i class="fas fa-box"></i></div><strong class="d-block">Hàng hóa</strong><small class="text-muted">Vật tư, linh kiện</small></div></div>
                        <div class="col"><div class="type-card" data-type="service"><div class="type-icon mb-2" style="background:#e18a3b"><i class="fas fa-concierge-bell"></i></div><strong class="d-block">Dịch vụ</strong><small class="text-muted">Dịch vụ thuê ngoài</small></div></div>
                        <div class="col"><div class="type-card" data-type="design"><div class="type-icon mb-2" style="background:#38a58d"><i class="fas fa-pencil-ruler"></i></div><strong class="d-block">Hàng hóa thiết kế</strong><small class="text-muted">Theo bản vẽ</small></div></div>
                        <div class="col"><div class="type-card" data-type="construction"><div class="type-icon mb-2" style="background:#8764c2"><i class="fas fa-home"></i></div><strong class="d-block">Công trình</strong><small class="text-muted">Dự án, thi công</small></div></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100"><div class="card-header"><strong>Trạng thái cấu hình</strong></div><div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3"><span class="text-muted">Luồng hiện tại</span><strong id="statusFlow">GA · Hàng hóa</strong></div>
                <div class="progress mb-2" style="height:8px"><div class="progress-bar bg-success" id="progressBar" style="width:0%"></div></div>
                <div class="d-flex justify-content-between small text-muted mb-4"><span id="selectedCount">0 bước được chọn</span><span id="totalCount">0 bước</span></div>
                <div class="alert alert-light border mb-0 small"><i class="fas fa-info-circle text-primary me-1"></i> Thứ tự bước được lấy từ cột <b>INT_StepNumber</b> trong bảng <b>BaoGia_Step</b>.</div>
            </div></div>
        </div>
    </div>

    <div class="card mb-3"><div class="card-header d-flex justify-content-between align-items-center"><div><strong>3. Các bước trong quy trình</strong><div class="small text-muted">Bật các bước mà loại hàng phải đi qua</div></div><span class="badge bg-success" id="loadStatus"><i class="fas fa-circle-notch fa-spin"></i> Đang tải</span></div>
        <div class="card-body"><div class="step-list" id="stepList"><div class="empty-state">Đang tải danh sách bước...</div></div></div>
    </div>
</div>

<script>
    window.workflowStepsUrl = '@Url.Action("GetWorkflowSteps", "Workflow")';
</script>
<script src="~/js/workflow/workflow.js" asp-append-version="true"></script>
