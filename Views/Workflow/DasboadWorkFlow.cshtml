@{
    ViewData["Title"] = "Dashboard Workflow";
}
<link rel="stylesheet" href="~/css/workflow.css" asp-append-version="true" />

<div class="container-fluid py-3 workflow-page">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div><h4 class="page-title mb-1">Dashboard Workflow</h4><div class="subtitle">Theo dõi nhanh cấu hình và tình trạng xử lý yêu cầu.</div></div>
        <a class="btn btn-primary" href="@Url.Action("workflow", "Workflow")"><i class="fas fa-sliders-h me-2"></i>Cấu hình workflow</a>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card stat-card stat-blue"><div class="card-body"><div class="small opacity-75">Workflow hoạt động</div><div class="stat-value">8</div><div class="small opacity-75">4 loại hàng · 2 luồng</div></div></div></div>
        <div class="col-md-3"><div class="card stat-card stat-green"><div class="card-body"><div class="small opacity-75">Đang xử lý</div><div class="stat-value">24</div><div class="small opacity-75">+12% so với tuần trước</div></div></div></div>
        <div class="col-md-3"><div class="card stat-card stat-orange"><div class="card-body"><div class="small opacity-75">Chờ tôi xử lý</div><div class="stat-value">7</div><div class="small opacity-75">3 yêu cầu sắp quá hạn</div></div></div></div>
        <div class="col-md-3"><div class="card stat-card stat-purple"><div class="card-body"><div class="small opacity-75">Quá hạn</div><div class="stat-value">2</div><div class="small opacity-75">Cần được kiểm tra</div></div></div></div>
    </div>
    <div class="row g-3">
        <div class="col-lg-8"><div class="card"><div class="card-header d-flex justify-content-between"><strong>Workflow theo loại hàng</strong><a href="@Url.Action("workflow", "Workflow")" class="small">Xem cấu hình</a></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Loại hàng</th><th>GA</th><th>PUR</th><th>Trạng thái</th></tr></thead><tbody>
            <tr><td><strong>GOODS</strong><div class="small text-muted">Hàng hóa</div></td><td><span class="badge bg-success">13 bước</span></td><td><span class="badge bg-success">13 bước</span></td><td><span class="badge bg-light text-success">Đã cấu hình</span></td></tr>
            <tr><td><strong>DESIGN_GOODS</strong><div class="small text-muted">Hàng hóa thiết kế</div></td><td><span class="badge bg-success">13 bước</span></td><td><span class="badge bg-success">13 bước</span></td><td><span class="badge bg-light text-success">Đã cấu hình</span></td></tr>
            <tr><td><strong>SERVICE</strong><div class="small text-muted">Dịch vụ</div></td><td><span class="badge bg-success">13 bước</span></td><td><span class="badge bg-warning text-dark">Chưa kiểm tra</span></td><td><span class="badge bg-light text-warning">Cần rà soát</span></td></tr>
            <tr><td><strong>RENOVATION</strong><div class="small text-muted">Cải tạo / công trình</div></td><td><span class="badge bg-success">13 bước</span></td><td><span class="badge bg-success">13 bước</span></td><td><span class="badge bg-light text-success">Đã cấu hình</span></td></tr>
        </tbody></table></div></div></div>
        <div class="col-lg-4"><div class="card h-100"><div class="card-header"><strong>Truy cập nhanh</strong></div><div class="card-body d-grid gap-2">
            <a class="btn btn-light text-start" href="@Url.Action("WorkflowStages", "Workflow")"><i class="fas fa-layer-group text-primary me-2"></i>Quản lý bước lớn</a>
            <a class="btn btn-light text-start" href="@Url.Action("WorkflowSteps", "Workflow")"><i class="fas fa-list-ol text-primary me-2"></i>Quản lý bước nhỏ</a>
            <a class="btn btn-light text-start" href="@Url.Action("WorkflowRolePermissions", "Workflow")"><i class="fas fa-user-shield text-primary me-2"></i>Phân quyền theo role</a>
            <a class="btn btn-light text-start" href="@Url.Action("WorkflowTasks", "Workflow")"><i class="fas fa-tasks text-primary me-2"></i>Danh sách việc của tôi</a>
        </div></div></div>
    </div>
</div>
