@using PRJ_WAREHOUSE_BIVN.Language
@{
    ViewData["Title"] = "Trạng thái đơn";
}
<style>
    .form-control, .input-group-text, .custom-select, .custom-file-label {
        border-color: #6e75c4;
    }

</style>
<div class="row">
    <div class="col-12">
        <div class="card card-primary">      
            <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                <div class="table-responsive card">
                    <table class="table table-bordered">                     
                        <tr>
                            <td> 
                                <select class="form-control" id="khoi" onchange="checkSelectValue(this.value)">
                                    <option value="PROD">PROD</option>
                                    <option value="GA">GA</option>
                                    <option value="IT">IT</option>
                                    <option value="PUR">PUR</option>
                                </select>
                            </td>
                            <td>
                                <select id="trangthaidon" class="form-control">
                                    <option value=""> ---  Chọn ---</option>
                                    <option value="1">Gấp</option>
                                    <option value="0">Thông thường</option>
                                </select>
                            </td>
                            <td>
                                <select class="form-control" id="tinhtrangdon">
                                    <option value=""> ---  Chọn ---</option>
                                    <option value="0">Đợi người dự thảo</option>
                                    <option value="1">Đợi người thẩm tra</option>
                                    <option value="2">Đợi người phê duyệt</option>
                                    <option value="3">Đợi quản lý phòng tiếp nhận</option>
                                    <option value="4">Đợi người xuất kho</option>
                                    <option value="5">Hoàn thành</option>
                                    <option value="6">Bị từ chối</option>
                                </select>
                            </td>
                            <td width="125">
                                <input type="text" class="form-control" id="mnl">
                            </td>
                            <td width="80">
                                <input type="text" class="form-control" id="cost" >
                            </td>
                            <td hidden>
                                <input type="text" class="form-control" id="costt_ct" >
                            </td>
                            <td>
                                <input type="date" class="form-control" id="ngayyc">
                            </td>
                            <td>
                                <input type="date" class="form-control" id="ngaymn">
                            </td>
                            <td width="180">
                                <select class="form-control" id="loaicp">
                                    <option></option>
                                    <option value="AUXILIARY">@Languages.cpbiendoitheosanluong</option>
                                    <option value="EUQIMENT">@Languages.chiphicodinh</option>
                                    <option value="FIXED">@Languages.taisancodinh</option>
                                    <option value="COMMON">@Languages.Chiphichung</option>
                                    <option value="OTHER">Other</option>
                                </select>
                            </td>
                            <td>
                                <select id="giadonhang" class="form-control">
                                    <option value="0"> ---  Chọn ---</option>
                                    <option value="2999">Dưới 3000</option>
                                    <option value="3000">Dưới 10,000</option>
                                    <option value="10000">Trên 10,000</option>
                                </select>
                            </td>
                            <td colspan="9">
                                <div id="hienthitimkiem">
                                    <button type="button" class="btn btn-info ml-3" onclick="_load_request_condition()"><i class="ion ion-ios-search-strong"></i> @Languages.timkiem</button>
                                    <button type="button" class="btn btn-secondary ml-3" onclick="_load_request_condition()"><i class="ion ion-refresh"></i> Refresh </button>
                                    <span class="text-success ml-4">✓ : @Languages.daduyet </span> &nbsp;&nbsp;  <span class="text-warning"> ◉ : @Languages.dangdoi </span> &nbsp;&nbsp; <span class="text-danger mr-3"> × : @Languages.Tuchoi</span>
                                </div>
                                <div id="hienthitimkiem_GA">
                                    <button type="button" class="btn btn-info ml-3" onclick="_load_request_condition_ga()"><i class="ion ion-ios-search-strong"></i> @Languages.timkiem</button>
                                    <button type="button" class="btn btn-secondary ml-3" onclick="_load_request_condition_ga()"><i class="ion ion-refresh"></i> Refresh </button>
                                    <span class="text-success ml-4">✓ : @Languages.daduyet </span> &nbsp;&nbsp;  <span class="text-warning"> ◉ : @Languages.dangdoi </span> &nbsp;&nbsp; <span class="text-danger mr-3"> × : @Languages.Tuchoi</span>
                                </div>

                            </td>
                           @*  <td colspan="6">
                                <div class="form-group float-right mt-5">
                                    <span class="text-success ml-4">✓ : @Languages.daduyet </span> &nbsp;&nbsp;  <span class="text-warning"> ◉ : @Languages.dangdoi </span> &nbsp;&nbsp; <span class="text-danger mr-3"> × : @Languages.Tuchoi</span>
                                </div>
                            </td> *@
                        </tr>                      
                        <tr class="bg-primary text-white">                              
                            <th rowspan="2">@Languages.chitiet</th>
                            <th rowspan="2">@Languages.Tinhtrangdon</th>
                            <th rowspan="2">@Languages.Trangthaidon</th>
                            <th rowspan="2">@Languages.mayeucau</th>
                            <th rowspan="2">Cost Center</th>
                            <th rowspan="2">@Languages.Ngayyeucau</th>
                             
                            <th rowspan="2">@Languages.thoihanmuonnhan</th>
                            <th rowspan="2">@Languages.loaichiphi</th>
                            <th rowspan="2">@Languages.tongtien</th>
                            <th rowspan="2">@Languages.nguoitao</th>
                            <th colspan="3">@Languages.phongbanyeucau</th>
                            <th colspan="3">@Languages.phongtiepnhan</th>
                            <td colspan="3"></td>
                        </tr>
                        <tr class="bg-primary text-white" id="loadhangmuc"></tr>
                        <tbody id="list_approve"></tbody>
                    </table>
                    <ul class="pagination" id="pagination-controls"></ul>
                </div>
             
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalLyDoHuyn" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Lý do hủy đơn</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="id_huy">
                <div class="form-group">
                    <label>Vui lòng nhập lý do:</label>
                    <textarea class="form-control" id="txtLyDo" rows="4"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger" onclick="Huy_don()">Xác nhận hủy</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalLyDoHuyn_GA" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Lý do hủy đơn</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="id_huy_GA">
                <div class="form-group">
                    <label>Vui lòng nhập lý do:</label>
                    <textarea class="form-control" id="txtLyDo_GA" rows="4"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger" onclick="Huy_don_GA()">Xác nhận hủy</button>
            </div>
        </div>
    </div>
</div>
<button id="modal-7" hidden></button>
<button id="modal-23" hidden></button>
@await Html.PartialAsync("_modal_condition", "Approval")
<script src="~/scripts/request.js"></script>
<script>
window.onload = function()
{
    _load_request_condition();
    document.getElementById("hienthitimkiem_GA").style.display = 'none';
}

async function checkSelectValue(val) {
    if(val === "GA") {
            document.getElementById("loadhangmuc").innerHTML = `
                                <th>@Languages.nguoiduthao</th>
                                <th>@Languages.nguoithamtra</th>
                                <th>@Languages.nguoipheduyet</th>                                    
                                <th>@Languages.nguoixuatkho</th>
                                <th>@Languages.dongyboi QLSC</th>
                                <th>@Languages.dongyboi QLTC</th>
                                <th></th>
                                <th></th>
                                <th></th>`
        _load_request_condition_ga();
        document.getElementById("hienthitimkiem").style.display = 'none';
               document.getElementById("hienthitimkiem_GA").style.display = '';
    }
    if(val == "PROD"){
                document.getElementById("loadhangmuc").innerHTML = `
                                    <th>@Languages.nguoiduthao</th>
                                    <th>@Languages.nguoithamtra</th>
                                    <th>@Languages.nguoipheduyet</th>                                        
                                    <th>@Languages.dongyboi QLSC/QLTC</th>
                                    <th>@Languages.nguoixuatkho</th>
                                    <th></th>
                                    <th></th>
                                    <th></th>`
     _load_request_condition();
     document.getElementById("hienthitimkiem_GA").style.display = 'none';
     document.getElementById("hienthitimkiem").style.display = '';
    }
}

function _load_request_condition() {
    var us = document.getElementById("us").innerHTML;
    var Group_Code = document.getElementById("khoi").value;
    var Code_Request = document.getElementById("mnl").value;
    var INT_STEP = document.getElementById("tinhtrangdon").value;
    var Cost_Center = document.getElementById("cost").value;
    var Request_Date = document.getElementById("ngayyc").value;
    var Total = document.getElementById("giadonhang").value;
    var Urgent = document.getElementById("trangthaidon").value;
    var us = document.getElementById("us").innerHTML;
    var costt_ct = document.getElementById("costt_ct").value;
    var ngayyc = document.getElementById("ngaymn").value;
    var loaicp = document.getElementById("loaicp").value;
        
    const params = new URLSearchParams();
        params.append('Group_Code', Group_Code);
        params.append('Code_Request', Code_Request);
        params.append('INT_STEP', INT_STEP);
        params.append('Cost_Center', Cost_Center);
        params.append('Request_Date', Request_Date);
        params.append('Total', Total);
        params.append('Urgent', Urgent);
        params.append('us', us);
        params.append('costt_ct', costt_ct);
        params.append('ngayyc', ngayyc);
        params.append('loaicp', loaicp);

    fetch('/Request/get_requestcondition', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: params.toString()
    })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
                    const stepMap = {
            "0": ["Đợi người dự thảo", "warning", 1],
            "1": ["Đợi người thẩm tra", "info", 2],
            "2": ["Đợi người phê duyệt", "pink", 3],
            "3": ["Đợi bên tiếp nhận", "success", 4],
            "4": ["Đợi phụ trách kho", "light", 5],
            "5": ["Hoàn thành", "secondary", 6], // Vị trí 6 để tất cả 5 chấm đều success
            "6": ["Bị từ chối", "danger", 1],
            "7": ["Bị từ chối", "danger", 2],
            "8": ["Bị từ chối", "danger", 3],
            "9": ["Bị từ chối", "danger", 4],
            "10": ["Bị từ chối", "danger", 5],
            "15": ["Hủy đơn", "danger", 0],
        };

        const tbody = document.getElementById('list_approve');
        if (!data || data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="21" style="text-align:center">Không có dữ liệu</td></tr>';
            return;
        }
        // Cấu hình trạng thái: [Tên hiển thị, Badge class, Vị trí bước hiện tại/từ chối]

        tbody.innerHTML = data.map(item => {
            const s = item.inT_STEP;
            const config = stepMap[s] || ["Không xác định", "dark", 0];
            const isReject = Number(s) >= 6;
            const currentStep = config[2];
            var loaichiphi = "";
            if(item.declaration == "AUXILIARY") {loaichiphi = "Chi phí biến đổi theo sản lượng"}
            if(item.declaration == "EUQIMENT") {loaichiphi = "Chi phí cố định"}
            if(item.declaration == "FIXED") {loaichiphi = "Tài sản cố định"}
            if(item.declaration == "COMMON") {loaichiphi = "Chi phí chung"}
            if(item.declaration == "OTHER") {loaichiphi = "OTHER"}
            // Tạo các dấu chấm (chamtron)
            const dots = Array.from({ length: 5 }, (_, i) => {
                const stepIdx = i + 1;
                if (isReject && stepIdx === currentStep) return "<span class='text-danger'><b>×</b></span>";
                if (stepIdx < currentStep) return "<span class='text-success'><b>✓</b></span>";
                if (stepIdx === currentStep) return `<span class='text-warning'>${s === "5" ? "✓" : "◉"}</span>`;
                return "<span></span>";
            });

            const urg = item.urgent == "True" ? "<b class='text-danger'><i>* Gấp</i></b>" : "Thông thường";
            const trangthai = `<div class="badge badge-pill badge-${config[1]} mb-1">${config[0]}</div>`;

                var quyen = "<td></td><td></td>";
                    var suadon = ``;
                    var huydon = ``;

                    if(parseFloat(item.inT_STEP) <= 4){
                            suadon = `<a href="/Import/Suadon?iD_REQUEST=${item.iD_REQUEST}"> <i class="fa fa-pen text-success" ></i> </a>`;
                            huydon = `<i class="fa fa-ban text-danger" style="cursor:pointer" onclick="moModalHuyDon('${item.iD_REQUEST}')" ></i>`;
                    }
                    if(item.user_Create == us)
                    {
                        quyen = `<td  title="Xóa đơn" ><i class="fa fa-trash text-danger" onclick="xoa_don_prod('${item.iD_REQUEST}')"/></i> </td>
                                <td title="Sửa đơn" >${suadon}</td>
                                <td title="Hủy đơn" >${huydon}</td>`;
                    }
            return `
                    <tr>
                        <td class="text-center" id="${item.code_Request}" onclick="_modal_info(this.id, '${item.inT_STEP}')"><button class="btn btn-outline-primary"><i class="fa fa-info"></i></button></td>
                        <td>${urg}</td>
                        <td>${trangthai}</td>
                        <td>${item.code_Request}</td>
                        <td>${item.cost_Center}</td>
                        <td>${item.create_Date}</td>
                        <td>${item.dealine}</td>
                        <td>${loaichiphi}</td>
                        <td>${item.total}</td>
                        <td>${item.user_Create}</td>
                        <td>${item.chR_TEN_NGUOIYEUCAU}${dots[0]}</td>
                        <td>${item.chR_TEN_NGUOITHAMTRA}${dots[1]}</td>
                        <td>${item.chR_TEN_NGUOIPHEDUYET}${dots[2]}</td>
                        <td>${item.chR_TEN_XACNHAN}${dots[3]}</td>
                        <td>${item.chR_TEN_XUATKHO}${dots[4]}</td>
                        ${quyen}
                    </tr>`;
        }).join(''); // Nối tất cả các chuỗi thành một chuỗi HTML lớn

        // Cập nhật DOM chỉ MỘT lần
        tbody.innerHTML = htmlContent;
              
        })
        .catch(error => {
            console.error('There was a problem with the fetch operation:', error);
        });
}
    function moModalHuyDon(id) {
        document.getElementById("id_huy").value = id;
        document.getElementById("txtLyDo").value = "";

        // Mở modal
        $('#modalLyDoHuyn').modal('show');

        // Cách "chữa cháy" nếu lớp phủ vẫn đè lên:
        // Chuyển Modal ra ngoài cùng của body bằng JS ngay khi mở
        $('#modalLyDoHuyn').appendTo("body");
    }

// GA
async function _load_request_condition_ga() {
    // Lấy giá trị (Đảm bảo các ID này tồn tại trong HTML của bạn)
    var us = document.getElementById("us").innerHTML;
    const getValue = (id) => document.getElementById(id) ? document.getElementById(id).value : "";

    const params = new URLSearchParams({
        'Group_Code': getValue("khoi"),
        'Code_Request': getValue("mnl"),
        'INT_STEP': getValue("tinhtrangdon"),
        'Cost_Center': getValue("cost"),
        'Request_Date': getValue("ngayyc"),
        'Total': getValue("giadonhang"),
        'Urgent': getValue("trangthaidon"),
        'us': us,
        'costt_ct' : getValue("costt_ct") ,
        'ngayyc' : getValue("ngaymn"),
        'loaicp' : getValue("loaicp"),
    });

    fetch('/Request/get_requestcondition_ga', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params.toString()
    })
    .then(response => {
        if (!response.ok) throw new Error('Network response was not ok');
        return response.json();
    })
    .then(data => {
        console.log(data);
           document.getElementById('list_approve').innerHTML = "";
        if (data.length === 0) {
            document.getElementById('list_approve').innerHTML = `<tr><td colspan="15" class="text-center">Không có dữ liệu !</td></tr>`;
            //document.getElementById("pagination-controls").innerHTML = '';
        } else {
               const tbody = document.getElementById('list_approve');
        const stepMap = {
            "0": ["Đợi người dự thảo", "warning", 1],
            "1": ["Đợi người thẩm tra", "info", 2],
            "2": ["Đợi người phê duyệt", "pink", 3],
            "3": ["Đợi đảm nhiệm kho", "success", 4],
            "4": ["Đợi QLSC phòng tiếp nhận", "success", 5],
            "5": ["Đợi QLTC phòng tiếp nhận", "success", 5],
            "6": ["Bị từ chối", "danger", 1],
            "7": ["Bị từ chối", "danger", 2],
            "8": ["Bị từ chối", "danger", 3],
            "9": ["Bị từ chối", "danger", 4],
            "10": ["Bị từ chối", "danger", 5],
            "11": ["Hoàn thành", "secondary", 5],
            "15": ["Hủy đơn", "danger", 0],
        };

        const htmlContent = data.map(item => {
            const s = String(item.inT_STEP);
            const config = stepMap[s] || ["Không xác định", "dark", 0];
            const isReject = parseInt(s) >= 6;
            const currentStep = config[2];

            var loaichiphi = "";
            if(item.declaration == "AUXILIARY") {loaichiphi = "Chi phí biến đổi theo sản lượng"}
            if(item.declaration == "EUQIMENT") {loaichiphi = "Chi phí cố định"}
            if(item.declaration == "FIXED") {loaichiphi = "Tài sản cố định"}
            if(item.declaration == "COMMON") {loaichiphi = "Chi phí chung"}
            if(item.declaration == "OTHER") {loaichiphi = "OTHER"}

            const dots = Array.from({ length: 5 }, (_, i) => {
                const stepIdx = i + 1;
                if (isReject && stepIdx === currentStep) return "<span class='text-danger'><b>×</b></span>";
                if (stepIdx < currentStep) return "<span class='text-success'><b>✓</b></span>";
                if (stepIdx === currentStep) return `<span class='text-warning'>${s === "5" ? "✓" : "◉"}</span>`;
                return "<span></span>";
            });
                var quyen = "<td></td><td></td>";
                var suadon = ``;
                var huydon = ``;
                if (parseFloat(item.inT_STEP) <= 5 )
                {
                    suadon = `<a href="/Import/Suadon?iD_REQUEST=${item.iD_REQUEST}"> <i class="fa fa-pen text-success" ></i> </a>`;
                    huydon = `<i class="fa fa-ban text-danger" style="cursor:pointer" onclick="moModalHuyDon_GA('${item.iD_REQUEST}')" ></i>`;
                }
                if(item.user_Create == us)
                {
                        quyen = `<td  title="Xóa đơn" ><i class="fa fa-trash text-danger" onclick="xoa_don_GA('${item.iD_REQUEST}')"/></i></td>
                            <td title="Sửa đơn" >${suadon} </td>
                            <td title="Hủy đơn" >${huydon} </td>`;
                }        
            return `
                <tr>
                    <td class="text-center" onclick="_modal_info('${item.code_Request}', '${item.inT_STEP}')">
                        <button class="btn btn-outline-primary"><i class="fa fa-info"></i></button>
                    </td>
                    <td>${item.urgent == "True" ? "<b class='text-danger'><i>* Gấp</i></b>" : "Thông thường"}</td>
                    <td><div class="badge badge-pill badge-${config[1]}">${config[0]}</div></td>
                    <td>${item.code_Request}</td>
                    <td>${item.cost_Center}</td>
                    <td>${item.create_Date}</td>
                    <td>${item.dealine}</td>
                    <td>${loaichiphi}</td>
                    <td>${item.total}</td>
                    <td>${item.user_Create}</td>
                    <td>${item.chR_TEN_NGUOIYEUCAU || ''} ${dots[0]}</td>
                    <td>${item.chR_TEN_NGUOITHAMTRA || ''} ${dots[1]}</td>
                    <td>${item.chR_TEN_NGUOIPHEDUYET || ''} ${dots[2]}</td>
                    <td>${item.chR_TEN_XUATKHO || ''} ${dots[3]}</td>
                    <td>${item.chR_TEN_QLSC || ''} ${dots[4]}</td>
                    <td>${item.chR_TEN_QLTC || ''} ${dots[4]}</td>
                    ${quyen}
                </tr>`;
        }).join('');

        tbody.innerHTML = htmlContent;
        }
    })
    .catch(error => console.error('Error:', error));
}
function xoa_don_prod(iD_REQUEST){
var x = confirm("Bạn có muốn xóa đơn không !");
if(x){
        const params = new URLSearchParams();
        params.append('iD_REQUEST', iD_REQUEST);

        fetch('/Import/_XOADONPROD', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: params.toString()
        })
    .then(response => {
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
    })
        .then(data => {
            alert(data);
                _load_request_condition();
        })
        .catch(error => {
            console.error('There was a problem with the fetch operation:', error);
        });

    }   
}
function xoa_don_GA(iD_REQUEST){
var x = confirm("Bạn có muốn xóa đơn không !");
if(x){
        const params = new URLSearchParams();
        params.append('iD_REQUEST', iD_REQUEST);

        fetch('/Import/_XOADONGA', {
