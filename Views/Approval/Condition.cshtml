@using PRJ_WAREHOUSE_BIVN.Language
@{
    ViewData["Title"] = "Trạng thái đơn";
}
<style>
    .form-control, .input-group-text, .custom-select, .custom-file-label {
        border-color: #6e75c4;
    }

</style>
<div class="row">
    <div class="col-12">
        <div class="card card-primary">
            <div class="card-header ml-0">
                <div class="form-group" style="margin : 10px 0 0 0">
                    <label>@Languages.Khoi :</label> <br />
                    <div class="input-group mb-2">
                        <select class="form-control" id="khoi" onchange="checkSelectValue(this.value)">
                            <option value="PROD">PROD</option>
                            <option value="GA">GA</option>
                            <option value="IT">IT</option>
                            <option value="PUR">PUR</option>
                        </select>
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 10px">
                    <label>@Languages.Tinhtrangdon :</label> <br />
                    <div class="input-group mb-2">
                        <select id="trangthaidon" class="form-control">
                            <option value=""> ---  Chọn ---</option>
                            <option value="1">Gấp</option>
                            <option value="0">Thông thường</option>
                        </select>
                    </div>
                </div>
               
                <div class="form-group" style="margin : 10px 0 0 10px">
                    <label>@Languages.Trangthaidon :</label> <br />
                    <div class="input-group mb-2">
                       
                        <select class="form-control" id="tinhtrangdon">
                            <option value=""> ---  Chọn ---</option>
                            <option value="0">Đợi người dự thảo</option>
                            <option value="1">Đợi người thẩm tra</option>
                            <option value="2">Đợi người phê duyệt</option>
                            <option value="3">Đợi quản lý phòng tiếp nhận</option>
                            <option value="4">Đợi người xuất kho</option>
                            <option value="5">Hoàn thành</option>
                            <option value="6">Bị từ chối</option>
                        </select>
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 10px">
                    <label>@Languages.mayeucau :</label> <br />
                    <div class="input-group mb-2">
                        <input type="text" class="form-control" id="mnl" >
                    </div>
                </div>
              
                <div class="form-group" style="margin : 10px 0 0 10px" hidden>
                    <div class="input-group mb-2">
                        <input type="text" class="form-control" id="cost" placeholder="Cost">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 10px">
                    <label>@Languages.Ngayyeucau :</label> <br />
                    <div class="input-group mb-2">
                        <input type="date" class="form-control" id="ngayyc">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 10px">
                    <label>@Languages.Giatien :</label> <br />
                    <div class="input-group mb-2">
                   
                        <select id="giadonhang" class="form-control">
                            <option value="0"> ---  Chọn ---</option>
                            <option value="2999">Dưới 3000</option>
                            <option value="3000">Dưới 10,000</option>
                            <option value="10000" >Trên 10,000</option>
                        </select>
                    </div>
                </div>
                <button type="button" class="btn btn-info ml-3 mt-4" onclick="_load_request_condition()"><i class="ion ion-ios-search-strong"></i> @Languages.timkiem</button>
                <button type="button" class="btn btn-secondary ml-3 mt-4" onclick="_load_request_condition()"><i class="ion ion-refresh"></i> Refresh </button>
                <div class="form-group float-right mt-5" >
                    <span class="text-success ml-4">✓ : @Languages.daduyet </span> &nbsp;&nbsp;  <span class="text-warning"> ◉ : @Languages.dangdoi </span> &nbsp;&nbsp; <span class="text-danger mr-3"> × : @Languages.Tuchoi</span>
                </div>
            </div>
            <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                <div class="table-responsive card">
                    <table class="table table-bordered">
                        <thead class="bg-primary">
                            <tr>                              
                                <th rowspan="2">@Languages.chitiet</th>
                                <th rowspan="2">@Languages.Tinhtrangdon</th>
                                <th rowspan="2">@Languages.Trangthaidon</th>
                                <th rowspan="2">@Languages.mayeucau</th>
                                <th rowspan="2">Cost Center</th>
                                <th rowspan="2">@Languages.Ngayyeucau</th>
                                <th rowspan="2">@Languages.thoihanmuonnhan</th>
                                <th rowspan="2">@Languages.tongdon</th>
                                <th rowspan="2">@Languages.nguoitao</th>
                                <th colspan="3">@Languages.phongbanyeucau</th>
                                <th colspan="3">@Languages.phongtiepnhan</th>
            
                            </tr>
                            <tr id="loadhangmuc">
                              
                            </tr>
                        </thead>
                        <tbody id="list_approve"></tbody>
                    </table>             
                </div>
                <ul class="pagination" id="pagination-controls"></ul>
            </div>
        </div>
    </div>
</div>

<button id="modal-7" hidden></button>
@await Html.PartialAsync("_modal_condition", "Approval")
<script src="~/scripts/request.js"></script>
<script>
    window.onload = function()
    {
       _load_request_condition();
    }

    function checkSelectValue(val) {
        if(val === "GA") {
                document.getElementById("loadhangmuc").innerHTML = `
                                    <th>@Languages.nguoiduthao</th>
                                    <th>@Languages.nguoithamtra</th>
                                    <th>@Languages.nguoipheduyet</th>                                    
                                    <th>@Languages.nguoixuatkho</th>
                                    <th>@Languages.dongyboi QLSC</th>
                                    <th>@Languages.dongyboi QLTC</th>`
            _load_request_condition_ga();

        }
        if(vall == "PROD"){
                   document.getElementById("loadhangmuc").innerHTML = `
                                        <th>@Languages.nguoiduthao</th>
                                        <th>@Languages.nguoithamtra</th>
                                        <th>@Languages.nguoipheduyet</th>                                        
                                        <th>@Languages.dongyboi QLSC/QLTC</th>
                                        <th>@Languages.nguoixuatkho</th>`
            _load_request_condition();
        }
    }

    const userPagingState = {
        fullData: [],
        currentPage: 1,
        itemsPerPage: 15, // Số mục muốn hiển thị trên mỗi trang
        totalPages: 0
    };
    // --- 2. Hàm Tải Dữ liệu Chính (Fetch) ---
    function _load_request_condition() {

        var Group_Code = document.getElementById("khoi").value;
        var Code_Request = document.getElementById("mnl").value;
        var INT_STEP = document.getElementById("tinhtrangdon").value;
        var Cost_Center = document.getElementById("cost").value;
        var Request_Date = document.getElementById("ngayyc").value;
        var Total = document.getElementById("giadonhang").value;
        var Urgent = document.getElementById("trangthaidon").value;
        
        const params = new URLSearchParams();
            params.append('Group_Code', Group_Code);
            params.append('Code_Request', Code_Request);
            params.append('INT_STEP', INT_STEP);
            params.append('Cost_Center', Cost_Center);
            params.append('Request_Date', Request_Date);
            params.append('Total', Total);
            params.append('Urgent', Urgent);

        fetch('/Request/get_requestcondition', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: params.toString()
        })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                console.log(data);
                 userPagingState.fullData = data;
                // Tính tổng số trang
                userPagingState.totalPages = Math.ceil(data.length / userPagingState.itemsPerPage);

                if(data.length == 0){
                    document.getElementById('list_approve').innerHTML = `<tr><td colspan="15" style="text-align:center">Không có dữ liệu !</td></tr>`;
                }
                else{
                     
                // Khởi tạo hiển thị trang đầu tiên
                goToPage(1);
                }
              
            })
            .catch(error => {
                console.error('There was a problem with the fetch operation:', error);
            });
    }
    // --- 3. Hàm Xử lý Chuyển Trang ---
    function goToPage(page) {
        if (page < 1 || page > userPagingState.totalPages) return;

        userPagingState.currentPage = page;

        // Tính toán chỉ số
        const startIndex = (page - 1) * userPagingState.itemsPerPage;
        const endIndex = page * userPagingState.itemsPerPage;

        // Lấy dữ liệu trang hiện tại
        const pageData = userPagingState.fullData.slice(startIndex, endIndex);

        // Render giao diện
        renderUserTable(pageData);
        renderPaginationControls();
    }
    // --- 4. Hàm Render Bảng  ---
    function renderUserTable(data) {

        const tbody = document.getElementById('list_approve');
        if (!data || data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="21" style="text-align:center">Không có dữ liệu</td></tr>';
            return;
        }
        // Cấu hình trạng thái: [Tên hiển thị, Badge class, Vị trí bước hiện tại/từ chối]
        const stepMap = {
            "0": ["Đợi người dự thảo", "warning", 1],
            "1": ["Đợi người thẩm tra", "info", 2],
            "2": ["Đợi người phê duyệt", "pink", 3],
            "3": ["Đợi bên tiếp nhận", "success", 4],
            "4": ["Đợi phụ trách kho", "light", 5],
            "5": ["Hoàn thành", "secondary", 6], // Vị trí 6 để tất cả 5 chấm đều success
            "6": ["Bị từ chối", "danger", 1],
            "7": ["Bị từ chối", "danger", 2],
            "8": ["Bị từ chối", "danger", 3],
            "9": ["Bị từ chối", "danger", 4],
            "10": ["Bị từ chối", "danger", 5]
        };
        tbody.innerHTML = data.map(item => {
            const s = item.inT_STEP;
            const config = stepMap[s] || ["Không xác định", "dark", 0];
            const isReject = parseInt(s) >= 6;
            const currentStep = config[2];

            // Tạo các dấu chấm (chamtron)
            const dots = Array.from({ length: 5 }, (_, i) => {
                const stepIdx = i + 1;
                if (isReject && stepIdx === currentStep) return "<span class='text-danger'><b>×</b></span>";
                if (stepIdx < currentStep) return "<span class='text-success'><b>✓</b></span>";
                if (stepIdx === currentStep) return `<span class='text-warning'>${s === "5" ? "✓" : "◉"}</span>`;
                return "<span></span>";
            });

            const urg = item.urgent == "True" ? "<b class='text-danger'><i>* Gấp</i></b>" : "Thông thường";
            const trangthai = `<div class="badge badge-pill badge-${config[1]} mb-1">${config[0]}</div>`;

            return `
                    <tr>                       
                        <td class="text-center" id="${item.code_Request}" onclick="_modal_info(this.id, '${item.inT_STEP}')"><button class="btn btn-outline-primary"><i class="fa fa-info"></i></button></td>
                        <td>${urg}</td>
                        <td>${trangthai}</td>
                        <td>${item.code_Request}</td>
                        <td>${item.cost_Center}</td>
                        <td>${item.create_Date}</td>
                        <td>${item.dealine}</td>
                        <td>${item.total}</td>
                        <td>${item.user_Create}</td>
                        <td>${item.chR_TEN_NGUOIYEUCAU} ${dots[0]}</td>
                        <td>${item.chR_TEN_NGUOITHAMTRA} ${dots[1]}</td>
                        <td>${item.chR_TEN_NGUOIPHEDUYET} ${dots[2]}</td>
                        <td>${item.chR_TEN_XACNHAN} ${dots[3]}</td>
                        <td>${item.chR_TEN_XUATKHO} ${dots[4]}</td>                    
                    </tr>`;
        }).join(''); // Nối tất cả các chuỗi thành một chuỗi HTML lớn

        // Cập nhật DOM chỉ MỘT lần
        tbody.innerHTML = htmlContent;
    }
    // --- 5. Hàm Render Nút Phân trang ---
    function renderPaginationControls() {

        const container = document.getElementById("pagination-controls");
        const { currentPage, totalPages } = userPagingState;
        const maxButtonsToShow = 5; // Số nút tối đa (không tính Previous/Next)
        let controlsHTML = '';

        if (totalPages <= 1) {
            container.innerHTML = '';
            return;
        }

        // Nút Previous
        controlsHTML += ` <li class="page-item"><a class="page-link ${currentPage === 1 ? 'disabled' : ''} onclick="goToPage(${currentPage - 1})">« </a></li>`;

        // Tính toán phạm vi hiển thị
        let startPage = Math.max(1, currentPage - Math.floor((maxButtonsToShow - 1) / 2));
        let endPage = Math.min(totalPages, startPage + maxButtonsToShow - 1);

        // Điều chỉnh nếu phạm vi bị thu hẹp ở cuối
        if (endPage - startPage + 1 < maxButtonsToShow) {
            startPage = Math.max(1, endPage - maxButtonsToShow + 1);
        }

        // 1. Nút Trang 1
        if (startPage > 1) {
            controlsHTML += renderButton(1, currentPage);
            // Thêm dấu ... nếu trang 1 không sát với nút bắt đầu
            if (startPage > 2) {
                controlsHTML += `<span class="px-2">...</span>`;
            }
        }

        // 2. Các nút chính giữa
        for (let i = startPage; i <= endPage; i++) {
            controlsHTML += renderButton(i, currentPage);
        }

        // 3. Nút Trang Cuối
        if (endPage < totalPages) {
            // Thêm dấu ... nếu nút cuối không sát với trang cuối
            if (endPage < totalPages - 1) {
                controlsHTML += `<span class="px-2">...</span>`;
            }
            controlsHTML += renderButton(totalPages, currentPage);
        }

        // Nút Next

        controlsHTML += ` <li class="page-item"><a class="page-link  ${currentPage === totalPages ? 'disabled' : ''} onclick="goToPage(${currentPage + 1})"> »</a></li>`;
        container.innerHTML = controlsHTML;
    }
    // Hàm trợ giúp để tạo nút
    function renderButton(pageNumber, currentPage) {
        const activeClass = pageNumber === currentPage ? 'btn-primary text-white' : '';
        return ` <li class="page-item"><a class="page-link  ${activeClass}"  onclick="goToPage(${pageNumber})">${pageNumber}</a></li>`;
    }


 // load cho khối GA
// 1. Khởi tạo State
const userPagingState_ga = {
    fullData: [],
    currentPage: 1,
    itemsPerPage: 15,
    totalPages: 0
};

// 2. Hàm Tải Dữ liệu
function _load_request_condition_ga() {
    // Lấy giá trị (Đảm bảo các ID này tồn tại trong HTML của bạn)
    const getValue = (id) => document.getElementById(id) ? document.getElementById(id).value : "";

    const params = new URLSearchParams({
        'Group_Code': getValue("khoi"),
        'Code_Request': getValue("mnl"),
        'INT_STEP': getValue("tinhtrangdon"),
        'Cost_Center': getValue("cost"),
        'Request_Date': getValue("ngayyc"),
        'Total': getValue("giadonhang"),
        'Urgent': getValue("trangthaidon")
    });

    fetch('/Request/get_requestcondition_ga', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params.toString()
    })
    .then(response => {
        if (!response.ok) throw new Error('Network response was not ok');
        return response.json();
    })
    .then(data => {
        userPagingState_ga.fullData = data;
        userPagingState_ga.totalPages = Math.ceil(data.length / userPagingState_ga.itemsPerPage);

        if (data.length === 0) {
            document.getElementById('list_approve').innerHTML = `<tr><td colspan="15" class="text-center">Không có dữ liệu !</td></tr>`;
            document.getElementById("pagination-controls").innerHTML = '';
        } else {
            goToPage_ga(1);
        }
    })
    .catch(error => console.error('Error:', error));
}

// 3. Hàm Chuyển Trang
function goToPage_ga(page) {
    if (page < 1 || page > userPagingState_ga.totalPages) return;
    userPagingState_ga.currentPage = page;
    
    const startIndex = (page - 1) * userPagingState_ga.itemsPerPage;
    const pageData = userPagingState_ga.fullData.slice(startIndex, startIndex + userPagingState_ga.itemsPerPage);

    renderUserTable_ga(pageData);
    renderPaginationControls_ga();
}

// 4. Hàm Render Bảng
function renderUserTable_ga(data) {
    const tbody = document.getElementById('list_approve');
    const stepMap = {
        "0": ["Đợi người dự thảo", "warning", 1],
        "1": ["Đợi người thẩm tra", "info", 2],
        "2": ["Đợi người phê duyệt", "pink", 3],
        "3": ["Đợi đảm nhiệm kho", "success", 4],
        "4": ["Đợi QLSC phòng tiếp nhận", "light", 5],
        "5": ["Đợi QLTC phòng tiếp nhận", "secondary", 6],
        "6": ["Bị từ chối", "danger", 1],
        "7": ["Bị từ chối", "danger", 2],
        "8": ["Bị từ chối", "danger", 3],
        "9": ["Bị từ chối", "danger", 4],
        "10": ["Bị từ chối", "danger", 5]
    };

    const htmlContent = data.map(item => {
        const s = String(item.inT_STEP);
        const config = stepMap[s] || ["Không xác định", "dark", 0];
        const isReject = parseInt(s) >= 6;
        const currentStep = config[2];

        const dots = Array.from({ length: 5 }, (_, i) => {
            const stepIdx = i + 1;
            if (isReject && stepIdx === currentStep) return "<span class='text-danger'><b>×</b></span>";
            if (stepIdx < currentStep) return "<span class='text-success'><b>✓</b></span>";
            if (stepIdx === currentStep) return `<span class='text-warning'>${s === "5" ? "✓" : "◉"}</span>`;
            return "<span></span>";
        });

        return `
            <tr>
                <td class="text-center" onclick="_modal_info('${item.code_Request}', '${item.inT_STEP}')">
                    <button class="btn btn-outline-primary"><i class="fa fa-info"></i></button>
                </td>
                <td>${item.urgent == "True" ? "<b class='text-danger'><i>* Gấp</i></b>" : "Thông thường"}</td>
                <td><div class="badge badge-pill badge-${config[1]}">${config[0]}</div></td>
                <td>${item.code_Request}</td>
                <td>${item.cost_Center}</td>
                <td>${item.create_Date}</td>
                <td>${item.dealine}</td>
                <td>${item.total}</td>
                <td>${item.user_Create}</td>
                <td>${item.chR_TEN_NGUOIYEUCAU || ''} ${dots[0]}</td>
                <td>${item.chR_TEN_NGUOITHAMTRA || ''} ${dots[1]}</td>
                <td>${item.chR_TEN_NGUOIPHEDUYET || ''} ${dots[2]}</td>
                <td>${item.chR_TEN_XUATKHO || ''} ${dots[3]}</td>
                <td>${item.chR_TEN_QLSC || ''} ${dots[4]}</td>
                <td>${item.chR_TEN_QLTC || ''} ${dots[4]}</td>
            </tr>`;
    }).join('');

    tbody.innerHTML = htmlContent;
}

// 5. Hàm Render Phân Trang
function renderPaginationControls_ga() {
            const container = document.getElementById("pagination-controls");
            const { currentPage, totalPages } = userPagingState_ga;
            if (totalPages <= 1) { container.innerHTML = ''; return; }

            let html = `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                            <a class="page-link" href="javascript:void(0)" onclick="goToPage_ga(${currentPage - 1})">«</a>
                        </li>`;

            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
                    html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                                <a class="page-link" href="javascript:void(0)" onclick="goToPage_ga(${i})">${i}</a>
                            </li>`;
                } else if (i === currentPage - 3 || i === currentPage + 3) {
                    html += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }
            }

            html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                        <a class="page-link" href="javascript:void(0)" onclick="goToPage_ga(${currentPage + 1})">»</a>
                    </li>`;
                container.innerHTML = html;
}
</script>
