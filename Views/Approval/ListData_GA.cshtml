@using PRJ_WAREHOUSE_BIVN.Language
@{
    ViewData["Title"] = Languages.Pheduyetdon;
}
<style>
    .form-control, .input-group-text, .custom-select, .custom-file-label {
        border-color: #6e75c4;
    }

    .card .card-header .btn:not(.note-btn) {
        border-radius: 3px;
        height: 41px;
    }
    /* 2. Tạo vùng chứa các nút điều hướng ở dưới */
    .custom-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 80px; /* Khoảng cách giữa nút Prev và Next */
        margin-top: 20px;
        position: relative;
        height: 50px;
    }

    /* 3. Định dạng lại nút Next và Prev */
    .swiper-button-next,
    .swiper-button-prev {
        position: static !important; /* Bỏ chế độ tuyệt đối (absolute) */
        width: 40px !important;
        height: 40px !important;
        margin: 0 !important;
        background-color: #f8f9fa; /* Màu nền nút */
        color: #28a745 !important; /* Màu mũi tên xanh lá */
        float: right;
    }

        /* Chỉnh kích thước mũi tên nhỏ lại cho cân đối */
        .swiper-button-next:after,
        .swiper-button-prev:after {
            font-size: 15px !important;
            font-weight: bold;
        }

    /* 4. Đưa số phân trang vào giữa 2 nút */
    .swiper-pagination {
        position: static !important;
        width: auto !important;
        padding: 0 15px;
        font-size: 16px !important; /* Tăng kích thước chữ số */
        font-weight: bold !important; /* Làm đậm số */
        color: #495057 !important; /* Màu sắc của số hiển thị */
        display: flex;
        align-items: center;
    }

    /* Tùy chỉnh màu sắc riêng cho số trang hiện tại */
    .swiper-pagination-current {
        color: #28a745 !important; /* Đổi số trang hiện tại thành màu xanh lá giống màu nút */
    }

    /* Hiệu ứng khi di chuột qua nút */
    .swiper-button-next:hover,
    .swiper-button-prev:hover {
        background-color: #28a745;
        color: white !important;
    }
    /* Container bọc bảng có id hoặc class cụ thể để tránh ảnh hưởng bảng khác */
    .table-responsive-custom {
        max-height: 600px; /* Hoặc chiều cao bạn muốn */
        overflow-y: auto;
        position: relative;
    }

    /* Dòng header thứ nhất: Dính sát đỉnh (top: 0) */
    #modal-silder .table thead tr:nth-child(1) td,
    #modal-silder .table thead tr:nth-child(1) th {
        position: sticky;
        top: 0;
        background-color: #e8f3ff !important; /* Phải có màu nền để không lộ chữ bên dưới */
        z-index: 1000;
        border-bottom: 1px solid #dee2e6;
    }

    /* Dòng header thứ hai: Dính bên dưới dòng thứ nhất */
    #modal-silder .table thead tr:nth-child(2) td,
    #modal-silder .table thead tr:nth-child(2) th {
        position: sticky;
        top: 52px; /* TĂNG/GIẢM số này cho đến khi khít với dòng 1 */
        background-color: #e8f3ff !important;
        z-index: 999;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card card-primary">
            <div class="card-header" style="padding-left: 0px;">
                <div class="form-group" style="margin : 10px 0 0 5px">
                    <div class="input-group mb-2">
                        <button class="btn btn-outline-success" style="border-radius : 0px;" onclick="_dongy_all_GA()"><i class="fa fa-check"></i> @Languages.Dongy</button>
                        <button class="btn btn-outline-info ml-1" style="border-radius : 0px;" id="modal-15" onclick="_list_view()"><i class="fa fa-eye-dropper"></i> @Languages.Xem</button>
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 50px">
                    <div class="input-group mb-2">
                        <select class="form-control" id="trangthaidon">
                            <option value=""> -- @Languages.Tinhtrangdon --</option>
                            <option value="1">Gấp</option>
                            <option value="0">Thông thường</option>
                        </select>
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 10px">
                    <div class="input-group mb-2">
                        <select class="form-control" id="tinhtrangdon">
                            <option value=""> ---  @Languages.Trangthaidon ---</option>
                            <option value="0">Đợi người dự thảo</option>
                            <option value="1">Đợi người thẩm tra</option>
                            <option value="2">Đợi người phê duyệt</option>
                            <option value="3">Đợi quản lý phòng tiếp nhận</option>
                            <option value="4">Đợi người xuất kho</option>
                            <option value="5">Hoàn thành</option>
                            <option value="6">Bị từ chối</option>
                        </select>
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 10px">
                    <div class="input-group mb-2">
                        <input type="text" class="form-control" id="mnl" placeholder="@Languages.mayeucau ">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 10px">
                    <div class="input-group mb-2">
                        <select class="form-control" id="giadonhang">
                            <option value="">---  @Languages.Giatien  ---</option>
                            <option value="2999">Dưới 3000</option>
                            <option value="3000">Dưới 10,000</option>
                            <option value="10000">Trên 10,000</option>
                        </select>
                    </div>
                </div>
                <button type="button" class="btn btn-success ml-3" onclick="_load_confirm_GA()"><i class="ion ion-ios-search-strong"></i> @Languages.timkiem</button>
                <button type="button" class="btn btn-info ml-3" onclick="_reset()"><i class="ion ion-ios-refresh"></i> @Languages.Lammoi</button>

                <span class="text-success ml-4">✓ : @Languages.daduyet </span> &nbsp;&nbsp;  <span class="text-warning"> ◉ : @Languages.dangdoi </span> &nbsp;&nbsp; <span class="text-danger mr-3"> × : @Languages.Tuchoi</span>
            </div>
            <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                <div style="max-height: 600px; overflow-y: auto; border: 1px solid #dee2e6;">
                    <table class="table table-bordered">
                        <thead class="bg-primary" style="position: sticky; top: 0; background: #e8f3ff; z-index: 999;">
                            <tr>
                                <th rowspan="2" class="bg-white" style="text-align:center"><input type="checkbox" id="idd" /></th>
                                <th rowspan="2">@Languages.chitiet</th>
                                <th rowspan="2">No.</th>
                                <th rowspan="2">@Languages.Tinhtrangdon</th>
                                <th rowspan="2">@Languages.Trangthaidon</th>
                                <th rowspan="2">@Languages.mayeucau</th>
                                <th rowspan="2">Cost Center</th>
                                <th rowspan="2">@Languages.Ngayyeucau</th>
                                <th rowspan="2">@Languages.thoihanmuonnhan</th>
                                <th rowspan="2">@Languages.tongtien</th>
                                <th rowspan="2">@Languages.nguoitao</th>
                                <th colspan="3">@Languages.phongbanyeucau</th>
                                <th colspan="3">@Languages.phongtiepnhan</th>
                            </tr>
                            <tr>
                                <th>@Languages.nguoiduthao</th>
                                <th>@Languages.nguoithamtra</th>
                                <th>@Languages.nguoipheduyet</th>

                                <th>@Languages.Damnhiem</th>
                                <th>@Languages.dongyboi QLSC</th>
                                <th>@Languages.dongyboi QLTC</th>
                            </tr>
                        </thead>
                        <tbody id="list_approve"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<button id="modal-7" hidden></button>
@await Html.PartialAsync("_modal", "Approval")
<script src="~/scripts/request.js"></script>

<script>
    let swiper; // Định nghĩa biến Swiper toàn cục
    let lst = [];
    const checkAll = document.getElementById('idd');

    window.onload = function() {
        var us = document.getElementById("us").innerHTML;
        _load_confirm_GA(us);
    }

    document.addEventListener('change', function(e) {
        // 1. Xử lý logic Click vào nút "Chọn tất cả" (Check All)
        if (e.target && e.target.id === 'idd') {
            const checkboxes = document.querySelectorAll('.item');
            checkboxes.forEach(cb => {
                cb.checked = e.target.checked;
            });
        }

        // 2. Cập nhật trạng thái hiển thị cho nút "Check All" (Toàn bộ / Lửng lơ / Bỏ chọn)
        const allItems = document.querySelectorAll('.item');
        const checkedItems = document.querySelectorAll('.item:checked');

        if (checkAll) {
            checkAll.checked = (allItems.length > 0 && allItems.length === checkedItems.length);
            checkAll.indeterminate = (checkedItems.length > 0 && checkedItems.length < allItems.length);
        }

        // 3. GÁN GIÁ TRỊ VÀO LST
        lst = Array.from(checkedItems).map(cb => cb.value);
        console.log("Danh sách giá trị hiện tại:", lst);
    });

    function _list_view() {
        document.getElementById('slider').innerHTML = "";
        let ajaxPromises = []; // Mảng đồng bộ hóa hàng đợi AJAX

        // 1. Khởi tạo cấu trúc khung HTML của các slide trước
        for(let i = 0; i < lst.length; i++){
            var mayeucau = lst[i].split('_')[0];
            var buoc = lst[i].split('_')[1];

            document.getElementById('slider').innerHTML += `
            <div class="swiper-slide p-3">
                <table class="table table-bordered" style="text-align:center">
                    <tr hidden>
                        <td>Id_request : <i id="id_request${i}"></i></td>
                        <td>Bước : <i id="step${i}"></i></td>
                        <td>Regency : <i id="regency${i}"></i></td>
                        <td>Urgent : <i id="urgent${i}"></i></td>
                    </tr>
                    <tr>
                        <th rowspan="2" colspan="4" style="font-size:18px;background-color:#e8f3ff">
                            Phiếu yêu cầu hàng hóa (hàng trong danh mục chung, nguyên liệu phụ và vật tư tiêu hao) <br />
                            物品依頼書（共通間材・比例間材用・消耗品）　
                        </th>
                        <th colspan="2" id="madonhang${i}" style="background-color:#e8f3ff; font-size:18px"></th>
                    </tr>
                    <tr>
                        <th>Phòng tiếp nhậnを受け部門：</th>
                        <td style="background-color:#e8f3ff" id="khoi${i}"></td>
                    </tr>
                    <tr>
                        <td>※Mã bộ phận yêu cầu<br />依頼部門 コード</td>
                        <td>※ Mã phòng ban yêu cầu<br />依頼部門コストセンター</td>
                        <td>※ Tên phòng ban<br />依頼部門名</td>
                        <td>※Chuyền<br />ライン</td>
                        <td>※Ngày yêu cầu<br />依頼日</td>
                        <td>※Thời hạn mong muốn<br />希望期限</td>
                    </tr>
                    <tr style="height:60px; background-color : #e8f3ff">
                        <td id="mbp${i}"></td>
                        <td id="mpb_yc${i}"></td>
                        <td id="tenphongban${i}"></td>
                        <td id="chuyen${i}"></td>
                        <td id="nyc${i}"></td>
                        <td id="thmm${i}"></td>
                    </tr>
                </table>
                <div class="table-responsive-custom">
                    <table class="table table-bordered">
                        <thead class="text-center" style="position: sticky; top: 0; background: #e8f3ff; z-index: 999;">
                            <tr class="bg-white">
                                <td colspan="8" class="text-right">Tổng tiền 合計</td>
                                <td id="tongtien_${i}" class="bg-warning"></td>
                                <td colspan="4" class="text-center">
                                     <div id="cls_${i}">
                                          <button type="button" class="btn btn-success btn-icon icon-left" onclick="_update_request_GA_Slide('${i}')"><i class="ion ion-android-done-all"></i> Phê duyệt</button>
                                          <button type="button" class="btn btn-danger btn-icon icon-left" id="modal-22"><i class="ion ion-android-close"></i> Từ chối </button>
                                     </div>
                                </td>
                            </tr>
                            <tr>
                                <td rowspan="2">No</td>
                                <td rowspan="2">※ Mã đơn <br />システムコード</td>
                                <td rowspan="2">※ Tên hàng <br />品名</td>
                                <td rowspan="2">※ Đơn vị đóng gói <br />梱包単位</td>
                                <td rowspan="2">※ Số tài khoản<br />アカウントコスト</td>
                                <td rowspan="2">※ Tên tài khoản<br />アカウント名</td>
                                <td colspan="2">Yêu cầu <br />依頼</td>
                                <td colspan="2">Già thành<br />単価</td>
                                <td rowspan="2">Tổng chi phí <br />金額合計</td>
                                <td rowspan="2">※ Mục đích <br />目的</td>
                                <td rowspan="2">※ Ghi chú <br />備考</td>
                            </tr>
                            <tr>
                                <td>※ Số lượng <br />数量</td>
                                <td>Đơn vị<br />単位</td>
                                <td>Đơn giá<br />単価</td>
                                <td>Đơn vị tiền tệ <br />通貨単位</td>
                            </tr>
                        </thead>
                        <tbody id="load_detail${i}"></tbody>
                    </table>
                </div>
                <br />
            </div>`;

            // 2. Đưa các lệnh gọi AJAX vào danh sách theo dõi
            let ajaxRequest = $.ajax({
                url: '/Request/_get_request_GA',
                type: 'POST',
                dataType: 'JSON',
                data: { cost_request: mayeucau },
                success: function (response) {
                    console.log(response);
                    document.getElementById("load_detail" + i).innerHTML = "";
                    document.getElementById("madonhang" + i).innerHTML = "*" + response[0].code_Request + "*";
                    document.getElementById("mbp" + i).innerHTML = response[0].cost_Center_Group;
                    document.getElementById("mpb_yc" + i).innerHTML = response[0].cost_Center;
                    document.getElementById("tenphongban" + i).innerHTML = response[0].name_Dept;
                    document.getElementById("nyc" + i).innerHTML = response[0].creat_Date.split(' ')[0];
                    document.getElementById("thmm" + i).innerHTML = response[0].dealine.split(' ')[0];
                    document.getElementById("khoi" + i).innerHTML = response[0].group_Code.split(' ')[0];
                    document.getElementById("id_request" + i).innerHTML = response[0].id_Request;
                    document.getElementById("urgent" + i).innerHTML = response[0].urgent;
                    document.getElementById("step" + i).innerHTML = buoc;
                    document.getElementById("chuyen" + i).innerHTML = response[0].place;

                    if (buoc == "0") document.getElementById("regency" + i).innerHTML = "NGUOIYEUCAU";
                    if (buoc == "1") document.getElementById("regency" + i).innerHTML = "NGUOITHAMTRA";
                    if (buoc == "2") document.getElementById("regency" + i).innerHTML = "NGUOIPHEDUYET";
                    if (buoc == "3") document.getElementById("regency" + i).innerHTML = "XUATKHO";
                    if (buoc == "4") document.getElementById("regency" + i).innerHTML = "QLSC";
                    if (buoc == "5") document.getElementById("regency" + i).innerHTML = "QLTC";

                    var tongdon = 0;
                    for (var a = 0; a < response.length; a++) {
                        var tongtien = response[a].total_exchange;
                        // Sửa lỗi: Đã bọc các cột td vào trong cặp thẻ tr
                        document.getElementById("load_detail" + i).innerHTML += `<tr><td>${a + 1}</td><td>${response[a].material_Code}</td><td>${response[a].material_Name}</td><td>${response[a].unit}</td><td>${response[a].account_Code}</td><td>${response[a].account_Name}</td><td class="text-right">${response[a].amount.toLocaleString('en-US')}</td><td>${response[a].unit}</td><td class="text-right">${response[a].price.toLocaleString('en-US')}</td><td>${response[a].currency}</td><td class="text-right">${tongtien.toLocaleString('en-US')}</td><td>${response[a].aim}</td><td>${response[a].poisition}</td></tr>`;
                        tongdon += parseFloat(tongtien);
                    }
                    document.getElementById("tongtien_" + i).innerHTML = tongdon.toLocaleString('en-US');
                }
            });
            ajaxPromises.push(ajaxRequest);
        }

        // 3. Đợi toàn bộ các tiến trình AJAX hoàn tất thì mới bật Swiper số lên
        $.when.apply($, ajaxPromises).then(function() {
            // Huỷ cơ chế Swiper cũ nếu đang tồn tại để không dính lỗi cache slide
            if (swiper) {
                swiper.destroy(true, true);
            }

            // Tiến hành khởi tạo thực thể Swiper mới hoàn toàn
            swiper = new Swiper(".mySwiper", {
                slidesPerView: 1,
                spaceBetween: 30,
                navigation: {
                    nextEl: ".swiper-button-next",
                    prevEl: ".swiper-button-prev",
                },
                pagination: {
                    el: ".swiper-pagination",
                    type: "fraction", // <--- Chuyển nút tròn thành số trang phân số (1 / 5)
                },
                mousewheel: true,
                keyboard: true,
            });
        });
    }

    function _dongy_all_GA() {
        const checkboxes = document.querySelectorAll('input.item:checked');
        checkboxes.forEach((item) => {
            if (item.checked) {
                _update_request_all_GA(item.value);
            }
        });
        alert("Hoàn thành !");
    }
</script>
