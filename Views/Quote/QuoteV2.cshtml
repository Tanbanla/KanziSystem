@model PRJ_WAREHOUSE_BIVN.View_Models.Quote.QuoteModel
@using System.Collections.Generic
@using System.Linq
@using System.Text.Json
@using PRJ_WAREHOUSE_BIVN.DTO
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];

    var suppliers = Model?.DanhSachNhaCungCap ?? new List<IM_NCC_NEWDTO>();
    var materials = Model?.DanhSachVatTu ?? new List<MATERIALDTO>();
    var requester = Model?.NguoiThaoTac ?? string.Empty;
    var sections = Model?.DanhSachNhomViTri ?? new List<DEPARTMENTDTO>();
    var categories = Model?.DanhSachCategory ?? new List<string>();
    var requestTypes = Model?.RequestTypes ?? new List<BaoGia_RequestTypeDTO>();
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
    <link rel="stylesheet" href="~/css/QuoteNew.css" />
    <link rel="stylesheet" href="~/css/QuoteNotification.css" />
</head>

<div>
    <div id="quoteNotifications" class="quote-notifications" aria-live="polite" aria-atomic="true"></div>
    <div id="globalLoading" class="quote-global-loading" aria-hidden="true">
        <div class="quote-loading-box" role="status" aria-live="polite">
            <div class="quote-loading-spinner" aria-hidden="true"></div>
            <div class="quote-loading-message">@Localizer["Processing"]</div>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4>@Localizer["PageTitle"]</h4>
        <div class="btn-toolbar" role="toolbar" aria-label="@Localizer["PageTitle"]">
            <div class="d-flex gap-2 mb-2" role="group">
                <button type="button" class="btn btn-success" id="btnDownloadExcel"><i class="fas fa-file-excel me-1"></i>@Localizer["DownloadTemplate"]</button>
                <div style="margin-left: 6px;"></div>
                <button type="button" class="btn btn-warning w-100" id="btnDownMaster"><i class="fas fa-file-download me-1"></i> @Localizer["DownloadMaster"]</button>
            </div>
        </div>
    </div>
    <div class ="card shadow-sm quote-card mb-3">
        <div class="card-header bg-white quote-card-header">
            <h6 class="mb-0">@Localizer["QuoteInformation"]</h6>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label for="selectSection" class="form-label fw-semibold">
                        @Localizer["RequestDepartment"] <span class="text-danger">*</span>
                    </label>
                    <select id="selectSection" name="selectSection" class="form-select searchable-select">
                        <option value="">@Localizer["SelectDepartment"]</option>
                        <option value="GA">GA - General Affairs</option>
                        <option value="PUR">PUR - Purchasing</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label for="searchPhongBan" class="form-label">
                        @Localizer["CostCenter"] <span class="text-danger">*</span>
                    </label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchable-select">
                        <option value="" selected>@Localizer["SelectCostCenter"]</option>
                        @foreach (var s in sections)
                        {
                            <option value="@s.Cost_Center">
                                @s.Cost_Center - @s.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <button type="button" id="btnSendQuotation" class="btn btn-primary w-100">
                        <i class="fas fa-paper-plane me-1"></i> @Localizer["Send"]
                    </button>
                </div>
            </div>
            <div id="quoteContextValidationMessage" class="invalid-feedback d-block mt-3" role="alert" aria-live="polite"></div>
        </div>
    </div>
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class ="d-flex align-items-center gap-3">
                    <h6 class="mb-0 me-4" style="color:black">
                        @Localizer["QuotationList"]
                    </h6>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button type="button" class="btn"
                            id="btnImportfile"
                            style="color:darkgreen; background-color:white">
                        <i class="fas fa-file-excel"></i> @Localizer["ImportExcel"]
                    </button>
                    <button type="button" class="btn"
                            id="btnExportTablefile"
                            style="color:goldenrod; background-color:white">
                        <i class="fas fa-download me-1"></i> @Localizer["ExportTable"]
                    </button>
                    <button type="button" class="btn btn-primary"
                            id="btnAdd">
                        @Localizer["Add"] <i class="fas fa-plus-circle ms-1"></i>
                    </button>
                </div>

            </div>
        </div>
        <div class="card-body">
            <div class="quote-table-search mb-3" aria-label="@Localizer["SearchInTable"]">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <div>
                        <div class="quote-table-search-title"><i class="fas fa-search me-2"></i>@Localizer["SearchInTable"]</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnClearTableSearch">
                        <i class="fas fa-eraser me-1"></i>
                    </button>
                </div>
                <div class="row g-2">
                    <div class="col-12 col-md-4">
                        <label for="tableSearchInternalCode" class="visually-hidden">@Localizer["InternalCode"]</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                            <input type="search" class="form-control" id="tableSearchInternalCode" placeholder="@Localizer["InternalCode"]" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="tableSearchCategory" class="visually-hidden">@Localizer["Category"]</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-tags"></i></span>
                            <input type="search" class="form-control" id="tableSearchCategory" placeholder="@Localizer["Category"]" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="tableSearchSupplierCode" class="visually-hidden">@Localizer["SupplierItemCode"]</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-truck"></i></span>
                            <input type="search" class="form-control" id="tableSearchSupplierCode" placeholder="@Localizer["SupplierItemCode"]" autocomplete="off">
                        </div>
                    </div>
                </div>
                <div id="tableSearchResult" class="small text-muted mt-2" aria-live="polite"></div>
            </div>
            <div class="table-responsive quote-table" id="InforTableContainer">
                <table class="table table-sm table-hover table-bordered align-middle" id="InforTable">
                    <thead class="table-header-custom">
                        <tr class="text-center align-middle">
                            <th style="min-width: 40px">No.</th>
                            <th style="min-width: 160px">@Localizer["QuotationType"]</th>
                            <th style="min-width: 160px">@Localizer["InternalCode"]</th>
                            <th style="min-width: 140px">@Localizer["Category"]</th>
                            <th style="min-width: 100px">@Localizer["Classification"]</th>
                            <th style="min-width: 270px">@Localizer["NameVN"]</th>
                            <th style="min-width: 240px">@Localizer["NameEN"]</th>
                            <th style="min-width: 140px">@Localizer["SupplierItemCode"]</th>
                            <th style="min-width: 80px">@Localizer["Quantity"]</th>
                            <th style="min-width: 80px">@Localizer["Unit"]</th>
                            <th style="min-width: 140px">@Localizer["SupplierDeadline"]</th>
                            <th style="min-width: 140px">@Localizer["DesiredDate"]</th>
                            <th style="min-width: 60px">@Localizer["Urgent"]</th>
                            <th style="min-width: 160px">@Localizer["Supplier"]</th>
                            <th style="min-width: 80px">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="InforTableBody">
                        <tr><td colspan="15" class="text-center text-muted py-4">@Localizer["NoData"]</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer quote-card-footer">
            <div id="paginationInfo" class="d-flex justify-content-between align-items-center mt-2" style="display:none;">
                <div class="d-flex align-items-center gap-2">
                    <label for="rowsPerPageSelect" class="form-label mb-0" style="margin-right: 4px;">@Localizer["Showing"] </label>
                    <select id="rowsPerPageSelect" class="form-select form-select-sm" style="width: auto;">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20" selected>20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="150">150</option>
                        <option value="200">200</option>
                    </select>
                </div>
                <div id="pageInfo"></div>
                <div id="paginationControls" class="d-flex justify-content-center mt-3" style="display:none;">
                    <nav aria-label="Table pagination">
                        <ul class="pagination pagination-sm">
                            <li class="page-item" id="prevPage"><a class="page-link" href="#" aria-label="Trang trước"><span aria-hidden="true">&laquo;</span></a></li>
                            <li>
                                <div id="pageNumberInfo">1/5</div>
                            </li>
                            <li class="page-item" id="nextPage"><a class="page-link" href="#" aria-label="Trang sau"><span aria-hidden="true">&raquo;</span></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade quote-entry-modal" id="addInforModal" tabindex="-1" aria-labelledby="addInforModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header quote-modal-header">
                    <div>
                        <div class="quote-modal-kicker"><i class="fas fa-file-invoice me-1"></i> @Localizer["QuotationRequest"]</div>
                        <h5 class="modal-title" id="addInforModalLabel">@Localizer["AddQuotationItem"]</h5>
                        <div class="quote-modal-caption">@Localizer["EnterCompleteInfo"]</div>
                    </div>
                    <button type="button" class="quote-modal-close" id="btnCloseAddInforModal" aria-label="Đóng cửa sổ">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="modal-body">
                    <form id="addInforForm">
                        <div class="quote-form-section">
                            <div class="card-body">
                                <div class="quote-section-heading"><span class="quote-section-icon"><i class="fas fa-info-circle"></i></span><div><h6>@Localizer["BasicInformation"]</h6><small>@Localizer["ItemIdentity"]</small></div></div>
                                <div class="row g-3">
                                    <div class="col-12 col-md-4">
                                        <label for="searchMahangNB" class="form-label fw-semibold">@Localizer["InternalCode"] <span class="text-danger">*</span></label>
                                        <select id="searchMahangNB" name="searchMahangNB" class="form-select searchMahangNB searchable-select"
                                                data-remote="true" data-api="/Material/SearchMaterialView" data-page-size="200">
                                            <option value="" selected>@Localizer["InternalCode"]</option>
                                            @foreach (var s in materials)
                                            {
                                                <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="selectType" class="form-label fw-semibold">@Localizer["QuotationType"] <span class="text-danger">*</span></label>
                                        <select id="selectType" name="selectType" class="form-select searchable-select">
                                            <option value="" selected>@Localizer["SelectQuotationType"]</option>
                                            @foreach (var t in requestTypes)
                                            {
                                                <option value="@t.CHR_Code">@t.NVCHR_Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="selectPhanLoai" class="form-label fw-semibold">@Localizer["Classification"] <span class="text-danger">*</span></label>
                                        <select id="selectPhanLoai" name="selectPhanLoai" class="form-select searchable-select">
                                            <option value="" selected>@Localizer["SelectClassification"]</option>
                                            <option value="A">A</option>
                                            <option value="B">B</option>
                                            <option value="C">C</option>
                                            <option value="E">E</option>
                                            <option value="I">I</option>
                                            <option value="NO LIST">NO LIST</option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="selectChungLoai" class="form-label fw-semibold">@Localizer["Category"] <span class="text-danger">*</span></label>
                                        <select id="selectChungLoai" name="selectChungLoai" class="form-select searchable-select">
                                            <option value="" selected>@Localizer["SelectCategory"]</option>
                                            @foreach (var s in categories)
                                            {
                                                <option value="@s">@s</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label for="selectTenVN" class="form-label fw-semibold">@Localizer["NameVN"] <span class="text-danger">*</span></label>
                                        <input type="text" id="selectTenVN" name="selectTenVN" class="form-control" placeholder="@Localizer["EnterVNName"]" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label for="selectTenEN" class="form-label fw-semibold">@Localizer["NameEN"] <span class="text-danger">*</span></label>
                                        <input type="text" id="selectTenEN" name="selectTenEN" class="form-control" placeholder="@Localizer["EnterENName"]" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="selectMaThietBi" class="form-label fw-semibold">@Localizer["EquipmentCode"]</label>
                                        <input type="text" id="selectMaThietBi" name="selectMaThietBi" class="form-control" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="selectMaHangNCC" class="form-label fw-semibold">@Localizer["SupplierItemCode"]</label>
                                        <input type="text" id="selectMaHangNCC" name="selectMaHangNCC" class="form-control" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="selectSoLuong" class="form-label fw-semibold">@Localizer["Quantity"] <span class="text-danger">*</span></label>
                                        <input type="number" min="1" id="selectSoLuong" name="selectSoLuong" class="form-control" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="editDonVi" class="form-label fw-semibold">@Localizer["Unit"] <span class="text-danger">*</span></label>
                                        <input type="text" id="editDonVi" name="editDonVi" class="form-control" />
                                    </div>
                                    <div class="col-12">
                                        <label for="LyDoXinBaoGia" class="form-label fw-semibold">@Localizer["QuotationReason"]</label>
                                        <textarea class="form-control" id="LyDoXinBaoGia" name="LyDoXinBaoGia" rows="2" placeholder="@Localizer["EnterReason"]"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-lg-6">
                                <div class="quote-form-section h-100">
                                    <div class="card-body">
                                        <div class="quote-section-heading"><span class="quote-section-icon"><i class="fas fa-boxes"></i></span><div><h6>@Localizer["ItemDescription"]</h6><small>@Localizer["TechnicalPurpose"]</small></div></div>
                                        <div class="row g-3">
                                            <div class="col-12 col-md-6">
                                                <label for="selectHinhDang" class="form-label fw-semibold">@Localizer["Shape"]</label>
                                                <textarea type="text" id="selectHinhDang" name="selectHinhDang" class="form-control" ></textarea>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectChatLieu" class="form-label fw-semibold">@Localizer["Material"]</label>
                                                <textarea type="text" id="selectChatLieu" name="selectChatLieu" class="form-control" ></textarea>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectThanhPhan" class="form-label fw-semibold">@Localizer["Composition"]</label>
                                                <textarea type="text" id="selectThanhPhan" name="selectThanhPhan" class="form-control" ></textarea>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectKichThuoc" class="form-label fw-semibold">@Localizer["Dimensions"]</label>
                                                <textarea type="text" id="selectKichThuoc" name="selectKichThuoc" class="form-control" ></textarea>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectDungcho" class="form-label fw-semibold">@Localizer["UsedFor"]</label>
                                                <textarea type="text" id="selectDungcho" name="selectDungcho" class="form-control" ></textarea>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectDungde" class="form-label fw-semibold">@Localizer["Purpose"]</label>
                                                <textarea type="text" id="selectDungde" name="selectDungde" class="form-control" ></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-lg-6">
                                <div class="quote-form-section h-100">
                                    <div class="card-body">
                                        <div class="quote-section-heading"><span class="quote-section-icon"><i class="fas fa-shield-alt"></i></span><div><h6>@Localizer["SafetyRequirements"]</h6><small>@Localizer["RequiredDocuments"]</small></div></div>
                                        <div class="row g-3">
                                            <div class="col-12 col-md-6">
                                                <label for="selectROHS" class="form-label fw-semibold">ROHS</label>
                                                <select id="selectROHS" name="selectROHS" class="form-select">
                                                    <option value="" selected>@Localizer["SelectRohs"]</option>
                                                    <option value="NEED">@Localizer["RohsNeed"]</option>
                                                </select>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectCOCQ" class="form-label fw-semibold">CO / CQ</label>
                                                <select id="selectCOCQ" name="selectCOCQ" class="form-select">
                                                    <option value="" selected>@Localizer["SelectCoCq"]</option>
                                                    <option value="CO">CO</option>
                                                    <option value="CQ">CQ</option>
                                                    <option value="CO&CQ">CO & CQ</option>
                                                </select>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectMSDS" class="form-label fw-semibold">@Localizer["Msds"]</label>
                                                <textarea type="text" id="selectMSDS" name="selectMSDS" class="form-control" ></textarea>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectAnToan" class="form-label fw-semibold">@Localizer["SafetyStandard"]</label>
                                                <textarea type="text" id="selectAnToan" name="selectAnToan" class="form-control" ></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="quote-form-section mb-3">
                            <div class="card-body">
                                <div class="quote-section-heading"><span class="quote-section-icon"><i class="fas fa-truck"></i></span><div><h6>@Localizer["DeliveryInformation"]</h6><small>@Localizer["ReceivingPlan"]</small></div></div>
                                <div class="row g-3">
                                    <div class="col-12 col-md-3">
                                        <label for="NgayMuonNhan" class="form-label fw-semibold">@Localizer["ReceiveDate"] <span class="text-danger">*</span></label>
                                        <input type="date" class="form-control" id="NgayMuonNhan" name="NgayMuonNhan" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="LuaChonNcc" class="form-label fw-semibold">@Localizer["SupplierDeadline"] <span class="text-danger">*</span></label>
                                        <input type="date" class="form-control" id="LuaChonNcc" name="LuaChonNcc" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="selectGap" class="form-label fw-semibold">@Localizer["Urgent"]</label>
                                        <select id="selectGap" name="selectGap" class="form-select fw-bold text-danger  searchable-select">
                                            <option value="false" selected class="text-dark">@Localizer["No"]</option>
                                            <option value="true" class="text-danger">@Localizer["Yes"]</option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="NguoiNhanHang" class="form-label fw-semibold">@Localizer["Receiver"]</label>
                                        <input type="text" class="form-control" id="NguoiNhanHang" name="NguoiNhanHang" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="SDTNguoiNhanHang" class="form-label fw-semibold">@Localizer["ReceiverPhone"]</label>
                                        <input type="tel" class="form-control" id="SDTNguoiNhanHang" name="SDTNguoiNhanHang" />
                                    </div>
                                    <div class="col-12 col-md-8">
                                        <label for="DiaDiemGiaoHang" class="form-label fw-semibold">@Localizer["DeliveryLocation"]</label>
                                        <input type="text" class="form-control" id="DiaDiemGiaoHang" name="DiaDiemGiaoHang" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="quote-form-section mb-3">
                            <div class="card-body">
                                <div class="quote-section-heading"><span class="quote-section-icon"><i class="fas fa-paperclip"></i></span><div><h6>@Localizer["Attachments"]</h6><small>@Localizer["AttachmentDescription"]</small></div></div>
                                <div class="row g-3">
                                    <div class="col-12 col-md-4">
                                        <label for="FileThietKe" class="form-label fw-semibold">@Localizer["DesignFile"]</label>
                                        <input type="file" class="form-control" id="FileThietKe" name="FileThietKe" accept=".pdf,.doc,.docx,.xls,.xlsx,.dwg,.zip" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="LinkHinhAnh" class="form-label fw-semibold">@Localizer["ImageFile"]</label>
                                        <input type="file" class="form-control" id="LinkHinhAnh" name="LinkHinhAnh" accept="image/jpeg,image/png,image/webp" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="LinkBox" class="form-label fw-semibold">@Localizer["BoxLink"]</label>
                                        <input type="text" class="form-control" id="LinkBox" name="LinkBox" placeholder="@Localizer["LinkPassword"]" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="quote-form-section" id="supplierTableContainer">
                            <div class="card-body">
                                <div class="quote-section-heading justify-content-between">
                                    <div class="d-flex align-items-center gap-2"><span class="quote-section-icon" style="margin-right: 8px;" ><i class="fas fa-building"></i></span><div><h6>@Localizer["SupplierList"]</h6><small>@Localizer["SelectSuppliers"]</small></div></div>
                                    <span class="badge bg-warning text-dark fs-7">
                                        <i class="fas fa-exclamation-circle me-1"></i> @Localizer["MaximumFiveSuppliers"]
                                    </span>
                                </div>
                                <div class="table-responsive supplier-table-container">
                                    <table class="table table-sm table-hover table-bordered bg-white align-middle" id="supplierTable">
                                        <thead class="table-light text-center">
                                            <tr>
                                                <th style="width: 50px">No.</th>
                                                <th style="min-width: 140px">@Localizer["SupplierCode"]</th>
                                                <th style="min-width: 200px">@Localizer["SupplierName"]</th>
                                                <th style="min-width: 140px">@Localizer["Manufacturer"]</th>
                                                <th style="min-width: 120px">@Localizer["GetQuotation"]</th>
                                                <th style="min-width: 180px">@Localizer["RejectReason"]</th>
                                            </tr>
                                        </thead>
                                        <tbody id="supplierTableBody">
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-4">@Localizer["NoSupplierInfo"]</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div id="supplierValidationMessage" class="invalid-feedback d-block" role="alert" aria-live="polite"></div>
                            </div>
                        </div>

                    </form>
                </div>

                <div class="modal-footer quote-modal-footer">
                    <button type="button" class="btn btn-outline-warning px-4" id="btnClearAddInforModal">
                        <i class="fas fa-eraser me-1"></i> @Localizer["ClearData"]
                    </button>
                    <button type="button" class="btn btn-outline-secondary px-4 quote-modal-close-action" id="btnCancelAddInforModal">
                        <i class="fas fa-times me-1"></i> @Localizer["Close"]
                    </button>
                    <button type="button" class="btn btn-primary px-4 fw-semibold" id="btnSaveHistoryEdit">
                        <i class="fas fa-save me-1"></i> @Localizer["SaveInformation"]
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade quote-validation-modal" id="quoteValidationModal" tabindex="-1" aria-labelledby="quoteValidationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <div class="quote-validation-kicker"><i class="fas fa-exclamation-triangle me-1"></i> @Localizer["ValidationTitle"]</div>
                        <h5 class="modal-title" id="quoteValidationModalLabel">@Localizer["CannotSave"]</h5>
                    </div>
                    <button type="button" class="quote-validation-close" data-bs-dismiss="modal" aria-label="Đóng">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">@Localizer["FillRequired"]</p>
                    <ul id="quoteValidationErrors" class="quote-validation-errors mb-0"></ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">@Localizer["Understood"]</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="quoteApproverModal" tabindex="-1" aria-labelledby="quoteApproverModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="quoteApproverModalLabel">@Localizer["SelectApprover"]</h5>
                    <button type="button" class="quote-validation-close" id="btnCloseQuoteApproverModal" aria-label="Đóng">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <label for="quoteApproverSelect" class="form-label">@Localizer["ApproverRequired"] <span class="text-danger">*</span></label>
                    <select id="quoteApproverSelect" class="form-select">
                        <option value="">@Localizer["LoadingList"]</option>
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" id="btnCancelQuoteApproverModal">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-primary" id="btnConfirmSendQuotation">@Localizer["SendRequest"]</button>
                </div>
            </div>
        </div>
    </div>
</div>
