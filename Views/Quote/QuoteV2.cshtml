@model PRJ_WAREHOUSE_BIVN.View_Models.Quote.QuoteModel
@using System.Collections.Generic
@using System.Linq
@using PRJ_WAREHOUSE_BIVN.DTO
@{
    ViewData["Title"] = "Tạo yêu cầu báo giá";

    var suppliers = Model?.DanhSachNhaCungCap ?? new List<IM_NCC_NEWDTO>();
    var materials = Model?.DanhSachVatTu ?? new List<MATERIALDTO>();
    var requester = Model?.NguoiThaoTac ?? string.Empty;
    var sections = Model?.DanhSachNhomViTri ?? new List<DEPARTMENTDTO>();
    var categories = Model?.DanhSachCategory ?? new List<string>();
    var requestTypes = Model?.RequestTypes ?? new List<BaoGia_RequestTypeDTO>();
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
    <link rel="stylesheet" href="~/css/QuoteNew.css" />
    <link rel="stylesheet" href="~/css/QuoteNotification.css" />
</head>

<div>
    <div id="quoteNotifications" class="quote-notifications" aria-live="polite" aria-atomic="true"></div>
    <div id="globalLoading" class="quote-global-loading" aria-hidden="true">
        <div class="quote-loading-box" role="status" aria-live="polite">
            <div class="quote-loading-spinner" aria-hidden="true"></div>
            <div class="quote-loading-message">Đang xử lý...</div>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4>Tạo xin báo giá mới</h4>
        <div class="btn-toolbar" role="toolbar" aria-label="Toolbar">
            <div class="d-flex gap-2 mb-2" role="group">
                <button type="button" class="btn btn-success" id="btnDownloadExcel"><i class="fas fa-file-excel me-1"></i>Tải file mẫu</button>
                <div style="margin-left: 6px;"></div>
                <button type="button" class="btn btn-warning w-100" id="btnDownMaster"><i class="fas fa-file-download me-1"></i> Tải dữ liệu master</button>
            </div>
        </div>
    </div>
    <div class ="card shadow-sm quote-card mb-3">
        <div class="card-header bg-white quote-card-header">
            <h6 class="mb-0">Thông tin báo giá</h6>
        </div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label for="selectSection" class="form-label fw-semibold">
                        Phòng ban xin báo giá <span class="text-danger">*</span>
                    </label>
                    <select id="selectSection" name="selectSection" class="form-select searchable-select">
                        <option value="">Chọn phòng ban</option>
                        <option value="GA">GA - General Affairs</option>
                        <option value="PUR">PUR - Purchasing</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label for="searchPhongBan" class="form-label">
                        Mã chi phí <span class="text-danger">*</span>
                    </label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchable-select">
                        <option value="" selected>Chọn mã chi phí</option>
                        @foreach (var s in sections)
                        {
                            <option value="@s.Cost_Center">
                                @s.Cost_Center - @s.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <button type="button" id="btnSendQuotation" class="btn btn-primary w-100">
                        <i class="fas fa-paper-plane me-1"></i> Gửi
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class ="d-flex align-items-center gap-3">
                    <h6 class="mb-0 me-4" style="color:black">
                        Danh sách xin báo giá
                    </h6>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button type="button" class="btn"
                            id="btnImportfile"
                            style="color:darkgreen; background-color:white">
                        <i class="fas fa-file-excel"></i> Import file Excel
                    </button>
                    <button type="button" class="btn"
                            id="btnExportTablefile"
                            style="color:goldenrod; background-color:white">
                        <i class="fas fa-download me-1"></i> Tải dữ liệu bảng
                    </button>
                    <button type="button" class="btn btn-primary"
                            id="btnAdd">
                        Thêm <i class="fas fa-plus-circle ms-1"></i>
                    </button>
                </div>

            </div>
        </div>
        <div class="card-body">
            <div class="quote-table-search mb-3" aria-label="Tìm kiếm mặt hàng trong bảng">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <div>
                        <div class="quote-table-search-title"><i class="fas fa-search me-2"></i>Tìm kiếm trong bảng</div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnClearTableSearch">
                        <i class="fas fa-eraser me-1"></i>
                    </button>
                </div>
                <div class="row g-2">
                    <div class="col-12 col-md-4">
                        <label for="tableSearchInternalCode" class="visually-hidden">Mã hàng nội bộ</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-barcode"></i></span>
                            <input type="search" class="form-control" id="tableSearchInternalCode" placeholder="Mã hàng nội bộ" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="tableSearchCategory" class="visually-hidden">Chủng loại</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-tags"></i></span>
                            <input type="search" class="form-control" id="tableSearchCategory" placeholder="Chủng loại" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <label for="tableSearchSupplierCode" class="visually-hidden">Mã hàng nhà cung cấp</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-truck"></i></span>
                            <input type="search" class="form-control" id="tableSearchSupplierCode" placeholder="Mã hàng nhà cung cấp" autocomplete="off">
                        </div>
                    </div>
                </div>
                <div id="tableSearchResult" class="small text-muted mt-2" aria-live="polite"></div>
            </div>
            <div class="table-responsive quote-table" id="InforTableContainer">
                <table class="table table-sm table-hover table-bordered align-middle" id="InforTable">
                    <thead class="table-header-custom">
                        <tr class="text-center align-middle">
                            <th style="min-width: 40px">No.</th>
                            <th style="min-width: 160px">Loại báo giá</th>
                            <th style="min-width: 160px">Mã hàng nội bộ</th>
                            <th style="min-width: 140px">Chủng loại</th>
                            <th style="min-width: 100px">Phân loại hàng</th>
                            <th style="min-width: 270px">Tên tiếng việt</th>
                            <th style="min-width: 240px">Tên tiếng anh</th>
                            <th style="min-width: 140px">Mã hàng nhà cung cấp</th>
                            <th style="min-width: 80px">Số lượng</th>
                            <th style="min-width: 80px">Đơn vị</th>
                            <th style="min-width: 140px">Kỳ hạn lựa chọn nhà cung cấp</th>
                            <th style="min-width: 140px">Ngày mong muốn nhận hàng</th>
                            <th style="min-width: 60px">Gấp</th>
                            <th style="min-width: 160px">Nhà cung cấp xin báo giá</th>
                            <th style="min-width: 80px">Hành động</th>
                        </tr>
                    </thead>
                    <tbody id="InforTableBody">
                        <tr><td colspan="15" class="text-center text-muted py-4">Không có dữ liệu</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer quote-card-footer">
            <div id="paginationInfo" class="d-flex justify-content-between align-items-center mt-2" style="display:none;">
                <div class="d-flex align-items-center gap-2">
                    <label for="rowsPerPageSelect" class="form-label mb-0" style="margin-right: 4px;">Hiển thị </label>
                    <select id="rowsPerPageSelect" class="form-select form-select-sm" style="width: auto;">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20" selected>20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="150">150</option>
                        <option value="200">200</option>
                    </select>
                </div>
                <div id="pageInfo"></div>
                <div id="paginationControls" class="d-flex justify-content-center mt-3" style="display:none;">
                    <nav aria-label="Table pagination">
                        <ul class="pagination pagination-sm">
                            <li class="page-item" id="prevPage"><a class="page-link" href="#" aria-label="Trang trước"><span aria-hidden="true">&laquo;</span></a></li>
                            <li>
                                <div id="pageNumberInfo">1/5</div>
                            </li>
                            <li class="page-item" id="nextPage"><a class="page-link" href="#" aria-label="Trang sau"><span aria-hidden="true">&raquo;</span></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade quote-entry-modal" id="addInforModal" tabindex="-1" aria-labelledby="addInforModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header quote-modal-header">
                    <div>
                        <div class="quote-modal-kicker"><i class="fas fa-file-invoice me-1"></i> Yêu cầu báo giá</div>
                        <h5 class="modal-title" id="addInforModalLabel">Thêm mặt hàng báo giá</h5>
                        <div class="quote-modal-caption">Nhập đầy đủ thông tin để gửi yêu cầu đến nhà cung cấp</div>
                    </div>
                    <button type="button" class="quote-modal-close" id="btnCloseAddInforModal" aria-label="Đóng cửa sổ">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="modal-body">
                    <form id="addInforForm">
                        <div class="quote-form-section">
                            <div class="card-body">
                                <div class="quote-section-heading"><span class="quote-section-icon"><i class="fas fa-info-circle"></i></span><div><h6>Thông tin cơ bản</h6><small>Thông tin nhận diện mặt hàng và nhu cầu</small></div></div>
                                <div class="row g-3">
                                    <div class="col-12 col-md-4">
                                        <label for="searchMahangNB" class="form-label fw-semibold">Mã hàng nội bộ <span class="text-danger">*</span></label>
                                        <select id="searchMahangNB" name="searchMahangNB" class="form-select searchMahangNB searchable-select"
                                                data-remote="true" data-api="/Material/SearchMaterialView" data-page-size="200">
                                            <option value="" selected>Chọn mã hàng nội bộ</option>
                                            @foreach (var s in materials)
                                            {
                                                <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="selectType" class="form-label fw-semibold">Loại báo giá <span class="text-danger">*</span></label>
                                        <select id="selectType" name="selectType" class="form-select searchable-select">
                                            <option value="" selected>Chọn loại báo giá</option>
                                            @foreach (var t in requestTypes)
                                            {
                                                <option value="@t.CHR_Code">@t.NVCHR_Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="selectPhanLoai" class="form-label fw-semibold">Phân loại hàng <span class="text-danger">*</span></label>
                                        <select id="selectPhanLoai" name="selectPhanLoai" class="form-select searchable-select">
                                            <option value="" selected>Chọn phân loại</option>
                                            <option value="A">A</option>
                                            <option value="B">B</option>
                                            <option value="C">C</option>
                                            <option value="E">E</option>
                                            <option value="I">I</option>
                                            <option value="NO LIST">NO LIST</option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="selectChungLoai" class="form-label fw-semibold">Chủng loại hàng <span class="text-danger">*</span></label>
                                        <select id="selectChungLoai" name="selectChungLoai" class="form-select searchable-select">
                                            <option value="" selected>Chọn chủng loại</option>
                                            @foreach (var s in categories)
                                            {
                                                <option value="@s">@s</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label for="selectTenVN" class="form-label fw-semibold">Tên hàng tiếng Việt <span class="text-danger">*</span></label>
                                        <input type="text" id="selectTenVN" name="selectTenVN" class="form-control" placeholder="Nhập tên tiếng Việt" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label for="selectTenEN" class="form-label fw-semibold">Tên hàng tiếng Anh <span class="text-danger">*</span></label>
                                        <input type="text" id="selectTenEN" name="selectTenEN" class="form-control" placeholder="Nhập tên tiếng Anh" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="selectMaThietBi" class="form-label fw-semibold">Mã thiết bị</label>
                                        <input type="text" id="selectMaThietBi" name="selectMaThietBi" class="form-control" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="selectMaHangNCC" class="form-label fw-semibold">Mã hàng NCC</label>
                                        <input type="text" id="selectMaHangNCC" name="selectMaHangNCC" class="form-control" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="selectSoLuong" class="form-label fw-semibold">Số lượng <span class="text-danger">*</span></label>
                                        <input type="number" min="1" id="selectSoLuong" name="selectSoLuong" class="form-control" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="editDonVi" class="form-label fw-semibold">Đơn vị <span class="text-danger">*</span></label>
                                        <input type="text" id="editDonVi" name="editDonVi" class="form-control" />
                                    </div>
                                    <div class="col-12">
                                        <label for="LyDoXinBaoGia" class="form-label fw-semibold">Lý do xin báo giá</label>
                                        <textarea class="form-control" id="LyDoXinBaoGia" name="LyDoXinBaoGia" rows="2" placeholder="Nhập lý do chi tiết..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-lg-6">
                                <div class="quote-form-section h-100">
                                    <div class="card-body">
                                        <div class="quote-section-heading"><span class="quote-section-icon"><i class="fas fa-boxes"></i></span><div><h6>Mô tả hàng hóa</h6><small>Thông số kỹ thuật và mục đích sử dụng</small></div></div>
                                        <div class="row g-3">
                                            <div class="col-12 col-md-6">
                                                <label for="selectHinhDang" class="form-label fw-semibold">Hình dáng</label>
                                                <textarea type="text" id="selectHinhDang" name="selectHinhDang" class="form-control" ></textarea>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectChatLieu" class="form-label fw-semibold">Chất liệu / Màu sắc</label>
                                                <textarea type="text" id="selectChatLieu" name="selectChatLieu" class="form-control" ></textarea>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectThanhPhan" class="form-label fw-semibold">Thành phần, hàm lượng</label>
                                                <textarea type="text" id="selectThanhPhan" name="selectThanhPhan" class="form-control" ></textarea>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectKichThuoc" class="form-label fw-semibold">Kích thước</label>
                                                <textarea type="text" id="selectKichThuoc" name="selectKichThuoc" class="form-control" ></textarea>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectDungcho" class="form-label fw-semibold">Dùng cho máy/vị trí</label>
                                                <textarea type="text" id="selectDungcho" name="selectDungcho" class="form-control" ></textarea>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectDungde" class="form-label fw-semibold">Dùng để làm gì</label>
                                                <textarea type="text" id="selectDungde" name="selectDungde" class="form-control" ></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 col-lg-6">
                                <div class="quote-form-section h-100">
                                    <div class="card-body">
                                        <div class="quote-section-heading"><span class="quote-section-icon"><i class="fas fa-shield-alt"></i></span><div><h6>Yêu cầu an toàn & tiêu chuẩn</h6><small>Chứng từ và tiêu chuẩn bắt buộc</small></div></div>
                                        <div class="row g-3">
                                            <div class="col-12 col-md-6">
                                                <label for="selectROHS" class="form-label fw-semibold">ROHS</label>
                                                <select id="selectROHS" name="selectROHS" class="form-select">
                                                    <option value="" selected>Chọn tiêu chuẩn ROHS</option>
                                                    <option value="NEED">Need (Cần)</option>
                                                </select>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectCOCQ" class="form-label fw-semibold">CO / CQ</label>
                                                <select id="selectCOCQ" name="selectCOCQ" class="form-select">
                                                    <option value="" selected>Chọn tiêu chuẩn CO/CQ</option>
                                                    <option value="CO">CO</option>
                                                    <option value="CQ">CQ</option>
                                                    <option value="CO&CQ">CO & CQ</option>
                                                </select>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectMSDS" class="form-label fw-semibold">MSDS & CAS No</label>
                                                <textarea type="text" id="selectMSDS" name="selectMSDS" class="form-control" ></textarea>
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <label for="selectAnToan" class="form-label fw-semibold">Tiêu chuẩn an toàn</label>
                                                <textarea type="text" id="selectAnToan" name="selectAnToan" class="form-control" ></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="quote-form-section mb-3">
                            <div class="card-body">
                                <div class="quote-section-heading"><span class="quote-section-icon"><i class="fas fa-truck"></i></span><div><h6>Thời gian & địa điểm giao hàng</h6><small>Kế hoạch nhận hàng và thông tin liên hệ</small></div></div>
                                <div class="row g-3">
                                    <div class="col-12 col-md-3">
                                        <label for="NgayMuonNhan" class="form-label fw-semibold">Ngày muốn nhận hàng <span class="text-danger">*</span></label>
                                        <input type="date" class="form-control" id="NgayMuonNhan" name="NgayMuonNhan" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="LuaChonNcc" class="form-label fw-semibold">Hạn chọn nhà cung cấp <span class="text-danger">*</span></label>
                                        <input type="date" class="form-control" id="LuaChonNcc" name="LuaChonNcc" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="selectGap" class="form-label fw-semibold">Đơn hàng gấp</label>
                                        <select id="selectGap" name="selectGap" class="form-select fw-bold text-danger  searchable-select">
                                            <option value="false" selected class="text-dark">Không</option>
                                            <option value="true" class="text-danger">Có</option>
                                        </select>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <label for="NguoiNhanHang" class="form-label fw-semibold">Người nhận hàng</label>
                                        <input type="text" class="form-control" id="NguoiNhanHang" name="NguoiNhanHang" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="SDTNguoiNhanHang" class="form-label fw-semibold">SĐT người nhận</label>
                                        <input type="tel" class="form-control" id="SDTNguoiNhanHang" name="SDTNguoiNhanHang" />
                                    </div>
                                    <div class="col-12 col-md-8">
                                        <label for="DiaDiemGiaoHang" class="form-label fw-semibold">Địa điểm giao hàng</label>
                                        <input type="text" class="form-control" id="DiaDiemGiaoHang" name="DiaDiemGiaoHang" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="quote-form-section mb-3">
                            <div class="card-body">
                                <div class="quote-section-heading"><span class="quote-section-icon"><i class="fas fa-paperclip"></i></span><div><h6>Tài liệu kèm theo</h6><small>Đính kèm tài liệu hỗ trợ cho yêu cầu</small></div></div>
                                <div class="row g-3">
                                    <div class="col-12 col-md-4">
                                        <label for="FileThietKe" class="form-label fw-semibold">File thiết kế</label>
                                        <input type="file" class="form-control" id="FileThietKe" name="FileThietKe" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="LinkHinhAnh" class="form-label fw-semibold">Link/File hình ảnh</label>
                                        <input type="file" class="form-control" id="LinkHinhAnh" name="LinkHinhAnh" placeholder="" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <label for="LinkBox" class="form-label fw-semibold">Link Box/Drive</label>
                                        <input type="text" class="form-control" id="LinkBox" name="LinkBox" placeholder="Link + Password" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="quote-form-section" id="supplierTableContainer">
                            <div class="card-body">
                                <div class="quote-section-heading justify-content-between">
                                    <div class="d-flex align-items-center gap-2"><span class="quote-section-icon" style="margin-right: 8px;" ><i class="fas fa-building"></i></span><div><h6>Danh sách nhà cung cấp</h6><small>Chọn các nhà cung cấp cần gửi báo giá</small></div></div>
                                    <span class="badge bg-warning text-dark fs-7">
                                        <i class="fas fa-exclamation-circle me-1"></i> Tối đa 5 NCC
                                    </span>
                                </div>
                                <div class="table-responsive supplier-table-container">
                                    <table class="table table-sm table-hover table-bordered bg-white align-middle" id="supplierTable">
                                        <thead class="table-light text-center">
                                            <tr>
                                                <th style="width: 50px">STT</th>
                                                <th style="min-width: 140px">Mã NCC</th>
                                                <th style="min-width: 200px">Tên NCC</th>
                                                <th style="min-width: 140px">Nhà sản xuất</th>
                                                <th style="min-width: 120px">Lấy báo giá</th>
                                                <th style="min-width: 180px">Lý do không xin BG</th>
                                            </tr>
                                        </thead>
                                        <tbody id="supplierTableBody">
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-4">Chưa có thông tin nhà cung cấp</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>

                <div class="modal-footer quote-modal-footer">
                    <button type="button" class="btn btn-outline-warning px-4" id="btnClearAddInforModal">
                        <i class="fas fa-eraser me-1"></i> Xóa dữ liệu
                    </button>
                    <button type="button" class="btn btn-outline-secondary px-4 quote-modal-close-action" id="btnCancelAddInforModal">
                        <i class="fas fa-times me-1"></i> Đóng
                    </button>
                    <button type="button" class="btn btn-primary px-4 fw-semibold" id="btnSaveHistoryEdit">
                        <i class="fas fa-save me-1"></i> Lưu thông tin
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade quote-validation-modal" id="quoteValidationModal" tabindex="-1" aria-labelledby="quoteValidationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <div class="quote-validation-kicker"><i class="fas fa-exclamation-triangle me-1"></i> Kiểm tra thông tin</div>
                        <h5 class="modal-title" id="quoteValidationModalLabel">Chưa thể lưu thông tin</h5>
                    </div>
                    <button type="button" class="quote-validation-close" data-bs-dismiss="modal" aria-label="Đóng">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Vui lòng bổ sung các thông tin sau:</p>
                    <ul id="quoteValidationErrors" class="quote-validation-errors mb-0"></ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Đã hiểu</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="quoteApproverModal" tabindex="-1" aria-labelledby="quoteApproverModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="quoteApproverModalLabel">Chọn người phê duyệt</h5>
                    <button type="button" class="quote-validation-close" id="btnCloseQuoteApproverModal" aria-label="Đóng">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <label for="quoteApproverSelect" class="form-label">Người phê duyệt <span class="text-danger">*</span></label>
                    <select id="quoteApproverSelect" class="form-select">
                        <option value="">Đang tải danh sách...</option>
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" id="btnCancelQuoteApproverModal">Hủy</button>
                    <button type="button" class="btn btn-primary" id="btnConfirmSendQuotation">Gửi yêu cầu</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/common/searchable-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/shared/QuoteNotification.js" asp-append-version="true"></script>
    <script src="~/js/CreateQuotation/QuoteNew.js" asp-append-version="true"></script>
}
