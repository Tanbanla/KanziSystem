@using PRJ_WAREHOUSE_BIVN.DTO
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = "Input Quote Detail";
    List<string> mATERIAs = Model.listMaterial;
    List<dynamic> nccNews = Model.listNcc;
    List<string> categoryS = Model.listCategory;
    string currentUser = Model.NguoiThaoTac;
    List<BaoGia_Request_of_QuotationDTO> listRequest = Model.CurrentRequest;
    var currentRequest = listRequest.First();
    string madon = Model.MaDonHienTai;
}
<head>
    <link rel="stylesheet" href="~/css/Approval_Quote.css" />
    <link rel="stylesheet" href="~/css/Quote.css" />
</head>

<div class="container-fluid">
    <!-- Header -->
    <div class="card mb-3" style="background-color: #fff9e1; border: 2px solid #dee2e6;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h4 class="fw-bold" style="color: #000;">
                    @Localizer["InputQuoteTitle"] - <span id="pageMaDon" class="text-primary">@currentRequest?.CHR_MaDon</span>
                </h4>
                <button type="button" class="btn btn-link p-1" onclick="goBack()">
                    <i class="fas fa-times fa-lg"></i>
                </button>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <span class="fw-bold" style="color: #000;">@Localizer["DepartmentLabel"]:</span>
                    <span id="pageKhoi" class="bg-white px-3 py-1 rounded border" style="color: #000;">@currentRequest?.CHR_SectionName</span>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-warning text-dark p-2" id="pageUrgentBadge" style="display:@(currentRequest?.CHR_Gap == "true" ? "inline" : "none");">
                        <i class="ion ion-alert-circled"></i> @Localizer["UrgentBadgeText"]
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- General Info -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-sm mb-0">
                    <tr>
                        <td class="fw-bold bg-light" style="width: 15%;">@Localizer["DepartmentCodeLabel"]</td>
                        <td style="width: 18%; background-color: #fff9e1;" id="pageMpbyc">@currentRequest?.CHR_SectionCode</td>
                        <td class="fw-bold bg-light" style="width: 15%;">@Localizer["DepartmentNameLabel"]</td>
                        <td style="width: 19%; background-color: #fff9e1;" id="pageTenphongban">@currentRequest?.CHR_SectionName</td>
                    </tr>
                    <tr>
                        <td class="fw-bold bg-light">@Localizer["RequestDateLabel"]</td>
                        <td style="background-color: #fff9e1;" id="pageNyc">@currentRequest?.DTM_CreateDate.ToString("dd/MM/yyyy")</td>
                        <td class="fw-bold bg-light">@Localizer["DeadlineLabel"]</td>
                        <td style="background-color: #fff9e1;" id="pageThmm">@currentRequest?.DTM_KyHan?.ToString("dd/MM/yyyy")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- Supplier Selection -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row align-items-end mb-3">
                <div class="col-12 col-md-3">
                    <label class="form-label">@Localizer["SupplierLabel"] <span class="text-danger">*</span></label>
                    <select id="pageSupplierSelect" class="form-control searchable-select">
                        <option value="">@Localizer["SelectSupplier"]</option>
                        @foreach (var s in nccNews)
                        {
                            <option value="@s.MaNcc">@s.Ten</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">@Localizer["InternalMaterialCodeLabel"] <span class="text-danger">*</span></label>
                    <select id="pageInternalItemCodeSelect" class="form-control searchable-select">
                        <option value="">@Localizer["SelectInternalMaterialCode"]</option>
                        @foreach (var s in mATERIAs)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">@Localizer["CategoryLabel"] <span class="text-danger">*</span></label>
                    <select id="pageCategorySelect" class="form-control searchable-select">
                        <option value="">@Localizer["SelectCategory"]</option>
                        @foreach (var s in categoryS)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3 text-md-end mt-2 mt-md-0">
                    <div class="d-flex justify-content-md-end gap-2">
                        <button type="button" class="btn btn-success" id="pageSearch">
                            <i class="fas fa-search"></i> @Localizer["FilterButton"]
                        </button>
                        <div style="margin-right: 8px;"></div>
                        <button type="button" class="btn btn-primary" id="pageSendMail">
                            <i class="fas fa-paper-plane"></i> @Localizer["SendQuoteEmailButton"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Goods Detail -->
    <div class="card mb-2">
        <div class="card-header">
            <h5 class="fw-bold" style="color: #0d6efd; border-bottom: 2px solid #0d6efd; padding-bottom: 5px;">
                <i class="ion ion-clipboard"></i> @Localizer["GoodsDetailTitle"]
            </h5>
        </div>
        <div class="card-body">
            <!-- Table for items -->
            <div class="table-responsive-fixed">
                <table class="table table-bordered table-hover align-middle" id="pageDetailTable" style="font-size: 13px;">
                    <thead>
                        <tr class="text-center align-middle" style="background-color: #e9ecef;">
                            <th rowspan="2" style="width: 40px; background-color: #dee2e6;">@Localizer["STT"]</th>
                            <th rowspan="2" style="min-width: 120px; background-color: #dee2e6;">@Localizer["SupplierCode"]</th>
                            <th rowspan="2" style="min-width: 150px; background-color: #dee2e6;">@Localizer["InternalMaterialCode"]</th>
                            <th rowspan="2" style="min-width: 120px; background-color: #dee2e6;">@Localizer["Classification"]</th>
                            <th rowspan="2" style="min-width: 120px; background-color: #dee2e6;">@Localizer["Category"]</th>
                            <th rowspan="2" style="min-width: 200px; background-color: #dee2e6;">@Localizer["CustomsItemName"]</th>
                            <th rowspan="2" style="min-width: 100px; background-color: #dee2e6;">@Localizer["EnglishName"]</th>
                            <th colspan="8" style="background-color: #d3d9e5;">@Localizer["DescriptionGroup"]</th>
                            <th rowspan="2" style="min-width: 150px; background-color: #dee2e6;">@Localizer["DesignFile"]</th>
                            <th rowspan="2" style="min-width: 150px; background-color: #dee2e6;">@Localizer["Supplier"]</th>
                            <th rowspan="2" style="min-width: 100px; background-color: #dee2e6;">@Localizer["SupplierSelectionDeadline"]</th>
                            <th rowspan="2" style="min-width: 60px; background-color: #dee2e6;">@Localizer["Urgent"]</th>
                            <th rowspan="2" style="min-width: 60px; background-color: #dee2e6;">@Localizer["GetQuote"]</th>
                            <th rowspan="2" style="min-width: 60px; background-color: #dee2e6;">@Localizer["Reason"]</th>
                        </tr>
                        <tr class="text-center align-middle" style="background-color: #e9ecef;">
                            <th style="min-width: 80px;">@Localizer["Quantity"]</th>
                            <th style="min-width: 70px;">@Localizer["Unit"]</th>
                            <th style="min-width: 80px;">@Localizer["Shape"]</th>
                            <th style="min-width: 70px;">@Localizer["Material"]</th>
                            <th style="min-width: 100px;">@Localizer["Composition"]</th>
                            <th style="min-width: 100px;">@Localizer["Dimensions"]</th>
                            <th style="min-width: 120px;">@Localizer["UsedPosition"]</th>
                            <th style="min-width: 150px;">@Localizer["PurposeFeature"]</th>
                        </tr>
                    </thead>
                    <tbody id="pageDetailBody">
                        <tr class="text-center">
                            <td colspan="20" class="text-muted py-4">
                                <i class="ion ion-load-c ion-spin"></i> @Localizer["LoadingData"]
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quote Input Table -->
    <div class="card mb-2">
        <div class="card-header">
            <h5 class="fw-bold" style="color: #0d6efd; border-bottom: 2px solid #0d6efd; padding-bottom: 5px;">
                <i class="fas fa-edit"></i> @Localizer["QuoteInputTitle"]
            </h5>
            <div style="margin-left: 16px;"></div>
            <div class="btn-group mb-2" role="group">
                <button class="btn btn-success btn-sm" id="btnInputExcel"><i class="fas fa-file-excel"></i> @Localizer["ImportFromExcel"]</button>
            </div>
            <div style="margin-left: 16px;"></div>
            <div class="col-12 col-md-3">
                <label class="form-label">@Localizer["ExchangeRateLabel"]</label>
                <input type="number" id="exchangeRateInput" class="form-control" value="24500" step="1000" min="0">
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                <table class="table table-bordered table-hover align-middle" id="quoteInputTable" style="font-size: 13px; table-layout: fixed;">
                    <thead style="position: sticky; top: 0; background-color: white; z-index: 10;">
                        <tr class="text-center">
                            <th style="width: 40px; min-width: 40px;">@Localizer["STT"]</th>
                            <th style="width: 120px; min-width: 120px;">@Localizer["Supplier"]</th>
                            <th style="width: 120px; min-width: 120px;">@Localizer["InternalMaterialCode"]</th>
                            <th style="width: 120px; min-width: 120px;">@Localizer["SupplierItemCode"]</th>
                            <th style="width: 150px; min-width: 150px;">@Localizer["CustomsItemName"]</th>
                            <th style="width: 80px; min-width: 80px;">@Localizer["Quantity"]</th>
                            <th style="width: 80px; min-width: 80px;">@Localizer["Unit"]</th>
                            <th style="width: 80px; min-width: 80px;">@Localizer["PriceUSD"]</th>
                            <th style="width: 80px; min-width: 80px;">@Localizer["PriceVND"]</th>
                            <th style="width: 100px; min-width: 100px;">@Localizer["MOQ"]</th>
                            <th style="width: 100px; min-width: 100px;">@Localizer["LeadTime"]</th>
                            <th style="width: 120px; min-width: 120px;">@Localizer["DeliveryDate"]</th>
                            <th style="width: 80px; min-width: 80px;">@Localizer["RohsResponse"]</th>
                            <th style="width: 80px; min-width: 80px;">@Localizer["COCQ"]</th>
                            <th style="width: 80px; min-width: 80px;">@Localizer["MSDSWithCAS"]</th>
                            <th style="width: 80px; min-width: 80px;">@Localizer["SafetyResponse"]</th>
                            <th style="width: 80px; min-width: 80px;">@Localizer["CommitRequirement"]</th>
                            <th style="width: 120px; min-width: 120px;">@Localizer["DeliveryMethod"]</th>
                            <th style="width: 120px; min-width: 120px;">@Localizer["PaymentCondition"]</th>
                            <th style="width: 150px; min-width: 150px;">@Localizer["Attachment"]</th>
                        </tr>
                    </thead>
                    <tbody id="quoteInputBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="card">
        <div class="card-body" style="background-color: #f8f9fa; border-top: 1px solid #dee2e6;">
            <div class="d-flex justify-content-between align-items-center w-100">
                <div>
                    <span class="text-muted">
                        <i class="ion ion-document-text"></i> @Localizer["FooterID"]: <span id="pageIdRequest">@currentRequest?.ID</span> |
                        @Localizer["FooterStep"]: <span id="pageStep">@Localizer["InputStep"]</span> |
                        @Localizer["FooterCreator"]: <span id="pageRegency">@currentRequest?.CHR_CreateBy</span>
                    </span>
                </div>
                <div>
                    <button type="button" class="btn btn-primary" id="pageSave">
                        <i class="fas fa-save"></i> @Localizer["Save"]
                    </button>
                    <button type="button" class="btn btn-secondary" onclick="goBack()">
                        <i class="fas fa-times"></i> @Localizer["Close"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    window.inputQuoteDetailData = {
        user: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentUser)),
        maDon: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(madon)),
        materials: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mATERIAs)),
        nccNews: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(nccNews))
    };
    window.i18nInputQuoteDetail = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        InputQuoteTitle = Localizer["InputQuoteTitle"].Value,
        DepartmentLabel = Localizer["DepartmentLabel"].Value,
        UrgentBadgeText = Localizer["UrgentBadgeText"].Value,
        DepartmentCodeLabel = Localizer["DepartmentCodeLabel"].Value,
        DepartmentNameLabel = Localizer["DepartmentNameLabel"].Value,
        RequestDateLabel = Localizer["RequestDateLabel"].Value,
        DeadlineLabel = Localizer["DeadlineLabel"].Value,
        SupplierLabel = Localizer["SupplierLabel"].Value,
        SelectSupplier = Localizer["SelectSupplier"].Value,
        InternalMaterialCodeLabel = Localizer["InternalMaterialCodeLabel"].Value,
        SelectInternalMaterialCode = Localizer["SelectInternalMaterialCode"].Value,
        CategoryLabel = Localizer["CategoryLabel"].Value,
        SelectCategory = Localizer["SelectCategory"].Value,
        FilterButton = Localizer["FilterButton"].Value,
        SendQuoteEmailButton = Localizer["SendQuoteEmailButton"].Value,
        GoodsDetailTitle = Localizer["GoodsDetailTitle"].Value,
        STT = Localizer["STT"].Value,
        SupplierCode = Localizer["SupplierCode"].Value,
        InternalMaterialCode = Localizer["InternalMaterialCode"].Value,
        Classification = Localizer["Classification"].Value,
        Category = Localizer["Category"].Value,
        CustomsItemName = Localizer["CustomsItemName"].Value,
        EnglishName = Localizer["EnglishName"].Value,
        DescriptionGroup = Localizer["DescriptionGroup"].Value,
        Quantity = Localizer["Quantity"].Value,
        Unit = Localizer["Unit"].Value,
        Shape = Localizer["Shape"].Value,
        Material = Localizer["Material"].Value,
        Composition = Localizer["Composition"].Value,
        Dimensions = Localizer["Dimensions"].Value,
        UsedPosition = Localizer["UsedPosition"].Value,
        PurposeFeature = Localizer["PurposeFeature"].Value,
        DesignFile = Localizer["DesignFile"].Value,
        Supplier = Localizer["Supplier"].Value,
        SupplierSelectionDeadline = Localizer["SupplierSelectionDeadline"].Value,
        Urgent = Localizer["Urgent"].Value,
        GetQuote = Localizer["GetQuote"].Value,
        Reason = Localizer["Reason"].Value,
        SupplierItemCode = Localizer["SupplierItemCode"].Value,
        PriceUSD = Localizer["PriceUSD"].Value,
        PriceVND = Localizer["PriceVND"].Value,
        MOQ = Localizer["MOQ"].Value,
        LeadTime = Localizer["LeadTime"].Value,
        DeliveryDate = Localizer["DeliveryDate"].Value,
        RohsResponse = Localizer["RohsResponse"].Value,
        COCQ = Localizer["COCQ"].Value,
        MSDSWithCAS = Localizer["MSDSWithCAS"].Value,
        SafetyResponse = Localizer["SafetyResponse"].Value,
        CommitRequirement = Localizer["CommitRequirement"].Value,
        DeliveryMethod = Localizer["DeliveryMethod"].Value,
        PaymentCondition = Localizer["PaymentCondition"].Value,
        Attachment = Localizer["Attachment"].Value,
        QuoteInputTitle = Localizer["QuoteInputTitle"].Value,
        ImportFromExcel = Localizer["ImportFromExcel"].Value,
        ExchangeRateLabel = Localizer["ExchangeRateLabel"].Value,
        FooterID = Localizer["FooterID"].Value,
        FooterStep = Localizer["FooterStep"].Value,
        InputStep = Localizer["InputStep"].Value,
        FooterCreator = Localizer["FooterCreator"].Value,
        Save = Localizer["Save"].Value,
        Close = Localizer["Close"].Value,
        LoadingData = Localizer["LoadingData"].Value,
        SaveSuccess = Localizer["SaveSuccess"].Value,
        SaveError = Localizer["SaveError"].Value,
        SelectSupplierWarning = Localizer["SelectSupplierWarning"].Value,
        NoDataToSendMail = Localizer["NoDataToSendMail"].Value,
        SendMailSuccess = Localizer["SendMailSuccess"].Value,
        SendMailError = Localizer["SendMailError"].Value,
        NoValidDataToSendMail = Localizer["NoValidDataToSendMail"].Value,
        PriceMustBeGreaterThanZero = Localizer["PriceMustBeGreaterThanZero"].Value,
        SearchPlaceholder = Localizer["SearchPlaceholder"].Value,
        NoResults = Localizer["NoResults"].Value
    }));
</script>
@section Scripts {
    <script src="~/js/InputQuoteDetail.js"></script>
    <script>
        function goBack() {
            window.history.back();
        }
    </script>
}
