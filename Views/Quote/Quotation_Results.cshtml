@functions {
    private string GetStatusClass(string status) => status switch
    {
        // prefer status code values (chR_Status)
        "NOT_SELECTED" => "bg-success",
        "PENDING" => "bg-warning text-dark",
        // legacy Vietnamese textual values fallback
        "Chưa chọn NCC" => "bg-success",
        "Đang chờ" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

