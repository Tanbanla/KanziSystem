@using PRJ_WAREHOUSE_BIVN.DTO
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Quotation Results";
    List<MATERIALDTO> listMaterials = Model.DanhSachVatTu;
    List<ACC_NHOMVITRIDTO> listPhong = Model.DanhSachNhomViTri;
    List<IM_NCC_NEWDTO> listNCC = Model.DanhSachNhaCungCap;
    List<BaoGia_StatusDTO> listStatus = Model.DanhSachStatus;
    List<string> madons = Model.DanhSachMaDon;
    List<dynamic> data = Model.DanhSachBaoGiaGomNhom;
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
    <link rel="stylesheet" href="~/css/Quotation_Results.css" />
</head>

<div class="container-fluid" id="quotation-results">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-primary">@Localizer["PageTitle"]</h4>
        </div>
        <div class="btn-group mb-2" role="group"></div>
    </div>
</div>

<div class="container-fluid" id="quotation-results">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"></div>
        <div>
    <ul class="nav nav-tabs" id="quotationResultsTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="request-list-tab" data-bs-toggle="tab" data-bs-target="#request-list" type="button" role="tab" aria-controls="request-list" aria-selected="true">Phê duyệt lựa chọn</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="supplier-input-tab" data-bs-toggle="tab" data-bs-target="#supplier-input" type="button" role="tab" aria-controls="supplier-input" aria-selected="false">Chọn nhà cung cấp</button>
        </li>
    </ul>
    <div class="tab-content" id="quotationResultsTabsContent" style="background-color: #ffffff; padding: 16px; border: 1px solid #dee2e6; border-top: 0; border-radius: 0 0 .25rem .25rem;">
        <!-- Tab 1: Danh sách yêu cầu -->
        <div class="tab-pane fade show active" id="request-list" role="tabpanel" aria-labelledby="request-list-tab">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white py-2">
                    <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["Filters"]</h6>
                </div>
                <div class="card-body pt-3 pb-2">
                    <form id="filterForm" class="row g-4 align-items-end">
                        <div class="col-12 col-md-3">
                            <label for="searchMaDon" class="form-label small text-uppercase fw-semibold">@Localizer["QuotationCode"]</label>
                            <select id="searchMaDon" name="searchMaDon" class="form-select searchMaDon searchable-select">
                                <option value="" selected>@Localizer["SelectQuotation"]</option>
                                @foreach (var s in madons)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <label for="searchPhongBan" class="form-label small text-uppercase fw-semibold">@Localizer["DepartmentCode"]</label>
                            <select id="searchPhongBan" name="searchPhongBan" class="form-select searchPhongBan searchable-select">
                                <option value="" selected>@Localizer["SelectDepartment"]</option>
                                @foreach (var s in listPhong)
                                {
                                    <option value="@s.Mahangmuctheovitri">@s.Mahangmuctheovitri - @s.Tenhangmuctheovitri</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <label for="searchMaterial" class="form-label small text-uppercase fw-semibold">@Localizer["MaterialCode"]</label>
                            <select id="searchMaterial" name="searchMaterial" class="form-select searchMaterial searchable-select">
                                <option value="" selected>@Localizer["SelectMaterial"]</option>
                                @foreach (var s in listMaterials)
                                {
                                    <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                                }
                            </select>
                        </div>
                         <div class="col-12 col-md-3">
                            <label for="searchStatus" class="form-label small text-uppercase fw-semibold">@Localizer["Status"]</label>
                            <select id="searchStatus" name="searchStatus" class="form-select searchStatus searchable-select">
                                <option value="1" selected>@Localizer["SelectAll"]</option>
                                <option value="2">@Localizer["Confirm"]</option>
                                <option value="3">@Localizer["Done"]</option>
                            </select>
                        </div>
                        <div class="col-12 d-flex gap-2 mt-2">
                            <button type="button" id="btnSearch" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> @Localizer["Search"]</button>
                            <div style="min-width: 12px;"></div>
                            <button type="button" id="btnClear" class="btn btn-outline-secondary btn-sm"><i class="fas fa-eraser"></i> @Localizer["ClearFilters"]</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["RequestList"]</h6>
                    <small class="text-muted" id="summaryText">@Localizer["SummaryFormat", 0]</small>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 480px;">
                        <table class="table table-sm table-hover table-bordered align-middle mb-0" id="quotationResultsTable" style="font-size:13px;">
                            <thead class="table-header-custom">
                                <tr class="text-center align-middle">
                                    <th style="width:40px"><input type="checkbox" id="selectAll" title="@Localizer["SelectAll"]" /></th>
                                    <th style="min-width:80px">@Localizer["Detail"]</th>
                                    <th style="min-width:140px">@Localizer["OrderCode"]</th>
                                    <th style="min-width:110px">@Localizer["RequestDate"]<br></th>
                                    <th style="min-width:140px">@Localizer["DepartmentName"]<br></th>
                                    <th style="min-width:130px">@Localizer["CreatorPIC"]</th>
                                    <th style="min-width:150px">@Localizer["NumberMaterial"]<br></th>
                                    <th style="min-width:170px">@Localizer["SupplierSelectionDeadline"]<br></th>
                                    <th style="min-width:70px">@Localizer["Status"]<br></th>
                                </tr>
                            </thead>
                            <tbody id="quotationResultsTableBody">
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- Pagination controls -->
                <div class="p-2 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <label class="small mb-0" style="margin-right:4px;">@Localizer["RowsPerPage"]</label>
                        <select id="pageSizeSelect">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <div id="paginationControls" class="btn-group" role="group"></div>
                        <div style="margin-right: 4px;"></div>
                        <small class="text-muted" id="pagingInfo">&nbsp;</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab 2: Nhập báo giá nhà cung cấp -->
        <div class="tab-pane fade" id="supplier-input" role="tabpanel" aria-labelledby="supplier-input-tab">
            <!-- Search Form -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white py-2">
                    <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["SupplierSearchTitle"]</h6>
                </div>
                <div class="card-body pt-3 pb-2">
                    <form id="supplierFilterForm" class="row g-4 align-items-end">
                        <div class="col-12 col-md-2">
                            <label for="supplierSearchMaDon" class="form-label small text-uppercase fw-semibold">@Localizer["OrderCode"]</label>
                            <select id="supplierSearchMaDon" name="supplierSearchMaDon" class="form-select supplierSearchMaDon searchable-select">
                                <option value="" selected>@Localizer["SelectQuotation"]</option>
                                @foreach (var s in madons)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label for="supplierSearchMaNcc" class="form-label small text-uppercase fw-semibold">@Localizer["SupplierCode"]</label>
                            <select id="supplierSearchMaNcc" name="supplierSearchMaNcc" class="form-select supplierSearchMaNcc searchable-select">
                                <option value="" selected>@Localizer["SelectSupplier"]</option>
                                @foreach (var s in listNCC)
                                {
                                    <option value="@s.Ma">@s.Ma - @s.Ten</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label for="supplierSearchMaVatTu" class="form-label small text-uppercase fw-semibold">@Localizer["MaterialCode"]</label>
                            <select id="supplierSearchMaVatTu" name="supplierSearchMaVatTu" class="form-select supplierSearchMaVatTu searchable-select">
                                <option value="" selected>@Localizer["SelectMaterial"]</option>
                                @foreach (var s in listMaterials)
                                {
                                    <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-2">
                            <label for="supplierSearchSection" class="form-label small text-uppercase fw-semibold">@Localizer["DepartmentCode"]</label>
                            <select id="supplierSearchSection" name="supplierSearchSection" class="form-select supplierSearchSection searchable-select">
                                <option value="" selected>@Localizer["SelectDepartment"]</option>
                                @foreach (var s in listPhong)
                                {
                                    <option value="@s.Mahangmuctheovitri">@s.Mahangmuctheovitri - @s.Tenhangmuctheovitri</option>
                                }
                            </select>
                        </div>
                        @* <div class="col-12 col-md-2">
                            <label for="supplierSearchDayMM" class="form-label small text-uppercase fw-semibold">@Localizer["Date"]</label>
                            <input type="date" id="supplierSearchDayMM" class="form-control">
                        </div> *@
                        <div class="col-12 col-md-2 text-md-end mt-2 mt-md-0">
                            <div class="d-flex justify-content-md-end gap-2">
                                <button type="button" class="btn btn-primary btn-sm" id="supplierSearchBtn">
                                    <i class="fas fa-search"></i> @Localizer["Search"]
                                </button>
                                <div style="margin-left: 8px;"></div>
                                <button type="button" class="btn btn-success btn-sm" id="supplierImportExcelBtn">
                                    <i class="fas fa-file-excel"></i> @Localizer["ImportExcel"]
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Supplier Quote Table -->
            <div class="card shadow-sm">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["SupplierListTitle"]</h6>
                    <div class="d-flex align-items-center gap-2">
                        <button id="toggleAdditionalColumns" class="btn btn-outline-secondary btn-sm">Ẩn chi tiết</button>
                        <div style="margin-left: 6px;"></div>
                        <small class="text-muted" id="supplierSummaryText">@Localizer["SummaryFormat", 0]</small>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 600px;">
                        <table class="table table-sm table-hover table-bordered table-striped align-middle mb-0" id="supplierQuoteTable" style="font-size:13px;">
                            <thead class="table-header-custom">
                                <tr class="text-center" style="background-color: #f8f9fa;">
                                    <th colspan="3" style="background-color: #ffff; border: 1px solid #dee2e6;">Status</th>
                                    <th colspan="19" style="background-color: #d1ecf1; border: 1px solid #dee2e6;">BIVN Input</th>
                                    <th colspan="21" style="background-color: #f8d7da; border: 1px solid #dee2e6;">Vendor Input</th>
                                </tr>
                                <tr class="text-center align-middle">
                                    <th rowspan="2"  style="min-width: 40px;">@Localizer["STT"]</th>
                                    <th  rowspan="2" style="min-width: 50px;">@Localizer["OrderNumber"]</th>
                                    <th  rowspan="2" style="min-width: 50px;">@Localizer["Status"]</th>
                                    
                                    <th rowspan="2" style="min-width: 150px; background-color: #dee2e6;" class="additional-column">@Localizer["InternalMaterialCode"]</th>
                                    <th rowspan="2" style="min-width: 120px; background-color: #dee2e6;" class="additional-column">@Localizer["Classification"]</th>
                                    <th rowspan="2" style="min-width: 120px; background-color: #dee2e6;" class="additional-column">@Localizer["Category"]</th>
                                    <th rowspan="2" style="min-width: 200px; background-color: #dee2e6;" class="additional-column">@Localizer["CustomsItemName"]</th>
                                    <th rowspan="2" style="min-width: 100px; background-color: #dee2e6;" class="additional-column">@Localizer["EnglishName"]</th>
                                    <th colspan="8" style="background-color: #d3d9e5;" class="additional-column">@Localizer["DescriptionGroup"]</th>
                                    <th rowspan="2" style="min-width: 150px; background-color: #dee2e6;" class="additional-column">@Localizer["DesignFile"]</th>
                                    <th rowspan="2" style="min-width: 150px; background-color: #dee2e6;" class="additional-column">@Localizer["Supplier"]</th>
                                    <th rowspan="2" style="min-width: 100px; background-color: #dee2e6;" class="additional-column">@Localizer["SupplierSelectionDeadline"]</th>
                                    <th rowspan="2" style="min-width: 60px; background-color: #dee2e6;" class="additional-column">@Localizer["Urgent"]</th>
                                    <th rowspan="2" style="min-width: 60px; background-color: #dee2e6;" class="additional-column">@Localizer["GetQuote"]</th>
                                    <th rowspan="2" style="min-width: 60px; background-color: #dee2e6;" class="additional-column">@Localizer["Reason"]</th>

                                    <th  rowspan="2" style="min-width: 100px;background-color: #FDFFE9;">@Localizer["SupplierCodeShort"]</th>
                                    <th rowspan="2" style="min-width: 180px;background-color: #FDFFE9;">@Localizer["SupplierName"]</th>
                                    <th rowspan="2" style="min-width: 120px;background-color: #FDFFE9;">@Localizer["SupplierItemCode"]</th>
                                    <th rowspan="2" style="min-width: 150px;background-color: #FDFFE9;">@Localizer["ItemNameHQ"]</th>
                                    <th rowspan="2" style="min-width: 80px;background-color: #FDFFE9;">@Localizer["Quantity"]</th>
                                    <th rowspan="2" style="min-width: 80px;background-color: #FDFFE9;">@Localizer["Unit"]</th>
                                    <th rowspan="2" style="min-width: 80px;background-color: #FDFFE9;">@Localizer["PriceUSD"]</th>
                                    <th rowspan="2" style="min-width: 80px;background-color: #FDFFE9;">@Localizer["PriceVND"]</th>
                                    <th rowspan="2" style="min-width: 100px;background-color: #FDFFE9;">@Localizer["MOQ"]</th>
                                    <th rowspan="2" style="min-width: 100px;background-color: #FDFFE9;">@Localizer["LeadTime"]</th>
                                    <th rowspan="2" style="min-width: 120px;background-color: #FDFFE9;">@Localizer["DeliveryDate"]</th>
                                    <th rowspan="2" style="min-width: 80px;background-color: #FDFFE9;">@Localizer["Rohs"]</th>
                                    <th rowspan="2" style="min-width: 80px;background-color: #FDFFE9;">@Localizer["COCQ"]</th>
                                    <th rowspan="2" style="min-width: 80px;background-color: #FDFFE9;">@Localizer["MSDS"]</th>
                                    <th rowspan="2" style="min-width: 80px;background-color: #FDFFE9;">@Localizer["Safety"]</th>
                                    <th rowspan="2" style="min-width: 80px;background-color: #FDFFE9;">@Localizer["Commitment"]</th>
                                    <th rowspan="2" style="min-width: 120px;background-color: #FDFFE9;">@Localizer["DeliveryMethod"]</th>
                                    <th rowspan="2" style="min-width: 120px;background-color: #FDFFE9;">@Localizer["PaymentTerms"]</th>
                                    <th rowspan="2" style="min-width: 150px;background-color: #FDFFE9;">@Localizer["Attachment"]</th>
                                    <th rowspan="2" style="min-width: 100px;background-color: #FDFFE9;">@Localizer["ApplyDay"]</th>
                                    <th rowspan="2" style="min-width: 100px;background-color: #FDFFE9;">@Localizer["DueDay"]</th>
                                </tr>
                                <tr class="text-center align-middle" style="background-color: #dee2e6;">
                                    <th style="min-width: 80px;" class="additional-column">@Localizer["Quantity"]</th>
                                    <th style="min-width: 70px;" class="additional-column">@Localizer["Unit"]</th>
                                    <th style="min-width: 80px;" class="additional-column">@Localizer["Shape"]</th>
                                    <th style="min-width: 70px;" class="additional-column">@Localizer["Material"]</th>
                                    <th style="min-width: 100px;" class="additional-column">@Localizer["Composition"]</th>
                                    <th style="min-width: 100px;" class="additional-column">@Localizer["Dimensions"]</th>
                                    <th style="min-width: 120px;" class="additional-column">@Localizer["UsedPosition"]</th>
                                    <th style="min-width: 150px;" class="additional-column">@Localizer["PurposeFeature"]</th>
                                </tr>
                            </thead>
                            <tbody id="supplierQuoteBody">
                                <tr class="text-center">
                                    <td colspan="31" class="text-muted py-4">
                                        <i class="ion ion-load-c ion-spin"></i> @Localizer["LoadingData"]
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!-- Supplier Pagination controls -->
            <div class="p-2 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <label class="small mb-0" style="margin-right:4px;">@Localizer["RowsPerPage"]</label>
                    <select id="supplierPageSizeSelect">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <div id="supplierPaginationControls" class="btn-group" role="group"></div>
                    <div style="margin-right: 4px;"></div>
                    <small class="text-muted" id="supplierPagingInfo">&nbsp;</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit modal for uncompleted orders -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" style="min-width: 50%">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["EditModalTitle"]</h5>
                <button type="button" class="btn btn-sm btn-outline-danger border-0" title="Đóng" id="btnCloseEdit_1" role="button" data-bs-dismiss="modal" aria-label="Đóng" aria-controls="editHistoryModal">
                    <i class="fas fa-times fa-sm"></i>
                </button>
            </div>
            <div class="modal-body" style="max-height: 500px; overflow-y: auto">
                <form id="editHistoryForm" class="row g-3">
                    <input type="hidden" id="editRequestId" />
                    <div class="col-12">
                        <div class="d-flex gap-3">
                            <div>
                                <label class="form-label">@Localizer["OrderCodeGroup"]</label>
                                <input type="text" class="form-control" id="editMaDon" readonly />
                            </div>
                            <div style="margin-left: 8px;">
                                <label class="form-label">@Localizer["Requester"]</label>
                                <input type="text" class="form-control" id="editRequester" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["DepartmentCode"]</label>
                        <input type="text" class="form-control" id="editSectionName" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Classification"]</label>
                        <input type="text" class="form-control" id="editPhanLoai" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label w-100">@Localizer["Category"]</label>
                        <input type="text" class="form-control" id="editChungLoai" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["InternalMaterialCode"]</label>
                        <input type="text" class="form-control" id="editMaHangNoiBo" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["EquipmentCode"]</label>
                        <input type="text" class="form-control" id="editMaThietBi" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["SupplierItemCode"]</label>
                        <input type="text" class="form-control" id="editMaHangNCC" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["ItemNameVN"]</label>
                        <input type="text" class="form-control" id="editTenHangVN" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["ItemNameEN"]</label>
                        <input type="text" class="form-control" id="editTenHangEN" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localizer["Quantity"]</label>
                        <input type="number" class="form-control" id="editSoLuong" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localizer["Unit"]</label>
                        <input type="text" class="form-control" id="editDonVi" readonly />
                    </div>
                    <!-- Description fields -->
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Shape"]</label>
                        <input type="text" class="form-control" id="editHinhDang" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Material"]</label>
                        <input type="text" class="form-control" id="editChatLieu" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Composition"]</label>
                        <input type="text" class="form-control" id="editThanhPhan" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Dimensions"]</label>
                        <input type="text" class="form-control" id="editKichThuoc" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["UsedForMachine"]</label>
                        <input type="text" class="form-control" id="editDongMay" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Feature"]</label>
                        <input type="text" class="form-control" id="editTinhNang" readonly />
                    </div>
                    <!-- Regulatory and files -->
                    <div class="col-md-4">
                        <label class="form-label w-100">@Localizer["Rohs"]</label>
                        <input type="text" class="form-control" id="editRohs" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label w-100">@Localizer["COCQ"]</label>
                        <input type="text" class="form-control" id="editCOCQ" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localizer["MSDS"]</label>
                        <input type="text" class="form-control" id="editMSDS" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localizer["SafetyStandard"]</label>
                        <input type="text" class="form-control" id="editAnToan" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["DesignFile"]</label>
