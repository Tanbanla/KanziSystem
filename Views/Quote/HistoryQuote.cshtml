@using PRJ_WAREHOUSE_BIVN.DTO
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Lịch sử yêu cầu báo giá";
    List<MATERIALDTO> listMaterials = Model.DanhSachVatTu;
    List<DEPARTMENTDTO> listPhong = Model.DanhSachNhomViTri;
    List<IM_NCC_NEWDTO> listNCC = Model.DanhSachNhaCungCap;
    List<BaoGia_StatusDTO> listStatus = Model.DanhSachStatus;
    List<string> madons = Model.DanhSachMaDon;
    List<string> categoryS = Model.DanhSachCategory;
    List<string> phanLoais = ["A", "B", "C", "E","I" ,"NO LIST"];
    string role = Model.Role;
     // determine UI language and prepare localized display names for steps and status
    var uiLang = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName?.ToLowerInvariant() ?? "vi";
    Func<BaoGia_StatusDTO, string> statusDisplay = s => uiLang == "en" ? (s.CHR_TenStatusEN ?? s.NVCHR_TenStatus) : uiLang == "ja" ? (s.CHR_TenStatusJP ?? s.NVCHR_TenStatus) : s.NVCHR_TenStatus;
    var localizedStatus = listStatus.Select(s => new {
        s.VCHR_CodeStatus,
        s.NVCHR_TenStatus,
        s.CHR_TenStatusEN,
        s.CHR_TenStatusJP,
        DisplayName = statusDisplay(s)
    }).ToList();
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
    <link rel="stylesheet" href="~/css/HistoryQuote.css" />
</head>

<div class="container-fluid" id="quote-history">
        <!-- Global loading overlay -->
    <div id="globalLoading" aria-hidden="true">
        <div class="loader-box">
            <div class="spinner" aria-hidden="true"></div>
            <div class="loader-msg">Đang xử lý...</div>
        </div>
    <!-- Modal: return reason (separate from delete) -->
    <div class="modal fade" id="returnReasonModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer["ReturnReasonTitle"]</h5>
                    <button type="button" class="btn btn-link p-1" data-bs-dismiss="modal" aria-label="@Localizer["Close"]">
                        <i class="fas fa-times fa-lg"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label for="returnReasonText" class="form-label small">@Localizer["ReturnReasonLabel"]</label>
                        <textarea id="returnReasonText" class="form-control" rows="4" placeholder="@Localizer["EnterReturnReasonPlaceholder"]"></textarea>
                        <div id="returnReasonNotice" class="text-danger small mt-2" style="display:none;">@Localizer["ReturnReasonRequired"]</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-primary" id="confirmReturnWithReason">@Localizer["DialogOk"]</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal: delete reason -->
    <div class="modal fade" id="deleteReasonModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer["DeleteReasonTitle"]</h5>
                    <button type="button" class="btn btn-link p-1" data-bs-dismiss="modal" aria-label="@Localizer["Close"]">
                        <i class="fas fa-times fa-lg"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label for="deleteReasonText" class="form-label small">@Localizer["DeleteReasonLabel"]</label>
                        <textarea id="deleteReasonText" class="form-control" rows="4" placeholder="@Localizer["EnterDeleteReasonPlaceholder"]"></textarea>
                        <div id="deleteReasonNotice" class="text-danger small mt-2" style="display:none;">@Localizer["DeleteReasonRequired"]</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteWithReason">@Localizer["Delete"]</button>
                </div>
            </div>
        </div>
    </div>
    </div>
    <!-- Modal: select next approver -->
    <div class="modal fade" id="selectApproverModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer["SelectNextApprover"]</h5>
                    <button type="button" class="btn btn-link p-1" data-bs-dismiss="modal" aria-label="@Localizer["Close"]">
                        <i class="fas fa-times fa-lg"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label for="selectNextApprover" class="form-label small">@Localizer["NextApproverLabel"]</label>
                        <select id="selectNextApprover" class="form-select">
                            <option value="">@Localizer["SelectPlaceholder"]</option>
                        </select>
                    </div>
                    <div id="selectApproverNotice" class="text-danger small" style="display:none;">@Localizer["SelectApproverRequired"]</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-primary" id="confirmSelectApprover">@Localizer["Confirm"]</button>
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-primary">@Localizer["PageTitle"]</h4>
            <small class="text-muted">@Localizer["PageSubtitle"]</small>
        </div>
        <div class="btn-toolbar" role="toolbar" aria-label="Toolbar">
            <div class="btn-group me-2 mb-2" role="group">
                <button type="button" class="btn btn-outline-success" id="btnImportHistory"><i class="fas fa-file-import"></i> @Localizer["ImportFileExcel"]</button>
            </div>
            <div style="margin-right: 6px;"></div>
            <div class="btn-group me-2 mb-2" role="group">
                <button type="button" class="btn btn-outline-primary" id="btnExportHistory"><i class="fas fa-file-export"></i> @Localizer["Export"]</button>
            </div>
            <div style="margin-right: 6px;"></div>
            <div class="btn-group me-2 mb-2" role="group" hidden>
                <button type="button" class="btn btn-outline-danger" id="btnExportManaHistory"><i class="fas fa-file-download"></i> Xuất file quản lý</button>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["Filters"]</h6>
        </div>
        <div class="card-body">
            <form id="historyFilterForm" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label for="searchMaDon" class="form-label">@Localizer["OrderCode"]</label>
                    <select id="searchMaDon" name="searchMaDon" class="form-control searchMaDon searchable-select">
                        <option value="">@Localizer["SelectOrderCode"]</option>
                        @foreach (var s in madons)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="searchPhongBan" class="form-label">@Localizer["Department"]</label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchPhongBan searchable-select">
                        <option value="" selected>@Localizer["SelectDepartment"]</option>
                        @foreach (var s in listPhong)
                        {
                            <option value="@s.Cost_Center">@s.Cost_Center - @s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="searchNguoiTao" class="form-label">@Localizer["Creator"]</label>
                    <input type="text" class="form-control" id="searchNguoiTao" name="searchNguoiTao" placeholder="@Localizer["EnterCreator"]">
                </div>
                <div class="col-md-3">
                    <label for="searchMaVatTu" class="form-label">@Localizer["MaterialCode"]</label>
                    <select id="searchMaVatTu" name="searchMaVatTu" class="form-select searchMaVatTu searchable-select">
                        <option value="" selected>@Localizer["SelectMaterialCode"]</option>
                        @foreach (var s in listMaterials)
                        {
                            <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="searchNhaCungCap" class="form-label">@Localizer["Supplier"]</label>
                    <select id="searchNhaCungCap" name="searchNhaCungCap" class="form-select searchNhaCungCap searchable-select">
                        <option value="" selected>@Localizer["SelectSupplier"]</option>
                        @foreach (var s in listNCC)
                        {
                            <option value="@s.Ma">@s.Ma - @s.Ten</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="statusFilter" class="form-label small text-uppercase fw-semibold">@Localizer["OrderStatus"]</label>
                    <select id="statusFilter" name="statusFilter" class="form-control statusFilter searchable-select">
                        <option value="" selected>@Localizer["All"]</option>
                        <option value="APPROVAL">@Localizer["Approving"]</option>
                        <option value="WAIT">@Localizer["Waiting"]</option>
                        <option value="RETURN">@Localizer["RETURN"]</option>
                        <option value="DONE">@Localizer["DONE"]</option>
                        <option value="DELETE">@Localizer["DELETE"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="dateRange" class="form-label">@Localizer["DateRange"]</label>
                    <div class="d-flex gap-2">
                        <input type="date" class="form-control" id="dateFrom" name="dateFrom">
                        <input type="date" class="form-control" id="dateTo" name="dateTo">
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="button" class="btn btn-primary w-100" id="btnApplyFilters"><i class="fas fa-search"></i> @Localizer["Filter"]</button>
                    <div style="min-width: 8px"></div>
                    <button type="button" class="btn btn-outline-secondary w-100" id="btnResetFilters"><i class="fas fa-undo"></i> @Localizer["Reset"]</button>
                </div>
            </form>
        </div>
        <div class="card-header bg-white border-top">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["GroupListByOrder"]</h6>
            </div>
        </div>
        <div class="card-body pt-2">
            <div class="table-responsive" id="historyGroupTableContainer">
                <table class="table table-sm table-hover table-bordered align-middle" id="historyGroupTable">
                    <thead class="table-light">
                        <tr class="text-center align-middle">
                            <th style="width: 40px">#</th>
                            <th style="min-width: 180px">@Localizer["OrderCodeGroup"]</th>
                            <th style="min-width: 180px">@Localizer["Creator"]</th>
                            <th style="min-width: 160px">@Localizer["CreatedDate"]</th>
                            <th style="min-width: 140px">@Localizer["CurrentStatus"]</th>
                            <th style="min-width: 140px">@Localizer["TotalOrders"]</th>
                            <th style="min-width: 160px">@Localizer["RelatedSuppliers"]</th>
                            <th style="min-width: 200px">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="historyGroupTableBody">
                        <tr class="group-row" data-group-id="" hidden>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-link text-primary px-0 btn-toggle-group" title="@Localizer["Expand"]"><i class="fas fa-plus-square"></i></button>
                            </td>
                            <td class="fw-semibold group-code"></td>
                            <td class="group-requester"></td>
                            <td class="group-created"></td>
                            <td class="group-status"></td>
                            <td class="group-count text-end"></td>
                            <td class="group-suppliers"></td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-info btn-view-history" title="@Localizer["ViewHistory"]"><i class="fas fa-history"></i></button>
                                    <button type="button" class="btn btn-outline-secondary btn-view-approvals" title="@Localizer["Approval"]"><i class="fas fa-check-double"></i></button>
                                </div>
                            </td>
                        </tr>
                        <!-- Child detail container row -->
                        <tr class="group-detail" data-group-id="" hidden>
                            <td colspan="8" class="p-0">
                                <div class="p-2">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered mb-0">
                                            <thead class="table-light">
                                                <tr class="text-center align-middle">
                                                    <th style="width: 40px">No</th>
                                                    <th style="min-width: 160px">@Localizer["OrderCode"]</th>
                                                    <th style="min-width: 200px">@Localizer["Material"]</th>
                                                    <th style="min-width: 160px">@Localizer["Supplier"]</th>
                                                    <th style="min-width: 140px">@Localizer["Quantity"]</th>
                                                    <th style="min-width: 140px">@Localizer["Status"]</th>
                                                    <th style="min-width: 160px">@Localizer["UpdatedDate"]</th>
                                                    <th style="min-width: 200px">@Localizer["Actions"]</th>
                                                </tr>
                                            </thead>
                                            <tbody class="group-detail-body">
                                                <!-- Child orders injected by JS -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                <div class="small text-muted" id="historyPaginationInfo">@Localizer["PaginationInfo", "0", "0", "0"].Value</div>
                <nav>
                    <ul class="pagination pagination-sm mb-0" id="historyPagination">
                        <li class="page-item disabled"><button class="page-link" data-page="prev">«</button></li>
                        <li class="page-item active"><button class="page-link" data-page="1">1</button></li>
                        <li class="page-item disabled"><button class="page-link" data-page="next">»</button></li>
                    </ul>
                </nav>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="small text-muted">@Localizer["FooterHint"]</div>
        </div>
    </div>
</div>
<!-- Edit modal for uncompleted orders -->
<div class="modal fade" id="editHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xxl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["EditModalTitle"]</h5>
                <button type="button" class="btn btn-sm btn-outline-danger border-0" title="Đóng" id="btnCloseEdit_1" role="button" data-bs-dismiss="modal" aria-label="Đóng" aria-controls="editHistoryModal">
                    <i class="fas fa-times fa-sm"></i>
                </button>
            </div>
            <div class="modal-body" style="max-height: 650px; overflow-y: auto">
                <form id="editHistoryForm" class="row g-3">
                    <input type="hidden" id="editRequestId" />
                    <div class="col-12">
                        <div class="d-flex gap-3">
                            <div>
                                <label class="form-label">@Localizer["OrderCodeGroup"]</label>
                                <input type="text" class="form-control" id="editMaDon" readonly />
                            </div>
                            <div style="margin-left: 8px;">
                                <label class="form-label">@Localizer["Requester"]</label>
                                <input type="text" class="form-control" id="editRequester" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["DepartmentCode"]</label>
                        <select id="editSectionCode" name="editSectionCode" class="form-select editSectionCode searchable-select">
                            <option value="">@Localizer["SelectDepartment"].Value</option>
                            @foreach (var s in listPhong)
                            {
                                <option value="@s.Cost_Center">@s.Cost_Center - @s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Classification"]</label>
                        <select id="editPhanLoai" name="editPhanLoai" class="form-select editPhanLoai searchable-select">
                            <option value="">--</option>
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                            <option value="E">E</option>
                            <option value="I">I</option>
                            <option value="NO LIST">NO LIST</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label w-100">@Localizer["Category"]</label>
                        <select id="editChungLoai" class="form-select editChungLoai searchable-select">
                            <option value="">--</option>
                            @foreach (var c in categoryS)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["InternalMaterialCode"]</label>
                        @* <select id="editMaHangNoiBo" name="editMaHangNoiBo" class="form-select editMaHangNoiBo searchable-select">
                            <option value="">--</option>
                            @foreach (var m in listMaterials)
                            {
                                <option value="@m.Material_Code">@m.Material_Code - @m.Material_Name_VN</option>
                            }
                        </select> *@
                          <input type="text" class="form-control" id="editMaHangNoiBo" readonly/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["EquipmentCode"]</label>
                        <input type="text" class="form-control" id="editMaThietBi" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["SupplierItemCode"]</label>
                        <input type="text" class="form-control" id="editMaHangNCC" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["ItemNameVN"]</label>
                        <input type="text" class="form-control" id="editTenHangVN" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["ItemNameEN"]</label>
                        <input type="text" class="form-control" id="editTenHangEN" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localizer["Quantity"]</label>
                        <input type="number" class="form-control" id="editSoLuong" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localizer["Unit"]</label>
                        <input type="text" class="form-control" id="editDonVi" />
                    </div>
                    <!-- Description fields -->
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Shape"]</label>
                        <input type="text" class="form-control" id="editHinhDang" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Material"]</label>
                        <input type="text" class="form-control" id="editChatLieu" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Composition"]</label>
                        <input type="text" class="form-control" id="editThanhPhan" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Dimensions"]</label>
                        <input type="text" class="form-control" id="editKichThuoc" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["UsedForMachine"]</label>
                        <input type="text" class="form-control" id="editDongMay" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Feature"]</label>
                        <input type="text" class="form-control" id="editTinhNang" />
                    </div>
                    <!-- Regulatory and files -->
                    <div class="col-md-4">
                        <label class="form-label w-100">@Localizer["Rohs"]</label>
                        <select id="editRohs" name="editRohs" class="form-select editRohs" style="min-height: 40px;">
                            <option value="No Need" selected>No Need</option>
                            <option value="Need">Need</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label w-100">@Localizer["COCQ"]</label>
                        <select id="editCOCQ" name="editCOCQ" class="form-select editCOCQ" style="min-height: 40px;">
                            <option value="" selected>-- Chọn CO/CQ --</option>
                            <option value="CO">CO</option>
                            <option value="CQ">CQ</option>
                            <option value="CO&CQ">CO&CQ</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localizer["MSDS"]</label>
                        <input type="text" class="form-control" id="editMSDS" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localizer["SafetyStandard"]</label>
                        <input type="text" class="form-control" id="editAnToan" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["DesignFile"]</label>
                        <input type="text" class="form-control" id="editFileThietKe" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["Manufacturer"]</label>
                        <input type="text" class="form-control" id="editNhaSanXuat" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["Supplier"]</label>
                        <select id="editNhaCungCap" name="editNhaCungCap" class="form-select searchNhaCungCap searchable-select"> 
                            <option value="">--</option>
                            @foreach (var n in listNCC)
                            {
                                <option value="@n.Ma">@n.Ma - @n.Ten</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label w-100">@Localizer["GetQuotation"]</label>
                        <select class="form-select" id="editLayBaoGia" style="min-height: 40px;">
                            <option value="true">O</option>
                            <option value="false">X</option>
                        </select>
                    </div>
                    <div class="col-md-9">
                        <label class="form-label">@Localizer["Reason"]</label>
                        <input type="text" class="form-control lydoTb" id="editLyDo" placeholder="Lý do" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["DesiredReceiveDate"]</label>
                        <input type="date" class="form-control" id="editNgayMuonNhan" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["SupplierSelectionDeadline"]</label>
                        <input type="date" class="form-control" id="editKyHan" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label w-100">@Localizer["Urgent"]</label>
                        <select class="form-select" id="editGap" style="min-height: 40px">
                            <option value="false">X</option>
                            <option value="true">O</option>
                        </select>
                    </div>
                   @* Cac thuoc tinh khac *@
                    <div class="col-md-6" hidden>
                        <input type="date" class="form-control" id="editDaycreate" hidden />
                        <input type="text" class="form-control" id="editStatus" hidden />
                        <input type="text" class="form-control" id="editStep" hidden />

                        <input type="hidden" id="editTenNCC" />
                        <input type="number" class="form-control" id="editSoLanUpdate" hidden />
                        <input type="date" class="form-control" id="editUpdateLater" hidden />
                        <input type="date" class="form-control" id="editDeadline" hidden />
                        <input type="hidden" id="editIsTemplate" />
                        <input type="hidden" id="editSectionName" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btnCloseEdit_2" role="button" data-bs-dismiss="modal" aria-label="@Localizer["Close"]" aria-controls="editHistoryModal">@Localizer["Close"]</button>
                <button type="button" class="btn btn-primary" id="btnSaveHistoryEdit">@Localizer["Save"]</button>
            </div>
        </div>
    </div>
</div>
