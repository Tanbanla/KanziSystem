@using PRJ_WAREHOUSE_BIVN.DTO
@{
    ViewData["Title"] = "Lịch sử yêu cầu báo giá";
    List<MATERIALDTO> listMaterials = Model.DanhSachVatTu;
    List<ACC_NHOMVITRIDTO> listPhong = Model.DanhSachNhomViTri;
    List<IM_NCC_NEWDTO> listNCC = Model.DanhSachNhaCungCap;
    List<BaoGia_StatusDTO> listStatus = Model.DanhSachStatus;
    List<string> madons = Model.DanhSachMaDon;
    List<dynamic> categoryS = Model.DanhSachCategory;
    List<string> phanLoais = ["A", "B", "C", "E", "NO LIST"];
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
</head>

<div class="container-fluid" id="quote-history">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-primary">LỊCH SỬ YÊU CẦU BÁO GIÁ</h4>
            <small class="text-muted">History of Request for Quotation</small>
        </div>
        <div class="btn-toolbar" role="toolbar" aria-label="Toolbar">
            <div class="btn-group me-2 mb-2" role="group">
                <button type="button" class="btn btn-outline-primary" id="btnExportHistory"><i class="fas fa-file-export"></i> Export</button>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h6 class="mb-0 text-secondary" style="color:black !important">Bộ lọc / Filters</h6>
        </div>
        <div class="card-body">
            <form id="historyFilterForm" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label for="searchMaDon" class="form-label">Mã đơn</label>
                    <select id="searchMaDon" name="searchMaDon" class="form-control searchMaDon searchable-select">
                        <option value="">-- Chọn mã đơn --</option>
                        @foreach (var s in madons)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="searchPhongBan" class="form-label">Phòng ban</label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchPhongBan searchable-select">
                        <option value="" selected>Chọn phòng ban</option>
                        @foreach (var s in listPhong)
                        {
                            <option value="@s.Mahangmuctheovitri">@s.Mahangmuctheovitri - @s.Tenhangmuctheovitri</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="searchNguoiTao" class="form-label">Người tạo đơn</label>
                    <input type="text" class="form-control" id="searchNguoiTao" name="searchNguoiTao" placeholder="Nhập người tạo">
                </div>
                <div class="col-md-3">
                    <label for="searchMaVatTu" class="form-label">Mã nguyên vật liệu</label>
                    <select id="searchMaVatTu" name="searchMaVatTu" class="form-select searchMaVatTu searchable-select">
                        <option value="" selected>Chọn mã nguyên vật liệu</option>
                        @foreach (var s in listMaterials)
                        {
                            <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="searchNhaCungCap" class="form-label">Nhà cung cấp</label>
                    <select id="searchNhaCungCap" name="searchNhaCungCap" class="form-select searchNhaCungCap searchable-select">
                        <option value="" selected>Chọn nhà cung cấp</option>
                        @foreach (var s in listNCC)
                        {
                            <option value="@s.Ma">@s.Ma - @s.Ten</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="statusFilter" class="form-label">Trạng thái đơn</label>
                    <select class="form-select" id="statusFilter" name="statusFilter">
                        <option value="" selected>Tất cả</option>
                        @foreach (var s in listStatus)
                        {
                            <option value="@s.VCHR_CodeStatus">@s.NVCHR_TenStatus</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="dateRange" class="form-label">Khoảng thời gian</label>
                    <div class="d-flex gap-2">
                        <input type="date" class="form-control" id="dateFrom" name="dateFrom">
                        <input type="date" class="form-control" id="dateTo" name="dateTo">
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="button" class="btn btn-primary w-100" id="btnApplyFilters"><i class="fas fa-search"></i> Lọc</button>
                    <div style="min-width: 8px"></div>
                    <button type="button" class="btn btn-outline-secondary w-100" id="btnResetFilters"><i class="fas fa-undo"></i> Reset</button>
                </div>
            </form>
        </div>
        <div class="card-header bg-white border-top">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <h6 class="mb-0 text-secondary" style="color:black !important">Danh sách nhóm đơn (theo Mã đơn)</h6>
            </div>
        </div>
        <div class="card-body pt-2">
            <div class="table-responsive">
                <table class="table table-sm table-hover table-bordered align-middle" id="historyGroupTable">
                    <thead class="table-light">
                        <tr class="text-center align-middle">
                            <th style="width: 40px">#</th>
                            <th style="min-width: 180px">Mã đơn (Nhóm)</th>
                            <th style="min-width: 180px">Người yêu cầu</th>
                            <th style="min-width: 160px">Ngày tạo</th>
                            <th style="min-width: 140px">Trạng thái hiện tại</th>
                            <th style="min-width: 140px">Tổng số đơn</th>
                            <th style="min-width: 160px">NCC liên quan</th>
                            <th style="min-width: 200px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="historyGroupTableBody">
                        <tr class="group-row" data-group-id="" hidden>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-link text-primary px-0 btn-toggle-group" title="Mở rộng"><i class="fas fa-plus-square"></i></button>
                            </td>
                            <td class="fw-semibold group-code"></td>
                            <td class="group-requester"></td>
                            <td class="group-created"></td>
                            <td class="group-status"></td>
                            <td class="group-count text-end"></td>
                            <td class="group-suppliers"></td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-info btn-view-history" title="Xem lịch sử"><i class="fas fa-history"></i></button>
                                    <button type="button" class="btn btn-outline-secondary btn-view-approvals" title="Phê duyệt"><i class="fas fa-check-double"></i></button>
@*                                     <button type="button" class="btn btn-outline-primary btn-edit-uncompleted" data-action="edit-history" title="Sửa đơn trả lại"><i class="fas fa-edit"></i></button> *@
                                </div>
                            </td>
                        </tr>
                        <!-- Child detail container row -->
                        <tr class="group-detail" data-group-id="" hidden>
                            <td colspan="8" class="p-0">
                                <div class="p-2">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered mb-0">
                                            <thead class="table-light">
                                                <tr class="text-center align-middle">
                                                    <th style="width: 40px">No</th>
                                                    <th style="min-width: 160px">Mã đơn</th>
                                                    <th style="min-width: 200px">Vật tư</th>
                                                    <th style="min-width: 160px">NCC</th>
                                                    <th style="min-width: 140px">Số lượng</th>
                                                    <th style="min-width: 140px">Trạng thái</th>
                                                    <th style="min-width: 160px">Ngày cập nhật</th>
                                                    <th style="min-width: 200px">Thao tác</th>
                                                </tr>
                                            </thead>
                                            <tbody class="group-detail-body">
                                                <!-- Child orders injected by JS -->
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                <div class="small text-muted" id="historyPaginationInfo">Hiển thị 0 - 0 / 0 nhóm</div>
                <nav>
                    <ul class="pagination pagination-sm mb-0" id="historyPagination">
                        <li class="page-item disabled"><button class="page-link" data-page="prev">«</button></li>
                        <li class="page-item active"><button class="page-link" data-page="1">1</button></li>
                        <li class="page-item disabled"><button class="page-link" data-page="next">»</button></li>
                    </ul>
                </nav>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="small text-muted">Chọn nhóm CHR_MaDon để xem chi tiết các đơn trong nhóm.</div>
        </div>
    </div>
</div>
<!-- Edit modal for uncompleted orders -->
<div class="modal fade" id="editHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xxl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chỉnh sửa yêu cầu báo giá</h5>
                <button type="button" class="btn btn-sm btn-outline-danger border-0" title="Đóng" id="btnCloseEdit_1" role="button" data-bs-dismiss="modal" aria-label="Đóng" aria-controls="editHistoryModal">
                    <i class="fas fa-times fa-sm"></i>
                </button>
            </div>
            <div class="modal-body" style="max-height: 650px; overflow-y: auto">
                <form id="editHistoryForm" class="row g-3">
                    <input type="hidden" id="editRequestId" />
                    <div class="col-12">
                        <div class="d-flex gap-3">
                            <div>
                                <label class="form-label">Mã đơn (Nhóm)</label>
                                <input type="text" class="form-control" id="editMaDon" readonly />
                            </div>
                            <div style="margin-left: 8px;">
                                <label class="form-label">Người yêu cầu</label>
                                <input type="text" class="form-control" id="editRequester" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mã phòng ban</label>
                        <input type="text" class="form-control" id="editSectionName" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Phân loại</label>
                        <input type="text" class="form-control" id="editPhanLoai" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label w-100">Chủng loại</label>
                        <input type="text" class="form-control" id="editChungLoai" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mã hàng nội bộ</label>
                        <input type="text" class="form-control" id="editMaHangNoiBo" readonly/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mã thiết bị</label>
                        <input type="text" class="form-control" id="editMaThietBi" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mã hàng NCC</label>
                        <input type="text" class="form-control" id="editMaHangNCC" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tên hàng VN</label>
                        <input type="text" class="form-control" id="editTenHangVN" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tên hàng EN</label>
                        <input type="text" class="form-control" id="editTenHangEN" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Số lượng</label>
                        <input type="number" class="form-control" id="editSoLuong" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Đơn vị</label>
                        <input type="text" class="form-control" id="editDonVi" />
                    </div>
                    <!-- Description fields -->
                    <div class="col-md-4">
                        <label class="form-label">Hình dáng</label>
                        <input type="text" class="form-control" id="editHinhDang" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Chất liệu</label>
                        <input type="text" class="form-control" id="editChatLieu" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Thành phần</label>
                        <input type="text" class="form-control" id="editThanhPhan" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Kích thước</label>
                        <input type="text" class="form-control" id="editKichThuoc" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Dùng cho máy</label>
                        <input type="text" class="form-control" id="editDongMay" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tính năng</label>
                        <input type="text" class="form-control" id="editTinhNang" />
                    </div>
                    <!-- Regulatory and files -->
                    <div class="col-md-4">
                        <label class="form-label w-100">ROHS</label>
@*                         <input type="text" class="form-control" id="editRohs" /> *@
                        <select id="editRohs" name="editRohs" class="form-select editRohs" style="min-height: 40px;">
                            <option value="No Need" selected>No Need</option>
                            <option value="Need">Need</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label w-100">CO/CQ</label>
@*                         <input type="text" class="form-control" id="editCOCQ" /> *@
                        <select id="editCOCQ" name="editCOCQ" class="form-select editCOCQ" style="min-height: 40px;">
                            <option value="" selected>-- Chọn CO/CQ --</option>
                            <option value="CO">CO</option>
                            <option value="CQ">CQ</option>
                            <option value="CO&CQ">CO&CQ</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">MSDS</label>
                        <input type="text" class="form-control" id="editMSDS" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Tiêu chuẩn an toàn</label>
                        <input type="text" class="form-control" id="editAnToan" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">File thiết kế</label>
                        <input type="text" class="form-control" id="editFileThietKe" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nhà sản xuất</label>
                        <input type="text" class="form-control" id="editNhaSanXuat" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nhà cung cấp</label>
                        <input type="text" class="form-control" id="editNhaCungCap" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label w-100">Lấy báo giá</label>
                        <select class="form-select" id="editLayBaoGia" style="min-height: 40px;">
                            <option value="true">O</option>
                            <option value="false">X</option>
                        </select>
                    </div>
                    <div class="col-md-9">
                        <label class="form-label">Lý do</label>
                        <input type="text" class="form-control lydoTb" id="editLyDo" placeholder="Lý do" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngày muốn nhận</label>
                        <input type="date" class="form-control" id="editNgayMuonNhan" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Kỳ hạn lựa chọn NCC</label>
                        <input type="date" class="form-control" id="editKyHan" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label w-100">Gấp</label>
                        <select class="form-select" id="editGap" style="min-height: 40px">
                            <option value="false">X</option>
                            <option value="true">O</option>
                        </select>
                    </div>
                   @* Cac thuoc tinh khac *@
                    <div class="col-md-6" hidden>
                        <input type="date" class="form-control" id="editDaycreate" hidden />
                        <input type="text" class="form-control" id="editStatus" hidden />
                        <input type="text" class="form-control" id="editStep" hidden />
                        <input type="hidden" id="editSectionCode" />
                        <input type="hidden" id="editTenNCC" />
                        <input type="number" class="form-control" id="editSoLanUpdate" hidden />
                        <input type="date" class="form-control" id="editUpdateLater" hidden />
                        <input type="date" class="form-control" id="editDeadline" hidden />
                        <input type="hidden" id="editIsTemplate" />
                        <input type="hidden" id="editSectionCode" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btnCloseEdit_2" role="button" data-bs-dismiss="modal" aria-label="Đóng" aria-controls="editHistoryModal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnSaveHistoryEdit">Lưu</button>
            </div>
        </div>
    </div>
</div>
<!-- Dialogs reused from Quote -->
<div id="cmDialogOverlay" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmDialogTitle">
        <div class="cm-dialog-header">
            <h6 id="cmDialogTitle" class="cm-dialog-title">Thông báo</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="close" aria-label="Đóng">✕</button>
        </div>
        <div id="cmDialogBody" class="cm-dialog-body"></div>
        <div id="cmDialogFooter" class="cm-dialog-footer"></div>
    </div>
    <div class="cm-dialog-backdrop" data-cm-action="overlay"></div>
</div>
<script>
    window.HistoryData = {
        status: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(listStatus))
    };
</script>
@section Scripts {
    <script src="~/js/HistoryQuote.js"></script>
}
