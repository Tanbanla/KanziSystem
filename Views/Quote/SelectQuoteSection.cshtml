@using PRJ_WAREHOUSE_BIVN.DTO
@{
    ViewData["Title"] = "Yêu cầu hàng hóa";
    // Expect the model to provide lists similar to other Quote pages for consistency
    List<ACC_NHOMVITRIDTO> nhomViTri = Model?.DanhSachNhomViTri ?? new List<ACC_NHOMVITRIDTO>();
    List<MATERIALDTO> materials = Model?.DanhSachVatTu ?? new List<MATERIALDTO>();
    List<IM_NCC_NEWDTO> suppliers = Model?.DanhSachNhaCungCap ?? new List<IM_NCC_NEWDTO>();
    List<string> maDons = Model?.DanhSachMaDon ?? new List<string>();
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
</head>

<div class="container-fluid" id="select-quote-section">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-primary">YÊU CẦU HÀNG HÓA THEO PHÒNG</h4>
            <small class="text-muted">Request items by section</small>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white py-2">
            <h6 class="mb-0 text-secondary" style="color:black !important">Bộ lọc / Filters</h6>
        </div>
        <div class="card-body pt-3 pb-2">
            <form id="filterForm" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-uppercase fw-semibold">Mã phòng ban</label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchPhongBan searchable-select">
                        <option value="" selected>Chọn phòng ban</option>
                        @foreach (var s in nhomViTri)
                        {
                            <option value="@s.Mahangmuctheovitri">@s.Mahangmuctheovitri - @s.Tenhangmuctheovitri</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-uppercase fw-semibold">Mã đơn yêu cầu</label>
                    <select id="searchMaDon" name="searchMaDon" class="form-select searchable-select">
                        <option value="" selected>Chọn mã đơn</option>
                        @foreach (var s in maDons)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-uppercase fw-semibold">Mã hàng nội bộ</label>
                    <select id="searchMaterial" name="searchMaterial" class="form-select searchMaterial searchable-select">
                        <option value="" selected>Chọn mã hàng nội bộ</option>
                        @foreach (var m in materials)
                        {
                            <option value="@m.Material_Code">@m.Material_Code - @m.Material_Name_VN</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-uppercase fw-semibold">Nhà cung cấp</label>
                    <select id="searchSupplier" name="searchSupplier" class="form-select searchable-select">
                        <option value="" selected>Chọn nhà cung cấp</option>
                        @foreach (var n in suppliers)
                        {
                            <option value="@n.Ma">@n.Ma - @n.Ten</option>
                        }
                    </select>
                </div>
                <div class="col-12 d-flex gap-2 mt-2">
                    <button type="button" id="btnSearch" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Tìm kiếm</button>
                    <div style="min-width: 12px;"></div>
                    <button type="button" id="btnClear" class="btn btn-outline-secondary btn-sm"><i class="fas fa-eraser"></i> Xóa lọc</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 text-secondary" style="color:black !important">Danh sách yêu cầu theo phòng</h6>
            <small class="text-muted" id="summaryText">0 bản ghi</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 520px;">
                <table class="table table-sm table-hover table-bordered align-middle mb-0" id="sectionRequestTable">
                    <thead class="table-light">
                        <tr class="text-center align-middle">
                            <th style="width:40px"><input type="checkbox" id="selectAll" title="Chọn tất cả" /></th>
                            <th style="min-width:140px">Mã đơn</th>
                            <th style="min-width:140px">Phòng yêu cầu</th>
                            <th style="min-width:160px">Mã hàng nội bộ</th>
                            <th style="min-width:220px">Tên hàng</th>
                            <th style="min-width:100px" class="text-end">Số lượng</th>
                            <th style="min-width:90px">Đơn vị</th>
                            <th style="min-width:140px">Nhà cung cấp</th>
                            <th style="min-width:130px">Ngày muốn nhận</th>
                            <th style="min-width:110px">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="sectionRequestBody">
                        <!-- Rows will be populated by server or JS -->
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnCancel"><i class="fas fa-times"></i> Hủy</button>
            <div style="min-width:12px"></div>
            <button type="button" class="btn btn-success btn-sm" id="btnConfirm"><i class="fas fa-check"></i> Xác nhận</button>
        </div>
    </div>
</div>

