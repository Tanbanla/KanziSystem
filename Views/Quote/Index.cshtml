@using Newtonsoft.Json
@using PRJ_WAREHOUSE_BIVN.DTO
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Tạo yêu cầu báo giá";
    List<DEPARTMENTDTO> nhomViTri = Model.DanhSachNhomViTri;
    List<string> phanLoais = ["A","B","C","E","I","NO LIST"];
    List<MATERIALDTO> mATERIAs = Model.DanhSachVatTu;
    List<IM_NCC_NEWDTO> nccNews = Model.DanhSachNhaCungCap;
    List<string> categoryS = Model.DanhSachCategory;
    string currentUser = Model.NguoiThaoTac;
    List<BaoGia_Master_Approver_Send_MailDTO> listApproval = Model.ListApprovel;
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
</head>
<div class="container-fluid" id="quote-request">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-primary">@Localizer["Title"]</h4>
        </div>
<!-- Global loading overlay -->
<div id="globalLoading" aria-hidden="true">
    <div class="loader-box">
        <div class="spinner" aria-hidden="true"></div>
        <div class="loader-msg">Đang xử lý...</div>
    </div>
</div>
        <div class="btn-toolbar" role="toolbar" aria-label="Toolbar">
            <div class="btn-group me-2 mb-2" role="group">
                <button type="button" class="btn btn-outline-success" id="btnDownloadExcel"><i class="fas fa-file-excel"></i> @Localizer["DownloadExcelTemplate"]</button>
                <button type="button" class="btn btn-outline-danger" id="btnDownExcelTable"><i class="fas fa-download"></i> @Localizer["DownloadExcelTable"]</button>
                <button type="button" class="btn btn-outline-primary" id="btnUploadExcel"><i class="fas fa-upload"></i> @Localizer["UploadExcel"]</button>
            </div>
        </div>
    </div>

    <form id="quoteForm" method="post" enctype="multipart/form-data" class="card shadow-sm">
        <div class="card-header bg-white">
            <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["Operations"]</h6>
        </div>
        <div class="btn_quote">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div class="btn-group mb-2">
                    <button type="button" class="btn btn-outline-secondary" id="btnReset"><i class="fas fa-undo"></i> @Localizer["Reset"]</button>
                    <button type="button" class="btn btn-outline-success" id="btnAuto"><i class="fas fa-file-excel"></i> @Localizer["AutoRender"]</button>
                    <button type="button" class="btn btn-outline-warning" id="btnDownMaster" ><i class="fas fa-file-download"></i> @Localizer["DownloadMaster"]</button>
                </div>

                <div class="d-flex align-items-center gap-2 mb-2">
                    <select id="approverSelect" name="approverAdid" class="form-select form-select-sm" style="min-width: 260px; max-width: 360px; border-radius: 0; min-height: 38px;">
                        <option value="">@Localizer["SelectApprover"]</option>
                        @foreach (var a in listApproval)
                        {
                            <option value="@a.CHR_UserAdid">@a.NVCHR_UserName (@a.CHR_UserAdid)</option> 
                        }
                    </select>
                    <button type="button" class="btn btn-primary" id="btnCreate"><i class="fas fa-check me-1"></i> @Localizer["Submit"]</button>
                </div>
            </div>
        </div>
        <div class="card-header bg-white border-top">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["RequestDetail"]</h6>
            </div>
        </div>
        <div class="card-body pt-2">
            <div class="table-responsive fixed-header">
                <table class="table table-sm table-hover table-bordered align-middle" id="quoteTable">
                    <thead class="table-light" style="position: sticky; top: 0; background-color: white; z-index: 10;">
                        <tr class="text-center align-middle">
                            <th rowspan="2" class="title_column_stt">No</th>
                            <th rowspan="2" class="title_column" style="min-width: 200px">@Localizer["SectionCode"]<span class="text-danger">*</span></th>
                            <th rowspan="2" class="title_column" style="min-width: 230px">@Localizer["Category"]<span class="text-danger">*</span><br /></th>
                            <th rowspan="2" class="title_column">@Localizer["Classification"]<br /> </th>
                            <th rowspan="2" class="title_column">@Localizer["EquipmentCode"]<br /></th>
                            <th rowspan="2" class="title_column" style="min-width: 230px">@Localizer["InternalMaterialCode"]<span class="text-danger">*</span></th>
                            <th rowspan="2" class="title_column">@Localizer["SupplierItemCode"]<br /></th>
                            <th rowspan="2" class="title_column">@Localizer["ItemNameVN"]<span class="text-danger">*</span></th>
                            <th rowspan="2" class="title_column">@Localizer["ItemNameEN"]<span class="text-danger">*</span></th>
                            <th rowspan="2" class="title_column">@Localizer["Quantity"]<span class="text-danger">*</span></th>
                            <th rowspan="2" class="title_column">@Localizer["Unit"]<span class="text-danger">*</span></th>
                            @* Mô tà hàng hóa *@
                            <th colspan="6" class="title_column">@Localizer["ItemDescription"]<br /></th>
                            @* -------- *@
                            <th rowspan="2" class="title_column" style="width: 100px">@Localizer["ROHSRequirement"]<br /> </th>
                            <th rowspan="2" class="title_column" style="width: 100px">@Localizer["COCQRequirement"]<br /> </th>
                            <th rowspan="2" class="title_column" style="min-width: 200px">@Localizer["MSDSRequirement"]<br /> </th>
                            <th rowspan="2" class="title_column">@Localizer["SafetyStandardRequirement"]<br /> </th>
                            <th rowspan="2" class="title_column">@Localizer["DesignFile"]<br /></th>
                            <th rowspan="2" class="title_column">@Localizer["Manufacturer"]</th>
                            <th rowspan="2" class="title_column" style="min-width: 250px">@Localizer["Supplier"]<span class="text-danger">*</span></th>
                            <th rowspan="2" class="title_column">@Localizer["GetQuotation"]<span class="text-danger">*</span></th>
                            <th rowspan="2" class="title_column">@Localizer["Reason"] <br /></th>
                            <th rowspan="2" class="title_column">@Localizer["DesiredReceiveDate"]<span class="text-danger">*</span></th>
                            <th rowspan="2" class="title_column">@Localizer["SupplierSelectionDeadline"]<br /></th>
                            <th rowspan="2" class="title_column" style="width: 50px">@Localizer["Urgent"]<br /></th>
                            <th rowspan="2" class="title_column" style="min-width: 150px">@Localizer["Requester"]<br /></th>
                            <th rowspan="2" class="title_column">@Localizer["FileLink"]<br /><small>(No need to keep it confidential)</small></th>
                            <th rowspan="2" class="title_column_stt">#</th>
                        </tr>
                        <tr class="text-center align-middle">
                            <th class="title_column">@Localizer["Shape"]<br /></th>
                            <th class="title_column">@Localizer["Material"]<br /></th>
                            <th class="title_column">
                                @Localizer["CompositionForChemicals"] <br />
                            </th>
                            <th class="title_column">
                                @Localizer["DimensionsMM"]<br />
                            </th>
                            <th class="title_column">
                                @Localizer["UsedForPosition"]<br />
                            </th>
                            <th class="title_column">
                                @Localizer["PurposeFeature"]<br />
                            </th>
                        </tr>
                        <tr id="filterRow" class="filter-row">
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="0" placeholder="@Localizer["FilterNo"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="1" placeholder="@Localizer["FilterSection"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="2" placeholder="@Localizer["FilterCategory"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="3" placeholder="@Localizer["FilterClassification"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="4" placeholder="@Localizer["FilterEquipment"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="5" placeholder="@Localizer["FilterMaterialCode"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="6" placeholder="@Localizer["FilterSupplierCode"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="7" placeholder="@Localizer["FilterVNName"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="8" placeholder="@Localizer["FilterENName"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="9" placeholder="@Localizer["FilterQuantity"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="10" placeholder="@Localizer["FilterUnit"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="11" placeholder="@Localizer["FilterShape"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="12" placeholder="@Localizer["FilterMaterial"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="13" placeholder="@Localizer["FilterComposition"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="14" placeholder="@Localizer["FilterDimensions"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="15" placeholder="@Localizer["FilterUsedFor"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="16" placeholder="@Localizer["FilterPurpose"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="17" placeholder="@Localizer["FilterROHS"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="18" placeholder="@Localizer["FilterCOCQ"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="19" placeholder="@Localizer["FilterMSDS"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="20" placeholder="@Localizer["FilterSafety"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="21" placeholder="@Localizer["FilterDesignFile"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="23" placeholder="@Localizer["FilterManufacturer"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="23" placeholder="@Localizer["FilterSupplier"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="24" placeholder="@Localizer["FilterGetQuote"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="25" placeholder="@Localizer["FilterReason"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="26" placeholder="@Localizer["FilterDate"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="27" placeholder="@Localizer["FilterDeadline"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="28" placeholder="@Localizer["FilterUrgent"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="29" placeholder="@Localizer["FilterRequester"]" /></th>
                            <th><input type="text" class="form-control form-control-sm filter-input" data-column="22" placeholder="@Localizer["FilterLink"]" /></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="quoteTableBody">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <tr>
                                <td class="text-center">@i</td>
                                <td>
                                    <select id="tenPhongBanTb_@i" name="tenPhongBanTb_@i" class="form-select tenPhongBanTb searchable-select">
                                        <option value="" selected>@Localizer["SelectSection"]</option>
                                        @foreach (var s in nhomViTri)
                                        {
                                            <option value="@s.Cost_Center">@s.Cost_Center - @s.Name</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select id="chungLoai_@i" name="chungLoai_@i" class="form-select chungLoaiTb searchable-select">
                                        <option value="" selected>@Localizer["SelectCategory"]</option>
                                        @foreach (var s in categoryS)
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select id="tenPhanLoaiTb_@i" name="tenPhanLoaiTb_@i" style="min-width: 230px" class="form-select tenPhanLoaiTb">
                                        <option value="" selected>@Localizer["SelectClassification"]</option>
                                        @foreach (var s in phanLoais)
                                        {
                                            <option value="@s">@s</option>
                                        }
                                    </select>
                                </td>
                                <td><input id="maThietBi_@i" name="maThietBi_@i" type="text" class="form-control form-control-sm" placeholder="@Localizer["EquipmentCode"]" /></td>
                                <td>
                                    <select id="maHangNoiBo_@i" name="maHangNoiBo_@i" class="form-select maHangNoiBo searchable-select">
                                        <option value="" selected>@Localizer["SelectInternalMaterialCode"]</option>
                                        @foreach (var s in mATERIAs)
                                        {
                                            <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                                        }
                                    </select>
                                </td>
                                <td><input id="maHangNCC_@i" name="maHangNCC_@i" type="text" class="form-control form-control-sm" placeholder="@Localizer["SupplierItemCode"]" /></td>
                                <td><input id="tenHangVN_@i" name="tenHangVN_@i" type="text" class="form-control form-control-sm" placeholder="@Localizer["ItemNameVNPlaceholder"]" /></td>
                                <td><input id="tenHangEN_@i" name="tenHangEN_@i" style="width: 270px" type="text" class="form-control form-control-sm" placeholder="@Localizer["ItemNameEN"]" /></td>
                                <td><input id="soLuong_@i" name="soLuong_@i" type="number" class="form-control form-control-sm text-end" placeholder="0" min="0" /></td>
                                <td><input id="donVi_@i" name="donVi_@i" type="text" class="form-control form-control-sm donVi" placeholder="@Localizer["Unit"]" /></td>
                                <td><input id="hinhDang_@i" name="hinhDang_@i" type="text" class="form-control form-control-sm hinhDang" placeholder="@Localizer["Shape"]" /></td>
                                <td><input id="chatLieu_@i" name="chatLieu_@i" type="text" class="form-control form-control-sm chatLieu" placeholder="@Localizer["Material"]" /></td>
                                <td><input id="thanhPhan_@i" name="thanhPhan_@i" type="text" class="form-control form-control-sm thanhPhan" placeholder="@Localizer["Composition"]" /></td>
                                <td><input id="kichThuoc_@i" name="kichThuoc_@i" type="text" class="form-control form-control-sm kichThuoc" placeholder="@Localizer["DimensionsMM"]" /></td>
                                <td><input id="viTriSuDung_@i" name="viTriSuDung_@i" type="text" class="form-control form-control-sm viTriSuDung" placeholder="@Localizer["UsedForPosition"]" /></td>
                                <td><input id="tinhNang_@i" name="tinhNang_@i" type="text" class="form-control form-control-sm tinhNang" placeholder="@Localizer["PurposeFeature"]" /></td>
                                <td>
                                    <select id="rohsTb_@i" name="rohsTb_@i" class="form-select rohsTb">
                                        <option value="" selected></option>
                                        <option value="No Need">No Need</option>
                                        <option value="Need">Need</option>
                                    </select>
                                </td>
                                <td>
                                    <select id="CoCqTb_@i" name="CoCqTb_@i" class="form-select CoCqTb">
                                        <option value="" selected>@Localizer["SelectCOCQ"]</option>
                                        <option value="CO">CO</option>
                                        <option value="CQ">CQ</option>
                                        <option value="CO&CQ">CO&CQ</option>
                                    </select>
                                </td>
                                <td><input id="msds_@i" name="msds_@i" type="text" class="form-control form-control-sm" placeholder="@Localizer["MSDSRequirementPlaceholder"]" /></td>
                                <td><input id="tieuChuanAnToan_@i" name="tieuChuanAnToan_@i" type="text" class="form-control form-control-sm" placeholder="@Localizer["SafetyRequirement"]" /></td>
                                <td><input id="fileThietKe_@i" name="fileThietKe_@i" type="text" class="form-control form-control-sm" placeholder="@Localizer["DesignFile"]" /></td>
                                <td><input id="nsx_@i" name="nsx_@i" type="text" class="form-control form-control-sm" placeholder="@Localizer["Manufacturer"]" /></td>
                                <td>
                                    <select id="nhaCungCapTb_@i" name="nhaCungCapTb_@i" class="form-select nhaCungCapTb searchable-select">
                                        <option value="" selected>@Localizer["SelectSupplier"]</option>
                                        @foreach (var s in nccNews)
                                        {
                                            <option value="@s.Ma">@s.Ma - @s.Ten</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select id="laybaogiaTb_@i" name="laybaogiaTb_@i" class="form-select laybaogiaTb">
                                        <option value="true" selected>O</option>
                                        <option value="false">X</option>
                                    </select>
                                </td>
                                <td><input id="lyDo_@i" name="lyDo_@i" type="text" class="form-control form-control-sm" placeholder="@Localizer["Reason"]" /></td>
                                <td><input id="ngayMuonNhan_@i" name="ngayMuonNhan_@i" type="date" class="form-control form-control-sm" /></td>
                                <td><input id="kyHanChonNCC_@i" name="kyHanChonNCC_@i" type="date" class="form-control form-control-sm" /></td>
                                <td>
                                    <select id="gapTb_@i" name="gapTb_@i" class="form-select gapTb">
                                        <option value="false" selected>X</option>
                                        <option value="true">O</option>
                                    </select>
                                </td>
                                <td><input id="nguoiYeuCauRow_@i" name="nguoiYeuCauRow_@i" type="text" class="form-control form-control-sm" placeholder="@Localizer["Requester"]" /></td>
                                <td><input id="linkFile_@i" name="linkFile_@i" type="text" class="form-control form-control-sm linkFile" placeholder="@Localizer["LinkToFile"]" /></td>
                                <td class="text-center"><button type="button" class="btn btn-sm btn-link text-danger px-0 btn-remove-row" title="@Localizer["RemoveRow"]"><i class="fas fa-times"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div id="paginationInfo" class="d-flex justify-content-between align-items-center mt-2" style="display:none;">
               <div class="d-flex align-items-center gap-2">
                    <label for="rowsPerPageSelect" class="form-label mb-0" style="margin-right: 4px;">@Localizer["RowIndex"] </label>
                    <select id="rowsPerPageSelect" class="form-select form-select-sm" style="width: auto;">
                        <option value="5" selected>5</option>
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="150">150</option>
                        <option value="200">200</option>
                    </select>
               </div>
               <div id="pageInfo"></div>
                    <div id="paginationControls" class="d-flex justify-content-center mt-3" style="display:none;">
                    <nav aria-label="Table pagination">
                        <ul class="pagination pagination-sm">
                            <li class="page-item" id="prevPage"><a class="page-link" href="#" aria-label="@Localizer["Previous"]"><span aria-hidden="true">&laquo;</span></a></li>
                            <li>
                                 <div id="pageNumberInfo">1/5</div>
                            </li>
                            <li class="page-item" id="nextPage"><a class="page-link" href="#" aria-label="@Localizer["Next"]"><span aria-hidden="true">&raquo;</span></a></li>
                        </ul>
                    </nav>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 mt-2">
                <button type="button" id="btnAddRow" class="btn btn-sm btn-outline-secondary"><i class="fas fa-plus"></i> @Localizer["AddOneRow"]</button>
                <div style="margin-left: 8px;"></div>
                <button type="button" id="btnClearFilters" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eraser"></i> @Localizer["ClearFilters"]</button>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="small text-muted">@Localizer["RequiredFieldsNote"]</div>
        </div>

        <input type="file" id="excelUpload" accept=".xlsx,.xls" class="d-none" />
    </form>
</div>
<!-- Custom dialog root -->
<div id="cmDialogOverlay" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmDialogTitle">
        <div class="cm-dialog-header">
            <h6 id="cmDialogTitle" class="cm-dialog-title">@Localizer["Notification"]</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="close" aria-label="@Localizer["Close"]">✕</button>
        </div>
        <div id="cmDialogBody" class="cm-dialog-body"></div>
        <div id="cmDialogFooter" class="cm-dialog-footer">
            <!-- Buttons injected by JS -->
        </div>
    </div>
    <!-- Make overlay clickable to close for info dialogs -->
    <div class="cm-dialog-backdrop" data-cm-action="overlay"></div>
</div>
<!-- Auto Render modal -->
<div id="arModalOverlay" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="arModalTitle">
        <div class="cm-dialog-header">
            <h6 id="arModalTitle" class="cm-dialog-title">@Localizer["AutoRenderExportExcel"]</h6>
            <button type="button" class="cm-btn cm-btn-outline" id="arCloseBtn" aria-label="@Localizer["Close"]">✕</button>
        </div>
        <div id="arModalBody" class="cm-dialog-body">
            <div id="arError" class="text-danger small mb-2" style="display:none"></div>
            <div class="mb-3">
                <div class="btn-group" role="group" aria-label="Tabs">
                    <button type="button" class="cm-btn cm-btn-primary" id="arTabHasCode">@Localizer["HasInternalMaterialCode"]</button>
                    <button type="button" class="cm-btn cm-btn-outline" id="arTabNoCode">@Localizer["NoInternalMaterialCode"]</button>
                </div>
            </div>
            <!-- Tab: Has internal material code -->
            <div id="arTabHasCodeBody">
                <div class="mb-3">
                    <label class="form-label">@Localizer["SectionCode"]</label>
                    <select id="arSection" class="form-select"></select>
                    <div id="arSectionName" class="small text-muted mt-1"></div>
                </div>
                <div class="mb-2 d-flex justify-content-between align-items-center">
                    <label class="form-label mb-0">@Localizer["SelectInternalMaterialCode"]</label>
                    <label class="mb-0" style="cursor:pointer"><input type="checkbox" id="arSelectAll" /> @Localizer["SelectAll"]</label>
                </div>
                <input id="arSearch" type="text" class="form-control form-control-sm mb-2" placeholder="@Localizer["SearchCodeOrName"]" />
                <div id="arMaterialList" style="max-height: 320px; overflow: auto; border: 1px solid #e0e0e0; padding: 6px; border-radius: 4px;"></div>
            </div>
            <!-- Tab: No internal material code -->
            <div id="arTabNoCodeBody" style="display:none">
                <div class="mb-3">
                    <label class="form-label">@Localizer["SectionCode"]</label>
                    <select id="arSection2" class="form-select"></select>
                    <div id="arSectionName2" class="small text-muted mt-1"></div>
                </div>
                <div class="mb-2 d-flex justify-content-between align-items-center">
                    <label class="form-label mb-0">@Localizer["SelectCategory"]</label>
