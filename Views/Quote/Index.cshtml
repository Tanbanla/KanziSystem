                <div id="arCategoryList" style="max-height: 320px; overflow: auto; border: 1px solid #e0e0e0; padding: 6px; border-radius: 4px;"></div>
            </div>
        </div>
        <div id="arModalFooter" class="cm-dialog-footer">
            <button type="button" class="cm-btn cm-btn-outline" id="arCancelBtn">@Localizer["Cancel"]</button>
            <button type="button" class="cm-btn cm-btn-primary" id="arExportBtn">@Localizer["ExportExcel"]</button>
        </div>
    </div>
    <div class="cm-dialog-backdrop" data-ar-action="overlay"></div>
</div>
