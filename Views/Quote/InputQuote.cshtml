@using PRJ_WAREHOUSE_BIVN.DTO
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = @Localizer["PageTitle"];
    List<ACC_NHOMVITRIDTO> nhomViTri = Model.DanhSachNhomViTri;
    List<MATERIALDTO> mATERIAs = Model.DanhSachVatTu;
    List<IM_NCC_NEWDTO> nccNews = Model.DanhSachNhaCungCap;
    List<string> categoryS = Model.DanhSachCategory;
    string currentUser = Model.NguoiThaoTac;
    List<string> madons = Model.DanhSachMaDon;
    List<BaoGia_Request_of_QuotationDTO> listQuote = Model.DanhSachYeuCauBaoGia;
}
<head>
    <link rel="stylesheet" href="~/css/Approval_Quote.css" />
    <link rel="stylesheet" href="~/css/Quote.css" />
</head>

<div class="container-fluid" id="input-quote">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-primary">@Localizer["PageTitle"]</h4>
        </div>
        <div class="btn-group mb-2" role="group">
            <button class="btn btn-success btn-sm" id="btnSampleExcel" ><i class="fas fa-file-excel"></i> @Localizer["ExportImportFromExcel"]</button>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white py-2">
            <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["Filters"]</h6>
        </div>
        <div class="card-body pt-3 pb-2">
            <form id="filterForm" class="row g-4 align-items-end">
                <div class="col-12 col-md-3">
                    <label for="searchMaDon" class="form-label small text-uppercase fw-semibold">@Localizer["QuotationCode"]</label>
                    <select id="searchMaDon" name="searchMaDon" class="form-select searchMaDon searchable-select">
                        <option value="" selected>@Localizer["SelectQuotation"]</option>
                        @foreach (var s in madons)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label for="searchPhongBan" class="form-label small text-uppercase fw-semibold">@Localizer["DepartmentCode"]</label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchPhongBan searchable-select">
                        <option value="" selected>@Localizer["SelectDepartment"]</option>
                        @foreach (var s in nhomViTri)
                        {
                            <option value="@s.Mahangmuctheovitri">@s.Mahangmuctheovitri - @s.Tenhangmuctheovitri</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label for="searchMaterial" class="form-label small text-uppercase fw-semibold">@Localizer["MaterialCode"]</label>
                    <select id="searchMaterial" name="searchMaterial" class="form-select searchMaterial searchable-select">
                        <option value="" selected>@Localizer["SelectMaterial"]</option>
                        @foreach (var s in mATERIAs)
                        {
                            <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                        }
                    </select>
                </div>
                 <div class="col-12 col-md-3">
                    <label for="searchStatus" class="form-label small text-uppercase fw-semibold">@Localizer["Status"]</label>
                    <select id="searchStatus" name="searchStatus" class="form-select searchStatus searchable-select">
                        <option value="1" selected>@Localizer["SelectAll"]</option>
                        <option value="2">@Localizer["Confirm"]</option>
                        <option value="3">@Localizer["Done"]</option>
                    </select>
                </div>
                <div class="col-12 d-flex gap-2 mt-2">
                    <button type="button" id="btnSearch" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> @Localizer["Search"]</button>
                    <div style="min-width: 12px;"></div>
                    <button type="button" id="btnClear" class="btn btn-outline-secondary btn-sm"><i class="fas fa-eraser"></i> @Localizer["ClearFilters"]</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["RequestList"]</h6>
            <small class="text-muted" id="summaryText">@Localizer["SummaryFormat", 0]</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 480px;">
                <table class="table table-sm table-hover table-bordered align-middle mb-0" id="inputQuoteTable">
                    <thead class="table-header-custom">
                        <tr class="text-center align-middle">
                            <th style="width:40px"><input type="checkbox" id="selectAll" title="@Localizer["SelectAll"]" /></th>
                            <th style="min-width:80px">@Localizer["Detail"]</th>
                            <th style="min-width:140px">@Localizer["OrderCode"]</th>
                            <th style="min-width:110px">@Localizer["RequestDate"]<br></th>
                            <th style="min-width:140px">@Localizer["DepartmentName"]<br></th>
                            <th style="min-width:130px">@Localizer["CreatorPIC"]</th>
                            <th style="min-width:150px">@Localizer["NumberMaterial"]<br></th>
                            <th style="min-width:170px">@Localizer["SupplierSelectionDeadline"]<br></th>
                            <th style="min-width:70px">@Localizer["Status"]<br></th>
                        </tr>
                    </thead>
                    <tbody id="inputQuoteTableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- Pagination controls -->
    <div class="d-flex justify-content-between align-items-center p-2 mt-2">
        <div class="d-flex align-items-center gap-2">
            <label class="small mb-0" style="margin-right:4px;">@Localizer["RowIndex"].Value</label>
            <select id="pageSizeSelect" class="form-select form-select-sm" style="width:90px;">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>

        <div class="d-flex align-items-center gap-2">
            <div id="paginationControls" class="btn-group" role="group"></div>
            <div style="margin-right: 4px;"></div>
            <small class="text-muted" id="pagingInfo">&nbsp;</small>
        </div>
    </div>
</div>

<script>
    window.inputQuoteData = {
        user: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentUser)),
        maDons: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(madons)),
        nhomViTri: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(nhomViTri)),
        materials: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mATERIAs)),
        nccNews: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(nccNews))
    };
    window.i18nInputQuote = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        PageTitle = Localizer["PageTitle"].Value,
        ImportFromExcel = Localizer["ImportFromExcel"].Value,
        SaveAll = Localizer["SaveAll"].Value,
        Filters = Localizer["Filters"].Value,
        QuotationCode = Localizer["QuotationCode"].Value,
        SelectQuotation = Localizer["SelectQuotation"].Value,
        DepartmentCode = Localizer["DepartmentCode"].Value,
        SelectDepartment = Localizer["SelectDepartment"].Value,
        MaterialCode = Localizer["MaterialCode"].Value,
        SelectMaterial = Localizer["SelectMaterial"].Value,
        Search = Localizer["Search"].Value,
        ClearFilters = Localizer["ClearFilters"].Value,
        RequestList = Localizer["RequestList"].Value,
        SummaryFormat = Localizer["SummaryFormat", "{0}"].Value,
        SelectAll = Localizer["SelectAll"].Value,
        Detail = Localizer["Detail"].Value,
        OrderCode = Localizer["OrderCode"].Value,
        RequestDate = Localizer["RequestDate"].Value,
        DepartmentName = Localizer["DepartmentName"].Value,
        CreatorPIC = Localizer["CreatorPIC"].Value,
        DesiredReceiveDate = Localizer["DesiredReceiveDate"].Value,
        SupplierSelectionDeadline = Localizer["SupplierSelectionDeadline"].Value,
        InputQuoteTitle = Localizer["InputQuoteTitle"].Value,
        ReceivingDepartmentLabel = Localizer["ReceivingDepartmentLabel"].Value,
        UrgentBadgeText = Localizer["UrgentBadgeText"].Value,
        DeptCostCenterLabel = Localizer["DeptCostCenterLabel"].Value,
        DeptNameLabel = Localizer["DeptNameLabel"].Value,
        RequestDateLabel = Localizer["RequestDateLabel"].Value,
        DesiredDeadlineLabel = Localizer["DesiredDeadlineLabel"].Value,
        Supplier = Localizer["Supplier"].Value,
        SelectSupplier = Localizer["SelectSupplier"].Value,
        QuoteDate = Localizer["QuoteDate"].Value,
        ValidUntil = Localizer["ValidUntil"].Value,
        GoodsDetailTitle = Localizer["GoodsDetailTitle"].Value,
        STT = Localizer["STT"].Value,
        SystemCode = Localizer["SystemCode"].Value,
        InternalMaterialCodeShort = Localizer["InternalMaterialCodeShort"].Value,
        Category = Localizer["Category"].Value,
        ItemNameVNEN = Localizer["ItemNameVNEN"].Value,
        DescriptionGroup = Localizer["DescriptionGroup"].Value,
        SupplierShort = Localizer["SupplierShort"].Value,
        UrgentShort = Localizer["UrgentShort"].Value,
        GetQuotation = Localizer["GetQuotation"].Value,
        Reason = Localizer["Reason"].Value,
        QuantityShort = Localizer["QuantityShort"].Value,
        UnitShort = Localizer["UnitShort"].Value,
        ShapeShort = Localizer["ShapeShort"].Value,
        MaterialShort = Localizer["MaterialShort"].Value,
        CompositionShort = Localizer["CompositionShort"].Value,
        DimensionsShort = Localizer["DimensionsShort"].Value,
        UsedPositionShort = Localizer["UsedPositionShort"].Value,
        PurposeFeatureShort = Localizer["PurposeFeatureShort"].Value,
        LoadingData = Localizer["LoadingData"].Value,
        QuoteInputTitle = Localizer["QuoteInputTitle"].Value,
        NoLabel = Localizer["NoLabel"].Value,
        InternalMaterialCode = Localizer["InternalMaterialCode"].Value,
        SupplierItemCode = Localizer["SupplierItemCode"].Value,
        CustomsItemName = Localizer["CustomsItemName"].Value,
        Quantity = Localizer["Quantity"].Value,
        PriceUSD = Localizer["PriceUSD"].Value,
        PriceVND = Localizer["PriceVND"].Value,
        MOQ = Localizer["MOQ"].Value,
        LeadTime = Localizer["LeadTime"].Value,
        DeliveryDate = Localizer["DeliveryDate"].Value,
        RohsResponse = Localizer["RohsResponse"].Value,
        COCQ = Localizer["COCQ"].Value,
        MSDSWithCAS = Localizer["MSDSWithCAS"].Value,
        SafetyResponse = Localizer["SafetyResponse"].Value,
        CommitRequirement = Localizer["CommitRequirement"].Value,
        DeliveryMethod = Localizer["DeliveryMethod"].Value,
        Condition = Localizer["Condition"].Value,
        Attachment = Localizer["Attachment"].Value,
        FooterID = Localizer["FooterID"].Value,
        FooterStep = Localizer["FooterStep"].Value,
        FooterRegency = Localizer["FooterRegency"].Value,
        Save = Localizer["Save"].Value,
        RowsPerPage = Localizer["RowsPerPage"].Value,
        SubmitQuote = Localizer["SubmitQuote"].Value,
        CloseButton = Localizer["CloseButton"].Value,
        Close = Localizer["Close"].Value,
        Confirm= Localizer["Confirm"].Value,
        Done = Localizer["Done"].Value,
        DataFilteredSuccessfully = Localizer["DataFilteredSuccessfully"].Value,
        FilterFailed = Localizer["FilterFailed"].Value
    }));
</script>
@section Scripts {
    <script src="~/js/InputQuote.js"></script>
}