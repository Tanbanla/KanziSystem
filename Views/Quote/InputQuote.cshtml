</div>

<!-- Product side panel (slide-in) -->
<div id="productPanel" class="product-panel" aria-hidden="true">
    <div class="panel-header d-flex justify-content-between align-items-center p-2 border-bottom">
        <strong class="ms-2"><i class="fas fa-box-open me-2"></i>Chọn sản phẩm</strong>
        <div>
            <button type="button" class="btn btn-sm btn-light me-1" id="btnCloseProductPanel">Đóng</button>
        </div>
    </div>
    <div class="panel-body p-3">
        <div class="mb-2">
            <div class="row g-2">
                <div class="col-sm-3">
                    <label class="form-label">Mã yêu cầu báo giá</label>
                    <select id="modalRqCode" name="modalRqCode" class="form-control modalRqCode searchable-select">
                        <option value="">-- Chọn mã đơn --</option>
                        @foreach (var s in madons)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-sm-3">
                    <label for="modalInternalCode" class="form-label">Mã hàng nội bộ</label>
                    <select id="modalInternalCode" name="modalInternalCode" class="form-select modalInternalCode searchable-select">
                        <option value="" selected>Chọn mã hàng nội bộ</option>
                        @foreach (var s in mATERIAs)
                        {
                            <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                        }
                    </select>
                </div>
                <div class="col-sm-3">
                    <label class="form-label">Phòng yêu cầu</label>
                    <select id="modalSection" name="modalSection" class="form-select searchable-select">
                        <option value="">-- Chọn phòng --</option>
                        @foreach (var s in nhomViTri)
                        {
                            <option value="@s.Mahangmuctheovitri">@s.Mahangmuctheovitri - @s.Tenhangmuctheovitri</option>
                        }
                    </select>
                </div>
                <div class="col-sm-3">
                    <label class="form-label">Nhà cung cấp</label>
                    <select id="modalSupplier" name="modalSupplier" class="form-select searchable-select">
                        <option value="">-- Chọn NCC --</option>
                        @foreach (var s in nccNews)
                        {
                            <option value="@s.Ma">@s.Ma - @s.Ten</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-sm-12 text-end">
                    <button type="button" id="btnDialogSearch" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Tìm kiếm</button>
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="thead-light sticky-top">
                    <tr>
                        <th style="width:48px;">Chọn</th>
                        <th>Mã đơn</th>
                        <th>Mã hàng nội bộ</th>
                        <th>Tên hàng</th>
                        <th>Phòng yêu cầu</th>
                        <th style="width:100px;" class="text-end">Số lượng</th>
                        <th style="width:80px;">Đơn vị</th>
                        <th>Nhà cung cấp</th>
                    </tr>
                </thead>
                <tbody id="availableProductsBody">
                    @foreach (var i in listQuote)
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox"
                                       class="form-check-input product-select"
                                       value="@i.ID"
                                       data-rq="@i.CHR_MaDon"
                                       data-internal="@i.CHR_MaHangNoiBo"
                                       data-name="@(!string.IsNullOrWhiteSpace(i.NVCHR_NameVN) ? i.NVCHR_NameVN : i.CHR_NameEN)"
                                       data-section="@i.CHR_SectionName"
                                       data-qty="@i.INT_SoLuong"
                                       data-unit="@i.NVCHR_DonVi"
                                       data-ncc="@i.CHR_MaNCC" 
                                       data-rohs="@i.NVCHR_Rohs"
                                       data-antoan="@i.NVCHR_AnToan"
                                       data-cocq="@i.NVCHR_COCQ"
                                       data-msds="@i.NVCHR_MSDS" />
                            </td>
                            <td>@i.CHR_MaDon</td>
                            <td>@i.CHR_MaHangNoiBo</td>
                            <td>@(!string.IsNullOrWhiteSpace(i.NVCHR_NameVN) ? i.NVCHR_NameVN : i.CHR_NameEN)</td>
                            <td>@i.CHR_SectionName</td>
                            <td class="text-end">@i.INT_SoLuong</td>
                            <td>@i.NVCHR_DonVi</td>
                            <td>@i.CHR_MaNCC</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-end mt-2">
            <button type="button" class="btn btn-primary btn-sm" id="btnConfirmAddProducts">Thêm vào báo giá</button>
        </div>
    </div>
</div>
<script>
    window.inputQuoteData = {
        user: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentUser))
    };
</script>
@section Scripts {
    <script src="~/js/InputQuote.js"></script>
}
