    </div> *@
</div>

<!-- Product side panel (slide-in) -->
<div id="productPanel" class="product-panel" aria-hidden="true">
    <div class="panel-header d-flex justify-content-between align-items-center p-2 border-bottom">
        <strong class="ms-2"><i class="fas fa-box-open me-2"></i>@Localizer["SelectProducts"]</strong>
        <div>
            <button type="button" class="btn btn-sm btn-light me-1" id="btnCloseProductPanel">@Localizer["Close"]</button>
        </div>
    </div>
    <div class="panel-body p-3">
        <div class="mb-2">
            <div class="row g-2">
                <div class="col-sm-3">
                    <label class="form-label">@Localizer["QuoteRequestCode"]</label>
                    <select id="modalRqCode" name="modalRqCode" class="form-control modalRqCode searchable-select">
                        <option value="">@Localizer["SelectOrderCode"]</option>
                        @foreach (var s in madons)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-sm-3">
                    <label for="modalInternalCode" class="form-label">@Localizer["InternalMaterialCode"]</label>
                    <select id="modalInternalCode" name="modalInternalCode" class="form-select modalInternalCode searchable-select">
                        <option value="" selected>@Localizer["SelectInternalMaterialCode"]</option>
                        @foreach (var s in mATERIAs)
                        {
                            <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                        }
                    </select>
                </div>
                <div class="col-sm-3">
                    <label class="form-label">@Localizer["RequestSection"]</label>
                    <select id="modalSection" name="modalSection" class="form-select searchable-select">
                        <option value="">@Localizer["SelectSection"]</option>
                        @foreach (var s in nhomViTri)
                        {
                            <option value="@s.Mahangmuctheovitri">@s.Mahangmuctheovitri - @s.Tenhangmuctheovitri</option>
                        }
                    </select>
                </div>
                <div class="col-sm-3">
                    <label class="form-label">@Localizer["Supplier"]</label>
                    <select id="modalSupplier" name="modalSupplier" class="form-select searchable-select">
                        <option value="">@Localizer["SelectSupplier"]</option>
                        @foreach (var s in nccNews)
                        {
                            <option value="@s.Ma">@s.Ma - @s.Ten</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-sm-12 text-end">
                    <button type="button" id="btnDialogSearch" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> @Localizer["Search"]</button>
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead class="thead-light sticky-top">
                    <tr>
                        <th style="width:48px;">@Localizer["Select"]</th>
                        <th>@Localizer["OrderCode"]</th>
                        <th>@Localizer["InternalMaterialCode"]</th>
                        <th>@Localizer["ItemName"]</th>
                        <th>@Localizer["RequestSection"]</th>
                        <th style="width:100px;" class="text-end">@Localizer["Quantity"]</th>
                        <th style="width:80px;">@Localizer["Unit"]</th>
                        <th>@Localizer["Supplier"]</th>
                    </tr>
                </thead>
                <tbody id="availableProductsBody">
                    @foreach (var i in listQuote)
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox"
                                       class="form-check-input product-select"
                                       value="@i.ID"
                                       data-rq="@i.CHR_MaDon"
                                       data-internal="@i.CHR_MaHangNoiBo"
                                       data-name="@(!string.IsNullOrWhiteSpace(i.NVCHR_NameVN) ? i.NVCHR_NameVN : i.CHR_NameEN)"
                                       data-section="@i.CHR_SectionName"
                                       data-qty="@i.INT_SoLuong"
                                       data-unit="@i.NVCHR_DonVi"
                                       data-ncc="@i.CHR_MaNCC" 
                                       data-rohs="@i.NVCHR_Rohs"
                                       data-antoan="@i.NVCHR_AnToan"
                                       data-cocq="@i.NVCHR_COCQ"
                                       data-msds="@i.NVCHR_MSDS" />
                            </td>
                            <td>@i.CHR_MaDon</td>
                            <td>@i.CHR_MaHangNoiBo</td>
                            <td>@(!string.IsNullOrWhiteSpace(i.NVCHR_NameVN) ? i.NVCHR_NameVN : i.CHR_NameEN)</td>
                            <td>@i.CHR_SectionName</td>
                            <td class="text-end">@i.INT_SoLuong</td>
                            <td>@i.NVCHR_DonVi</td>
                            <td>@i.CHR_MaNCC</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-end mt-2">
            <button type="button" class="btn btn-primary btn-sm" id="btnConfirmAddProducts">@Localizer["AddToQuote"]</button>
        </div>
    </div>
</div>
<script>
    window.inputQuoteData = {
        user: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentUser))
    };
    window.i18nInputQuote = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        PageTitle = Localizer["PageTitle"].Value,
        ImportFromExcel = Localizer["ImportFromExcel"].Value,
        Save = Localizer["Save"].Value,
        GeneralInfo = Localizer["GeneralInfo"].Value,
        QuoteRequestCode = Localizer["QuoteRequestCode"].Value,
        SelectOrderCode = Localizer["SelectOrderCode"].Value,
        Supplier = Localizer["Supplier"].Value,
        SelectSupplier = Localizer["SelectSupplier"].Value,
        QuoteDate = Localizer["QuoteDate"].Value,
        ValidUntil = Localizer["ValidUntil"].Value,
        DepartmentCode = Localizer["DepartmentCode"].Value,
        SelectDepartment = Localizer["SelectDepartment"].Value,
        MaterialCode = Localizer["MaterialCode"].Value,
        SelectMaterialCode = Localizer["SelectMaterialCode"].Value,
        Reset = Localizer["Reset"].Value,
        Filter = Localizer["Filter"].Value,
        SubmitQuote = Localizer["SubmitQuote"].Value,
        RequestEdit = Localizer["RequestEdit"].Value,
        SaveDraft = Localizer["SaveDraft"].Value,
        QuoteItemList = Localizer["QuoteItemList"].Value,
        NoLabel = Localizer["NoLabel"].Value,
        InternalMaterialCode = Localizer["InternalMaterialCode"].Value,
        SupplierCode = Localizer["SupplierCode"].Value,
        SupplierItemCode = Localizer["SupplierItemCode"].Value,
        CustomsItemName = Localizer["CustomsItemName"].Value,
        Quantity = Localizer["Quantity"].Value,
        Unit = Localizer["Unit"].Value,
        PriceUSD = Localizer["PriceUSD"].Value,
        PriceVND = Localizer["PriceVND"].Value,
        MOQ = Localizer["MOQ"].Value,
        Packing = Localizer["Packing"].Value,
        LeadTime = Localizer["LeadTime"].Value,
        DeliveryDate = Localizer["DeliveryDate"].Value,
        RohsResponse = Localizer["RohsResponse"].Value,
        COCQ = Localizer["COCQ"].Value,
        MSDSWithCAS = Localizer["MSDSWithCAS"].Value,
        SafetyResponse = Localizer["SafetyResponse"].Value,
        CommitRequirement = Localizer["CommitRequirement"].Value,
        DeliveryMethod = Localizer["DeliveryMethod"].Value,
        Condition = Localizer["Condition"].Value,
        Attachment = Localizer["Attachment"].Value,
        Delete = Localizer["Delete"].Value,
        SelectProducts = Localizer["SelectProducts"].Value,
        SelectSection = Localizer["SelectSection"].Value,
        Search = Localizer["Search"].Value,
        Select = Localizer["Select"].Value,
        OrderCode = Localizer["OrderCode"].Value,
        ItemName = Localizer["ItemName"].Value,
        AddToQuote = Localizer["AddToQuote"].Value,
        // JS messages
        MsgResetSuccess = Localizer["MsgResetSuccess"].Value,
        MsgSelectAtLeastOneProduct = Localizer["MsgSelectAtLeastOneProduct"].Value,
        MsgAddedProducts = Localizer["MsgAddedProducts", "{0}"].Value,
        MsgProductDuplicate = Localizer["MsgProductDuplicate"].Value,
        MsgDeleteConfirm = Localizer["MsgDeleteConfirm"].Value,
        MsgProcessingExcel = Localizer["MsgProcessingExcel"].Value,
        MsgUploadFailed = Localizer["MsgUploadFailed"].Value,
        MsgImportSuccess = Localizer["MsgImportSuccess"].Value,
        MsgImportError = Localizer["MsgImportError", "{0}"].Value,
        MsgSaveSuccess = Localizer["MsgSaveSuccess"].Value,
        MsgSaveFailed = Localizer["MsgSaveFailed", "{0}"].Value,
        MsgDraftSaved = Localizer["MsgDraftSaved"].Value,
        MsgSubmitConfirm = Localizer["MsgSubmitConfirm"].Value,
        MsgSubmitSuccess = Localizer["MsgSubmitSuccess"].Value,
        MsgUnsavedChangesConfirm = Localizer["MsgUnsavedChangesConfirm"].Value,
        SearchEllipsis = Localizer["SearchEllipsis"].Value,
        NoResults = Localizer["NoResults"].Value,
        SelectPlaceholder = Localizer["SelectPlaceholder"].Value
    }));
</script>
@section Scripts {
    <script src="~/js/InputQuote.js"></script>
    <script>
        (function() {
            // Ensure panel and overlay are appended to body to avoid being under navbar stacking contexts
            var panel = document.getElementById('productPanel');
            var overlay = document.getElementById('productPanelOverlay');
            if (panel && panel.parentElement !== document.body) {
                document.body.appendChild(panel);
            }
            if (overlay && overlay.parentElement !== document.body) {
                document.body.appendChild(overlay);
            }
        })();
    </script>
}
