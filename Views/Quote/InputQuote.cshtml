@using PRJ_WAREHOUSE_BIVN.DTO
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Nhập thông tin báo giá";
    List<ACC_NHOMVITRIDTO> nhomViTri = Model.DanhSachNhomViTri;
    List<MATERIALDTO> mATERIAs = Model.DanhSachVatTu;
    List<IM_NCC_NEWDTO> nccNews = Model.DanhSachNhaCungCap;
    List<string> categoryS = Model.DanhSachCategory;
    string currentUser = Model.NguoiThaoTac;
    List<string> madons = Model.DanhSachMaDon;
    List<BaoGia_Request_of_QuotationDTO> listQuote = Model.DanhSachYeuCauBaoGia;
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
    <link rel="stylesheet" href="~/css/InputQuote.css" />
</head>

<div class="input-quote-page py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 input-quote-header p-3 rounded">
        <h4 class="mb-0">@Localizer["PageTitle"]</h4>
        <div class="d-flex">
            <button type="button" class="btn-custom" id="btnImportExcel">
                <span class="text" style="margin-right: 7px">@Localizer["ImportFromExcel"]</span>
                <i class="fas fa-file-excel"></i>
            </button>
            <button type="button" class="btn btn-primary btn-sm" style="margin-left: 5px" id="btnSaveQuote">
                <span class="text" style="margin-right: 7px">@Localizer["Save"]</span>
                <i class="fas fa-save" ></i>
            </button>
        </div>
<!-- Overlay for side panel -->
<div id="productPanelOverlay" class="product-panel-overlay" aria-hidden="true"></div>
    </div>

    <!-- Thông tin chung -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header">
            <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>@Localizer["GeneralInfo"]</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">@Localizer["QuoteRequestCode"] <span class="text-danger">*</span></label>
                    <select id="quoteRequestCode" name="quoteRequestCode" class="form-control quoteRequestCode searchable-select">
                        <option value="">@Localizer["SelectOrderCode"]</option>
                        @foreach (var s in madons)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localizer["Supplier"] <span class="text-danger">*</span></label>
                    <select id="supplierSelect" name="supplierSelect" class="form-control supplierSelect searchable-select">
                        <option value="">@Localizer["SelectSupplier"]</option>
                        @foreach (var s in nccNews)
                        {
                            <option value="@s.Ma">@s.Ma - @s.Ten</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localizer["QuoteDate"]</label>
                    <input type="date" class="form-control" id="quoteDate" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Localizer["ValidUntil"]</label>
                    <input type="date" class="form-control" id="validUntil" value="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")">
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-3">
                    <label for="maPhongBan" class="form-label small text-uppercase fw-semibold">@Localizer["DepartmentCode"]</label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchPhongBan searchable-select">
                        <option value="" selected>@Localizer["SelectDepartment"]</option>
                        @foreach (var s in nhomViTri)
                        {
                            <option value="@s.Mahangmuctheovitri">@s.Mahangmuctheovitri - @s.Tenhangmuctheovitri</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="searchMaVatTu" class="form-label">@Localizer["MaterialCode"]</label>
                    <select id="searchMaVatTu" name="searchMaVatTu" class="form-select searchMaVatTu searchable-select">
                        <option value="" selected>@Localizer["SelectMaterialCode"]</option>
                        @foreach (var s in mATERIAs)
                        {
                            <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                        }
                    </select>
                </div>
                <!-- Nút điều khiển -->
                <div class="mt-4 d-flex justify-content-end">
                    <button type="button" class="btn btn-outline-secondary" id="btnReset">
                        <i class="fas fa-undo"></i> @Localizer["Reset"]
                    </button>
                    <div style="min-width:12px"></div>
                    <button type="button" class="btn btn-primary w-100" id="btnApplyFilters"><i class="fas fa-search"></i> @Localizer["Filter"]</button>
                    <div style="min-width:12px"></div>
                    <button type="button" class="btn btn-success" id="btnSubmitQuote">
                        <i class="fas fa-paper-plane me-1"></i> @Localizer["SubmitQuote"]
                    </button>
                    <div style="min-width:12px"></div>
                    <button type="button" class="btn btn-warning" id="btnReturnQuote">
                        <i class="fas fa-pen-alt"></i> @Localizer["RequestEdit"]
                    </button>
                    <div style="min-width:12px"></div>
                    <button type="button" class="btn btn-warning" id="btnSaveDraft">
                        <i class="fas fa-save me-1"></i> @Localizer["SaveDraft"]
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách sản phẩm báo giá -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fas fa-list me-2"></i>@Localizer["QuoteItemList"]</h6>
            <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddProduct">
                <i class="fas fa-plus"></i>
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered quote-items-table mb-0 align-middle">
                    <thead>
                        <tr class="text-center">
                            <th style="width: 40px; background : #0950B0" hidden>ID</th>
                            <th style="width: 40px; background : #0950B0">@Localizer["NoLabel"]</th>
                            <th style="background : #0950B0">@Localizer["InternalMaterialCode"]</th>
                            <th style="background : #0950B0">@Localizer["SupplierCode"]</th>
                            <th style="background : #0950B0">@Localizer["SupplierItemCode"]</th>
                            <th style="min-width: 230px;background : #0950B0">@Localizer["CustomsItemName"]</th>
                            <th style="background : #0950B0">@Localizer["Quantity"]</th>
                            <th style="background : #0950B0">@Localizer["Unit"]</th>
                            <th style="background : #0950B0">@Localizer["PriceUSD"]</th>
                            <th style="background : #0950B0">@Localizer["PriceVND"]</th>
                            <th style="min-width: 100px;background : #0950B0">@Localizer["MOQ"]</th>
                            <th style="min-width: 150px;background : #0950B0">@Localizer["Packing"]</th>
                            <th style="background : #0950B0">@Localizer["LeadTime"]</th>
                            <th style="background : #0950B0">@Localizer["DeliveryDate"]</th>
                            <th style="background : #0950B0">@Localizer["RohsResponse"]</th>
                            <th style="min-width: 120px;background : #0950B0">@Localizer["COCQ"]</th>
                            <th style="background : #0950B0">@Localizer["MSDSWithCAS"]</th>
                            <th style="background : #0950B0">@Localizer["SafetyResponse"]</th>
                            <th style="background : #0950B0">@Localizer["CommitRequirement"]</th>
                            <th style="min-width: 180px;background : #0950B0">@Localizer["DeliveryMethod"]</th>
                            <th style="min-width: 150px;background : #0950B0">@Localizer["Condition"]</th>
                            <th style="min-width: 150px;background : #0950B0">@Localizer["Attachment"]</th>
                            <th style="background : #0950B0">@Localizer["Delete"]</th>
                        </tr>
                    </thead>
                    <tbody id="quoteItemsBody">
                        <tr class="quote-item-row">

                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Tổng kết -->
@*     <div class="row">
        <div class="col-md-8">
            <!-- Điều khoản và điều kiện -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-file-contract me-2"></i>Điều khoản và điều kiện</h6>
                </div>
                <div class="card-body">
                    <textarea class="form-control-note" id="termsConditions" rows="5" placeholder="Nhập điều khoản và điều kiện...
                        VD: 1. Giá trên đã bao gồm VAT 10%
                        2. Thời gian giao hàng: Theo thỏa thuận
