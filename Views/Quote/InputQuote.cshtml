@using PRJ_WAREHOUSE_BIVN.DTO
@{
    ViewData["Title"] = "Nhập thông tin báo giá";
    List<ACC_NHOMVITRIDTO> nhomViTri = Model.DanhSachNhomViTri;
    List<MATERIALDTO> mATERIAs = Model.DanhSachVatTu;
    List<IM_NCC_NEWDTO> nccNews = Model.DanhSachNhaCungCap;
    List<dynamic> categoryS = Model.DanhSachCategory;
    string currentUser = Model.NguoiThaoTac;
    List<string> madons = Model.DanhSachMaDon;
    List<BaoGia_Request_of_QuotationDTO> listQuote = Model.DanhSachYeuCauBaoGia;
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
    <link rel="stylesheet" href="~/css/InputQuote.css" />
</head>

<div class="input-quote-page py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 input-quote-header p-3 rounded">
        <h4 class="mb-0">Nhập thông tin báo giá</h4>
        <div class="d-flex">
            <button type="button" class="btn-custom" id="btnImportExcel">
                <span class="text" style="margin-right: 7px">Nhập từ Excel</span>
                <i class="fas fa-file-excel"></i>
            </button>
            <button type="button" class="btn btn-primary btn-sm" style="margin-left: 5px" id="btnSaveQuote">
                <span class="text" style="margin-right: 7px">Lưu</span>
                <i class="fas fa-save" ></i>
            </button>
        </div>
<!-- Overlay for side panel -->
<div id="productPanelOverlay" class="product-panel-overlay" aria-hidden="true"></div>
    </div>

    <!-- Thông tin chung -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header">
            <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Thông tin chung</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">Mã yêu cầu báo giá <span class="text-danger">*</span></label>
                    <select id="quoteRequestCode" name="quoteRequestCode" class="form-control quoteRequestCode searchable-select">
                        <option value="">-- Chọn mã đơn --</option>
                        @foreach (var s in madons)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nhà cung cấp <span class="text-danger">*</span></label>
                    <select id="supplierSelect" name="supplierSelect" class="form-control supplierSelect searchable-select">
                        <option value="">-- Chọn nhà cung cấp --</option>
                        @foreach (var s in nccNews)
                        {
                            <option value="@s.Ma">@s.Ma - @s.Ten</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Ngày báo giá</label>
                    <input type="date" class="form-control" id="quoteDate" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hiệu lực đến</label>
                    <input type="date" class="form-control" id="validUntil" value="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")">
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-3">
                    <label for="maPhongBan" class="form-label small text-uppercase fw-semibold">Mã phòng ban</label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchPhongBan searchable-select">
                        <option value="" selected>Chọn phòng ban</option>
                        @foreach (var s in nhomViTri)
                        {
                            <option value="@s.Mahangmuctheovitri">@s.Mahangmuctheovitri - @s.Tenhangmuctheovitri</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="searchMaVatTu" class="form-label">Mã nguyên vật liệu</label>
                    <select id="searchMaVatTu" name="searchMaVatTu" class="form-select searchMaVatTu searchable-select">
                        <option value="" selected>Chọn mã nguyên vật liệu</option>
                        @foreach (var s in mATERIAs)
                        {
                            <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                        }
                    </select>
                </div>
                <!-- Nút điều khiển -->
                <div class="mt-4 d-flex justify-content-end">
                    <button type="button" class="btn btn-outline-secondary" id="btnReset">
                        <i class="fas fa-undo"></i> Làm mới
                    </button>
                    <div style="min-width:12px"></div>
                    <button type="button" class="btn btn-primary w-100" id="btnApplyFilters"><i class="fas fa-search"></i> Lọc</button>
                    <div style="min-width:12px"></div>
                    <button type="button" class="btn btn-success" id="btnSubmitQuote">
                        <i class="fas fa-paper-plane me-1"></i> Gửi báo giá
                    </button>
                    <div style="min-width:12px"></div>
                    <button type="button" class="btn btn-warning" id="btnReturnQuote">
                        <i class="fas fa-pen-alt"></i> Yêu cầu chỉnh sửa
                    </button>
                    <div style="min-width:12px"></div>
                    <button type="button" class="btn btn-warning" id="btnSaveDraft">
                        <i class="fas fa-save me-1"></i> Lưu nháp
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách sản phẩm báo giá -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="fas fa-list me-2"></i>Danh sách sản phẩm báo giá</h6>
            <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddProduct">
                <i class="fas fa-plus"></i>
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered quote-items-table mb-0 align-middle">
                    <thead>
                        <tr class="text-center">
                            <th style="width: 40px; background : #0950B0" hidden>ID</th>
                            <th style="width: 40px; background : #0950B0">STT</th>
                            <th style="background : #0950B0">Mã hàng nội bộ</th>
                            <th style="background : #0950B0">Mã nhà cung cấp</th>
                            <th style="background : #0950B0">Mã hàng NCC</th>
                            <th style="min-width: 230px;background : #0950B0">Tên dùng mở thử tục</th>
                            <th style="background : #0950B0">Số lượng</th>
                            <th style="background : #0950B0">Đơn vị</th>
                            <th style="background : #0950B0">Đơn giá USD</th>
                            <th style="background : #0950B0">Đơn giá VND</th>
                            <th style="min-width: 100px;background : #0950B0">MOQ</th>
                            <th style="min-width: 150px;background : #0950B0">Quy cách đóng gói</th>
                            <th style="background : #0950B0">Lead time</th>
                            <th style="background : #0950B0">Ngày giao</th>
                            <th style="background : #0950B0">Có đối ứng Rohs</th>
                            <th style="min-width: 120px;background : #0950B0">CO/CQ</th>
                            <th style="background : #0950B0">Gửi MSDS kèm số CAS</th>
                            <th style="background : #0950B0">Đối ứng tiêu chuẩn an toàn</th>
                            <th style="background : #0950B0">Cam kết đúng yêu cầu</th>
                            <th style="min-width: 180px;background : #0950B0">Phương thức giao</th>
                            <th style="min-width: 150px;background : #0950B0">Điều kiện</th>
                            <th style="min-width: 150px;background : #0950B0">File đính kèm</th>
                            <th style="background : #0950B0">Xóa</th>
                        </tr>
                    </thead>
                    <tbody id="quoteItemsBody">
                        <tr class="quote-item-row">

                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Tổng kết -->
