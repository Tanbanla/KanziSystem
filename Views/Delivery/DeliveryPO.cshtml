<script src="~/scripts/delivery.js"></script>
<script>
    window.onload = function ()
    {
        loadListWarehouse();
    }
    function loadListWarehouse() {
            fetch('/Delivery/GetWareHouse', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
        })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                document.getElementById('IdWarehouse').innerHTML = ""; 
                console.log(data);
                data.forEach((wh) => {
                       document.getElementById('IdWarehouse').innerHTML  += `<option>${wh}</option>`;
                })
            })
            .catch(error => {
                console.error('There was a problem with the fetch operation:', error);
            });
      
    }
    document.addEventListener('DOMContentLoaded', function () {
        let modal = document.getElementById("CommonModal");
        let btn = document.getElementById("openModal") || document.querySelector(".btn-open");
        let closeBtn = modal ? modal.querySelector(".close-btn") : null;
        let closeBottom = modal ? modal.querySelector(".close-modal") : null;

    async function openModal() {
    const url = '/Delivery/GetExchangeUnit';
    const options =
    {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    };
    try
    {    
        response = await fetch(url, options);
        result = await response.json();
        console.log('openModal Data : ', result);
        populateConversionTable(result);
    }
    catch(error)
    {
       console.error('Error : ', error);
    }
    if (modal) modal.style.display = "flex";
    }

    function closeModal() {
        if (modal) modal.style.display = "none";
    }

    if (btn) btn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (closeBottom) closeBottom.addEventListener('click', closeModal);

    window.addEventListener('click', function (event) {
        if (event.target === modal) closeModal();
    });

    if (typeof loadListWarehouse === 'function') loadListWarehouse();

    function populateConversionTable(data) {
        let body = document.getElementById('bodyModal');
        if (!body) return;
        let html = '<div class="table-responsive"><table class="table table-bordered"><thead style="background:blue;"><tr>' +
                   '<th>Mã nguyên liệu</th><th>Đơn vị PO</th><th>Đơn vị quy đổi</th><th>Số lượng quy đổi</th><th>Đơn vị đang sử dụng cho phòng ban đặt hàng</th>' +
                   '</tr></thead><tbody>';
        if (!data || data.length === 0) {
            html += '<tr><td colspan="5" class="text-center">Không có dữ liệu</td></tr>';
        } else {
            data.forEach(item => {
                html += '<tr>' +
                        `<td>${escapeHtml(item.materialCode || '')}</td>` +
                        `<td>${escapeHtml(item.poUnit || '')}</td>` +
                        `<td>${escapeHtml(item.convertedUnit || '')}</td>` +
                        `<td>${escapeHtml(item.conversionQty || '')}</td>` +
                        `<td>${escapeHtml(item.deptUnit || '')}</td>` +
                        '</tr>';
            });
        }
        html += '</tbody></table></div>';
        body.innerHTML = html;
    }

    function escapeHtml(str) {
        return String(str).replace(/[&<>"']/g, function (m) {
            return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[m];
        });
    }
});

// 1. Lấy ra checkbox "Chọn tất cả" và danh sách các checkbox "con"
    let checkAll = document.getElementById('checkAll');
    document.addEventListener('change', function(e) {
    
    if (e.target && e.target.id === 'checkAll') {
            let checkboxes = document.querySelectorAll('.item');
        checkboxes.forEach(cb => {
            cb.checked = e.target.checked;
        });
    }

    if (e.target && e.target.classList.contains('item')) {
            let allItems = document.querySelectorAll('.item');
        let checkedItems = document.querySelectorAll('.item:checked');
        
        // Nếu số lượng checkbox đang chọn bằng tổng số checkbox -> Check nút đầu bảng
        checkAll.checked = (allItems.length === checkedItems.length);
        
        // Trạng thái lửng lơ (Gạch ngang) nếu chỉ chọn một vài ô
        checkAll.indeterminate = (checkedItems.length > 0 && checkedItems.length < allItems.length);
    }

});
</script>

