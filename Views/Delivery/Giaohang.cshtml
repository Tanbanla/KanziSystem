<div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title text-primary" id="updateModalLabel">
                    <i class="fa-solid fa fa-pen-to-square me-1"></i> Cập nhật Tiến độ PO: <span id="modalPoNumber"></span>
                </h5>
                <button type="button" class="btn-close btn" data-bs-dismiss="modal" aria-label="Close">x</button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2 mb-3 fs-7">
                    <strong>Mặt hàng:</strong> <span id="modalItemName"></span> (<span id="modalItemCode"></span>) <br>
                    <strong>Ngày YC giao trên PO:</strong> <span class="text-danger fw-bold" id="modalReqDate"></span>
                </div>

                <form id="updateForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">1. Ngày gửi PO cho NCC</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-regular fa fa-calendar"></i></span>
                            <input type="date" id="modalSendPoDate" class="form-control" placeholder="Chọn ngày gửi PO">
                        </div>
                        <div class="form-text text-muted">Hệ thống sẽ mail nhắc nhở PIC PUR sau 2 ngày phát hành nếu bỏ trống.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">2. Ngày NCC xác nhận giao (Dự kiến)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-regular fa fa-calendar-check"></i></span>
                            <input type="date" id="modalConfirmDate" class="form-control" placeholder="Chọn ngày NCC cam kết giao">
                        </div>
                        <div class="form-text text-muted">Sau 5 ngày gửi PO nếu chưa nhập, hệ thống sẽ gửi mail cảnh báo.</div>
                    </div>

                    <hr>

                    <div class="mb-3 p-3 bg-light rounded border border-warning">
                        <label class="form-label fw-bold text-warning-emphasis d-block mb-2">
                            <i class="fa-solid fa-users-gear me-1"></i> Dành cho Phòng ban yêu cầu (PR1-MC / User RQ)
                        </label>
                        <label class="form-label fw-semibold">Xác nhận ảnh hưởng tới sản xuất:</label>
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="flexRadioImpact" id="radioNo" value="No">
                                <label class="form-check-label text-success fw-bold" for="radioNo">Không ảnh hưởng (No)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="flexRadioImpact" id="radioYes" value="Yes">
                                <label class="form-check-label text-danger fw-bold" for="radioYes">Có ảnh hưởng (Yes)</label>
                            </div>
                        </div>
                        <div class="form-text text-danger mt-1">Lưu ý: Nếu chọn "Yes", cảnh báo sẽ duy trì liên tục trên hệ thống cho tới khi hàng về kho.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" id="btnSaveInfo" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thông tin
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="officialModal" tabindex="-1" aria-labelledby="officialModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-success">
            <div class="modal-header text-success">
                <h5 class="modal-title fw-bold" id="officialModalLabel">
                    <i class="fa-solid ion-android-checkbox me-1 "></i> Nhập nhận hàng thực tế PO: <span id="offPoNumber"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white btn" data-bs-dismiss="modal" aria-label="Close"> x</button>
            </div>
            <div class="modal-body">
                <div class="alert alert-success py-2 mb-3 fs-7">
                    <strong>Mặt hàng:</strong> <span id="offItemName"></span> (<span id="offItemCode"></span>) <br>
                    <strong>Ngày YC giao trên PO:</strong> <span class="fw-bold text-dark" id="offReqDate"></span>
                </div>

                <form id="officialForm">
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold text-dark">Ngày giao hàng chính thức</label>
                            <input type="date" id="modalActualDate" class="form-control border-success" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold text-dark">Giờ giao hàng</label>
                            <input type="time" id="modalActualTime" class="form-control border-success">
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold text-dark">Cửa giao hàng</label>
                            <select class="form-control" style="padding: 5px 12px">
                                <option>F1</option>
                                <option>F2</option>
                                <option>F3</option>
                                <option>F4</option>
                                <option>F5</option>
                                <option>F6</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold text-dark">Kho nhận hàng</label>
                            <select class="form-control" style="padding: 5px 12px">
                                <option>Kho F1</option>
                                <option>Kho F2</option>
                                <option>Kho F3</option>                             
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" id="btnSaveOfficial" class="btn btn-success fw-bold">
                    <i class="fa-solid fa-circle-check me-1"></i> Hoàn thành nhận hàng
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // --- KHỞI TẠO MODAL 1: DỰ KIẾN ---
        const estModalEl = document.getElementById('updateModal');
        let bsEstModal = null;
        if (estModalEl) {
            document.body.appendChild(estModalEl);
            bsEstModal = new bootstrap.Modal(estModalEl, { backdrop: true, focus: true });

            estModalEl.querySelectorAll('[data-bs-dismiss="modal"]').forEach(btn => {
                btn.addEventListener('click', function () {
                    if (bsEstModal) bsEstModal.hide();
                });
            });
        }

        // --- KHỞI TẠO MODAL 2: CHÍNH THỨC ---
        const offModalEl = document.getElementById('officialModal');
        let bsOffModal = null;
        if (offModalEl) {
            document.body.appendChild(offModalEl);
            bsOffModal = new bootstrap.Modal(offModalEl, { backdrop: true, focus: true });

            offModalEl.querySelectorAll('[data-bs-dismiss="modal"]').forEach(btn => {
                btn.addEventListener('click', function () {
                    if (bsOffModal) bsOffModal.hide();
                });
            });
        }

        // Hàm phụ trợ xử lý định dạng chuỗi ngày tháng
        function convertToDateInputValue(dateStr) {
            if (!dateStr || dateStr.trim() === "") return "";
            const months = {
                'jan': '01', 'feb': '02', 'mar': '03', 'apr': '04', 'may': '05', 'jun': '06',
                'jul': '07', 'aug': '08', 'sep': '09', 'oct': '10', 'nov': '11', 'dec': '12'
            };
            const parts = dateStr.split('-');
            if (parts.length !== 3) return "";
            const day = parts[0].padStart(2, '0');
            const monthStr = parts[1].toLowerCase();
            const month = months[monthStr] || '01';
            const year = parts[2];
            return `${year}-${month}-${day}`;
        }

        // --- LOGIC EVENT: NÚT NHẬP DỰ KIẾN ---
        const estButtons = document.querySelectorAll('.btn-update-po');
        estButtons.forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();

                const poNumber = this.getAttribute('data-po') || '';
                const itemName = this.getAttribute('data-item-name') || '';
                const itemCode = this.getAttribute('data-item-code') || '';
                const reqDate = this.getAttribute('data-req-date') || '';
                const sendDate = this.getAttribute('data-send-date') || '';
                const confirmDate = this.getAttribute('data-confirm-date') || '';
                const impact = this.getAttribute('data-impact') || '';

                document.getElementById('modalPoNumber').textContent = poNumber;
                document.getElementById('modalItemName').textContent = itemName;
                document.getElementById('modalItemCode').textContent = itemCode;
                document.getElementById('modalReqDate').textContent = reqDate;

                const inputSendDate = document.getElementById('modalSendPoDate');
                if (sendDate && sendDate.trim() !== "") {
                    inputSendDate.value = convertToDateInputValue(sendDate);
                    inputSendDate.classList.add('bg-light');
                } else {
                    inputSendDate.value = "";
                    inputSendDate.classList.remove('bg-light');
                }

                const inputConfirmDate = document.getElementById('modalConfirmDate');
                if (confirmDate && confirmDate.trim() !== "") {
                    inputConfirmDate.value = convertToDateInputValue(confirmDate);
                    inputConfirmDate.classList.add('bg-light');
                } else {
                    inputConfirmDate.value = "";
                    inputConfirmDate.classList.remove('bg-light');
                }

                const radioYes = document.getElementById('radioYes');
                const radioNo = document.getElementById('radioNo');
                const radioInputs = document.querySelectorAll('input[name="flexRadioImpact"]');

                if (impact === "Yes") {
                    radioYes.checked = true;
                    radioInputs.forEach(radio => radio.disabled = true);
                } else if (impact === "No") {
                    radioNo.checked = true;
                    radioInputs.forEach(radio => radio.disabled = true);
                } else {
                    radioNo.checked = true;
                    radioInputs.forEach(radio => radio.disabled = false);
                }

                const btnSave = document.getElementById('btnSaveInfo');
                if (sendDate && sendDate.trim() !== "" && confirmDate && confirmDate.trim() !== "" && (impact === "Yes" || impact === "No")) {
                    btnSave.style.display = 'none';
                } else {
                    btnSave.style.display = 'block';
                }

                if (bsEstModal) bsEstModal.show();
            });
        });

        // --- LOGIC EVENT: NÚT NHẬP CHÍNH THỨC ---
        const offButtons = document.querySelectorAll('.btn-official-po');
        offButtons.forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();

                const poNumber = this.getAttribute('data-po') || '';
                const itemName = this.getAttribute('data-item-name') || '';
                const itemCode = this.getAttribute('data-item-code') || '';
                const reqDate = this.getAttribute('data-req-date') || '';

                document.getElementById('offPoNumber').textContent = poNumber;
                document.getElementById('offItemName').textContent = itemName;
                document.getElementById('offItemCode').textContent = itemCode;
                document.getElementById('offReqDate').textContent = reqDate;

                // Xóa form cũ trước khi hiển thị
                document.getElementById('officialForm').reset();

                if (bsOffModal) bsOffModal.show();
            });
        });

        // --- LOGIC EVENT: LƯU MODAL DỰ KIẾN ---
        const btnSaveInfo = document.getElementById('btnSaveInfo');
        if (btnSaveInfo) {
            btnSaveInfo.addEventListener('click', function() {
                alert('Lưu dữ liệu thành công! Hệ thống sẽ tự động tính toán OK/NG và kích hoạt luồng Mail.');
                if (bsEstModal) bsEstModal.hide();
            });
        }

        // --- LOGIC EVENT: LƯU MODAL CHÍNH THỨC ---
        const btnSaveOfficial = document.getElementById('btnSaveOfficial');
        if (btnSaveOfficial) {
            btnSaveOfficial.addEventListener('click', function() {
                const actualDate = document.getElementById('modalActualDate').value;
                const warehouse = document.getElementById('modalWarehouse').value;

                if (!actualDate || !warehouse) {
                    alert("Vui lòng nhập Ngày nhận hàng thực tế và Chọn kho nhận hàng!");
                    return;
                }

                alert("Xác nhận nhập kho hàng thành công! Trạng thái đơn hàng sẽ được lưu chính thức.");
                if (bsOffModal) bsOffModal.hide();
            });
        }

        // --- RESET FORM KHI ĐÓNG MODAL DỰ KIẾN ---
        if (estModalEl) {
            estModalEl.addEventListener('hidden.bs.modal', function () {
                document.getElementById('updateForm').reset();
                document.getElementById('modalSendPoDate').classList.remove('bg-light');
                document.getElementById('modalConfirmDate').classList.remove('bg-light');
                document.querySelectorAll('input[name="flexRadioImpact"]').forEach(radio => {
                    radio.disabled = false;
                });
                document.getElementById('btnSaveInfo').style.display = 'block';
            });
        }
    });
</script>
