
@using PRJ_WAREHOUSE_BIVN.Language
@{
    ViewData["Title"] = "Quản lý nhận hàng";
}

<style>
    body {
        background-color: #f8f9fa;
        font-size: 14px;
    }

    .input-group-text, select.form-control:not([size]):not([multiple]), .form-control:not(.form-control-sm):not(.form-control-lg) {
        font-size: 13px;
        padding: 15px 12px;
        height: 38px;
    }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .table th {
        background-color: #e9ecef;
        position: sticky;
        top: 0;
        z-index: 1;
        vertical-align: middle;
    }

    .bg-pur {
        background-color: #e2f0d9 !important;
    }

    .badge-ng {
        background-color: #ff0000;
        color: white;
    }

    .badge-ok {
        background-color: #28a745;
        color: white;
    }

    .row-alert-yes {
        background-color: #fce8e6;
    }

    /* Đảm bảo khoảng cách nhỏ giữa 2 nút trong ô hành động */
    .btn-action-gap {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
</style>

