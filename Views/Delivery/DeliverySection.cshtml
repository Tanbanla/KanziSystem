@using PRJ_WAREHOUSE_BIVN.Language
@{
    ViewData["Title"] = "Xác nhận hàng về kho phòng ban";
}


<script type="text/javascript" src="~/scripts/delivery.js"></script>

<style>
    .card .card-header .form-control {
        height: 42px;
        font-size: 13px;
        border-radius: 2px;
    }

    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(5px);
        align-items: center;
        justify-content: center;
    }

    .modal-content {
        background-color: #fff;
        padding: 0;
        border-radius: 12px;
        width: 400px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        animation: slideDown 0.3s ease-out;
    }

    .modal-header {
        padding: 15px 20px;
        border-bottom: 1px solid #eee;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-body {
        padding: 20px;
        color: #444;
        line-height: 1.6;
    }

    .modal-footer {
        padding: 15px 20px;
        border-top: 1px solid #eee;
        text-align: right;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .btn-open {
        padding: 10px 20px;
        cursor: pointer;
        background: #007bff;
        color: #fff;
        border: none;
        border-radius: 5px;
    }

    .btn-primary {
        background: #007bff;
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
    }

    .btn-secondary {
        background: #e0e0e0;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        cursor: pointer;
    }

    .close-btn {
        font-size: 24px;
        cursor: pointer;
        color: #888;
    }

        .close-btn:hover {
            color: #000;
        }

    .table-responsive {
        max-height: 400px;
        overflow-y: auto;
        border: 1px solid #ddd;
    }

    .table-responsive {
        max-height: 400px;
        overflow-y: auto;
        position: relative;
    }

        .table-responsive table thead th {
            position: sticky;
            top: 0;
            background-color: #ffffff;
            z-index: 10;
            border-bottom: 2px solid #dee2e6;
            box-shadow: 0 2px 2px -1px rgba(0,0,0,0.1);
        }

        .table-responsive table tbody td {
            position: relative;
            z-index: 1;
        }
</style>
<div class="row">
    <div class="col-12">
        <div class="card card-primary">
            <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer" id="table-1_wrapper">
                <div class="table-responsive">                   
                        <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                            <table class="table table-bordered">
                                <thead class="bg-primary">
                                    <tr>
                                        <th>@Languages.xacnhannhapkho</th>
                                        <th>@Languages.Mahethong</th>
                                        <th>@Languages.Duoctachtu</th>
                                        <th>@Languages.Bennhaptruoc</th>
                                        <th>@Languages.Sopo</th>
                                        <th>@Languages.Mahang</th>
                                        <th>@Languages.Mahang</th>
                                        <th>@Languages.TenhangTA</th>
                                        <th>@Languages.TenhangTV </th>
                                        <th>@Languages.soluongdathang</th>
                                        <th>@Languages.Luongthucte</th>
                                        <th>@Languages.Luonglamthutuc</th>
                                        <th>@Languages.Ngaynhapkho</th>
                                        <th>@Languages.Nguoinhapkho</th>
                                        <th>@Languages.Donvi</th>
                                        <th>@Languages.Dongiauoctinh</th>
                                        <th>@Languages.Dieukiengiaohang</th>
                                        <th>@Languages.Diadiemgiaohang</th>
                                        <th>@Languages.Phuongthucvanchuyen</th>
                                        <th>@Languages.Sotien</th>
                                        <th>@Languages.vat</th>
                                        <th>@Languages.phongbanyeucau</th>
                                        <th>@Languages.tenphongyeucau</th>
                                        <th>@Languages.ngaygiaohangdukien</th>
                                        <th>@Languages.noigiaohangdukien</th>
                                        <th>@Languages.thoihanthanhtoan</th>
                                        <th>@Languages.loaitien</th>
                                        <th>@Languages.tygia</th>
                                        <th>@Languages.doisangusd</th>
                                        <th>@Languages.danhmuc</th>
                                        <th>@Languages.thuocdonyeucau</th>
                                        <th>@Languages.tinhtrangtokhai</th>
                                        <th>@Languages.nhacungcap</th>
                                        <th>@Languages.Idlichsu</th>
                                        <th>@Languages.luongvekho</th>
                                        <th>Invoice</th>
                                        <th>@Languages.tinhtranghaiquan</th>
                                    </tr>
                                </thead>
                                <tbody id="show_apply" style="color:black;"></tbody>
                            </table>
                            <ul class="pagination" id="pagination-controls"></ul>
                        </div>
                   
                </div>
            </div>
        </div>
    </div>

</div>