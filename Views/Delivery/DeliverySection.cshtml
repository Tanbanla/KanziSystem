<style>
    /* Hiệu ứng cuộn cho bảng */
    .table-wrapper {
        width: 100%;
        overflow-x: auto; /* Cho phép cuộn ngang */
        border: 1px solid #ddd;
        border-radius: 4px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        min-width: 3000px; /* Ép bảng rộng ra để chứa 30+ cột */
        font-size: 13px;
    }

    th, td {
        padding: 12px 15px;
        text-align: left;
        border-bottom: 1px solid #eee;
        white-space: nowrap; /* Ngăn dòng bị ngắt để bảng gọn gàng */
    }

    /* Header trang trí */
    thead th {
        color: #333;
        font-weight: 600;
        position: sticky;
        top: 0;
        border-bottom: 2px solid #3498db;
    }

    /* Cố định cột quan trọng */
    .sticky-col {
        position: sticky;
        left: 0;
        background-color: #fff;
        z-index: 1;
        border-right: 2px solid #ddd;
    }

    thead th.sticky-col {
        background-color: #f8f9fa;
        z-index: 2;
    }

    /* Màu dòng khi di chuột qua */
    tbody tr:hover {
        background-color: #f1f8ff;
    }

    /* Trạng thái Label */
    .status {
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: bold;
    }

    .status-done {
        background-color: #d4edda;
        color: #155724;
    }

    .status-pending {
        background-color: #fff3cd;
        color: #856404;
    }
    /* Khung chứa bảng có thanh cuộn */
    .table-container {
        width: 100%;
        max-height: 500px; /* Giới hạn chiều cao nếu muốn cuộn dọc luôn */
        overflow: auto; /* Tự động hiện thanh cuộn ngang/dọc */
        border: 1px solid #ddd;
    }

    table {
        border-collapse: separate; /* Quan trọng để sticky hoạt động chuẩn */
        border-spacing: 0;
        width: max-content; /* Ép bảng rộng theo nội dung cột */
    }


    /* 1. Cố định Header khi cuộn dọc */
    thead th {
        position: sticky;
        top: 0;
        z-index: 10;
    }

    /* 2. Cố định Cột bên trái khi cuộn ngang */
    .sticky-left {
        position: sticky;
        left: 0;
        z-index: 5;
        background: #fff;
        box-shadow: 2px 0 5px rgba(0,0,0,0.05); /* Tạo hiệu ứng tách biệt */
    }

    /* 3. Cố định Cột bên phải (Ví dụ: Trạng thái hoặc Nút sửa) */
    .sticky-right {
        position: sticky;
        right: 0;
        z-index: 5;
        background: #fff;
        box-shadow: -2px 0 5px rgba(0,0,0,0.05);
    }

    /* Xử lý z-index cho ô giao nhau giữa Header và Cột cố định */
    thead th.sticky-left,
    thead th.sticky-right {
        z-index: 15;
    }

    /* Hiệu ứng hover để dễ theo dõi dòng */
    tbody tr:hover td {
        background-color: #f1f7ff;
    }
</style>
