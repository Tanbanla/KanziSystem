<script>
    function toggleRow(id) {
        var element = document.getElementById(id);
        if (element.style.display === "none") {
            element.style.display = "table-row";
        } else {
            element.style.display = "none";
        }
    }
    function _giaohang(){
       alert("Giao hàng thành công !");
