@using PRJ_WAREHOUSE_BIVN.DTO
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    // Expect the model to provide lists similar to other Quote pages for consistency
    List<DEPARTMENTDTO> nhomViTri = Model?.DanhSachNhomViTri ?? new List<DEPARTMENTDTO>();
    List<MATERIALDTO> materials = Model?.DanhSachVatTu ?? new List<MATERIALDTO>();
    List<IM_NCC_NEWDTO> suppliers = Model?.DanhSachNhaCungCap ?? new List<IM_NCC_NEWDTO>();
    List<string> maDons = Model?.DanhSachMaDon ?? new List<string>();
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
    <link rel="stylesheet" href="~/css/Quotation_Results.css" />
    <link rel="stylesheet" href="~/css/SelectQuoteSection.css" />
</head>
<!-- Global loading overlay -->
<div id="globalLoading" aria-hidden="true">
    <div class="loader-box">
        <div class="spinner" aria-hidden="true"></div>
        <div class="loader-msg">Đang xử lý...</div>
    </div>
</div>
<!-- Detail modal -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #fff9e1; border-bottom: 2px solid #dee2e6; color: #000;">
                <div class="w-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="modal-title fw-bold" id="detailModalTitle" style="color: #000;">
                            @Localizer["DetailModalTitle"] - <span id="madonhang" class="text-primary"></span>
                        </h4>
                        <button type="button" class="btn btn-link p-1" onclick="hideEditModal()" aria-label="@Localizer["Close"]">
                            <i class="fas fa-times fa-lg"></i>
                        </button>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <span class="fw-bold" style="color: #000;">@Localizer["ReceivingDepartmentLabel"]</span>
                            <span id="khoi" class="bg-white px-3 py-1 rounded border" style="color: #000;"></span>
                        </div>
                        <div class="col-md-6 text-end">
                            <span class="badge bg-warning text-dark p-2" id="urgent-badge" style="display:none;">
                                <i class="ion ion-alert-circled"></i> @Localizer["UrgentBadgeText"]
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-body p-3" style="background-color: #fff; color: #000;">
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm mb-0" style="background-color: #fff; color: #000;">
                                <tr>
                                    <td class="fw-bold bg-light" style="width: 15%;">@Localizer["DeptCostCenterLabel"]</td>
                                    <td style="width: 18%; background-color: #fff9e1;" id="mpb_yc"></td>
                                    <td class="fw-bold bg-light" style="width: 15%;">@Localizer["DeptNameLabel"]</td>
                                    <td style="width: 19%; background-color: #fff9e1;" id="tenphongban"></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold bg-light">@Localizer["RequestDateLabel"]</td>
                                    <td style="background-color: #fff9e1;" id="nyc"></td>
                                    <td class="fw-bold bg-light">@Localizer["DesiredDeadlineLabel"]</td>
                                    <td style="background-color: #fff9e1;" id="thmm"></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col-12">
                        <h5 class="fw-bold" style="color: #0d6efd; border-bottom: 2px solid #0d6efd; padding-bottom: 5px;">
                            <i class="ion ion-clipboard"></i> @Localizer["GoodsDetailTitle"]
                        </h5>
                    </div>
                </div>

                <div class="table-responsive-fixed">
                    <table class="table table-bordered table-hover align-middle" id="detailTable" style="font-size: 13px; background-color:#fff; color:#000;">
                        <thead>
                            <tr class="text-center align-middle" style="background-color: #e9ecef; color:#000;">
                                <th rowspan="2" style="width: 40px; background-color: #dee2e6; color:#000;">@Localizer["STT"]</th>
                                <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["SystemCode"]</th>
                                <th rowspan="2" style="min-width: 150px; background-color: #dee2e6; color:#000;">@Localizer["InternalMaterialCodeShort"]</th>
                                <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["Category"]</th>
                                <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["Classification"]</th>
                                <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["SupplierItemCode"]</th>
                                <th rowspan="2" style="min-width: 200px; background-color: #dee2e6; color:#000;">@Localizer["ItemNameVNEN"]</th>
                                <th rowspan="2" style="min-width: 80px; background-color: #dee2e6; color:#000;">@Localizer["QuantityShort"]</th>
                                <th rowspan="2" style="min-width: 70px;background-color: #dee2e6; color:#000;">@Localizer["UnitShort"]</th>
                                <th colspan="6" style="background-color: #d3d9e5; color:#000;">@Localizer["DescriptionGroup"]</th>
                                <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["DesignFile"]</th>
                                <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["Manufacturer"]</th>
                                <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["VendorCode"]</th>
                                <th rowspan="2" style="min-width: 150px; background-color: #dee2e6; color:#000;">@Localizer["Supplier"]</th>
                                <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["ROHSRequirement"]</th>
                                <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["COCQRequirement"]</th>
                                <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["MSDSRequirement"]</th>
                                <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["SafetyStandardRequirement"]</th>
                                <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["SupplierSelectionDeadline"]</th>
                                <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["UrgentShort"]</th>
                                <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["GetQuotation"]</th>
                                <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["Reason"]</th>
                                @* Vendor input columns *@
                                <th rowspan="2" class="vendor-column" style="min-width: 80px;">@Localizer["Supplier"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 150px;">@Localizer["SupplierName"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 100px;">@Localizer["SupplierItemCode"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 120px;">@Localizer["CustomsItemName"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 80px;">@Localizer["EnglishName"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 60px;">@Localizer["Quantity"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 50px;">@Localizer["Unit"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 60px;">@Localizer["PriceUSD"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 60px;">@Localizer["PriceVND"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 60px;">@Localizer["MOQ"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 60px;">@Localizer["LeadTime"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 80px;">@Localizer["DeliveryDate"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 50px;">@Localizer["Rohs"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 50px;">@Localizer["COCQ"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 50px;">@Localizer["MSDS"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 50px;">@Localizer["Safety"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 50px;">@Localizer["CommitRequirement"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 80px;">@Localizer["DeliveryMethod"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 80px;">@Localizer["PaymentTerms"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 120px;">@Localizer["Attachment"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 70px;">@Localizer["ApplyDay"]</th>
                                <th rowspan="2" class="vendor-column" style="min-width: 70px;">@Localizer["DueDay"]</th>

                                @* Approval columns *@
                                <th rowspan="2" class="approval-column" style="min-width: 70px;">@Localizer["SystemCalculatedTotal"]</th>
                                <th rowspan="2" class="approval-column" style="min-width: 70px;">@Localizer["SupplierSelection"]</th>
                                <th rowspan="2" class="approval-column" style="min-width: 70px;">@Localizer["SelectionReason"]</th>
                                <th rowspan="2" style="min-width: 100px;background-color: #E1FAFD;"> @Localizer["PriceIncreaseReason"] </th>

                                @* Approval user *@
                                <th colspan="9" class="approval-column" style="min-width: 70px;">Approval</th>
   
                            <tr class="text-center align-middle" style="background-color: #e9ecef; color:#000;">
                                <th style="min-width: 80px; color:#000;">@Localizer["ShapeShort"]</th>
                                <th style="min-width: 80px; color:#000;">@Localizer["MaterialShort"]</th>
                                <th style="min-width: 100px; color:#000;">@Localizer["CompositionShort"]</th>
                                <th style="min-width: 100px; color:#000;">@Localizer["DimensionsShort"]</th>
                                <th style="min-width: 120px; color:#000;">@Localizer["UsedPositionShort"]</th>
                                <th style="min-width: 150px; color:#000;">@Localizer["PurposeFeatureShort"]</th>

                                <th style="min-width: 80px; color:#000;">@Localizer["PrimaryManager"]</th>
                                <th style="min-width: 80px; color:#000;">@Localizer["Result"]</th>
                                <th style="min-width: 100px; color:#000;">@Localizer["Reason"]</th>
                                <th style="min-width: 80px; color:#000;">@Localizer["MiddleManager"]</th>
                                <th style="min-width: 80px; color:#000;">@Localizer["Result"]</th>
                                <th style="min-width: 100px; color:#000;">@Localizer["Reason"]</th>
                                <th style="min-width: 80px; color:#000;">@Localizer["DepartmentHead"]</th>
                                <th style="min-width: 80px; color:#000;">@Localizer["Result"]</th>
                                <th style="min-width: 100px; color:#000;">@Localizer["Reason"]</th>
                            </tr>
                        </thead>
                        <tbody id="detailModalBody">
                            <tr class="text-center">
                                <td colspan="100" class="text-muted py-4" style="color:#000; background-color:#fff;">
                                    <i class="ion ion-load-c ion-spin"></i> @Localizer["LoadingData"]
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="row mt-4">
                    <div class="col-md-8">
                        <div class="card border" style="background-color:#fff; color:#000;">
                            <div class="card-header bg-light py-2">
                                <strong>@Localizer["ApprovalFlowTitle"]</strong>
                            </div>
                            <div class="card-body p-2" style="font-size: 11px; background-color: #f8f9fa; color:#000;">
                                <p class="mb-1">@Localizer["ApprovalFlowLine1"]</p>
                                <p class="mb-1">@Localizer["ApprovalFlowLine2"]</p>
                                <p class="mb-1">@Localizer["ApprovalFlowLine3"]</p>
                                <p class="mb-0 text-primary">@Localizer["ApprovalFlowLine4"]</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border" style="background-color:#fff; color:#000;">
                            <div class="card-header bg-light py-2">
                                <strong>@Localizer["AdditionalInfoTitle"]</strong>
                            </div>
                            <div class="card-body p-2">
                                <table class="table table-sm table-borderless mb-0">
                                    <tr>
                                        <td class="fw-bold p-1">@Localizer["RequesterLabel"]</td>
                                        <td class="p-1" id="requester">-</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer" style="background-color: #f8f9fa; border-top: 1px solid #dee2e6; color:#000;">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <div>
                        <span class="text-muted" id="request-info" style="color:#000;">
                            <i class="ion ion-document-text"></i> @Localizer["FooterID"] <span id="id_request"></span> |
                            @Localizer["FooterStep"] <span id="step"></span> |
                            @Localizer["FooterRegency"] <span id="regency"></span>
                        </span>
                    </div>
                    <div>
                        <button type="button" class="btn btn-secondary" onclick="hideEditModal()">
                            <i class="ion ion-android-close"></i> @Localizer["CloseButton"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid" id="select-quote-section">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-primary">@Localizer["HeaderTitle"]</h4>
            @* <small class="text-muted">@Localizer["HeaderSubtitle"]</small> *@
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white py-2">
            <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["Filters"]</h6>
        </div>
        <div class="card-body pt-3 pb-2">
            <form id="filterForm" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-uppercase fw-semibold">@Localizer["DepartmentCode"]</label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchPhongBan searchable-select">
                        <option value="" selected>@Localizer["SelectDepartment"]</option>
                        @foreach (var s in nhomViTri)
                        {
                            <option value="@s.Cost_Center">@s.Cost_Center - @s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-uppercase fw-semibold">@Localizer["OrderCode"]</label>
                    <select id="searchMaDon" name="searchMaDon" class="form-select searchable-select">
                        <option value="" selected>@Localizer["SelectOrderCode"]</option>
                        @foreach (var s in maDons)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-uppercase fw-semibold">@Localizer["InternalMaterialCode"]</label>
                    <select id="searchMaterial" name="searchMaterial" class="form-select searchMaterial searchable-select" data-remote="true" data-api="/Material/SearchMaterialView" data-page-size="500">
                        <option value="" selected>@Localizer["SelectInternalMaterialCode"]</option>
                        @foreach (var m in materials)
                        {
                            <option value="@m.Material_Code">@m.Material_Code - @m.Material_Name_VN</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-uppercase fw-semibold">@Localizer["Supplier"]</label>
                    <select id="searchSupplier" name="searchSupplier" class="form-select searchable-select">
                        <option value="" selected>@Localizer["SelectSupplier"]</option>
                        @foreach (var n in suppliers)
                        {
                            <option value="@n.Ma">@n.Ma - @n.Ten</option>
                        }
                    </select>
                </div>
                <div class="col-12 d-flex gap-2 mt-2">
                    <button type="button" id="btnSearch" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> @Localizer["Search"]</button>
                    <div style="min-width: 6px;"></div>
                    <button type="button" id="btnExportExcel" class="btn btn-outline-success btn-sm"><i class="fas fa-download"></i> @Localizer["ExportFile"]</button>
                    <div style="min-width: 6px;"></div>
                    <button type="button" id="btnClear" class="btn btn-outline-secondary btn-sm"><i class="fas fa-eraser"></i> @Localizer["ClearFilters"]</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["SectionRequestList"]</h6>
            <small class="text-muted" id="summaryText">@Localizer["SummaryRecords", "0"].Value</small>
        </div>
        <div class="card-body p-0">
            <ul class="nav nav-tabs px-3 pt-3 quote-tabs" id="quoteTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-active-quotes" type="button" role="tab" aria-controls="pane-active-quotes" aria-selected="true" data-tab="active">
                        <i class="fas fa-check-circle text-success"></i>
                        <span>@Localizer["ActiveQuotesTab"]</span>
                        <span class="badge bg-success quote-tab-count" id="countActiveTab">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-all-quotes" type="button" role="tab" aria-controls="pane-all-quotes" aria-selected="false" data-tab="all">
                        <i class="fas fa-list text-primary"></i>
                        <span>@Localizer["AllQuotesTab"]</span>
                        <span class="badge bg-primary quote-tab-count" id="countAllTab">0</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="quoteTabsContent">
                <div class="tab-pane fade show active" id="pane-active-quotes" role="tabpanel" aria-labelledby="tab-active-quotes" tabindex="0">
                    <div class="table-wrap">
                        <table class="table table-sm table-hover table-bordered align-middle mb-0" id="sectionRequestTableActive">
                            <thead class="table-header-custom">
                                <tr class="text-center align-middle">
                                    <th style="width:40px"><input type="checkbox" id="selectAllActive" class="select-all" data-tab="active" title="@Localizer["SelectAll"]" /></th>
                                    <th style="min-width:120px">@Localizer["OrderCode"]</th>
                                    <th style="min-width:160px">@Localizer["InternalMaterialCode"]</th>
                                    <th style="min-width:220px">@Localizer["ItemName"]</th>
                                    <th style="min-width:140px">@Localizer["EnglishName"]</th>
                                    <th style="min-width:180px">@Localizer["Supplier"]</th>
                                    <th style="min-width:120px">@Localizer["Price"]</th>
                                    <th style="min-width:130px">@Localizer["ExpiryDate"]</th>
                                    <th style="min-width:130px">@Localizer["Status"]</th>
                                    <th style="min-width:90px">@Localizer["Action"]</th>
                                </tr>
                            </thead>
                            <tbody id="sectionRequestBodyActive"></tbody>
                        </table>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <label class="small mb-0">@Localizer["PageSize"].Value</label>
                            <div style="padding: 3px;"></div>
                            <select id="sectionPageSizeSelectActive" class="form-select form-select-sm" style="width:120px">
                                <option value="10">10</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="small text-muted" id="sectionPageInfoActive">&nbsp;</div>
                            <div style="padding: 3px;"></div>
                            <div id="sectionPaginationActive" class="btn-group" role="group" aria-label="pagination"></div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="pane-all-quotes" role="tabpanel" aria-labelledby="tab-all-quotes" tabindex="0">
                    <div class="table-wrap">
                        <table class="table table-sm table-hover table-bordered align-middle mb-0" id="sectionRequestTableAll">
                            <thead class="table-header-custom">
                                <tr class="text-center align-middle">
                                    <th style="width:40px"><input type="checkbox" id="selectAllAll" class="select-all" data-tab="all" title="@Localizer["SelectAll"]" /></th>
                                    <th style="min-width:140px">@Localizer["OrderCode"]</th>
                                    <th style="min-width:140px">@Localizer["RequestSection"]</th>
                                    <th style="min-width:140px">@Localizer["InternalMaterialCode"]</th>
                                    <th style="min-width:240px">@Localizer["ItemName"]</th>
                                    <th style="min-width:100px" class="text-start">@Localizer["EnglishName"]</th>
                                    <th style="min-width:90px">@Localizer["Unit"]</th>
                                    <th style="min-width:140px">@Localizer["RequesterLabel"]</th>
                                    <th style="min-width:160px">@Localizer["DesiredReceiveDate"]</th>
                                    <th style="min-width:110px">@Localizer["Status"]</th>
                                    <th style="min-width:90px">@Localizer["Action"]</th>
                                </tr>
                            </thead>
                            <tbody id="sectionRequestBodyAll"></tbody>
                        </table>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <label class="small mb-0">@Localizer["PageSize"].Value</label>
                            <div style="padding: 3px;"></div>
                            <select id="sectionPageSizeSelectAll" class="form-select form-select-sm" style="width:120px">
                                <option value="10">10</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <div class="small text-muted"id="sectionPageInfoAll">&nbsp;</div>
                            <div style="padding: 3px;"></div>
                            <div id="sectionPaginationAll" class="btn-group" role="group" aria-label="pagination"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Custom dialog root -->
<div id="cmDialogOverlay" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmDialogTitle">
        <div class="cm-dialog-header">
            <h6 id="cmDialogTitle" class="cm-dialog-title">@Localizer["Notification"]</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="close" aria-label="@Localizer["Close"]">✕</button>
        </div>
        <div id="cmDialogBody" class="cm-dialog-body"></div>
        <div id="cmDialogFooter" class="cm-dialog-footer"></div>
    </div>
    <div class="cm-dialog-backdrop" data-cm-action="overlay"></div>
</div>
@section Scripts {
    <script src="~/js/common/searchable-dropdown.js" asp-append-version="true"></script>
    <script>
        window.i18nSelectQuote = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
