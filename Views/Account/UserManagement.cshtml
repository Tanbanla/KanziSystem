@model PRJ_WAREHOUSE_BIVN.View_Models.Login.UserManagerModel
@using System.Text.Json
@using PRJ_WAREHOUSE_BIVN.DTO
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = @Localizer["Title"];
    var roles = Model?.Roles?.Where(x => x.IsActive).ToList() ?? new List<BaoGia_WorkflowRoleDTO>();
}
<head>
    <link rel="stylesheet" href="~/css/UserManagement.css" asp-append-version="true" />
</head>

<div class="section user-management">
    <div class="section-header page-header p-4 mb-4">
        <div>
            <h1 class="mb-1 text-white"><i class="fas fa-users-cog mr-2"></i>@Localizer["Title"]</h1>
            <p class="mb-0 text-white-50">@Localizer["Subtitle"]</p>
        </div>
    </div>

    <div id="userAlert" class="alert d-none" role="alert"></div>
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
                <h5 class="mb-2 mb-md-0"><i class="fas fa-filter text-primary mr-2"></i>@Localizer["SearchFilters"]</h5>
                <button type="button" class="btn btn-primary" id="addUserButton"><i class="fas fa-user-plus mr-1"></i>@Localizer["AddUser"]</button>
            </div>
            <form id="searchForm" class="row">
                <div class="form-group col-lg-3 col-md-6"><label for="searchAdid">ADID</label><input id="searchAdid" class="form-control" placeholder="@Localizer["EnterAdid"]"></div>
                <div class="form-group col-lg-3 col-md-6"><label for="searchName">@Localizer["FullName"]</label><input id="searchName" class="form-control" placeholder="@Localizer["EnterFullName"]"></div>
                <div class="form-group col-lg-2 col-md-6"><label for="searchSection">@Localizer["Department"]</label><input id="searchSection" class="form-control" placeholder="@Localizer["EnterDepartment"]"></div>
                <div class="form-group col-lg-2 col-md-6"><label for="searchRole">@Localizer["Role"]</label><select id="searchRole" class="form-control"><option value="">@Localizer["AllRoles"]</option>@foreach (var role in roles) {<option value="@role.RoleCode">@role.RoleCode-@role.RoleName</option>}</select></div>
                <div class="form-group col-lg-2 col-md-6"><label for="searchStatus">@Localizer["Status"]</label><select id="searchStatus" class="form-control"><option value="">@Localizer["All"]</option><option value="0">@Localizer["Active"]</option><option value="1">@Localizer["Locked"]</option><option value="2">@Localizer["Deleted"]</option></select></div>
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary mr-2"><i class="fas fa-search mr-1"></i>@Localizer["Search"]</button>
                    <button type="button" class="btn btn-light" id="resetSearch"><i class="fas fa-undo mr-1"></i>@Localizer["Reset"]</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center"><h5 class="mb-0">@Localizer["UserList"]</h5><span class="text-muted small" id="userCount">0 @Localizer["Users"]</span></div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th class="text-center" style="background-color: #2335b7 !important;">ADID</th>
                        <th class="text-center" style="background-color: #2335b7 !important;">@Localizer["FullName"]</th>
                        <th class="text-center" style="background-color: #2335b7 !important;">@Localizer["EmployeeId"]</th>
                        <th class="text-center" style="background-color: #2335b7 !important;">@Localizer["Department"]</th>
                        <th class="text-center" style="background-color: #2335b7 !important;">Email</th>
                        <th class="text-center" style="background-color: #2335b7 !important;">@Localizer["Role"]</th>
                        <th class="text-center" style="background-color: #2335b7 !important;">@Localizer["Status"]</th>
                        <th class="text-center" style="background-color: #2335b7 !important;">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody id="userTable"><tr><td colspan="8" class="text-center empty-state"><i class="fas fa-spinner fa-spin fa-2x mb-3"></i><br>@Localizer["Loading"]</td></tr></tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center flex-wrap">
            <div class="small text-muted mb-2 mb-md-0" id="pageSummary">@Localizer["Showing", 0, 0, 0, Localizer["Users"]]</div>
            <div class="d-flex align-items-center">
                <label for="pageSize" class="small text-muted mr-2 mb-0">@Localizer["Rows"]:</label>
                <select id="pageSize" class="form-control form-control-sm mr-3" style="width: 75px;">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <nav aria-label="@Localizer["UserPagination"]"><ul class="pagination pagination-sm mb-0" id="userPagination"></ul></nav>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="userModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title"><i class="fas fa-user-edit text-primary mr-2"></i><span id="modalTitle">@Localizer["AddUser"]</span></h5><button type="button" class="close" data-dismiss="modal" aria-label="@Localizer["Close"]"><span aria-hidden="true">&times;</span></button></div>
        <form id="userForm"><div class="modal-body"><div id="formError" class="alert alert-danger d-none"></div><input type="hidden" id="isEdit">
            <div class="row">
                <div class="form-group col-md-6"><label class="required" for="userId">ADID</label><input id="userId" class="form-control" required maxlength="50"><small class="form-text text-muted">@Localizer["UsedLoggin"]</small></div>
                <div class="form-group col-md-6"><label class="required" for="fullName">@Localizer["FullName"]</label><input id="fullName" class="form-control" required maxlength="150"></div>
                <div class="form-group col-md-6"><label for="employeeId">@Localizer["EmployeeId"]</label><input id="employeeId" class="form-control" maxlength="50"></div>
                <div class="form-group col-md-6"><label for="email">Email</label><input id="email" type="email" class="form-control" maxlength="150"></div>
                <div class="form-group col-md-6"><label for="section">@Localizer["DepartmentSection"]</label><input id="section" class="form-control" maxlength="100"></div>
@*                 <div class="form-group col-md-6"><label for="department">Phòng ban</label><input id="department" class="form-control" maxlength="100"></div> *@
                <div class="form-group col-md-6"><label class="required" for="role">@Localizer["PermissionRole"]</label><select id="role" class="form-control" required><option value="">@Localizer["SelectRole"]</option>@foreach (var role in roles) {<option value="@role.RoleCode">@role.RoleName (@role.RoleCode)</option>}</select></div>
                <div class="form-group col-md-6"><label for="password">@Localizer["Password"]</label><input id="password" type="password" class="form-control" autocomplete="new-password"><small class="form-text text-muted">@Localizer["PasswordHint"]</small></div>
                <div class="form-group col-md-6"><label for="active">@Localizer["Status"]</label>
                    <select id="active" class="form-control">
                        <option value="0">@Localizer["Active"]</option>
                        <option value="1">@Localizer["TemporarilyLocked"]</option>
                                <option value="2">@Localizer["TemporarilyDeleted"]</option>
                    </select>
                </div>
            </div>
        </div><div class="modal-footer"><button type="button" class="btn btn-light" data-dismiss="modal">@Localizer["Cancel"]</button><button type="submit" class="btn btn-primary" id="saveUser"><i class="fas fa-save mr-1"></i>@Localizer["Save"]</button></div></form>
    </div></div>
</div>

@section Scripts {
    <script>
        (() => {
            var panel = document.getElementById('userModal');
            if (panel && panel.parentElement !== document.body) {
                document.body.appendChild(panel);
            }
        })();
        window.userManagementConfig = {
            roles: @Html.Raw(JsonSerializer.Serialize(roles.Select(x => new { code = x.RoleCode, name = x.RoleName }))),
            texts: @Html.Raw(JsonSerializer.Serialize(new {
                user = Localizer["User"].Value,
                users = Localizer["Users"].Value,
                addUser = Localizer["AddUser"].Value,
                active = Localizer["Active"].Value,
                locked = Localizer["Locked"].Value,
                deleted = Localizer["Deleted"].Value,
                loading = Localizer["Loading"].Value,
                loadError = Localizer["LoadError"].Value,
                noUsers = Localizer["NoUsers"].Value,
                previousPage = Localizer["PreviousPage"].Value,
                nextPage = Localizer["NextPage"].Value,
                edit = Localizer["Edit"].Value,
                lockUser = Localizer["LockUser"].Value,
                updateUser = Localizer["UpdateUser"].Value,
                employeeError = Localizer["EmployeeError"].Value,
                employeeNotFound = Localizer["EmployeeNotFound"].Value,
                confirmLock = Localizer["ConfirmLock"].Value,
                lockError = Localizer["LockError"].Value,
                lockedUser = Localizer["LockedUser"].Value,
                saveError = Localizer["SaveError"].Value,
                updated = Localizer["Updated"].Value,
                added = Localizer["Added"].Value,
                showing = Localizer["Showing"].Value
            })),
            endpoints: {
                search: '@Url.Action("SearchUser", "Account")',
                register: '@Url.Action("RegisterUser", "Account")',
                update: '@Url.Action("UpdateUser", "Account")',
                delete: '@Url.Action("DeleteUser", "Account")',
                searchEmployee: '@Url.Action("GetEmployeeWorkingById", "Account")'
            }
        };
    </script>
    <script src="~/js/Account/UserManagement.js" asp-append-version="true"></script>
}
