@using PRJ_WAREHOUSE_BIVN.View_Models.Login
@model LoginViewModel
@{
    ViewData["Title"] = Localizer["Title"];
    Layout = null;
}

<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/modules/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="language-selector position-absolute top-0 end-0 p-3">
        <form method="post" asp-action="SetCulture" asp-controller="Account" id="cultureForm" class="d-flex align-items-center">
            <i class="fas fa-globe text-muted me-2"></i>
            <input type="hidden" name="returnUrl" value="/Account/Login" />
            <select name="culture" class="form-select form-select-sm border-0 bg-transparent" onchange="this.form.submit()" style="width: auto; min-width: 120px;">
                <option value="vi" selected="@(System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("vi"))">Tiếng Việt</option>
                <option value="en" selected="@(System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("en"))">English</option>
                <option value="ja" selected="@(System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ja"))">日本語</option>
            </select>
        </form>
    </div>
    <div class="center-wrapper">
        <div class="simple-card">
            <div class="brand">
                <div class="icon"><i class="fas fa-warehouse"></i></div>
                <div>
                    <h2>@Localizer["SystemTitle"]</h2>
                    <div class="subtitle">@Localizer["Subtitle"]</div>
                </div>
            </div>

    <div id="login-loading" style="display:none;position:fixed;inset:0;background:rgba(255,255,255,0.7);z-index:1050;">
        <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);" class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Localizer["Loading"]</span>
            </div>
            <div class="mt-2 text-primary">@Localizer["LoggingIn"]</div>
        </div>
    </div>

            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="Login" method="post" id="loginForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3 form-floating">
                    <input asp-for="Username" class="form-control" id="username" placeholder="@Localizer["Username"]" autocomplete="username" autocomplete="off" />
                    <label for="username">@Localizer["Username"]</label>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-floating">
                    <input asp-for="Password" type="password" class="form-control" id="password" placeholder="@Localizer["Password"]" autocomplete="current-password" />
                    <label for="password">@Localizer["Password"]</label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" />
                        <label class="form-check-label" for="rememberMe">@Localizer["RememberMe"]</label>
                    </div>
                    <a href="#" class="small text-decoration-none" tabindex="-1">@Localizer["ForgotPassword"]</a>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2">@Localizer["LoginButton"]</button>
            </form>

            <div class="small-note">@Localizer["VersionNote"]</div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        (function(){
            const form = document.getElementById('loginForm');
            const overlay = document.getElementById('login-loading');
            if(form && overlay){
                form.addEventListener('submit', function(){
                    overlay.style.display = 'block';
                });
            }
        })();
    </script>
</body>
</html>
