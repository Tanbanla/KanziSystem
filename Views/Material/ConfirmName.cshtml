@using PRJ_WAREHOUSE_BIVN.DTO
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    var role = ViewBag.Role as string ?? "UserPUR"; // UserShip | UserAcc | UserPUR
    List<ACC_NHOMVITRIDTO> nhomVitris = Model.vitris;
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
    <link rel="stylesheet" href="~/css/ConfirmName.css" />

</head>

<div class="container-fluid" id="confirm-name" data-role="@role">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-primary">@Localizer["HeaderTitle"]</h4>
            <small class="text-muted">@Localizer["HeaderSubtitle"]</small>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["Search"]</h6>
        </div>
        <div class="card-body">
            <form id="searchForm" class="row g-3">
                <!-- Tăng khoảng cách giữa các hàng từ g-2 lên g-3 -->
                <!-- Hàng 1: 3 cột -->
                <div class="col-12 col-md-4">
                    <label class="form-label mb-1">@Localizer["ItemName"]</label>
                    <input type="text" class="form-control" id="tenHang" placeholder="@Localizer["EnterItemName"]" />
                </div>
                <div class="col-12 col-sm-6 col-md-4">
                    <!-- Điều chỉnh từ col-md-3 lên col-md-4 -->
                    <label class="form-label mb-1">@Localizer["OrderCode"]</label>
                    <input type="text" class="form-control" id="soDon" placeholder="@Localizer["EnterOrderCode"]" />
                </div>
                <div class="col-12 col-sm-6 col-md-4">
                    <!-- Điều chỉnh từ col-md-3 lên col-md-4 -->
                    <label for="maPhongBan" class="form-label small text-uppercase fw-semibold">@Localizer["DepartmentCode"]</label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchPhongBan searchable-select" style="min-height:50px;">
                        <option value="" selected>@Localizer["SelectDepartment"]</option>
                        @foreach (var s in nhomVitris)
                        {
                            <option value="@s.Mahangmuctheovitri">@s.Mahangmuctheovitri - @s.Tenhangmuctheovitri</option>
                        }
                    </select>
                </div>

                <!-- Hàng 2: 2 cột - Trạng thái và nút tìm kiếm -->
                <div class="col-10 col-sm-10 col-md-1">
                    <label class="form-label mb-1 w-100" style="min-width: 150px;">@Localizer["ConfirmStatus"]</label>
                    <select id="trangThai" class="form-select" style="min-height: 40px;">
                        <option value="">@Localizer["All"]</option>
                        <option value="Draft">@Localizer["StatusDraft"]</option>
                        <option value="Confirming">@Localizer["StatusConfirming"]</option>
                        <option value="Confirmed">@Localizer["StatusConfirmed"]</option>
                        <option value="Rejected">@Localizer["StatusRejected"]</option>
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-2 d-flex align-items-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" id="btnReset"><i class="fas fa-undo"></i> @Localizer["Reset"]</button>
                    <div style="min-width: 6px;"></div>
                    <button type="button" class="btn btn-primary" id="btnSearch">
                        <i class="fas fa-search me-1"></i> @Localizer["Search"]
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm mt-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["List"]</h6>
            <div class="small text-muted">@Localizer["Role"]: <b>@role</b></div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 70vh;">
                <table class="table table-sm table-hover table-bordered align-middle table-fixed mb-0" id="confirmTable">
                    <thead class="table-light">
                        <tr class="text-center align-middle">
                            <th style="width:60px">#</th>
                            <th style="width:60px">@Localizer["Detail"]</th>
                            <th style="min-width:100px">@Localizer["OrderCode"]</th>
                            <th style="min-height:260px;">@Localizer["CustomsNameSuggestion"]</th>
                            <th style="min-width:240px">@Localizer["CustomsItemName"]</th>
                            <th style="min-width:180px">@Localizer["InternalMaterialCode"]</th>
                            <th style="min-width:120px">@Localizer["Status"]</th>
                            <th style="min-width:160px">@Localizer["CreatedAt"]</th>
                            <th style="min-width:220px">@Localizer["Handler"]</th>
                            <th style="min-width:220px">@Localizer["Note"]</th>
                            <th style="min-width:220px">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="confirmTableBody">
                        <tr><td colspan="9" class="text-center text-muted">@Localizer["NoData"]</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <div class="small text-muted" id="resultCount"></div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-secondary" id="prevPage">&lt;</button>
                <div style="min-width: 6px;"></div>
                <span class="align-self-center small" id="pageInfo">1/1</span>
                <div style="min-width: 6px;"></div>
                <button class="btn btn-sm btn-outline-secondary" id="nextPage">&gt;</button>
            </div>
        </div>
    </div>
</div>
<!-- Edit modal for uncompleted orders -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered" style="min-width: 50%">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["DetailModalTitle"]</h5>
                <button type="button" class="btn btn-sm btn-outline-danger border-0" title="@Localizer["Close"]" id="btnCloseEdit_1" role="button" data-bs-dismiss="modal" aria-label="@Localizer["Close"]" aria-controls="editHistoryModal">
                    <i class="fas fa-times fa-sm"></i>
                </button>
            </div>
            <div class="modal-body" style="max-height: 620px; overflow-y: auto">
                <form id="editHistoryForm" class="row g-3">
                    <input type="hidden" id="editRequestId" />
                    <div class="col-12">
                        <div class="d-flex gap-3">
                            <div>
                                <label class="form-label">@Localizer["OrderCodeGroup"]</label>
                                <input type="text" class="form-control" id="editMaDon" readonly />
                            </div>
                            <div style="margin-left: 8px;">
                                <label class="form-label">@Localizer["Requester"]</label>
                                <input type="text" class="form-control" id="editRequester" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["DepartmentCode"]</label>
                        <input type="text" class="form-control" id="editSectionName" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Classification"]</label>
                        <input type="text" class="form-control" id="editPhanLoai" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label w-100">@Localizer["Category"]</label>
                        <input type="text" class="form-control" id="editChungLoai" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["InternalMaterialCode"]</label>
                        <input type="text" class="form-control" id="editMaHangNoiBo" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["EquipmentCode"]</label>
                        <input type="text" class="form-control" id="editMaThietBi" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["SupplierItemCode"]</label>
                        <input type="text" class="form-control" id="editMaHangNCC" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["ItemNameVN"]</label>
                        <input type="text" class="form-control" id="editTenHangVN" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["ItemNameEN"]</label>
                        <input type="text" class="form-control" id="editTenHangEN" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localizer["Quantity"]</label>
                        <input type="number" class="form-control" id="editSoLuong" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localizer["Unit"]</label>
                        <input type="text" class="form-control" id="editDonVi" readonly />
                    </div>
                    <!-- Description fields -->
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Shape"]</label>
                        <input type="text" class="form-control" id="editHinhDang" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Material"]</label>
                        <input type="text" class="form-control" id="editChatLieu" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Composition"]</label>
                        <input type="text" class="form-control" id="editThanhPhan" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Dimensions"]</label>
                        <input type="text" class="form-control" id="editKichThuoc" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["UsedForMachine"]</label>
                        <input type="text" class="form-control" id="editDongMay" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Feature"]</label>
                        <input type="text" class="form-control" id="editTinhNang" readonly />
                    </div>
                    <!-- Regulatory and files -->
                    <div class="col-md-4">
                        <label class="form-label w-100">@Localizer["Rohs"]</label>
                        <input type="text" class="form-control" id="editRohs" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label w-100">@Localizer["COCQ"]</label>
                        <input type="text" class="form-control" id="editCOCQ" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localizer["MSDS"]</label>
                        <input type="text" class="form-control" id="editMSDS" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Localizer["SafetyStandard"]</label>
                        <input type="text" class="form-control" id="editAnToan" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["DesignFile"]</label>
                        <input type="text" class="form-control" id="editFileThietKe" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["Manufacturer"]</label>
                        <input type="text" class="form-control" id="editNhaSanXuat" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["Supplier"]</label>
                        <input type="text" class="form-control" id="editNhaCungCap" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label w-100">@Localizer["GetQuotation"]</label>
                        <select class="form-select" id="editLayBaoGia" style="min-height: 40px;">
                            <option value="true">O</option>
                            <option value="false">X</option>
                        </select>
                    </div>
                    <div class="col-md-9">
                        <label class="form-label">@Localizer["Reason"]</label>
                        <input type="text" class="form-control lydoTb" id="editLyDo" placeholder="Lý do" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["DesiredReceiveDate"]</label>
                        <input type="date" class="form-control" id="editNgayMuonNhan" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["SupplierSelectionDeadline"]</label>
                        <input type="date" class="form-control" id="editKyHan" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label w-100">@Localizer["Urgent"]</label>
                        <select class="form-select" id="editGap" style="min-height: 40px">
                            <option value="false">X</option>
                            <option value="true">O</option>
                        </select>
                    </div>
                    @* Cac thuoc tinh khac *@
                    <div class="col-md-6" hidden>
                        <input type="date" class="form-control" id="editDaycreate" hidden />
                        <input type="text" class="form-control" id="editStatus" hidden />
                        <input type="text" class="form-control" id="editStep" hidden />
                        <input type="hidden" id="editSectionCode" />
                        <input type="hidden" id="editTenNCC" />
                        <input type="number" class="form-control" id="editSoLanUpdate" hidden />
                        <input type="date" class="form-control" id="editUpdateLater" hidden />
                        <input type="date" class="form-control" id="editDeadline" hidden />
                        <input type="hidden" id="editIsTemplate" />
                        <input type="hidden" id="editSectionCode" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btnCloseEdit_2" role="button" data-bs-dismiss="modal" aria-label="@Localizer["Close"]" aria-controls="editHistoryModal">@Localizer["Close"]</button>
            </div>
        </div>
    </div>
</div>
<!-- Custom confirm dialog -->
<div id="cmConfirmDialog" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmConfirmTitle">
        <div class="cm-dialog-header">
            <h6 id="cmConfirmTitle" class="cm-dialog-title cm-confirm-title">@Localizer["Confirm"]</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="cancel" aria-label="@Localizer["Close"]">✕</button>
        </div>
        <div class="cm-dialog-body cm-confirm-body">@Localizer["AreYouSure"]</div>
        <div class="cm-dialog-footer">
            <button type="button" class="cm-btn cm-btn-primary" data-cm-action="ok">@Localizer["OK"]</button>
        </div>
    </div>
</div>

<!-- Custom reason input dialog -->
<div id="cmReasonDialog" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmReasonTitle">
        <div class="cm-dialog-header">
            <h6 id="cmReasonTitle" class="cm-dialog-title cm-reason-title">@Localizer["EnterReason"]</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="cancel" aria-label="@Localizer["Close"]">✕</button>
        </div>
        <div class="cm-dialog-body">
            <div class="cm-reason-body">@Localizer["PleaseEnterReason"]</div>
            <input id="cmReasonInput" type="text" class="form-control mt-2" placeholder="@Localizer["EnterReasonPlaceholder"]" />
        </div>
        <div class="cm-dialog-footer">
            <button type="button" class="cm-btn cm-btn-primary" data-cm-action="ok">@Localizer["Confirm"]</button>
        </div>
    </div>
</div>
<!-- Custom dialog root -->
<div id="cmDialogOverlay" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmDialogTitle">
        <div class="cm-dialog-header">
            <h6 id="cmDialogTitle" class="cm-dialog-title">@Localizer["Notification"]</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="close" aria-label="@Localizer["Close"]">✕</button>
        </div>
        <div id="cmDialogBody" class="cm-dialog-body"></div>
        <div id="cmDialogFooter" class="cm-dialog-footer">
            <!-- Buttons injected by JS -->
        </div>
    </div>
    <!-- Make overlay clickable to close for info dialogs -->
    <div class="cm-dialog-backdrop" data-cm-action="overlay"></div>
</div>
@section Scripts {
    <script src="~/js/utils/date.js"></script>
    <script src="~/js/ConfirmName.js"></script>
    <script>
        window.i18nConfirmName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            NoData = Localizer["NoData"].Value,
            Total = Localizer["Total"].Value,
            StatusConfirmed = Localizer["StatusConfirmed"].Value,
            StatusConfirming = Localizer["StatusConfirming"].Value,
            StatusRejected = Localizer["StatusRejected"].Value,
            StatusDraft = Localizer["StatusDraft"].Value,
            BtnApprove = Localizer["Approve"].Value,
            BtnReject = Localizer["Reject"].Value,
            CreatedByPrefix = Localizer["CreatedByPrefix"].Value,
            MsgLoadDetailFailed = Localizer["MsgLoadDetailFailed"].Value,
            MsgGenericError = Localizer["MsgGenericError"].Value,
            MsgSearchFailed = Localizer["MsgSearchFailed"].Value,
            MsgSaveFailed = Localizer["MsgSaveFailed"].Value,
            ConfirmApproveTitle = Localizer["ConfirmApproveTitle"].Value,
            ConfirmApproveMessage = Localizer["ConfirmApproveMessage"].Value,
            ReasonTitle = Localizer["EnterReason"].Value,
            ReasonMessage = Localizer["PleaseEnterReason"].Value,
            OK = Localizer["OK"].Value,
            Close = Localizer["Close"].Value,
            SearchEllipsis = Localizer["SearchEllipsis"].Value,
            NoResults = Localizer["NoResults"].Value,
            SelectPlaceholder = Localizer["SelectPlaceholder"].Value
        }));
    </script>
}
