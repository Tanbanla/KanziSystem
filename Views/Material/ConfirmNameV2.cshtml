@using PRJ_WAREHOUSE_BIVN.DTO
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    var role = ViewBag.Role as string ?? "User";
    List<DEPARTMENTDTO> nhomVitris = Model.vitris;
    List<dynamic> confirmedCodes = Model.confirmedCodes;
    List<string> maDons = Model?.DanhSachMaDon ?? new List<string>();
    List<MATERIALDTO> materials = Model?.DanhSachVatTu ?? new List<MATERIALDTO>();
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
    <link rel="stylesheet" href="~/css/ConfirmName.css" />
</head>

<div class="container-fluid" id="confirm-name" data-role="@role">
    <!-- Global loading overlay -->
    <div id="globalLoading" aria-hidden="true">
        <div class="loader-box">
            <div class="spinner" aria-hidden="true"></div>
            <div class="loader-msg">Đang xử lý...</div>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-primary">@Localizer["HeaderTitle"]</h4>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-success" id="btnImportExcel">
                <i class="fas fa-upload me-1"></i> @Localizer["ImportExcel"]
            </button>
            <input type="file" id="itemsExcelFileInput" accept=".xlsx,.xls" style="display:none" />
            <div style="margin-left: 6px;"></div>
            <button type="button" class="btn btn-outline-primary" id="btnExportTemplate">
                <i class="fas fa-download me-1"></i> @Localizer["ExportTemplate"]
            </button>
            <div style="margin-left: 6px;"></div>
            <button type="button" class="btn btn-outline-warning" id="btnExportTable">
                <i class="fas fa-download me-1"></i> @Localizer["ExportTable"]
            </button>
        </div>
    </div>

    <div class="row g-3 mb-3" id="kpiRow">
        <div class="col-12 col-sm-6 col-xl-3">
            <button type="button" class="kpi-card text-start w-100" data-kpi-status="Confirming">
                <div class="kpi-title">@Localizer["StatusConfirming"]</div>
                <div class="kpi-value" id="kpiConfirming">0</div>
            </button>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <button type="button" class="kpi-card text-start w-100" data-kpi-status="Confirmed">
                <div class="kpi-title">@Localizer["StatusConfirmed"]</div>
                <div class="kpi-value" id="kpiConfirmed">0</div>
            </button>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <button type="button" class="kpi-card text-start w-100" data-kpi-status="Rejected">
                <div class="kpi-title">@Localizer["StatusRejected"]</div>
                <div class="kpi-value" id="kpiRejected">0</div>
            </button>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card kpi-muted h-100">
                <div class="kpi-title">@Localizer["Total"]</div>
                <div class="kpi-value" id="kpiTotal">0</div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs modern-tabs" id="confirmTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tabPending" type="button" role="tab" data-tab="pending">
                @Localizer["StatusConfirming"]
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tabConfirmed" type="button" role="tab" data-tab="confirmed">
                @Localizer["StatusConfirmed"]
            </button>
        </li>
    </ul>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["Search"]</h6>
        </div>
        <div class="card-body">
            <form id="searchForm" class="row g-3">
                <div class="col-12 col-md-3">
                    <label class="form-label mb-1">@Localizer["ItemName"]</label>
                    <select id="tenHang" name="tenHang" class="form-select searchMaterial searchable-select" data-remote="true" data-api="/Material/SearchMaterialView" data-page-size="500" style="min-height:50px;">
                        <option value="" selected>@Localizer["SelectInternalMaterialCode"]</option>
                        @foreach (var m in materials)
                        {
                            <option value="@m.Material_Code">@m.Material_Code - @m.Material_Name_VN</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label mb-1">@Localizer["OrderCode"]</label>
                    <select id="soDon" name="soDon" class="form-select searchable-select" style="min-height:50px;">
                        <option value="" selected>@Localizer["SelectOrderCode"]</option>
                        @foreach (var s in maDons)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-sm-6 col-md-3">

                    <label for="maPhongBan" class="form-label small text-uppercase fw-semibold">@Localizer["DepartmentCode"]</label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchPhongBan searchable-select" style="min-height:50px;">
                        <option value="" selected>@Localizer["SelectDepartment"]</option>
                        @foreach (var s in nhomVitris)
                        {
                            <option value="@s.Cost_Center">@s.Cost_Center - @s.Name</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label mb-1">@Localizer["CreatedByPrefix"]</label>
                    <input type="text" class="form-control" id="createdByFilter" placeholder="ADID"  />
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label mb-1">Từ ngày</label>
                    <input type="date" class="form-control" id="fromDateFilter"  />
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label mb-1">Đến ngày</label>
                    <input type="date" class="form-control" id="toDateFilter" />
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label mb-1">Tìm nhanh</label>
                    <input type="text" class="form-control" id="quickSearch" placeholder="Mã đơn / mã vật tư / tên" />
                </div>

                <div class="col-12 col-sm-6 col-md-3">

                    <label class="form-label mb-1 d-block">@Localizer["ConfirmStatus"]</label>
                    <select id="trangThai" name="trangThai" class="form-select trangThai searchable-select" style="min-height:50px;">
                        @if (role == "User"|| role == "UserPUR")
                        {
                            <option value="">@Localizer["All"]</option>
                            <option value="Confirming" selected>@Localizer["StatusConfirming"]</option>
                            <option value="Confirmed">@Localizer["StatusConfirmed"]</option>
                            <option value="Rejected">@Localizer["StatusRejected"]</option>
                        }
                        else
                        {
                            <option value="">@Localizer["All"]</option>
                            <option value="Confirming" selected>@Localizer["StatusConfirming"]</option>
                            <option value="Confirmed">@Localizer["StatusConfirmed"]</option>
                            <option value="Rejected">@Localizer["StatusRejected"]</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-md-3 d-flex align-items-end gap-2" style="margin-top: 4px;">
                    <button type="button" class="btn btn-outline-secondary" id="btnReset"><i class="fas fa-undo"></i> @Localizer["Reset"]</button>
                    <div style="min-width: 6px;"></div>
                    <button type="button" class="btn btn-primary" id="btnSearch">
                        <i class="fas fa-search me-1"></i> @Localizer["Search"]
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm mt-3">
        <div class="card-header bg-white p-2">
            <div class="action-bar d-flex justify-content-between align-items-center flex-wrap gap-2" id="pendingActionBar">
                <div class="d-flex align-items-center gap-2">
                    <input type="checkbox" id="chkSelectAll" title="Chọn tất cả" />
                    <span class="small text-muted">Đã chọn: <b id="selectedCount">0</b></span>
                </div>
                <div style="margin-right: 6px;"></div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnSaveSelected">
                        <i class="fas fa-save me-1"></i> @Localizer["SaveSelected"]
                    </button>
                    @if (role == "UserShip")
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger" id="btnRejectAccSelected">
                            <i class="fas fa-times me-1"></i> @Localizer["RejectSelected"]
                        </button>
                    }
                    <div style="margin-right: 6px;"></div>
                    <div class="small text-muted">@Localizer["Role"]: <b>@role</b></div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div id="pendingTabPane" class="tab-pane-area">
                <div class="table-responsive modern-table-wrap">
                    <table class="table table-sm table-hover align-middle mb-0" id="confirmTable">
                        <thead>
                            <tr>
                                <th style="width:40px"><input type="checkbox" id="_row_check_all" /></th>
                                <th>@Localizer["RequestQuoteNumber"]</th>
                                <th>@Localizer["ConfirmCode"]</th>
                                <th>@Localizer["VietnameseItemNameDraft"]</th>
                                <th>@Localizer["ConfirmName"]</th>
                                <th>@Localizer["EnglishItemName"]</th>
                                <th>@Localizer["CreatedByPrefix"]</th>
                                <th>@Localizer["CreatedDate"]</th>
                                <th>@Localizer["Handler"]</th>
                                <th>@Localizer["Status"]</th>
                                <th class="text-center">@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody id="confirmTableBody">
                            <tr><td colspan="11" class="text-center text-muted py-4">@Localizer["NoData"]</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="confirmedTabPane" class="tab-pane-area d-none">
                <div class="card-list" id="confirmedCardList">
                    <div class="text-center text-muted py-4">@Localizer["NoData"]</div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <!-- Bên trái: Result Count và Page Size -->
                <div class="d-flex align-items-center gap-3">
                    <div class="small text-muted" id="resultCount"></div>
                    <div style="min-width: 6px;"></div>
                    <div class="d-flex align-items-center gap-2">
                        <label class="form-label mb-0 small text-nowrap">@Localizer["PageSize"]</label>
                        <div style="min-width: 6px;"></div>
                        <select id="pageSizeSelect" class="form-select form-select-sm" style="width: auto; min-width: 80px;">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="20" selected>20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </div>
        
                <!-- Bên phải: Phân trang-->
                <div class="d-flex align-items-center gap-1">
                    <button class="btn btn-sm btn-outline-secondary" id="prevPage">&lt;</button>
                    <div style="min-width: 6px;"></div>
                    <span class="align-self-center small" id="pageInfo">1/1</span>
                    <div style="min-width: 6px;"></div>
                    <button class="btn btn-sm btn-outline-secondary" id="nextPage">&gt;</button>
                </div>
            </div>
        </div>

    <div class="drawer-overlay" id="confirmDrawerOverlay" aria-hidden="true"></div>
    <aside class="detail-drawer" id="confirmDetailDrawer" aria-hidden="true">
        <div class="drawer-header">
            <h5 class="mb-0">Chi tiết xác nhận vật tư</h5>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnCloseDrawer">✕</button>
        </div>
        <div class="drawer-body">
            <div class="drawer-section mb-3">
                <h6 class="drawer-section-title">Thông tin đơn</h6>
                <div class="detail-grid">
                    <div><span>Mã đơn</span><b id="dMaDon">-</b></div>
                    <div><span>Mã vật tư</span><b id="dMaVatTu">-</b></div>
                    <div><span>Tên hải quan</span><b id="dTenHaiQuan">-</b></div>
                    <div><span>Tên tiếng Anh</span><b id="dTenEN">-</b></div>
                    <div><span>Tên đề xuất</span><b id="dTenDeXuat">-</b></div>
                    <div><span>Trạng thái</span><b id="dTrangThai">-</b></div>
                </div>
            </div>

            <div class="drawer-section mb-3">
                <h6 class="drawer-section-title">Thông tin nghiệp vụ</h6>
                <div class="detail-grid">
                    <div><span>Người tạo</span><b id="dCreateBy">-</b></div>
                    <div><span>Ngày tạo</span><b id="dCreateDate">-</b></div>
                    <div><span>Người sửa cuối</span><b id="dUpdateBy">-</b></div>
                    <div><span>Ngày sửa cuối</span><b id="dUpdateDate">-</b></div>
                    <div><span>Người PUR xác nhận</span><b id="dUserPur">-</b></div>
                    <div><span>Ngày PUR xác nhận</span><b id="dUserPurDate">-</b></div>
                    <div><span>Người SHIP xác nhận</span><b id="dUserShip">-</b></div>
                    <div><span>Ngày SHIP xác nhận</span><b id="dUserShipDate">-</b></div>
                    <div><span>Ghi chú</span><b id="dNote">-</b></div>
                    <div><span>Lý do từ chối</span><b id="dRejectReason">-</b></div>
                </div>
            </div>

            <div class="drawer-section">
                <h6 class="drawer-section-title">Lịch sử thay đổi</h6>
                <div class="history-timeline" id="drawerHistoryTimeline">
                    <div class="text-muted small">Chưa có dữ liệu</div>
                </div>
            </div>
        </div>
    </aside>
    </div>
</div>

<!-- Custom confirm dialog -->
<div id="cmConfirmDialog" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmConfirmTitle">
        <div class="cm-dialog-header">
            <h6 id="cmConfirmTitle" class="cm-dialog-title cm-confirm-title">@Localizer["Confirm"]</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="cancel" aria-label="@Localizer["Close"]">✕</button>
        </div>
        <div class="cm-dialog-body cm-confirm-body">@Localizer["AreYouSure"]</div>
        <div class="cm-dialog-footer">
            <button type="button" class="cm-btn cm-btn-primary" data-cm-action="ok">@Localizer["OK"]</button>
        </div>
    </div>
</div>

<!-- Custom reason input dialog -->
<div id="cmReasonDialog" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmReasonTitle">
        <div class="cm-dialog-header">
            <h6 id="cmReasonTitle" class="cm-dialog-title cm-reason-title">@Localizer["EnterReason"]</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="cancel" aria-label="@Localizer["Close"]">✕</button>
        </div>
        <div class="cm-dialog-body">
            <div class="cm-reason-body">@Localizer["PleaseEnterReason"]</div>
            <input id="cmReasonInput" type="text" class="form-control mt-2" placeholder="@Localizer["EnterReasonPlaceholder"]" />
        </div>
        <div class="cm-dialog-footer">
            <button type="button" class="cm-btn cm-btn-primary" data-cm-action="ok">@Localizer["Confirm"]</button>
        </div>
    </div>
</div>
<!-- Custom dialog root -->
<div id="cmDialogOverlay" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmDialogTitle">
        <div class="cm-dialog-header">
            <h6 id="cmDialogTitle" class="cm-dialog-title">@Localizer["Notification"]</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="close" aria-label="@Localizer["Close"]">✕</button>
        </div>
        <div id="cmDialogBody" class="cm-dialog-body"></div>
        <div id="cmDialogFooter" class="cm-dialog-footer">
            <!-- Buttons injected by JS -->
        </div>
    </div>
    <!-- Make overlay clickable to close for info dialogs -->
    <div class="cm-dialog-backdrop" data-cm-action="overlay"></div>
</div>
@section Scripts {
    <datalist id="maNBList">
        @foreach (var code in confirmedCodes)
        {
            <option value="@code.Material_Code">@code.Material_Code - @code.Material_Name_VN</option>
        }
    </datalist>
    <script src="~/js/common/searchable-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/utils/date.js"></script>
    <script>
        (function() {
            // Ensure panel and overlay are appended to body to avoid being under navbar stacking contexts
            var panel = document.getElementById('confirmDetailDrawer');
            if (panel && panel.parentElement !== document.body) {
                document.body.appendChild(panel);
            }
        })();
        window.apiBaseUrl = '@ViewBag.ApiBaseUrl';
        window.i18nConfirmName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            NoData = Localizer["NoData"].Value,
            Total = Localizer["Total"].Value,
            StatusConfirmed = Localizer["StatusConfirmed"].Value,
            StatusConfirming = Localizer["StatusConfirming"].Value,
            StatusRejected = Localizer["StatusRejected"].Value,
            StatusDraft = Localizer["StatusDraft"].Value,
            BtnApprove = Localizer["Approve"].Value,
            BtnReject = Localizer["Reject"].Value,
            CreatedByPrefix = Localizer["CreatedByPrefix"].Value,
            MsgLoadDetailFailed = Localizer["MsgLoadDetailFailed"].Value,
            MsgGenericError = Localizer["MsgGenericError"].Value,
            MsgSearchFailed = Localizer["MsgSearchFailed"].Value,
            MsgSaveFailed = Localizer["MsgSaveFailed"].Value,
            ConfirmApproveTitle = Localizer["ConfirmApproveTitle"].Value,
            ConfirmApproveMessage = Localizer["ConfirmApproveMessage"].Value,
            ReasonTitle = Localizer["EnterReason"].Value,
            ReasonMessage = Localizer["PleaseEnterReason"].Value,
            OK = Localizer["OK"].Value,
            Close = Localizer["Close"].Value,
            SearchEllipsis = Localizer["SearchEllipsis"].Value,
            NoResults = Localizer["NoResults"].Value,
            SelectPlaceholder = Localizer["SelectPlaceholder"].Value,
            LoadingMessage = Localizer["LoadingMessage"].Value,
            Success = Localizer["Success"].Value,
            ImportSuccess = Localizer["ImportSuccess"].Value,
            Error = Localizer["Error"].Value,
            ExportError = Localizer["ExportError"].Value,
            Processing = Localizer["Processing"].Value,
            BtnSave = Localizer["BtnSave"].Value,
            RequestQuoteNumber = Localizer["RequestQuoteNumber"].Value,
            Department = Localizer["Department"].Value,
            EquipmentClassification = Localizer["EquipmentClassification"].Value,
            EquipmentCode = Localizer["EquipmentCode"].Value,
            SupplierItemCode = Localizer["SupplierItemCode"].Value,
            VietnameseItemNameDraft = Localizer["VietnameseItemNameDraft"].Value,
            EnglishItemName = Localizer["EnglishItemName"].Value,
            Quantity = Localizer["Quantity"].Value,
            Unit = Localizer["Unit"].Value,
            ItemCategory = Localizer["ItemCategory"].Value,
            Shape = Localizer["Shape"].Value,
            Material = Localizer["Material"].Value,
            Composition = Localizer["Composition"].Value,
            Dimensions = Localizer["Dimensions"].Value,
            UsedForMachine = Localizer["UsedForMachine"].Value,
            Feature = Localizer["Feature"].Value,
            ConfirmName = Localizer["ConfirmName"].Value,
            ConfirmCode = Localizer["ConfirmCode"].Value,
            Status = Localizer["Status"].Value,
            CreatedDate = Localizer["CreatedDate"].Value,
            Handler = Localizer["Handler"].Value,
            Note = Localizer["Note"].Value,
            Actions = Localizer["Actions"].Value,
            Record = Localizer["Record"].Value,
            Datafield = Localizer["Datafield"].Value,
            Reason = Localizer["Reason"].Value
        }));
    </script>
    <script src="~/js/ConfirmNameV2.js" asp-append-version="true"></script>
}
