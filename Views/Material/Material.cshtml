@{
    ViewData["Title"] = "Material";
}
<head>
    <link rel="stylesheet" href="~/css/Material.css" />
</head>

<div class="row">
    <div class="col-12">
        <div class="card">
            <!-- Card Header - Search Area -->
            <div class="card-header">
                <div class="search-section">
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="ion ion-ios-barcode"></i></span>
                            </div>
                            <input type="text" class="form-control" id="Material_Code" placeholder="Mã vật tư">
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="ion ion-ios-paper"></i></span>
                            </div>
                            <input type="text" class="form-control" id="Material_Name_VN" placeholder="Tên vật tư (VN)">
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="ion ion-key"></i></span>
                            </div>
                            <input type="text" class="form-control" id="Category_VN" placeholder="Chủng loại">
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="ion ion-ios-grid-view"></i></span>
                            </div>
                            <select class="form-control" id="lst_gc" onchange="_load_material()">
                                <option value="">Chọn khối</option>
                                <option value="PROD">PROD</option>
                                <option value="GA">GA</option>
                                <option value="IT">IT</option>
                                <option value="PUR">PUR</option>
                            </select>
                        </div>
                    </div>

                    <div class="search-actions">
                        <button type="button" class="btn-search" onclick="_load_material()">
                            <i class="ion ion-ios-search-strong"></i>
                        </button>
                        <a href="@Context.Request.PathBase/Material/Creat_Material" class="btn-create">
                            <i class="ion ion-plus"></i> Tạo mã
                        </a>
                        <button type="button" class="btn btn-outline-success" style="border-radius: 10px;" onclick="_download_material()">
                            <i class="fas fa-file-download"> Tải dữ liệu</i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Table Area -->
            <div class="table-wrapper">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead style="background: #007aff">
                            <tr>
                                <th>Mã vật tư</th>
                                <th>Tên VN</th>
                                <th>Tên EN</th>
                                <th>Tên JP</th>
                                <th>Đơn vị</th>
                                <th>Chủng loại hàng</th>
                                <th>Mã nhà hàng nhà cung cấp</th>
                                <th>Nhóm</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="show_material"></tbody>
                    </table>
                </div>
                <div class="pagination-wrapper">
                    <ul class="pagination" id="pagination-controls"></ul>
                </div>
            </div>
            <!-- Pagination -->
            <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="small text-muted" style="margin-right: 8px;" id="historyPaginationInfo">@Localizer["PaginationInfo", "0", "0", "0"].Value</div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <label for="historyPageSize" class="small text-muted mb-0">Số dòng</label>
                    <select id="historyPageSize" class="form-select form-select-sm" style="width:90px;margin-left: 4px;">
                        <option value="20">20</option>
                        <option value="50" selected>50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                    </select>
                    <nav>
                        <ul class="pagination pagination-sm mb-0" id="historyPagination">
                            <li class="page-item disabled"><button class="page-link" data-page="prev">«</button></li>
                            <li class="page-item active"><button class="page-link" data-page="1">1</button></li>
                            <li class="page-item disabled"><button class="page-link" data-page="next">»</button></li>
                        </ul>
                    </nav>
                </div>
            </div>

        </div>
    </div>
</div>

<script src="~/js/Material.js" asp-append-version="true"></script>
