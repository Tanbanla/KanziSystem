@{
    ViewData["Title"] = "Material";
}
<head>
    <link rel="stylesheet" href="~/css/Material.css" />
</head>

<div class="row">
    <div class="col-12">
        <div class="card">
            <!-- Card Header - Search Area -->
            <div class="card-header">
                <div class="search-section">
                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="ion ion-ios-barcode"></i></span>
                            </div>
                            <input type="text" class="form-control" id="Material_Code" placeholder="Mã vật tư">
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="ion ion-ios-paper"></i></span>
                            </div>
                            <input type="text" class="form-control" id="Material_Name_VN" placeholder="Tên vật tư (VN)">
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="ion ion-key"></i></span>
                            </div>
                            <input type="text" class="form-control" id="Account_Name_VN" placeholder="Tên tài khoản (VN)">
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="ion ion-ios-grid-view"></i></span>
                            </div>
                            <select class="form-control" id="lst_gc" onchange="_load_material()">
                                <option value="">Chọn khối</option>
                                <option value="PROD">PROD</option>
                                <option value="GA">GA</option>
                                <option value="IT">IT</option>
                                <option value="PUR">PUR</option>
                            </select>
                        </div>
                    </div>

                    <div class="search-actions">
                        <button type="button" class="btn-search" onclick="_load_material()">
                            <i class="ion ion-ios-search-strong"></i>
                        </button>
                        <a href="@Context.Request.PathBase/Material/Creat_Material" class="btn-create">
                            <i class="ion ion-plus"></i> Tạo mã
                        </a>
                    </div>
                </div>
            </div>

            <!-- Table Area -->
            <div class="table-wrapper">
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Mã vật tư</th>
                                <th>Tên VN</th>
                                <th>Tên EN</th>
                                <th>Tên JP</th>
                                <th>Đơn vị</th>
                                <th>Chủng loại hàng</th>
                                <th>Mã nhà hàng nhà cung cấp</th>
                                <th>Nhóm</th>
                                <th>Loại</th>
                            </tr>
                        </thead>
                        <tbody id="show_material"></tbody>
                    </table>
                </div>
                <div class="pagination-wrapper">
                    <ul class="pagination" id="pagination-controls"></ul>
                </div>
            </div>
        </div>
    </div>
</div>

