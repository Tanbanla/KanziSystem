@using PRJ_WAREHOUSE_BIVN.Language
@{
    ViewData["Title"] = "Trạng thái đơn";
}
<style>
    .form-control, .input-group-text, .custom-select, .custom-file-label {
        border-color: #6e75c4;
    }

</style>
<div class="row">
    <div class="col-12">
        <div class="card card-primary">
            <div class="card-header ml-0">
                <div class="form-group" style="margin : 10px 0 0 0">
                    <label>@Languages.Khoi :</label> <br />
                    <div class="input-group mb-2">
                        <select class="form-control" id="khoi" onchange="checkSelectValue(this.value)">
                            <option value="PROD">PROD</option>
                            <option value="GA">GA</option>
                            <option value="IT">IT</option>
                            <option value="PUR">PUR</option>
                        </select>
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 10px">
                    <label>@Languages.Tinhtrangdon :</label> <br />
                    <div class="input-group mb-2">
                        <select id="trangthaidon" class="form-control">
                            <option value=""> ---  Chọn ---</option>
                            <option value="1">Gấp</option>
                            <option value="0">Thông thường</option>
                        </select>
                    </div>
                </div>

                <div class="form-group" style="margin : 10px 0 0 10px">
                    <label>@Languages.Trangthaidon :</label> <br />
                    <div class="input-group mb-2">

                        <select class="form-control" id="tinhtrangdon">
                            <option value=""> ---  Chọn ---</option>
                            <option value="0">Đợi người dự thảo</option>
                            <option value="1">Đợi người thẩm tra</option>
                            <option value="2">Đợi người phê duyệt</option>
                            <option value="3">Đợi quản lý phòng tiếp nhận</option>
                            <option value="4">Đợi người xuất kho</option>
                            <option value="5">Hoàn thành</option>
                            <option value="6">Bị từ chối</option>
                        </select>
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 10px">
                    <label>@Languages.mayeucau :</label> <br />
                    <div class="input-group mb-2">
                        <input type="text" class="form-control" id="mnl">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 10px">
                    <label>Cost :</label> <br />
                    <div class="input-group mb-2">
                        <input type="text" class="form-control" id="costt_ct">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 10px" hidden>
                    <div class="input-group mb-2">
                        <input type="text" class="form-control" id="cost" placeholder="Cost">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 10px">
                    <label>@Languages.Ngayyeucau :</label> <br />
                    <div class="input-group mb-2">
                        <input type="date" class="form-control" id="ngayyc">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 10px">
                    <label>@Languages.Giatien :</label> <br />
                    <div class="input-group mb-2">

                        <select id="giadonhang" class="form-control">
                            <option value="0"> ---  Chọn ---</option>
                            <option value="2999">Dưới 3000</option>
                            <option value="3000">Dưới 10,000</option>
                            <option value="10000">Trên 10,000</option>
                        </select>
                    </div>
                </div>

                <div id="hienthitimkiem">
                    <button type="button" class="btn btn-info ml-3 mt-4" onclick="_load_request_condition()"><i class="ion ion-ios-search-strong"></i> @Languages.timkiem</button>
                    <button type="button" class="btn btn-secondary ml-3 mt-4" onclick="_load_request_condition()"><i class="ion ion-refresh"></i> Refresh </button>
                </div>
            </div>
            <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                <div class="table-responsive card">
                    <table class="table table-bordered">
                        <thead class="bg-primary">
                            <tr>
                                <th rowspan="2">@Languages.chitiet</th>
                                <th rowspan="2">@Languages.Tinhtrangdon</th>
                                <th rowspan="2">@Languages.Trangthaidon</th>
                                <th rowspan="2">@Languages.mayeucau</th>
                                <th rowspan="2">Cost Center</th>
                                <th rowspan="2">@Languages.Ngayyeucau</th>

                                <th rowspan="2">@Languages.thoihanmuonnhan</th>
                                <th rowspan="2">@Languages.loaichiphi</th>
                                <th rowspan="2">@Languages.tongtien</th>
                                <th rowspan="2">@Languages.nguoitao</th>
                                <th colspan="3">@Languages.phongbanyeucau</th>
                                <th colspan="3">@Languages.phongtiepnhan</th>
                                <td colspan="2"></td>
                            </tr>
                            <tr id="loadhangmuc" >
                            </tr>
                        </thead>
                        <tbody id="list_approve"></tbody>
                    </table>
                    <ul class="pagination" id="pagination-controls"></ul>
                </div>
            </div>
        </div>
    </div>
</div>

<button id="modal-7" hidden></button>
<button id="modal-23" hidden></button>
<script src="~/scripts/request.js"></script>
<script>
    window.onload = function () {
        // Gọi hàm load dữ liệu khi trang đã tải xong
        _load_request_all();
    };
    function _load_request_all() {
        // Giả sử bạn lấy user hiện tại từ một biến global hoặc input ẩn
        var user = document.getElementById("us").innerHTML;
        // Thiết lập ngày mặc định (ví dụ: trong vòng 30 ngày qua)
        var startDate = "2026-05-01";
        var endDate = "2026-05-14";

        $.ajax({
            url: '/Request/view_rqall', // Thay YourControllerName bằng tên Controller của bạn
            type: 'GET',
            data: {
                StartDate: startDate,
                EndDate: endDate,
                us: user
            },
            success: function (data) {
              
                var html = '';
                if (data && data.length > 0) {
                    console.log(data);
                    $.each(data, function (index, item) {
                        html += '<tr>';
                        html += `<td><button class="btn btn-sm btn-info" onclick="viewDetail('${item.Id_Request}')">Xem</button></td>`;
                        html += `<td>${item.Type == 1 ? '<span class="badge badge-danger">Gấp</span>' : 'Thông thường'}</td>`;
                        html += `<td>${getStatusName(item.Status)}</td>`;
                        html += `<td>${item.Code_Request}</td>`;
                        html += `<td>${item.Cost_Center}</td>`;
                        html += `<td>${formatDate(item.Request_Date)}</td>`;
                        html += `<td>${formatDate(item.Dealine)}</td>`;
                        html += `<td>${item.Kind}</td>`;
                        html += `<td>${item.Total.toLocaleString()}</td>`;
                        html += `<td>${item.User_Create}</td>`;

                        // Các cột phê duyệt (Ví dụ hiển thị icon theo status)
                        html += `<td colspan="3" class="text-center">${item.Status}</td>`;
                        html += `<td colspan="3"></td>`;
                        html += '</tr>';
                    });
                } else {
                    html = '<tr><td colspan="15" class="text-center">Không có dữ liệu</td></tr>';
                }
                $('#list_approve').html(html);
            },
            error: function (err) {
                console.error("Lỗi khi tải dữ liệu:", err);
            }
        });
    }

    // Hàm bổ trợ định dạng ngày tháng
    function formatDate(dateString) {
        if (!dateString) return "";
        var date = new Date(dateString);
        return date.toLocaleDateString('vi-VN');
    }

    // Hàm bổ trợ lấy tên trạng thái
    function getStatusName(status) {
        var statuses = {
            "WAITCONFIRM": "Đang chờ xác nhận",
            "EXPORT": "Đang xuất kho",
            "PROGRESS": "Đang xử lý",
            "REFUSE": "Hủy bỏ",
            "ACCEPT": "Đang chờ nhận hàng",
            "DONE": "Hoàn thành"     
        };
        return statuses[status] || "Không xác định";
    }

  
</script>
