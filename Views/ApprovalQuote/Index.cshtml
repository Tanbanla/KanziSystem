@using PRJ_WAREHOUSE_BIVN.DTO
@{
    ViewData["Title"] = "Approval Quote";
    List<string> maDons = Model.listSoDon;
    List<ACC_NHOMVITRIDTO> phongBans = Model.listNhomVitri;
    List<MATERIALDTO> materials = Model.listMaterial;
    List<BaoGia_Request_of_QuotationDTO> listData = Model.listBaoGia;
    List<BaoGia_StatusDTO> listStatus = Model.listStatusBaoGia;
    List<BaoGia_StepDTO> listStep = Model.listStepBaoGia;
}
<head>
    <link rel="stylesheet" href="~/css/Approval_Quote.css" />
    <link rel="stylesheet" href="~/css/Quote.css" />
</head>

<div class="container-fluid" id="approval-quote">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-primary">TÌNH TRẠNG PHÊ DUYỆT ĐƠN BÁO GIÁ</h4>
            <small class="text-muted">Approval status for quotation requests</small>
        </div>
        <div class="btn-group mb-2" role="group">
            <button class="btn btn-success btn-sm" id="btnApprove" disabled><i class="fas fa-check"></i> Phê duyệt (<span id="approveCount">0</span>)</button>
            <div style="min-width: 12px;"></div>
            <button class="btn btn-danger btn-sm" id="btnReturn" disabled><i class="fas fa-undo"></i> Trả lại (<span id="returnCount">0</span>)</button>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white py-2">
            <h6 class="mb-0 text-secondary" style="color:black !important">Bộ lọc / Filters</h6>
        </div>
        <div class="card-body pt-3 pb-2">
            <form id="filterForm" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label for="tinhTrangPheDuyet" class="form-label small text-uppercase fw-semibold">Tình trạng phê duyệt</label>
                    <select id="tinhTrangPheDuyet" name="tinhTrangPheDuyet" class="form-control tinhTrangPheDuyet searchable-select">
                        <option value="">-- Tất cả --</option>
                        @foreach (var s in listStep)
                        {
                            <option value="@s.INT_StepNumber">@s.CHR_StepName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="maPhongBan" class="form-label small text-uppercase fw-semibold">Mã phòng ban</label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchPhongBan searchable-select">
                        <option value="" selected>Chọn phòng ban</option>
                        @foreach (var s in phongBans)
                        {
                            <option value="@s.Mahangmuctheovitri">@s.Mahangmuctheovitri - @s.Tenhangmuctheovitri</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="maDonBaoGia" class="form-label small text-uppercase fw-semibold">Mã đơn báo giá</label>
                    <select id="searchmaDonBaoGia" name="searchmaDonBaoGia" class="form-select searchmaDonBaoGia searchable-select">
                        <option value="" selected>Chọn đơn báo giá</option>
                        @foreach (var s in maDons)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="maHang" class="form-label small text-uppercase fw-semibold">Mã hàng</label>
                    <select id="searchMaterial" name="searchMaterial" class="form-select searchMaterial searchable-select">
                        <option value="" selected>Chọn mã nguyên vật liệu</option>
                        @foreach (var s in materials)
                        {
                            <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                        }
                    </select>
                </div>
                <div class="col-12 d-flex gap-2 mt-2">
                    <button type="button" id="btnSearch" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Tìm kiếm</button>
                    <div style="min-width: 12px;"></div>
                    <button type="button" id="btnClear" class="btn btn-outline-secondary btn-sm"><i class="fas fa-eraser"></i> Xóa lọc</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 text-secondary" style="color:black !important">Danh sách yêu cầu</h6>
            <small class="text-muted" id="summaryText">2 bản ghi</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 480px;">
                <table class="table table-sm table-hover table-bordered align-middle mb-0" id="approvalTable">
                    <thead class="table-header-custom">
                        <tr class="text-center align-middle">
                            <th style="width:40px"><input type="checkbox" id="selectAll" title="Chọn tất cả" /></th>
                            <th style="min-width:120px">Tình trạng đơn</th>
                            <th style="min-width:80px">Chi tiết</th>
                            <th style="min-width:140px">Mã đơn</th>
                            <th style="min-width:110px">Ngày yêu cầu<br></th>
                            <th style="min-width:140px">Tên phòng ban<br></th>
                            <th style="min-width:130px">PIC tạo đơn</th>
                            <th style="min-width:150px">Ngày muốn nhận hàng<br></th>
                            <th style="min-width:170px">Kỳ hạn lựa chọn NCC<br></th>
                        </tr>
                    </thead>
                    <tbody id="approvalTableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- Modal for detail -->
    <div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-xxl modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="detailModalTitle">Chi tiết đơn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-2">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover table-bordered align-middle mb-0" id="detailTable">
                            <thead class="table-header-custom">
                                <tr class="text-center align-middle">
                                    <th rowspan="2" class="title_column_stt" style="width:40px">&nbsp;</th>
                                    <th rowspan="2" class="title_column" style="min-width: 200px">Mã phòng ban</th>
                                    <th rowspan="2" class="title_column">Chủng loại hàng</th>
                                    <th rowspan="2" class="title_column">Phân loại(A/B/C/E/Non list)</th>
                                    <th rowspan="2" class="title_column">Mã thiết bị</th>
                                    <th rowspan="2" class="title_column" style="min-width: 230px">Mã hàng nội bộ</th>
                                    <th rowspan="2" class="title_column">Mã hàng của NCC</th>
                                    <th rowspan="2" class="title_column">Tên hàng VN dùng để mở thủ tục hải quan (dự thảo)</th>
                                    <th rowspan="2" class="title_column">Tên hàng EN</th>
                                    <th rowspan="2" class="title_column">Số lượng</th>
                                    <th rowspan="2" class="title_column">Đơn vị</th>
                                    <th colspan="6" class="title_column">Mô tả hàng hóa</th>
                                    <th rowspan="2" class="title_column" style="width: 100px">Yêu cầu ROHS</th>
                                    <th rowspan="2" class="title_column" style="width: 100px">Yêu cầu CO/CQ</th>
                                    <th rowspan="2" class="title_column" style="min-width: 200px">Yêu cầu MSDS</th>
                                    <th rowspan="2" class="title_column">Yêu cầu tiêu chuẩn an toàn</th>
                                    <th rowspan="2" class="title_column">File thiết kế</th>
                                    <th rowspan="2" class="title_column">Nhà sản xuất</th>
                                    <th rowspan="2" class="title_column" style="min-width: 250px">Nhà cung cấp</th>
                                    <th rowspan="2" class="title_column">Lấy báo giá</th>
                                    <th rowspan="2" class="title_column">Lý do</th>
                                    <th rowspan="2" class="title_column">Ngày muốn nhận hàng</th>
                                    <th rowspan="2" class="title_column">Kỳ hạn lựa chọn NCC</th>
                                    <th rowspan="2" class="title_column" style="width: 50px">Gấp</th>
                                    <th rowspan="2" class="title_column">Người yêu cầu</th>
                                </tr>
                                <tr class="text-center align-middle">
                                    <th class="title_column">Hình dáng</th>
                                    <th class="title_column">Chất liệu</th>
                                    <th class="title_column">Thành phần, hàm lượng (đối với hóa chất)</th>
                                    <th class="title_column">Kích thước(mm) (dài/rộng/cao)</th>
                                    <th class="title_column">Dùng cho máy/thiết bị/vị trí nào</th>
                                    <th class="title_column">Dùng để làm gì(tính năng)</th>
                                </tr>
                            </thead>
                            <tbody id="detailModalBody"></tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-close">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Custom dialog root -->
<div id="cmDialogOverlay" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmDialogTitle">
        <div class="cm-dialog-header">
            <h6 id="cmDialogTitle" class="cm-dialog-title">Thông báo</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="close" aria-label="Đóng">✕</button>
        </div>
        <div id="cmDialogBody" class="cm-dialog-body"></div>
        <div id="cmDialogFooter" class="cm-dialog-footer">
            <!-- Buttons injected by JS -->
        </div>
    </div>
</div>
<script>
    window.ApprovalData = {
        status: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(listStatus)),
        steps: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(listStep))
    };
</script>
@section Scripts {
   <script src="~/js/Approval_Quote.js"></script>
}