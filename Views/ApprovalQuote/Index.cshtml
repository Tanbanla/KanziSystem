@using PRJ_WAREHOUSE_BIVN.DTO
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Approval Quote";
    List<string> maDons = Model.listSoDon;
    List<ACC_NHOMVITRIDTO> phongBans = Model.listNhomVitri;
    List<MATERIALDTO> materials = Model.listMaterial;
    List<BaoGia_Request_of_QuotationDTO> listData = Model.listBaoGia;
    List<BaoGia_StatusDTO> listStatus = Model.listStatusBaoGia;
    List<BaoGia_StepDTO> listStep = Model.listStepBaoGia;

    // determine UI language and prepare localized display names for steps and status
    var uiLang = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName?.ToLowerInvariant() ?? "vi";
    Func<BaoGia_StepDTO, string> stepDisplay = s => uiLang == "en" ? (s.CHR_StepNameEN ?? s.CHR_StepName) : uiLang == "ja" ? (s.CHR_StepNameJP ?? s.CHR_StepName) : s.CHR_StepName;
    Func<BaoGia_StatusDTO, string> statusDisplay = s => uiLang == "en" ? (s.CHR_TenStatusEN ?? s.NVCHR_TenStatus) : uiLang == "ja" ? (s.CHR_TenStatusJP ?? s.NVCHR_TenStatus) : s.NVCHR_TenStatus;

    var localizedSteps = listStep.Select(s => new {
        s.INT_StepNumber,
        s.CHR_StepName,
        s.CHR_StepNameEN,
        s.CHR_StepNameJP,
        DisplayName = stepDisplay(s)
    }).ToList();

    var localizedStatus = listStatus.Select(s => new {
        s.VCHR_CodeStatus,
        s.NVCHR_TenStatus,
        s.CHR_TenStatusEN,
        s.CHR_TenStatusJP,
        DisplayName = statusDisplay(s)
    }).ToList();
}
<head>
    <link rel="stylesheet" href="~/css/Approval_Quote.css" />
    <link rel="stylesheet" href="~/css/Quote.css" />
</head>

<div class="container-fluid" id="approval-quote">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-primary">@Localizer["PageTitle"]</h4>
            @* <small class="text-muted">@Localizer["PageSubtitle"]</small> *@
        </div>
        <div class="btn-group mb-2" role="group">
            <button class="btn btn-success btn-sm" id="btnApprove" disabled><i class="fas fa-check"></i> @Localizer["Approve"] (<span id="approveCount">0</span>)</button>
            <div style="min-width: 12px;"></div>
            <button class="btn btn-danger btn-sm" id="btnReturn" disabled><i class="fas fa-undo"></i> @Localizer["Return"] (<span id="returnCount">0</span>)</button>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white py-2">
            <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["Filters"]</h6>
        </div>
        <div class="card-body pt-3 pb-2">
            <form id="filterForm" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label for="tinhTrangPheDuyet" class="form-label small text-uppercase fw-semibold">@Localizer["ApprovalStatusLabel"]</label>
                    <select id="tinhTrangPheDuyet" name="tinhTrangPheDuyet" class="form-control tinhTrangPheDuyet searchable-select">
                        <option value="">@Localizer["AllOption"]</option>
                        @foreach (var s in localizedSteps)
                        {
                            <option value="@s.INT_StepNumber">@s.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="maPhongBan" class="form-label small text-uppercase fw-semibold">@Localizer["DepartmentCode"]</label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchPhongBan searchable-select">
                        <option value="" selected>@Localizer["SelectDepartment"]</option>
                        @foreach (var s in phongBans)
                        {
                            <option value="@s.Mahangmuctheovitri">@s.Mahangmuctheovitri - @s.Tenhangmuctheovitri</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="maDonBaoGia" class="form-label small text-uppercase fw-semibold">@Localizer["QuotationCode"]</label>
                    <select id="searchmaDonBaoGia" name="searchmaDonBaoGia" class="form-select searchmaDonBaoGia searchable-select">
                        <option value="" selected>@Localizer["SelectQuotation"]</option>
                        @foreach (var s in maDons)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="maHang" class="form-label small text-uppercase fw-semibold">@Localizer["MaterialCode"]</label>
                    <select id="searchMaterial" name="searchMaterial" class="form-select searchMaterial searchable-select">
                        <option value="" selected>@Localizer["SelectMaterial"]</option>
                        @foreach (var s in materials)
                        {
                            <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                        }
                    </select>
                </div>
                <div class="col-12 d-flex gap-2 mt-2">
                    <button type="button" id="btnSearch" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> @Localizer["Search"]</button>
                    <div style="min-width: 12px;"></div>
                    <button type="button" id="btnExcelExport" class="btn btn-success btn-sm"><i class="fas fa-file-excel"></i> @Localizer["ExportToExcel"]</button>
                    <div style="min-width: 12px;"></div>
                    <button type="button" id="btnClear" class="btn btn-outline-secondary btn-sm"><i class="fas fa-eraser"></i> @Localizer["ClearFilters"]</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["RequestList"]</h6>
            <small class="text-muted" id="summaryText">@Localizer["SummaryFormat", 0]</small>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 480px;">
                <table class="table table-sm table-hover table-bordered align-middle mb-0" id="approvalTable">
                    <thead class="table-header-custom">
                        <tr class="text-center align-middle">
                            <th style="width:40px"><input type="checkbox" id="selectAll" title="@Localizer["SelectAll"]" /></th>
                            <th style="min-width:60px">@Localizer["No"]</th>
                            <th style="min-width:120px">@Localizer["OrderStatus"]</th>
                            <th style="min-width:80px">@Localizer["Detail"]</th>
                            <th style="min-width:140px">@Localizer["OrderCode"]</th>
                            <th style="min-width:110px">@Localizer["RequestDate"]<br></th>
                            <th style="min-width:140px">@Localizer["DepartmentName"]<br></th>
                            <th style="min-width:130px">@Localizer["CreatorPIC"]</th>
                            <th style="min-width:150px">@Localizer["DesiredReceiveDate"]<br></th>
                            <th style="min-width:170px">@Localizer["SupplierSelectionDeadline"]<br></th>
                        </tr>
                    </thead>
                    <tbody id="approvalTableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <!-- Modal for detail -->
    <div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen modal-dialog-scrollable">
            <div class="modal-content">
                <!-- Header với thiết kế giống phiếu yêu cầu -->
                <div class="modal-header" style="background-color: #fff9e1; border-bottom: 2px solid #dee2e6; color: #000;">
                    <div class="w-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="modal-title fw-bold" id="detailModalTitle" style="color: #000;">
                                @Localizer["DetailModalTitle"] - <span id="madonhang" class="text-primary"></span>
                            </h4>
                            <button type="button" class="btn btn-link p-1" data-bs-dismiss="modal" aria-label="@Localizer["Close"]">
                                <i class="fas fa-times fa-lg"></i>
                            </button>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <span class="fw-bold" style="color: #000;">@Localizer["ReceivingDepartmentLabel"]</span>
                                <span id="khoi" class="bg-white px-3 py-1 rounded border" style="color: #000;"></span>
                            </div>
                            <div class="col-md-6 text-end">
                                <span class="badge bg-warning text-dark p-2" id="urgent-badge" style="display:none;">
                                    <i class="ion ion-alert-circled"></i> @Localizer["UrgentBadgeText"]
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Body với thông tin chi tiết -->
                <div class="modal-body p-3" style="background-color: #fff; color: #000;">
                    <!-- Thông tin yêu cầu -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm mb-0" style="background-color: #fff; color: #000;">
                                    <tr>
                                        @* <td class="fw-bold bg-light" style="width: 15%;">@Localizer["DeptCodeLabel"]</td> *@
                                        @* <td style="width: 18%; background-color: #fff9e1;" id="mbp"></td> *@
                                        <td class="fw-bold bg-light" style="width: 15%;">@Localizer["DeptCostCenterLabel"]</td>
                                        <td style="width: 18%; background-color: #fff9e1;" id="mpb_yc"></td>
                                        <td class="fw-bold bg-light" style="width: 15%;">@Localizer["DeptNameLabel"]</td>
                                        <td style="width: 19%; background-color: #fff9e1;" id="tenphongban"></td>
                                    </tr>
                                    <tr>
                                        @* <td class="fw-bold bg-light">@Localizer["LineLabel"]</td> *@
                                        @* <td style="background-color: #fff9e1;" id="chuyen"></td> *@
                                        <td class="fw-bold bg-light">@Localizer["RequestDateLabel"]</td>
                                        <td style="background-color: #fff9e1;" id="nyc"></td>
                                        <td class="fw-bold bg-light">@Localizer["DesiredDeadlineLabel"]</td>
                                        <td style="background-color: #fff9e1;" id="thmm"></td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Tiêu đề chi tiết hàng hóa -->
                    <div class="row mb-2">
                        <div class="col-12">
                            <h5 class="fw-bold" style="color: #0d6efd; border-bottom: 2px solid #0d6efd; padding-bottom: 5px;">
                                <i class="ion ion-clipboard"></i> @Localizer["GoodsDetailTitle"]
                            </h5>
                        </div>
                    </div>

                    <!-- Bảng chi tiết -->
                    <div class="table-responsive-fixed">
                        <table class="table table-bordered table-hover align-middle" id="detailTable" style="font-size: 13px; background-color:#fff; color:#000;">
                            <thead>
                                <!-- Header chính -->
                                <tr class="text-center align-middle" style="background-color: #e9ecef; color:#000;">
                                    <th rowspan="2" style="width: 40px; background-color: #dee2e6; color:#000;">@Localizer["STT"]</th>
                                    <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["SystemCode"]</th>
                                    <th rowspan="2" style="min-width: 150px; background-color: #dee2e6; color:#000;">@Localizer["InternalMaterialCodeShort"]</th>
                                    <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["Category"]</th>
                                    <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["Classification"]</th>
                                    <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["SupplierItemCode"]</th>
                                    <th rowspan="2" style="min-width: 200px; background-color: #dee2e6; color:#000;">@Localizer["ItemNameVNEN"]</th>
                                    <th rowspan="2" style="min-width: 80px; background-color: #dee2e6; color:#000;">@Localizer["QuantityShort"]</th>
                                    <th rowspan="2" style="min-width: 70px;background-color: #dee2e6; color:#000;">@Localizer["UnitShort"]</th>
                                    <th colspan="6" style="background-color: #d3d9e5; color:#000;">@Localizer["DescriptionGroup"]</th>
                                    <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["DesignFile"]</th>
                                    <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["Manufacturer"]</th>
                                    <th rowspan="2" style="min-width: 120px; background-color: #dee2e6; color:#000;">@Localizer["VendorCode"]</th>
                                    <th rowspan="2" style="min-width: 150px; background-color: #dee2e6; color:#000;">@Localizer["Supplier"]</th>
                                    <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["ROHSRequirement"]</th>
                                    <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["COCQRequirement"]</th>
                                    <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["MSDSRequirement"]</th>
                                    <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["SafetyStandardRequirement"]</th>
                                    <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["SupplierSelectionDeadline"]</th>
                                    <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["UrgentShort"]</th>
                                    <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["GetQuotation"]</th>
                                    <th rowspan="2" style="min-width: 100px; background-color: #dee2e6; color:#000;">@Localizer["Reason"]</th>
                                </tr>
                                <!-- Header phụ -->
                                <tr class="text-center align-middle" style="background-color: #e9ecef; color:#000;">
                                    <th style="min-width: 80px; color:#000;">@Localizer["ShapeShort"]</th>
                                    <th style="min-width: 80px; color:#000;">@Localizer["MaterialShort"]</th>
                                    <th style="min-width: 100px; color:#000;">@Localizer["CompositionShort"]</th>
                                    <th style="min-width: 100px; color:#000;">@Localizer["DimensionsShort"]</th>
                                    @* <th style="min-width: 100px; color:#000;">@Localizer["LineLabel"]</th> *@
                                    <th style="min-width: 120px; color:#000;">@Localizer["UsedPositionShort"]</th>
                                    <th style="min-width: 150px; color:#000;">@Localizer["PurposeFeatureShort"]</th>
                                </tr>
                            </thead>
                            <tbody id="detailModalBody">
                                <tr class="text-center">
                                    <td colspan="20" class="text-muted py-4" style="color:#000; background-color:#fff;">
                                        <i class="ion ion-load-c ion-spin"></i> @Localizer["LoadingData"]
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Thông tin bổ sung -->
                    <div class="row mt-4">
                        <div class="col-md-8">
                            <div class="card border" style="background-color:#fff; color:#000;">
                                <div class="card-header bg-light py-2">
                                    <strong>@Localizer["ApprovalFlowTitle"]</strong>
                                </div>
                                <div class="card-body p-2" style="font-size: 11px; background-color: #f8f9fa; color:#000;">
                                    <p class="mb-1">@Localizer["ApprovalFlowLine1"]</p>
                                    <p class="mb-1">@Localizer["ApprovalFlowLine2"]</p>
                                    <p class="mb-1">@Localizer["ApprovalFlowLine3"]</p>
                                    <p class="mb-0 text-primary">@Localizer["ApprovalFlowLine4"]</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border" style="background-color:#fff; color:#000;">
                                <div class="card-header bg-light py-2">
                                    <strong>@Localizer["AdditionalInfoTitle"]</strong>
                                </div>
                                <div class="card-body p-2">
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr>
                                            <td class="fw-bold p-1">@Localizer["RequesterLabel"]</td>
                                            <td class="p-1" id="requester">-</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer với buttons -->
                <div class="modal-footer" style="background-color: #f8f9fa; border-top: 1px solid #dee2e6; color:#000;">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <div>
                            <span class="text-muted" id="request-info" style="color:#000;">
                                <i class="ion ion-document-text"></i> @Localizer["FooterID"] <span id="id_request"></span> |
                                @Localizer["FooterStep"] <span id="step"></span> |
                                @Localizer["FooterRegency"] <span id="regency"></span>
                            </span>
                        </div>
                        <div>
                            <button type="button" class="btn btn-success" id="modalApprove">
                                <i class="ion ion-android-done-all"></i> @Localizer["ApproveButton"]
                            </button>
                            <button type="button" class="btn btn-danger" id="modalReject">
                                <i class="ion ion-android-close"></i> @Localizer["RejectButton"]
                            </button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="ion ion-android-close"></i> @Localizer["CloseButton"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Custom dialog root -->
<div id="cmDialogOverlay" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmDialogTitle">
        <div class="cm-dialog-header">
            <h6 id="cmDialogTitle" class="cm-dialog-title">@Localizer["Notification"]</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="close" aria-label="@Localizer["Close"]">✕</button>
        </div>
        <div id="cmDialogBody" class="cm-dialog-body"></div>
        <div id="cmDialogFooter" class="cm-dialog-footer">
            <!-- Buttons injected by JS -->
        </div>
    </div>
</div>
<script>
    window.ApprovalData = {
        status: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizedStatus)),
        steps: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(localizedSteps)),
        uiland: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(uiLang))
    };
    window.i18nApproval = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        PageTitle = Localizer["PageTitle"].Value,
        PageSubtitle = Localizer["PageSubtitle"].Value,
        Approve = Localizer["Approve"].Value,
        Return = Localizer["Return"].Value,
        Filters = Localizer["Filters"].Value,
        ApprovalStatusLabel = Localizer["ApprovalStatusLabel"].Value,
        AllOption = Localizer["AllOption"].Value,
        DepartmentCode = Localizer["DepartmentCode"].Value,
        SelectDepartment = Localizer["SelectDepartment"].Value,
        QuotationCode = Localizer["QuotationCode"].Value,
        SelectQuotation = Localizer["SelectQuotation"].Value,
        MaterialCode = Localizer["MaterialCode"].Value,
        SelectMaterial = Localizer["SelectMaterial"].Value,
        Search = Localizer["Search"].Value,
        ClearFilters = Localizer["ClearFilters"].Value,
        RequestList = Localizer["RequestList"].Value,
        SummaryFormat = Localizer["SummaryFormat", "{0}"].Value,
        SelectAll = Localizer["SelectAll"].Value,
        OrderStatus = Localizer["OrderStatus"].Value,
        Detail = Localizer["Detail"].Value,
        OrderCode = Localizer["OrderCode"].Value,
        RequestDate = Localizer["RequestDate"].Value,
        DepartmentName = Localizer["DepartmentName"].Value,
        CreatorPIC = Localizer["CreatorPIC"].Value,
        DesiredReceiveDate = Localizer["DesiredReceiveDate"].Value,
        SupplierSelectionDeadline = Localizer["SupplierSelectionDeadline"].Value,
        DetailButton = Localizer["Detail"].Value,
        DetailModalTitle = Localizer["DetailModalTitle"].Value,
        DetailModalTitleFormat = Localizer["DetailModalTitleFormat", "{0}", "{1}"].Value,
        DialogCancel = Localizer["Cancel"].Value,
        DialogConfirm = Localizer["Confirm"].Value,
        InputReasonTitle = Localizer["InputReasonTitle"].Value,
        InputReasonPlaceholder = Localizer["InputReasonPlaceholder"].Value,
        ReasonRequired = Localizer["ReasonRequired"].Value,
        ApproveSuccess = Localizer["ApproveSuccess"].Value,
        ApproveFailed = Localizer["ApproveFailed", "{0}"].Value,
        ApproveError = Localizer["ApproveError"].Value,
        ReturnSuccess = Localizer["ReturnSuccess"].Value,
        ReturnFailed = Localizer["ReturnFailed", "{0}"].Value,
        ReturnError = Localizer["ReturnError"].Value,
        Unknown = Localizer["Unknown"].Value,
        SearchEllipsis = Localizer["SearchEllipsis"].Value,
        NoResults = Localizer["NoResults"].Value,
        SelectPlaceholder = Localizer["SelectPlaceholder"].Value,
        Notification = Localizer["Notification"].Value,
        Close = Localizer["Close"].Value,
        MsgSusscesAprover = Localizer["MsgSusscesAprover"].Value,
        MSGFailedApprover = Localizer["MSGFailedApprover"].Value,
        MSGErrorApprover = Localizer["MSGErrorApprover"].Value,
        MSGReturnFailed = Localizer["MSGReturnFailed"].Value,
        MSGReturnOK = Localizer["MSGReturnOK"].Value,
        MSGExportOK = Localizer["MSGExportOK"].Value
    }));
</script>
@section Scripts {
    <script src="~/js/Approval_Quote.js"></script>
    <script>
        (function() {
            // Ensure panel and overlay are appended to body to avoid being under navbar stacking contexts
            var panel = document.getElementById('detailModal');
            if (panel && panel.parentElement !== document.body) {
                document.body.appendChild(panel);
            }
        })();
    </script>
}