@{ ViewData["Title"] = "Phê duyệt khảo sát"; }
<link rel="stylesheet" href="~/css/survey/survey.css" asp-append-version="true" />
<div class="survey-page">
    <div class="survey-hero"><div><div class="survey-eyebrow"><i class="fas fa-user-check mr-1"></i> Xin khảo sát</div><h1 class="survey-title">Phê duyệt và lựa chọn thông tin</h1><p class="survey-subtitle">Đánh giá kết quả khảo sát, chọn phương án phù hợp và chuyển bước tiếp theo.</p></div><i class="fas fa-check-double survey-hero-icon"></i></div>
