@{
    ViewData["Title"] = "Tiếp nhận đơn khảo sát";
}
<link rel="stylesheet" href="~/css/survey/survey.css" asp-append-version="true" />
<div class="survey-page">
    <div class="survey-hero"><div><div class="survey-eyebrow"><i class="fas fa-inbox mr-1"></i> Xin khảo sát</div><h1 class="survey-title">Tiếp nhận và xác nhận đơn</h1><p class="survey-subtitle">Kiểm tra nội dung, phân công xử lý và xác nhận các đơn mới.</p></div><i class="fas fa-file-signature survey-hero-icon"></i></div>
    <div class="survey-kpis"><div class="survey-kpi"><span class="survey-kpi-icon amber"><i class="fas fa-hourglass-half"></i></span><div><strong>08</strong><small>Chờ tiếp nhận</small></div></div><div class="survey-kpi"><span class="survey-kpi-icon blue"><i class="fas fa-eye"></i></span><div><strong>03</strong><small>Đang xem xét</small></div></div><div class="survey-kpi"><span class="survey-kpi-icon green"><i class="fas fa-circle-check"></i></span><div><strong>24</strong><small>Đã xác nhận tháng này</small></div></div><div class="survey-kpi"><span class="survey-kpi-icon red"><i class="fas fa-clock-rotate-left"></i></span><div><strong>02</strong><small>Quá hạn phản hồi</small></div></div></div>
    <div class="card"><div class="survey-card-header"><div><h2 class="survey-section-title">Đơn chờ tiếp nhận</h2><p class="survey-section-hint">Chọn một đơn để xem chi tiết và xác nhận xử lý.</p></div><button class="btn btn-light btn-sm"><i class="fas fa-arrows-rotate mr-1"></i>Làm mới</button></div><div class="survey-card-body"><div class="survey-toolbar mb-3"><div class="survey-search"><div class="input-group"><span class="input-group-text"><i class="fas fa-search"></i></span><input class="form-control" placeholder="Tìm mã đơn, tên đơn hoặc người gửi"></div></div><select class="form-select" style="max-width:190px"><option>Tất cả loại khảo sát</option><option>Khảo sát hiện trạng</option><option>Khảo sát kỹ thuật</option></select><button class="btn btn-outline-secondary"><i class="fas fa-filter mr-1"></i>Lọc</button></div><div class="table-responsive"><table class="table survey-table table-hover"><thead><tr><th>Mã đơn</th><th>Tên đơn khảo sát</th><th>Người gửi</th><th>Ngày gửi</th><th>Hạn xử lý</th><th>Trạng thái</th><th class="text-right">Thao tác</th></tr></thead><tbody><tr><td class="survey-code">KS-2026-008</td><td><strong>Khảo sát khu vực kho thành phẩm</strong><small class="d-block text-muted">Khảo sát hiện trạng</small></td><td>Nguyễn Văn An</td><td>21/09/2026</td><td>24/09/2026</td><td><span class="survey-status pending">Chờ tiếp nhận</span></td><td class="text-right"><button class="btn btn-primary btn-sm"><i class="fas fa-file-signature mr-1"></i>Tiếp nhận</button></td></tr><tr><td class="survey-code">KS-2026-007</td><td><strong>Đo đạc mặt bằng dây chuyền A</strong><small class="d-block text-muted">Khảo sát kỹ thuật</small></td><td>Trần Minh Đức</td><td>20/09/2026</td><td>23/09/2026</td><td><span class="survey-status pending">Chờ tiếp nhận</span></td><td class="text-right"><button class="btn btn-primary btn-sm"><i class="fas fa-file-signature mr-1"></i>Tiếp nhận</button></td></tr><tr><td class="survey-code">KS-2026-006</td><td><strong>Khảo sát cải tạo phòng họp</strong><small class="d-block text-muted">Khảo sát mặt bằng</small></td><td>Lê Thị Hương</td><td>19/09/2026</td><td>22/09/2026</td><td><span class="survey-status review">Đang xem xét</span></td><td class="text-right"><button class="btn btn-outline-primary btn-sm"><i class="fas fa-eye mr-1"></i>Xem chi tiết</button></td></tr></tbody></table></div></div></div>
</div>
