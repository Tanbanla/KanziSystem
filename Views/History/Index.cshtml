@using PRJ_WAREHOUSE_BIVN.DTO
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = "Lịch sử yêu cầu báo giá";
    List<MATERIALDTO> listMaterials = Model.DanhSachVatTu;
    List<DEPARTMENTDTO> listPhong = Model.DanhSachNhomViTri;
    List<IM_NCC_NEWDTO> listNCC = Model.DanhSachNhaCungCap;
    List<BaoGia_StatusDTO> listStatus = Model.DanhSachStatus;
    List<string> madons = Model.DanhSachMaDon;
    List<string> categoryS = Model.DanhSachCategory;
    List<string> phanLoais = ["A", "B", "C", "E","I" ,"NO LIST"];
    string role = Model.Role;
     // determine UI language and prepare localized display names for steps and status
    var uiLang = System.Threading.Thread.CurrentThread.CurrentUICulture.TwoLetterISOLanguageName?.ToLowerInvariant() ?? "vi";
    Func<BaoGia_StatusDTO, string> statusDisplay = s => uiLang == "en" ? (s.CHR_TenStatusEN ?? s.NVCHR_TenStatus) : uiLang == "ja" ? (s.CHR_TenStatusJP ?? s.NVCHR_TenStatus) : s.NVCHR_TenStatus;
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
    <link rel="stylesheet" href="~/css/HistoryQuote.css" />
</head>

<div class="container-fluid" id="quote-history">
        <!-- Global loading overlay -->
    <div id="globalLoading" aria-hidden="true">
        <div class="loader-box">
            <div class="spinner" aria-hidden="true"></div>
            <div class="loader-msg">Đang xử lý...</div>
        </div>
    </div>
    <!-- Modal: return reason (separate from delete) -->
    <div class="modal fade" id="returnReasonModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer["ReturnReasonTitle"]</h5>
                    <button type="button" class="btn btn-link p-1" data-bs-dismiss="modal" aria-label="@Localizer["Close"]">
                        <i class="fas fa-times fa-lg"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label for="returnReasonText" class="form-label small">@Localizer["ReturnReasonLabel"]</label>
                        <textarea id="returnReasonText" class="form-control" rows="4" placeholder="@Localizer["EnterReturnReasonPlaceholder"]"></textarea>
                        <div id="returnReasonNotice" class="text-danger small mt-2" style="display:none;">@Localizer["ReturnReasonRequired"]</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-primary" id="confirmReturnWithReason">@Localizer["DialogOk"]</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal: delete reason -->
    <div class="modal fade" id="deleteReasonModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer["DeleteReasonTitle"]</h5>
                    <button type="button" class="btn btn-link p-1" data-bs-dismiss="modal" aria-label="@Localizer["Close"]">
                        <i class="fas fa-times fa-lg"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label for="deleteReasonText" class="form-label small">@Localizer["DeleteReasonLabel"]</label>
                        <textarea id="deleteReasonText" class="form-control" rows="4" placeholder="@Localizer["EnterDeleteReasonPlaceholder"]"></textarea>
                        <div id="deleteReasonNotice" class="text-danger small mt-2" style="display:none;">@Localizer["DeleteReasonRequired"]</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteWithReason">@Localizer["Delete"]</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal: select next approver -->
    <div class="modal fade" id="selectApproverModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Localizer["SelectNextApprover"]</h5>
                    <button type="button" class="btn btn-link p-1" data-bs-dismiss="modal" aria-label="@Localizer["Close"]">
                        <i class="fas fa-times fa-lg"></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="mb-2">
                        <label for="selectNextApprover" class="form-label small">@Localizer["NextApproverLabel"]</label>
                        <select id="selectNextApprover" class="form-select">
                            <option value="">@Localizer["SelectPlaceholder"]</option>
                        </select>
                    </div>
                    <div id="selectApproverNotice" class="text-danger small" style="display:none;">@Localizer["SelectApproverRequired"]</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="button" class="btn btn-primary" id="confirmSelectApprover">@Localizer["Confirm"]</button>
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0 fw-bold text-primary">@Localizer["PageTitle"]</h4>
            <small class="text-muted">@Localizer["PageSubtitle"]</small>
        </div>
        <div class="btn-toolbar" role="toolbar" aria-label="Toolbar">
            <div class="btn-group me-2 mb-2" role="group">
                <button type="button" class="btn btn-outline-success" id="btnImportHistory"><i class="fas fa-file-import"></i> @Localizer["ImportFileExcel"]</button>
            </div>
            <div style="margin-right: 6px;"></div>
            <div class="btn-group me-2 mb-2" role="group">
                <button type="button" class="btn btn-outline-primary" id="btnExportHistory"><i class="fas fa-file-export"></i> @Localizer["Export"]</button>
            </div>
            <div style="margin-right: 6px;"></div>
            <div class="btn-group me-2 mb-2" role="group" >
                <button type="button" class="btn btn-outline-danger" id="btnExportManaHistory"><i class="fas fa-file-download"></i> @Localizer["ExportTable"]</button>
            </div>
        </div>
    </div>
    <!-- Part 1: Dashboard summary -->
    <section class="history-section mb-4">
        <div class="history-section-header d-flex align-items-center">
            <h6 class="mb-0 fw-bold text-dark">@Localizer["DashboardSummary"]</h6>
            <div style="margin-left: 12px;"></div>
            <div>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnToggleDashboardSummary" aria-expanded="false">
                    <i class="fas fa-eye-slash me-1" aria-hidden="true"></i>
                    <span id="btnToggleDashboardSummaryText">@Localizer["Hide"].Value</span>
                </button>
            </div>
        </div>
        <div id="dashboardSummaryContent" class="row g-3 history-summary-grid">
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm history-summary-card h-100">
                    <div class="card-header bg-white">
                        <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["SummaryTable1Title"]</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="summary-table mb-0">
                            <tbody>
                                <tr>
                                    <td>@Localizer["TotalWaitingItems"]</td>
                                    <td><strong id="statWaitingSupplier">0</strong></td>
                                </tr>
                                <tr>
                                    <td>@Localizer["TotalSelectedItems"]</td>
                                    <td><strong id="statSelectedSupplier">0</strong></td>
                                </tr>
                                <tr>
                                    <td>@Localizer["TotalBothStatusItems"]</td>
                                    <td><strong id="statBothStatusSupplier">0</strong></td>
                                </tr>
                                <tr>
                                    <td>@Localizer["TotalAllItems"]</td>
                                    <td><strong id="statTotalSupplier">0</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm history-summary-card h-100">
                    <div class="card-header bg-white">
                        <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["SummaryTable2Title"]</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="summary-table mb-0">
                            <tbody>
                                <tr>
                                    <td><span class="status-dot bg-primary"></span>@Localizer["DueSoon"]</td>
                                    <td><strong id="statDueSoon">0</strong></td>
                                </tr>
                                <tr>
                                    <td><span class="status-dot bg-warning"></span>@Localizer["OneDayLeft"]</td>
                                    <td><strong id="statOneDayLeft">0</strong></td>
                                </tr>
                                <tr>
                                    <td><span class="status-dot bg-info"></span>@Localizer["Remaining"]</td>
                                    <td><strong id="statRemaining">0</strong></td>
                                </tr>
                                <tr>
                                    <td><span class="status-dot bg-danger"></span>@Localizer["Overdue"]</td>
                                    <td><strong id="statOverdue">0</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card shadow-sm history-summary-card h-100">
                    <div class="card-header bg-white">
                        <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["SummaryTable3Title"]</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="summary-table mb-0">
                            <tbody>
                                <tr>
                                    <td>@Localizer["WaitDeptPic"]</td>
                                    <td><strong id="statWaitDeptPic">0</strong></td>
                                </tr>
                                <tr>
                                    <td>@Localizer["WaitDeptQlsc"]</td>
                                    <td><strong id="statWaitDeptQlsc">0</strong></td>
                                </tr>
                                <tr>
                                    <td>@Localizer["WaitDeptQltc"]</td>
                                    <td><strong id="statWaitDeptQltc">0</strong></td>
                                </tr>
                                <tr>
                                    <td>@Localizer["WaitOrderPic"]</td>
                                    <td><strong id="statWaitOrderPic">0</strong></td>
                                </tr>
                                <tr>
                                    <td>@Localizer["WaitOrderQlsc"]</td>
                                    <td><strong id="statWaitOrderQlsc">0</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
          @*   <div class="col-12 col-sm-6 col-xl-3" hidden>
                <div class="card shadow-sm history-summary-card h-100">
                    <div class="card-header bg-white">
                        <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["SummaryTable4Title"]</h6>
                    </div>
                    <div class="card-body p-0">
                        <table class="summary-table mb-0">
                            <tbody>
                                <tr>
                                    <td>@Localizer["CompletedOrders"]</td>
                                    <td><strong id="statCompletedOrders">0</strong></td>
                                </tr>
                                <tr>
                                    <td>@Localizer["ProcessingOrders"]</td>
                                    <td><strong id="statProcessingOrders">0</strong></td>
                                </tr>
                                <tr>
                                    <td>@Localizer["UnprocessedOrders"]</td>
                                    <td><strong id="statUnprocessedOrders">0</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div> *@
        </div>
    </section>

    <!-- Part 2 + 3: Combined filter area and data table -->
    <section class="history-section mb-3">
    <div class="card shadow-sm h-100">
        <div class="card-header bg-white border-0 pb-1">
            <h6 class="mb-0 fw-bold text-dark">@Localizer["Filters"]</h6>
        </div>
        <div class="card-body pt-2 pb-3">
            <form id="historyFilterForm" class="row g-2 history-filter-grid">
                <div class="col-12 col-md-6 col-xl-3">
                    <label for="searchMaDon" class="form-label">@Localizer["OrderCode"]</label>
                    <select id="searchMaDon" name="searchMaDon" class="form-control searchable-select">
                        <option value="">@Localizer["SelectOrderCode"]</option>
                        @foreach (var s in madons)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <label for="searchPhongBan" class="form-label">@Localizer["Department"]</label>
                    <select id="searchPhongBan" name="searchPhongBan" class="form-select searchable-select">
                        <option value="" selected>@Localizer["SelectDepartment"]</option>
                        @foreach (var s in listPhong)
                        {
                            <option value="@s.Cost_Center">@s.Cost_Center - @s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <label for="searchNguoiTao" class="form-label">@Localizer["Creator"]</label>
                    <input type="text" class="form-control" id="searchNguoiTao" name="searchNguoiTao" placeholder="@Localizer["EnterCreator"]">
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <label for="searchMaVatTu" class="form-label">@Localizer["MaterialCode"]</label>
                    <select id="searchMaVatTu" name="searchMaVatTu" class="form-select searchMaVatTu searchable-select" data-remote="true" data-api="/Material/SearchMaterialView" data-page-size="500">
                        <option value="" selected>@Localizer["SelectMaterialCode"]</option>
                        @foreach (var s in listMaterials)
                        {
                            <option value="@s.Material_Code">@s.Material_Code - @s.Material_Name_VN</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <label for="searchNhaCungCap" class="form-label">@Localizer["Supplier"]</label>
                    <select id="searchNhaCungCap" name="searchNhaCungCap" class="form-select searchable-select">
                        <option value="" selected>@Localizer["SelectSupplier"]</option>
                        @foreach (var s in listNCC)
                        {
                            <option value="@s.Ma">@s.Ma - @s.Ten</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <label for="statusFilter" class="form-label small text-uppercase fw-semibold">@Localizer["OrderStatus"]</label>
                    <select id="statusFilter" name="statusFilter" class="form-control searchable-select">
                        <option value="" selected>@Localizer["All"]</option>
                        <option value="APPROVAL">@Localizer["Approving"]</option>
                        <option value="WAIT">@Localizer["Waiting"]</option>
                        <option value="RETURN">@Localizer["RETURN"]</option>
                        <option value="DONE">@Localizer["DONE"]</option>
                        <option value="DELETE">@Localizer["DELETE"]</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label">@Localizer["DateRange"]</label>
                    <div class="d-flex gap-2">
                        <input type="date" class="form-control" id="dateFrom" name="dateFrom">
                        <input type="date" class="form-control" id="dateTo" name="dateTo">
                    </div>
                </div>
                <div class="col-12 col-md-6 col-xl-3 d-flex gap-2 align-items-end history-filter-actions">
                    <button type="button" class="btn btn-primary flex-fill" id="btnApplyFilters"><i class="fas fa-search"></i> @Localizer["Filter"]</button>
                    <button type="button" class="btn btn-outline-secondary flex-fill" id="btnResetFilters"><i class="fas fa-undo"></i> @Localizer["Reset"]</button>
                </div>
            </form>
        </div>
        <div class="card-header bg-white border-top">
            <h6 class="mb-0 text-secondary" style="color:black !important">@Localizer["HistoryTableTitle"]</h6>
        </div>
        <div class="card-body px-0 pt-0">
            <div class="table-responsive" id="historyGroupTableContainer">
                <table class="approval-table">
                    <thead>
                        <tr class="legend-row">
                             <th colspan="5"></th>
                             <th colspan="5" class="legend-cell">
                                 <div class="legend compact mb-0">
                                     <div class="item"><span class="swatch yellow" aria-hidden="true"></span><span>@Localizer["LegendRejectedQuote"]</span></div>
                                     <div class="item"><span class="swatch green" aria-hidden="true"></span><span>@Localizer["LegendSupplierSubmitted"]</span></div>
                                     <div class="item"><span class="swatch white" aria-hidden="true"></span><span>@Localizer["LegendSupplierNotSubmitted"]</span></div>
                                     <div class="item"><span class="swatch selected" aria-hidden="true"></span><span>@Localizer["LegendSelectedSupplier"]</span></div>
                                      <div class="item"><span class="swatch red" aria-hidden="true"></span><span>@Localizer["NotQuotation"]</span></div>
                                 </div>
                             </th>
                             <th></th>
                             <th class="legend-cell">
                                 <div class="legend compact mb-0 justify-content-center">
                                     <div class="item"><span class="swatch red" aria-hidden="true"></span><span>@Localizer["LegendOverdue"]</span></div>
                                 </div>
                             </th>
                             <th></th>
                             <th colspan="8" class="legend-cell">
                                 <div class="legend compact mb-0">
                                     <div class="item"><span class="swatch green" aria-hidden="true"></span><span>@Localizer["SubmittedApprover"]</span></div>
                                     <div class="item"><span class="swatch white" aria-hidden="true"></span><span>@Localizer["WaitingApprover"]</span></div>
                                 </div>
                             </th>
                             <th colspan="2"></th>
                        </tr>
                        <tr>
                            <th rowspan="2">@Localizer["No"]</th>
                            <th rowspan="2">@Localizer["OrderNo"]</th>
                            <th rowspan="2">@Localizer["InternalCode"]</th>
                            <th rowspan="2">@Localizer["VendorGoodCode"]<br/>Vendor's good code</th>
                            <th rowspan="2">@Localizer["PartNameEnglish"]<br/>Part name (English)</th>
                            <th rowspan="2">@Localizer["Supplier1"]</th>
                            <th rowspan="2">@Localizer["Supplier2"]</th>
                            <th rowspan="2">@Localizer["Supplier3"]</th>
                            <th rowspan="2">@Localizer["Supplier4"]</th>
                            <th rowspan="2">@Localizer["Supplier5"]</th>
                            <th rowspan="2">@Localizer["SelectedSupplierReason"]</th>
                            <th rowspan="2">@Localizer["SelectionDeadline"]</th>
                            <th rowspan="2">@Localizer["RequesterUser"]</th>
                            <th class="group1" colspan="4">@Localizer["ApprovalOrderGroup"]</th>
                            <th class="group2" colspan="4">@Localizer["ApprovalSupplierGroup"]</th>
                            <th class="group4" rowspan="2">@Localizer["Status"]</th>
                            <th class="group4" rowspan="2">@Localizer["Action"]</th>
                        </tr>
                        <tr>
                            <th class="group1">QLSC</th>
                            <th class="group1">QLTC</th>
                            <th class="group1">PUR PIC</th>
                            <th class="group1">PUR QLSC</th>

                            <th class="group2">PUR PIC</th>
                            <th class="group2">QLSC</th>
                            <th class="group2">QLTC</th>
                            <th class="group2">QLCC</th>                     
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Data table -->
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Pagination -->
        <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
             <div class="small text-muted" style="margin-right: 8px;" id="historyPaginationInfo">@Localizer["PaginationInfo", "0", "0", "0"].Value</div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <label for="historyPageSize" class="small text-muted mb-0">@Localizer["PageSize"].Value</label>
                <select id="historyPageSize" class="form-select form-select-sm" style="width:90px;margin-left: 4px;">
                    <option value="20">20</option>
                    <option value="50" selected>50</option>
                    <option value="100">100</option>
                    <option value="200">200</option>
                </select>
                <nav>
                    <ul class="pagination pagination-sm mb-0" id="historyPagination">
                        <li class="page-item disabled"><button class="page-link" data-page="prev">«</button></li>
                        <li class="page-item active"><button class="page-link" data-page="1">1</button></li>
                        <li class="page-item disabled"><button class="page-link" data-page="next">»</button></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
    </section>
</div>
<!-- Dialogs reused from Quote -->
<div id="cmDialogOverlay" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmDialogTitle">
        <div class="cm-dialog-header">
            <h6 id="cmDialogTitle" class="cm-dialog-title">@Localizer["Notification"]</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="close" aria-label="@Localizer["Close"]">✕</button>
        </div>
        <div id="cmDialogBody" class="cm-dialog-body"></div>
        <div id="cmDialogFooter" class="cm-dialog-footer"></div>
    </div>
    <div class="cm-dialog-backdrop" data-cm-action="overlay"></div>
</div>
<script>
    window.HistoryData = {
        role : @Html.Raw(System.Text.Json.JsonSerializer.Serialize(role))
    };
    window.apiBaseUrl = '@ViewBag.ApiBaseUrl';
    window.i18nHistoryQuote = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        PageTitle = Localizer["PageTitle"].Value,
        PageSubtitle = Localizer["PageSubtitle"].Value,
        Export = Localizer["Export"].Value,
        Filters = Localizer["Filters"].Value,
        OrderCode = Localizer["OrderCode"].Value,
        SelectOrderCode = Localizer["SelectOrderCode"].Value,
        Department = Localizer["Department"].Value,
        SelectDepartment = Localizer["SelectDepartment"].Value,
        Creator = Localizer["Creator"].Value,
        EnterCreator = Localizer["EnterCreator"].Value,
        MaterialCode = Localizer["MaterialCode"].Value,
        SelectMaterialCode = Localizer["SelectMaterialCode"].Value,
        Supplier = Localizer["Supplier"].Value,
        SelectSupplier = Localizer["SelectSupplier"].Value,
        OrderStatus = Localizer["OrderStatus"].Value,
        All = Localizer["All"].Value,
        DateRange = Localizer["DateRange"].Value,
        Filter = Localizer["Filter"].Value,
        Reset = Localizer["Reset"].Value,
        GroupListByOrder = Localizer["GroupListByOrder"].Value,
        OrderCodeGroup = Localizer["OrderCodeGroup"].Value,
        Requester = Localizer["Requester"].Value,
        CreatedDate = Localizer["CreatedDate"].Value,
        CurrentStatus = Localizer["CurrentStatus"].Value,
        TotalOrders = Localizer["TotalOrders"].Value,
        RelatedSuppliers = Localizer["RelatedSuppliers"].Value,
        Actions = Localizer["Actions"].Value,
        Expand = Localizer["Expand"].Value,
        ViewHistory = Localizer["ViewHistory"].Value,
        Approval = Localizer["Approval"].Value,
        Material = Localizer["Material"].Value,
        Quantity = Localizer["Quantity"].Value,
        Status = Localizer["Status"].Value,
        UpdatedDate = Localizer["UpdatedDate"].Value,
        PaginationInfo = Localizer["PaginationInfo", "{0}", "{1}", "{2}"].Value,
        FooterHint = Localizer["FooterHint"].Value,
        EditModalTitle = Localizer["EditModalTitle"].Value,
        Close = Localizer["Close"].Value,
        Save = Localizer["Save"].Value,
        Notification = Localizer["Notification"].Value,
        // JS messages
        MsgSearchFailed = Localizer["MsgSearchFailed"].Value,
        MsgLoadHistoryFailed = Localizer["MsgLoadHistoryFailed"].Value,
        MsgNoHistory = Localizer["MsgNoHistory"].Value,
        MsgNoDataToEdit = Localizer["MsgNoDataToEdit"].Value,
        MsgNotFoundData = Localizer["MsgNotFoundData"].Value,
        MsgSaveSuccess = Localizer["MsgSaveSuccess"].Value,
        MsgSaveFailed = Localizer["MsgSaveFailed", "{0}"].Value,
        DialogOk = Localizer["DialogOk"].Value,
        SearchEllipsis = Localizer["SearchEllipsis"].Value,
        NoResults = Localizer["NoResults"].Value,
        SelectPlaceholder = Localizer["SelectPlaceholder"].Value,
        HistoryTime= Localizer["HistoryTime"].Value,
        RequestNo= Localizer["RequestNo"].Value,
        Action =Localizer["Action"].Value,
        UpdatedBy=Localizer["UpdatedBy"].Value,
        Reason = Localizer["Reason"].Value,
        PageTitleHistory = Localizer["PageTitleHistory"].Value,
        MsgSelectGroupFailed = Localizer["MsgSelectGroupFailed"].Value,
        Exporting = Localizer["Exporting"].Value,
        ReturnFailed  = Localizer["ReturnFailed"].Value,
        ReturnSuccess = Localizer["ReturnSuccess"].Value,
        SenedSupperlier = Localizer["SenedSupperlier"].Value,
        Confirm = Localizer["Confirm"].Value,
        CHR_StepName = Localizer["CHR_StepName"].Value,
        LoadingData = Localizer["LoadingData"].Value,
        ViewHistoryTooltip = Localizer["ViewHistoryTooltip"].Value,
        ReturnTooltip = Localizer["ReturnTooltip"].Value,
        DeleteTooltip = Localizer["DeleteTooltip"].Value,
        Hide = Localizer["Hide"].Value,
