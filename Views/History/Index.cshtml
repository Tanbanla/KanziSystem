    }));
</script>
@section Scripts {
    <script src="~/js/common/searchable-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/HistoryV2.js"  asp-append-version="true"></script>
    <script>
        (function() {
            // Ensure panel and overlay are appended to body to avoid being under navbar stacking contexts
            var panel = document.getElementById('editHistoryModal');
            if (panel && panel.parentElement !== document.body) {
                document.body.appendChild(panel);
            }
        })();
    </script>
    <script>
        (function () {
            var content = document.getElementById('dashboardSummaryContent');
            var btn = document.getElementById('btnToggleDashboardSummary');
            var btnText = document.getElementById('btnToggleDashboardSummaryText');
            var storageKey = 'history_dashboard_visible';

            function setVisible(visible, save) {
                if (!content) return;
                content.style.display = visible ? '' : 'none';
                if (btn) {
                    btn.setAttribute('aria-expanded', visible ? 'true' : 'false');
                    var icon = btn.querySelector('i');
                    if (icon) {
                        icon.className = visible ? 'fas fa-eye-slash me-1' : 'fas fa-eye me-1';
                    }
                    if (btnText) {
                        btnText.textContent = visible ? window.i18nHistoryQuote?.Hide : window.i18nHistoryQuote?.Show;
                    }
                }
                if (save) localStorage.setItem(storageKey, visible ? '1' : '0');
            }

            try {
                var saved = localStorage.getItem(storageKey);
                if (saved === '0') {
                    setVisible(false, false);
                } else {
                    setVisible(true, false);
                }
            } catch (e) {

            }

            if (btn) {
                btn.addEventListener('click', function () {
                    var isVisible = content && content.style.display !== 'none';
                    setVisible(!isVisible, true);
                });
            }
        })();
    </script>
}
