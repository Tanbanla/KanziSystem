<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, shrink-to-fit=no" name="viewport">
    <title> @ViewData["Title"] - PRJ WAREHOUSE BIVN</title>
    <link rel="icon" type="image/x-icon" href="~/css/img/logokho-removebg-preview.ico" asp-append-version="true">
    <!-- General CSS Files -->
    <link rel="stylesheet" href="~/modules/bootstrap/css/bootstrap.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/modules/fontawesome/css/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/modules/ionicons/css/ionicons.min.css" asp-append-version="true">
    <!-- CSS Libraries -->
    <link rel="stylesheet" href="~/modules/jqvmap/dist/jqvmap.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/modules/summernote/summernote-bs4.css" asp-append-version="true">
@*     <link rel="stylesheet" href="~/modules/owlcarousel2/dist/css/owl.carousel.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/modules/owlcarousel2/dist/css/owl.theme.default.min.css" asp-append-version="true"> *@

    <link rel="stylesheet" href="~/modules/datatables/datatables.min.css">
    <link rel="stylesheet" href="~/modules/datatables/DataTables-1.10.16/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/modules/datatables/Select-1.2.4/css/select.bootstrap4.min.css">

    <!-- Template CSS -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true">
    <!-- Start GA -->
    <script>
        window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'UA-94034622-3');</script>
    <!-- /END GA -->  
</head>
<body class="sidebar-mini" data-authenticated="@(User.Identity.IsAuthenticated ? "true" : "false")">
    <div id="app">
        <div class="main-wrapper main-wrapper-1">
            <div class="navbar-bg"></div>
            <nav class="navbar navbar-expand-lg main-navbar">
                <form class="form-inline mr-auto">
                    <ul class="navbar-nav mr-3">
                        <li><a href="#" data-toggle="sidebar" class="nav-link nav-link-lg"><i class="fas fa-bars"></i></a></li>
                        <li><h4 class="text-white">BIVN Warehouse Management System (BWMS)</h4></li>
                    </ul>                  
                </form>
                <ul class="navbar-nav navbar-right">
                    <li>
                        <a href="#" class="m-1" title="Tiếng Việt" data-culture="vi" onclick="setAppCulture(event)">
                            <img src="~/img/viet.png" height="20" />
                        </a>
                        <a href="#" class="m-1" title="English" data-culture="en" onclick="setAppCulture(event)">
                            <img src="~/img/anh.png" height="20" />
                        </a>
                        <a href="#" class="m-1" title="日本語" data-culture="ja" onclick="setAppCulture(event)">
                            <img src="~/img/jp.svg" height="20" /> 
                        </a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="dropdown">
                            <a href="#" data-toggle="dropdown" class="nav-link dropdown-toggle nav-link-lg nav-link-user">
                                <i class="fa fa-user"></i>
                                Xin chào, @(User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "User")!
                                <div class="d-sm-none d-lg-inline-block"></div>
                            </a>
                            <div class="dropdown-menu dropdown-menu-right">
                                <div class="dropdown-title">
                                    Đăng nhập lúc: @(Context.Session.GetString("LoginTime") ?? "N/A")
                                </div>
                                <a href="@Url.Action("Profile", "Account")" class="dropdown-item has-icon">
                                    <i class="far fa-user"></i> Thông tin tài khoản
                                </a>
                                <div class="dropdown-divider"></div>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item has-icon text-danger" style="background: none; border: none; width: 100%; text-align: left;">
                                        <i class="fas fa-sign-out-alt"></i> Đăng xuất
                                    </button>
                                </form>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li>
                            <a href="@Url.Action("Login", "Account")" class="nav-link">
                                <i class="fas fa-sign-in-alt"></i> Đăng nhập
                            </a>
                        </li>
                    }
                    <li><span id="us" hidden>@(User.FindFirst("UserId")?.Value ?? "User")</span></li>
                </ul>
            </nav>
            <div class="main-sidebar sidebar-style-2" tabindex="1" style="overflow: auto visible; outline: none;">
                <aside id="sidebar-wrapper">
                    <div class="sidebar-brand">
                        <a href="~/Home/Index">WAREHOUSE</a>
                    </div>
                    <div class="sidebar-brand sidebar-brand-sm">
                        <a href="~/Home/Index">WH</a>
                    </div>
                    <ul class="sidebar-menu">
                        <li class="dropdown @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                            <a href="#" class="nav-link has-dropdown"><i class="ion ion-ios-home"></i> <span>Dashboard</span></a>
                            <ul class="dropdown-menu">
                                <li><a href="~/Home/Index" class="nav-link"><i class="fa fa-home"></i> <span>Dashboard</span></a></li>
                            </ul>
                        </li>
                        <li class="dropdown @(ViewContext.RouteData.Values["Controller"]?.ToString() == "User" ? "active" : "")">
                            <a href="#" class="nav-link has-dropdown"><i class="ion ion-ios-people"></i> <span>User</span></a>
                            <ul class="dropdown-menu">
                                <li><a href="~/User/Index" class="nav-link"><i class="far fa-user"></i> <span>User</span></a></li>
                            </ul>
                        </li>
                        <li class="dropdown @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Quote" ? "active" : "")">
                            <a href="#" class="nav-link has-dropdown">
                                <i class="fas fa-file-invoice-dollar"></i> <span>Báo giá</span>
                            </a>
                            <ul class="dropdown-menu" style="max-width: 320px;">
                                <li>
                                    <a class="dropdown-item py-2" href="~/Quote/Index">
                                        <i class="fas fa-file-signature me-2"></i>
                                        <span class="small">Tạo đơn yêu cầu báo giá</span>
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item py-2" href="~/ApprovalQuote/Index">
                                        <i class="fas fa-user-check me-2"></i>
                                        <span class="small">Phê duyệt đơn báo giá</span>
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item py-2" href="~/Quote/InputQuote">
                                        <i class="fas fa-inbox me-2"></i>
                                        <span class="small">Nhập báo giá</span>
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item py-2" href="~/Quote/Quotation_Results">
                                        <i class="fas fa-clipboard-list me-2"></i>
                                        <span class="small">Kết quả báo giá</span>
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item py-2" href="~/Quote/SelectQuoteSection">
                                        <i class="fas fa-baseball-ball me-2"></i>
                                        <span class="small">Yêu cầu hàng hóa</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" href="~/Quote/HistoryQuote">
                                        <i class="fas fa-history me-2"></i>
                                        <span class="small">Lịch sử yêu cầu</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="dropdown @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Material" ? "active" : "")">
                            <a href="#" class="nav-link has-dropdown"><i class="ion ion-social-dropbox"></i> <span>Nguyên vật liệu</span></a>
                            <ul class="dropdown-menu">
                                <li><a class="nav-link" href="~/Material/Material"><i class="fas fa-business-time"></i> Quản lý NVL</a></li>
                                <li><a class="nav-link" href="~/Material/Creat_Material"><i class="fas fa-plus-square"></i> Tạo mã NVL</a></li>
                                <li><a class="nav-link" href="~/Material/ConfirmName"><i class="fas fa-check-square"></i> Xác nhận tên NVL</a></li>
                            </ul>
                        </li>
                        <li class="dropdown @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Import" ? "active" : "")">
                            <a href="#" class="nav-link has-dropdown"><i class="ion ion-ios-cloud-upload"></i> <span>Kho</span></a>
                            <ul class="dropdown-menu">
                                <li><a class="nav-link" href="~/Delivery/DeliveryPO"><i class="fas fa-truck-pickup"></i> Nhập hàng theo PO</a></li> @* Nhập hàng PO *@
                                <li><a class="nav-link" href="~/Delivery/DeliverySection"><i class="fas fa-calendar-check"></i> Xác nhận nhập hàng</a></li> @* Nhập hàng PO *@
                                <li><a class="nav-link" href="~/Import/Import_material"><i class="fas fa-home"></i> Hàng trong kho</a></li>
                                <li><a class="nav-link" href="~/Import/Export_material"><i class="fas fa-file-export"></i> Yêu cầu xuất kho</a></li>
                                <li><a class="nav-link" href=""><i class="fas fa-donate"></i> Tái nhập</a></li>
                                <li><a class="nav-link" href="~/Import/Log"><i class="fas fa-info"></i> Log nhập - xuất</a></li>
                                <li><a class="nav-link" href="~/Import/Xuatkho"><i class="fas fa-file-export"></i> Xuất kho</a></li>
                            </ul>
                        </li>                     
                        <li class="dropdown @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Approval" ? "active" : "")">
                            <a href="#" class="nav-link has-dropdown"><i class="ion ion-android-checkmark-circle"></i> <span>Phê duyệt</span></a>
                            <ul class="dropdown-menu">
                                <li><a href="~/Approval/ListData"><i class="fas fa-check"></i> Phê duyệt</a></li>
                                <li><a class="nav-link" href="~/Approval/Condition"><i class="fas fa-info-circle"></i> Trạng thái đơn</a></li>                            
                            </ul>
                        </li>
                        <li class="dropdown @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Master" ? "active" : "")">
                            <a href="#" class="nav-link has-dropdown"><i class="ion ion-ios-cog"></i> <span>Master</span></a>
                            <ul class="dropdown-menu">
                                <li><a href="~/Master/Masters"><i class="ion ion-ios-home"></i> Warehouse</a></li>
                                <li><a href="~/Master/master_vender"><i class="ion ion-social-snapchat"></i> Vender</a></li>
                                <li><a href="~/Master/master_material"><i class="ion ion-android-options"></i> Material</a></li>
                                <li><a href="~/Master/SendApprover"><i class="fas fa-sitemap me-2"></i> Master Send Mail</a></li>
                                <li><a href="~/Master/SupplierMana"><i class="fas fa-handshake"></i> Quản lý NCC</a></li>
                            </ul>
                        </li>
                    </ul>
                </aside>
            </div>
            <div class="main-content">
                <section class="section">
                    <div class="section-header">
                        <div class="section-header-breadcrumb" style="margin-left: 0px;">
                            <div class="breadcrumb-item "><a href="#"><i class="ion ion-ios-home"></i> Warehouse BIVN</a></div>
                            <div class="breadcrumb-item active">@ViewBag.Title</div>
                        </div>
                    </div>
                    <br />
                    @RenderBody()
                </section>
            </div>
            <footer class="main-footer">
                <div class="footer-left text-primary">
                    &copy; @DateTime.Now.Year Brother Industries (Vietnam) Ltd. All Rights Reserved
                </div>
                <div class="footer-right">
                </div>
            </footer>
        </div>
    </div>

    <!-- General JS Scripts -->
  
    <script src="~/modules/jquery.min.js"></script>
    <script src="~/modules/popper.js"></script>
    <script src="~/modules/tooltip.js"></script>
    <script src="~/modules/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/modules/nicescroll/jquery.nicescroll.min.js"></script>
    <script src="~/modules/moment.min.js"></script>
    <script src="~/js/stisla.js"></script>

    <!-- JS Libraies -->
    <script src="~/modules/jquery.sparkline.min.js"></script>
    <script src="~/modules/chart.min.js"></script>
    <script src="~/modules/owlcarousel2/dist/owl.carousel.min.js"></script>
    <script src="~/modules/summernote/summernote-bs4.js"></script>
    <script src="~/modules/chocolat/dist/js/jquery.chocolat.min.js"></script>

    <script src="~/modules/datatables/datatables.min.js"></script>
    <script src="~/modules/datatables/DataTables-1.10.16/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/modules/datatables/Select-1.2.4/js/dataTables.select.min.js"></script>
    <script src="~/modules/jquery-ui/jquery-ui.min.js"></script>

    <script src="~/js/page/modules-datatables.js"></script>
    <!-- Page Specific JS File -->
    @* <script src="~/js/page/index.js"></script> *@
    <script src="~/js/page/bootstrap-modal.js"></script>
    <!-- Template JS File -->
    <script src="~/js/scripts.js"></script>
    <script src="~/js/custom.js"></script>
    
    @if (User.Identity.IsAuthenticated)
    {
        <script src="~/js/session-manager.js" asp-append-version="true"></script>
    }
    
    @RenderSection("Scripts", required: false)
    <script>
        function setAppCulture(e) {
            e.preventDefault();
            var culture = e.currentTarget.getAttribute('data-culture');
            if (!culture) return;
            // Set ASP.NET Core localization cookie for entire app
            var cookieName = '.AspNetCore.Culture';
            var cookieValue = 'c=' + culture + '|uic=' + culture;
            var expires = new Date();
            expires.setFullYear(expires.getFullYear() + 1); // 1 year
            document.cookie = cookieName + '=' + encodeURIComponent(cookieValue) + '; expires=' + expires.toUTCString() + '; path=/';
            // Reload current page to apply culture
            window.location.reload();
        }
    </script>
 
</body>
</html>
