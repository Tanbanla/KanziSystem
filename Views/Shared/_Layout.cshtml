    @RenderSection("Scripts", required: false)
    <script>
        // Get BaseUrl from appsettings
        window.apiBaseUrl = '@Configuration["ApiSettings:BaseUrl"]';

        function setAppCulture(e) {
            e.preventDefault();
            var culture = e.currentTarget.getAttribute('data-culture');
            if (!culture) return;

            // Set ASP.NET Core localization cookie for entire app
            var cookieName = '.AspNetCore.Culture';
            var cookieValue = 'c=' + culture + '|uic=' + culture;
            var expires = new Date();
            expires.setFullYear(expires.getFullYear() + 1); // 1 year
            document.cookie = cookieName + '=' + encodeURIComponent(cookieValue) + '; expires=' + expires.toUTCString() + '; path=/';

            // Reload current page with apiBaseUrl if available
            var baseUrl = window.apiBaseUrl || '';
            var currentPath = window.location.pathname + window.location.search + window.location.hash;

            // Remove baseUrl from currentPath if it already exists to avoid duplication
            if (baseUrl && currentPath.startsWith(baseUrl)) {
                currentPath = currentPath.substring(baseUrl.length);
            }
            var newUrl = baseUrl + currentPath;
            window.location.href = newUrl;
        }
    </script>
