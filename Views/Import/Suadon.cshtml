                        <input type="text" class="form-control" id="name_dept" readonly>
                    </div>
                    <div class="form-group col-md-2" hidden>
                        <label>@Languages.tenphongyeucau</label>
                        <input type="text" class="form-control" id="dept"  required>
                    </div>
                    <div class="form-group col-md-2" hidden>
                        <label>@Languages.Bophan</label>
                        <input type="text" class="form-control" id="secs" readonly required>
                    </div>
                    <div class="form-group col-md-1">
                        <label>@Languages.phongchiuphi</label>
                        <input type="text" class="form-control" id="cost_center" style="background-color:#ffff0029">
                    </div>
                    <div class="form-group col-md-1">
                        <label>@Languages.vitri</label>
                        <input type="text" class="form-control" id="place" style="background-color:#ffff0029">
                    </div>                  
                    <div class="form-group">
