    function _luu(){
    var x = confirm("Bạn có muốn sửa đơn không ?");
    if(x) {
        let dataList = [];
        // Chọn tất cả các dòng có class 'input-row'
        const rows = document.querySelectorAll('.input-row');
        rows.forEach((row) => {
            // Safely query elements inside row
            const idrq_dt = row.querySelector('.idrq_dt');
            const tenhangEl = row.querySelector('.tenhang');
            const stkEl = row.querySelector('.stk');
            const slEl = row.querySelector('.sl');
            const dvEl = row.querySelector('.dv');
            const dgEl = row.querySelector('.dg');
            const ntEl = row.querySelector('.nt');
            const tcpEl = row.querySelector('.tcp');
            const mdEl = row.querySelector('.md');
            const pcpEl = row.querySelector('.pcp');
            const vtEl = row.querySelector('.vt');
            const gcEl = row.querySelector('.gc');

            // Helper to safely split value into two parts
            const splitPair = (val) => {
                const s = (val || '').toString().split(':');
                return [s[0] || '', s.slice(1).join(':') || ''];
            };
           
            const [materialCode, materialName] = splitPair(tenhangEl ? tenhangEl.value : '');
            const [accountCode, accountName] = splitPair(stkEl ? stkEl.value : '');

            // Lấy dữ liệu từ các phần tử bên trong dòng hiện tại
            let rowData = {
                    Id_RequestDetail: idrq_dt.innerHTML,
                    Material_Code: materialCode,
                    Material_Name: materialName,
                    Account_Code: accountCode,
                    Account_Name: accountName,
                    Amount: slEl ? slEl.value : 0,
                    Unit: dvEl ? dvEl.value : '',
                    Price: dgEl ? parseFloat(dgEl.value) || 0 : 0,
                    Currency: ntEl ? ntEl.value : '',
                    Total_exchange: tcpEl ? parseFloat(tcpEl.value) || 0 : 0,
                    Total: tcpEl ? parseFloat(tcpEl.value) || 0 : 0,
                    Aim: mdEl ? mdEl.value : '',
                    Phongchiuchiphi: (pcpEl ? pcpEl.value : ''),
                    Vitri: vtEl ? vtEl.value : '',
                    Poisition: gcEl ? gcEl.value : ''
                };
            // Thêm đối tượng vào danh sách tổng

            dataList.push(rowData);
        });
        var mucdichkhac = "";
        if (document.getElementById('mdk').checked == true) {
            mucdichkhac = "OTHER AIM";
        }
        var iD_REQUEST = document.getElementById("idrq").innerHTML;
        var Code_Request = document.getElementById("madon").value;
        var Dealine = document.getElementById("thoihan").value;
        // Remove thousand separators before parsing
        var Total_exchange = parseFloat((document.getElementById("thanhtien").value || "0").toString().replace(/,/g,'')) || 0;
        var Exchange_rate = document.getElementById("rate").value;
        var Total = parseFloat((document.getElementById("thanhtien").value || "0").toString().replace(/,/g,'')) || 0;
        var urgentValue = (document.querySelector('input[name="value"]:checked') && document.querySelector('input[name="value"]:checked').value) || 0;
        var Urgent = urgentValue;
        var User_Create = document.getElementById("us").innerHTML;
        var Place = document.getElementById("place").value;
        var Declaration = document.getElementById("loaichiphi").value;
        var cost_center = document.getElementById("cost_center").value;

        if (Dealine == "") {
            alert("Vui lòng điền đủ thông tin vào đơn !")
        }
        else {
            $.ajax({
                url: '/ipcs/Request/_sua_request',
                //url: '/Request/_sua_request',
                type: 'POST',
                dataType: 'JSON',
                //contentType: 'application/json',
                data: {
                    iD_REQUEST: iD_REQUEST,
                    Dealine : Dealine,
                    Total_exchange : Total_exchange,
                    Exchange_rate : Exchange_rate,
                    Total : Total,
                    Place : Place,
                    Urgent : Urgent,
                    User_Create : User_Create,
                    rq : dataList,
                    Code_Request : Code_Request,
                    Declaration : Declaration,
                    Cost_Center : cost_center,
                    Note : mucdichkhac
                },
                success: function (response) {
                    alert(response);
                    location.href = "/ipcs/Approval/Condition"
                }
            })

        }
    }
}
