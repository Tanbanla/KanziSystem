            },
        })
        .then(response => {
            if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
            return response.json();
        })
        .then(data => {
            const stkSelects = document.querySelectorAll('.stk');

            stkSelects.forEach(select => {
                const currentValue = select.value;
                // 1. Tạo chuỗi khởi đầu với giá trị mặc định
                let optionsHtml = currentValue ? `<option selected>${currentValue}</option>` : '';

                // 2. Nối thêm các option khác vào biến chuỗi
                data.forEach(account => {
                    if (account !== currentValue) {
                        optionsHtml += `<option value="${account}">${account}</option>`;
                    }
                });

                // 3. Gán chuỗi vào DOM ĐÚNG 1 LẦN cho mỗi thẻ select
                select.innerHTML = optionsHtml;
            });
        })
        .catch(error => console.error('Lỗi fetch:', error));
