@{
    ViewData["Title"] = "Sửa phiếu yêu cầu xuất kho";
}
<link href="~/modules/select2/select.css" rel="stylesheet" />
<style>
    .card .card-header .form-control {
        height: 42px;
        font-size: 13px;
        border-radius: 2px;
    }
    /* Nhắm trực tiếp vào phần hiển thị chữ của Select2 */
    .select2-container--default .select2-selection--single .select2-selection__rendered {
        white-space: normal !important; /* Cho phép xuống dòng */
        word-wrap: break-word !important; /* Ngắt từ nếu quá dài */
        line-height: 1.4 !important; /* Tạo khoảng cách dòng */
        display: block !important; /* Chuyển từ inline sang block */
    }
    /* Tự động tăng chiều cao ô khi chữ xuống dòng */
    .select2-container .select2-selection--single {
        height: auto !important;
        min-height: 38px !important; /* Độ cao mặc định của Bootstrap */
        display: flex !important;
        align-items: center;
    }
    /* Điều chỉnh vị trí mũi tên để không bị lệch khi ô cao lên */
    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 100% !important;
        top: 0 !important;
    }

    .selectgroup-input:focus + .selectgroup-button, .selectgroup-input:checked + .selectgroup-button {
        background-color: mediumblue
    }

    .selectgroup-input:focus + .selectgroup-button-gap, .selectgroup-input:checked + .selectgroup-button-gap {
        background-color: red;
        color: white
    }

    .selectgroup-button-gap {
        background-color: #fdfdff;
        border-color: #e4e6fc;
        border-width: 1px;
        border-style: solid;
        display: block;
        text-align: center;
        padding: 0 1rem;
        height: 42px;
        position: relative;
        cursor: pointer;
        border-radius: 3px;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        font-size: 13px;
        min-width: 2.375rem;
        line-height: 36px;
    }

    .form-group {
        margin-bottom: 10px;
    }
</style>
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body p-0">
                <div class="form-row">
                    <p hidden id="idrq">@ViewBag.MasterData</p>
                    <div class="form-group col-md-1">
                        <label for="inputEmail4"> @Languages.Khoi :</label>
                        <input type="text" class="form-control" id="group_code" readonly>
                    </div>
                    <div class="form-group col-md-2">
                        <label>@Languages.mayeucau</label>
                        <input type="text" class="form-control" value="" id="madon" readonly>
                    </div>
                    <div class="form-group col-md-2" hidden>
