                                        <input type="radio" name="value" value="0" class="selectgroup-input" checked>
                                        <span class="selectgroup-button">@Languages.Thongthuong</span>
                                    </label>
                                    <label class="selectgroup-item">
                                        <input type="radio" name="value" value="1" class="selectgroup-input" id="gap">
                                        <span class="selectgroup-button-gap"><b>@Languages.Gap</b></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
