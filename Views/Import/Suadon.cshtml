                                        <td><input type="text" class="form-control dv" id="dv_1" value="@item.Unit" readonly></td>
                                        <td><input type="number" class="form-control dg" id="dg_1" value="@item.Price" readonly></td>
                                        <td><input type="text" class="form-control nt" id="nt_1" value="@item.Currency" readonly></td>
                                        <td><input type="text" class="form-control tcp" id="tcp_1" value="@item.Total_exchange" readonly></td>
