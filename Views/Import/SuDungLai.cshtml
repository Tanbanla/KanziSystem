@using PRJ_WAREHOUSE_BIVN.Language
@model IEnumerable<PRJ_WAREHOUSE_BIVN.Models.REQUEST_DETAIL>
@{
    ViewData["Title"] = "Tạo đơn mới từ mã cũ";
}

<link href="~/modules/select2/select.css" rel="stylesheet" />
<style>
    .card .card-header .form-control {
        height: 42px;
        font-size: 13px;
        border-radius: 2px;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        white-space: normal !important;
        word-wrap: break-word !important;
        line-height: 1.4 !important;
        display: block !important;
    }

    .select2-container .select2-selection--single {
        height: auto !important;
        min-height: 38px !important;
        display: flex !important;
        align-items: center;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 100% !important;
        top: 0 !important;
    }

    .selectgroup-input:focus + .selectgroup-button, .selectgroup-input:checked + .selectgroup-button {
        background-color: mediumblue
    }

    .selectgroup-input:focus + .selectgroup-button-gap, .selectgroup-input:checked + .selectgroup-button-gap {
        background-color: red;
        color: white
    }

    .selectgroup-button-gap {
        background-color: #fdfdff;
        border-color: #e4e6fc;
        border-width: 1px;
        border-style: solid;
        display: block;
        text-align: center;
        padding: 0 1rem;
        height: 42px;
        position: relative;
        cursor: pointer;
        border-radius: 3px;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        font-size: 13px;
        min-width: 2.375rem;
        line-height: 36px;
    }

    .form-group {
        margin-bottom: 10px;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body p-0">
                <div class="form-row">
                    <div class="form-group col-md-1">
                        <label for="inputEmail4"> @Languages.Khoi :</label>
                        <select class="form-control" id="group_code" style="background-color:#ffff0029">
                            <option>PROD</option>
                            <option>GA</option>
                        </select>
                    </div>
                    <div class="form-group col-md-2">
                        <label>@Languages.loaiphieu</label>
                        <input type="text" class="form-control" value="Hàng trong danh mục" readonly>
                    </div>
                    <div class="form-group col-md-2">
                        <label>@Languages.Phongban</label>
                        <select class="form-control" id="name_dept" onchange="_load_dept(this.value)" style="background-color:#ffff0029"></select>
                    </div>
                    <div class="form-group col-md-2">
                        <label>@Languages.tenphongyeucau</label>
                        <input type="text" class="form-control" id="dept" readonly required>
                    </div>
                    <div class="form-group col-md-2">
                        <label>@Languages.Bophan</label>
                        <input type="text" class="form-control" id="secs" readonly required>
                    </div>
                    <div class="form-group col-md-1">
                        <label>@Languages.vitri</label>
                        <input type="text" class="form-control" id="placee" style="background-color:#ffff0029">
                    </div>
                    <div class="form-group">
                        <label class="d-block"><b class="text-danger">@Languages.dathang :</b></label>
                        <div class="form-group row">
                            <div class="col-lg-12 col-md-12">
                                <div class="selectgroup w-100">
                                    <label class="selectgroup-item">
                                        <input type="radio" name="value" value="0" class="selectgroup-input" checked>
                                        <span class="selectgroup-button">@Languages.Thongthuong</span>
                                    </label>
                                    <label class="selectgroup-item">
                                        <input type="radio" name="value" value="1" class="selectgroup-input">
                                        <span class="selectgroup-button-gap"><b>@Languages.Gap</b></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-2">
                        <label for="inputAddress">@Languages.loaichiphi</label>
                        <select class="form-control" id="loaichiphi" style="padding: 0px 2px; background-color:#ffff0029">
                            <option value="AUXILIARY">@Languages.cpbiendoitheosanluong</option>
                            <option value="EUQIMENT">@Languages.chiphicodinh</option>
                            <option value="FIXED">@Languages.taisancodinh</option>
                            <option value="COMMON">@Languages.Chiphichung</option>
                            <option value="OTHER">Other</option>
                        </select>
                    </div>
                    <div class="form-group col-md-1">
                        <label>@Languages.Ngayyeucau</label>
                        <input type="text" class="form-control" id="ngayyeucau" readonly value="@DateTime.Now.ToString("dd/MM/yyyy")" />
                    </div>
                    <div class="form-group col-md-1">
                        <label class="text-danger">@Languages.thoihanmuonnhan</label>
                        <input type="date" class="form-control" id="thoihan" style="background-color:#ffff0029" required />
                    </div>
                    <div class="form-group col-md-1">
                        <label>@Languages.loaihang </label>
                        <input type="text" id="typee" class="form-control" readonly />
                    </div>
                    <div class="form-group col-md-1">
                        <label>@Languages.loaihinhtokhai </label>
                        <input type="text" class="form-control" value="Loại khác" readonly />
                    </div>
                    <div class="form-group col-md-2">
                        <label for="inputCity">@Languages.tygia :  </label> <code style="float:right"><b> USD ↔ VND</b></code>
                        <input type="text" class="form-control" id="rate">
                    </div>
                    <div class="form-group col-md-1">
                        <label for="inputCity">@Languages.thanhtien  </label> <code style="float:right"><b>USD</b></code>
                        <input type="text" class="form-control" id="thanhtien" value="0" readonly>
                    </div>
                </div>
                <div class="form-row">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle" id="dynamic-table">
                            <thead>
                                <tr style="border-top:1px solid #e9e9e9">
                                    <td colspan="15"><input type="checkbox" id="mdk" /> &nbsp; Mục đích khác </td>
                                </tr>
                                <tr class="bg-primary text-white text-center">
                                    <th style="width: 50px;">No.</th>
                                    <th width="380px">@Languages.TenNVL</th>
                                    <th width="150px">@Languages.Maketoan</th>
                                    <th width="80">@Languages.soluong</th>
                                    <th width="150px">@Languages.Donvi</th>
                                    <th>@Languages.Giatien</th>
                                    <th width="70px">@Languages.Ngoaite</th>
                                    <th>@Languages.tongdon</th>
                                    <th>@Languages.Mucdich</th>
                                    <th>@Languages.phongchiuphi</th>
                                    <th>@Languages.vitri</th>
                                    <th>@Languages.Ghichu</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody id="lstMaterial">
                                @{
                                    int index = 1;
                                }
                                @foreach (var item in Model)
                                {
                                    <tr class="input-row">
                                        <td class="row-number text-center fw-bold">@index</td>
                                        <td>
                                            <select class="form-control tenhang" id="tenhang_@index" onchange="_load_material_1(this.value, this.id)">
                                                <option value="@item.Material_Name" selected>@item.Material_Name</option>
                                            </select>
                                        </td>
                                        <td>
                                            <select class="form-control stk" id="stk_@index">
                                                <option>@item.Account_Code</option>
                                            </select>
                                        </td>
                                        <td><input type="number" class="form-control sl" value="@item.Amount" id="sl_@index" min="0"></td>
                                        <td><input type="text" class="form-control dv" id="dv_@index" value="@item.Unit" readonly></td>
                                        <td><input type="number" class="form-control dg" id="dg_@index" value="@item.Price" readonly> </td>
                                        <td><input type="text" class="form-control nt" id="nt_@index" value="@item.Currency" readonly></td>

                                        <td><input type="text" class="form-control tcp" id="tcp_@index" value="@item.Total_exchange" readonly></td>

                                        <td><input type="text" class="form-control md" id="md_@index" value="@item.Aim"></td>
                                        <td>
                                            <select class="form-control pcp" id="pcp_@index">
                                                <option value="@item.Phongchiuchiphi">@item.Phongchiuchiphi</option>
                                            </select>
                                        </td>
                                        <td><input type="text" class="form-control vt" id="vt_@index" value="@item.Vitri"></td>
                                        <td><input type="text" class="form-control gc" id="gc_@index" value="@item.Poisition"></td>
                                        <td>
                                            <button type="button" class="btn btn-outline-danger btn-remove" onclick="$(this).closest('tr').remove(); tinhTongTatCa(); updateRowNumbers();">&times;</button>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            </tbody>
                        </table>
                    </div>
                    <button type="button" class="btn btn-success btn-sm mt-3 ml-2" id="btn-add-row">+ @Languages.themdongmoi </button>
                </div>
                <div id="gyc">
                    <button class="btn btn-info float-right" id="modal-6" onclick="getEmployeeData()">✉ @Languages.guiyeucau</button>
                    <button class="btn btn-info float-right" id="modal-20" onclick="getEmployeeData_GA()">✉ @Languages.guiyeucau</button>
                </div>
                <br />
                <br />
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_modal", "Import")

<script src="~/modules/select2/jquery.min.js"></script>
<!-- Tải Select2 và các script nghiệp vụ của dự án -->
<script src="~/modules/select2/select2.js"></script>
<script src="~/scripts/import_process.js"></script>
<script src="~/scripts/request.js"></script>
<script src="~/scripts/get_api.js"></script>
<script src="~/scripts/get_api_ga.js"></script>

<script>
    
    var ApiEndpoints = {
        infoMaterial: '@Url.Action("_info_material", "Import", new { area = "ipcs" })',
        loadMaterial: '@Url.Action("_load_material", "Import", new { area = "ipcs" })',
        getPhongChiuphi: '@Url.Action("_get_phongchiuphi", "Request", new { area = "ipcs" })',
        loadAccount: '@Url.Action("_load_account", "Import", new { area = "ipcs" })',
        request: '@Url.Action("request", "Import", new { area = "ipcs" })'
    };

    //   var ApiEndpoints = {
    //     infoMaterial: '@Url.Action("_info_material", "Import", new { area = "" })',
    //     loadMaterial: '@Url.Action("_load_material", "Import", new { area = "" })',
    //     getPhongChiuphi: '@Url.Action("_get_phongchiuphi", "Request", new { area = "" })',
    //     loadAccount: '@Url.Action("_load_account", "Import", new { area = "" })',
    //     request: '@Url.Action("request", "Import", new { area = "" })'
    // };

    window.onload = function(){
        //let group_code = document.getElementById("group_code").value + "_CPK";
        let group_code = document.getElementById("group_code").value;

        _load_name_inv(group_code);
        _load_request();
        _load_rate();
        _load_info_adid();
        _load_phongchiuphi_1();
        _load_account_1();
    }

    function _load_material_1(Material_Code, id) {
        // Chặn lỗi nếu mã rỗng
        if (!Material_Code || Material_Code.trim() === "") return;

        let idd = id.split('_')[1];
        var groupcode = document.getElementById("group_code").value;

        let materialCode = Material_Code;
        if (Material_Code && Material_Code.includes(':')) {
            materialCode = Material_Code.split(':')[0];
        }

        const params = new URLSearchParams();
        params.append('Material_Code', materialCode);
        params.append('Material_Name_VN', '');
        params.append('Account_Name_VN', '');
        params.append('Group_Code', groupcode);

        fetch(ApiEndpoints.infoMaterial, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: params.toString()
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            // Dữ liệu trả về đôi khi rỗng (undefined)
            if(data && data.length > 0) {
                document.getElementById("stk_" + idd).value = data[0].account_Code + ":" + data[0].account_Name_EN;
                if (data[0].unit_Note == "" || data[0].unit_Note == "-") {
                    document.getElementById("dv_" + idd).value = data[0].unit;
                }
                else {
                    document.getElementById("dv_" + idd).value = data[0].unit + "(" + data[0].unit_Note + ")";
                }
                document.getElementById("dg_" + idd).value = data[0].price;
                document.getElementById("nt_" + idd).value = data[0].currency;

                if (document.getElementById("sl_" + idd).value != "") {
                    var pr = parseFloat(data[0].price) || 0;
                    var sq = parseFloat(document.getElementById("sl_" + idd).value) || 0;
                    document.getElementById("tcp_" + idd).value = (pr * sq).toFixed(2);
                }
                //document.getElementById("tenhang_" + idd).value = data[0].material_Code;
                tinhTongTatCa();
            }
        })
        .catch(error => {
            console.error('There was a problem with the fetch operation:', error);
        });
    }

    document.getElementById('btn-add-row').addEventListener('click', function() {
        const tbody = document.querySelector('#dynamic-table tbody');
        const firstRow = tbody.querySelector('.input-row');

        // 1. Clone dòng đầu tiên
        const newRow = firstRow.cloneNode(true);
        const lastRow = tbody.querySelector('.input-row:last-child');

        // 2. Xóa bỏ container Select2 cũ
        $(newRow).find('.select2-container').remove();
        $(newRow).find('select').removeClass('select2-hidden-accessible').removeAttr('data-select2-id');
        $(newRow).find('*').removeAttr('data-select2-id');

        // 3. Giữ lại giá trị dùng chung
        if (lastRow) {
            const lastPcpValue = $(lastRow).find('.pcp').val();
            $(newRow).find('.pcp').val(lastPcpValue);

            const lastmdValue = $(lastRow).find('.md').val();
            $(newRow).find('.md').val(lastmdValue);

            const lastvtValue = $(lastRow).find('.vt').val();
            $(newRow).find('.vt').val(lastvtValue);
        }

        // 4. Reset giá trị input tính toán
        const $elements = $(newRow).find('select, input, textarea');
        $elements.each(function() {
            const $el = $(this);
            const id = $el.attr('id') || '';
            if (id.includes('stk_') || id.includes('kho_') || id.includes('tk_') || id.includes('sl_') || id.includes('dv_') || id.includes('dg_') || id.includes('nt_') || id.includes('tcp_')) {
                $el.val('');
            }
        });

        // 5. Làm sạch ô select Tên hàng
        const newRowTenHang = newRow.querySelector('.tenhang');
        if (newRowTenHang) {
            newRowTenHang.innerHTML = '<option value=""></option>';
        }

        // 6. Hiển thị nút xóa & Thêm vào bảng
        const removeBtn = newRow.querySelector('.btn-remove');
        if (removeBtn) {
            removeBtn.style.display = 'inline-block';
        }
        tbody.appendChild(newRow);

        // Cập nhật số thứ tự và gán ID mới (VD: tenhang_3)
        updateRowNumbers();

        // 7. Lấy thông tin để khởi tạo dữ liệu
        const newTenHangId = newRow.querySelector('.tenhang').id;
        let group_code = document.getElementById("group_code").value;


        // 8. Kích hoạt giao diện Select2 cho dòng mới
           if ($.fn.select2) {
                $('#' + newTenHangId).select2({ width: '100%' });
                $(newRow).find('.pcp, .stk').select2({ width: '100%' });

                // THÊM ĐOẠN NÀY: Bắt sự kiện khi Select2 thay đổi giá trị
                $('#' + newTenHangId).on('change', function() {
                    if (this.value && this.value.trim() !== '') {
                        _load_material_1(this.value, this.id);
                    }
                });
            }

        // 9. GỌI HÀM _load_name_inv1 để tải danh sách độc lập cho ID mới
        if (typeof _load_name_inv1 === 'function') {
            _load_name_inv1(group_code, newTenHangId);
        }
    });

    async function _load_name_inv1(group_code, targetSelectId) {
        const params = new URLSearchParams({
            group_code: group_code,
            loaichiphi: (document.getElementById("loaichiphi") ? document.getElementById("loaichiphi").value : '')
        });

        fetch(ApiEndpoints.loadMaterial, { // use centralized endpoint
            method: 'POST',
            body: params
        })
        .then(res => res.json())
        .then(data => {
            console.log(data)
            // 1. Nếu có ID mục tiêu (dòng mới tạo), đổ dữ liệu vào ô đó
            if (targetSelectId) {
                let options = '<option value=""></option>';
                data.forEach(item => {

                    options += `<option value="${item}">${item}</option>`;
                });
                $('#' + targetSelectId).html(options).trigger('change');
            }

          
        })
        .catch(error => {
            console.error("Lỗi khi load danh sách bằng _load_name_inv1:", error);
        });
    }

    // Xử lý xóa dòng
    document.querySelector('#dynamic-table').addEventListener('click', function(e) {
        if (e.target && e.target.classList.contains('btn-remove')) {
            const row = e.target.closest('tr');
            const rowCount = document.querySelectorAll('#dynamic-table tbody tr').length;
            if (rowCount > 1) {
                row.remove();
                updateRowNumbers(); // Cập nhật lại số thứ tự sau khi xóa
                tinhTongTatCa();
            }
        }
    });

    function updateRowNumbers() {
        const rows = document.querySelectorAll('#dynamic-table tbody tr');
        rows.forEach((row, index) => {
            const i = index + 1; // Số thứ tự mới

            // 1. Cập nhật số hiển thị
            const stt = row.querySelector('.row-number');
            if (stt) stt.innerText = i;

            // 2. Danh sách các ID cần cập nhật theo đúng hậu tố _i
            const idList = ['tenhang', 'stk', 'kho', 'tk', 'sl', 'dv', 'dg', 'nt', 'tcp', 'md', 'pcp', 'vt', 'gc'];

            idList.forEach(name => {
                const el = row.querySelector(`[id^="${name}_"]`); // Tìm phần tử có id bắt đầu bằng name_
                if (el) {
                    el.id = `${name}_${i}`;

                    // Cập nhật hàm sự kiện inline nếu có
                    if (name === 'tenhang') {
                        el.setAttribute('onchange', `_load_material_1(this.value, this.id)`);
                    }
                    if (name === 'sl') {
                        el.setAttribute('onblur', `caculator(this.id)`);
                        el.setAttribute('onchange', `caculator(this.id)`);
                    }
                }
            });
        });
    }

    function caculator(id) {
        // Lấy số thứ tự dòng từ ID (ví dụ: sl_1 -> 1)
        var idd = id.split('_')[1];

        // Lấy giá trị đơn giá và số lượng
        var pricee = document.getElementById("dg_" + idd).value || 0;
        var sl = document.getElementById("sl_" + idd).value || 0;

        // Tính thành tiền cho dòng hiện tại (TCP)
        var tcpValue = parseFloat(pricee) * parseFloat(sl);
        // Gán giá trị vào ô TCP (định dạng số thực hoặc 0 nếu NaN)
        document.getElementById("tcp_" + idd).value = (isNaN(tcpValue) ? 0 : tcpValue).toFixed(2);

        // Gọi hàm tính tổng tất cả các dòng
        tinhTongTatCa();
    }

    function tinhTongTatCa() {
        let tongMoi = 0;
        const allTcp = document.querySelectorAll('.tcp');

        // Hàm phụ để "làm sạch" số: Xóa toàn bộ dấu phẩy
        const parseNumber = (val) => {
            if (!val) return 0;
            // Xóa dấu phẩy: "1,234.56" -> "1234.56"
            let cleanedStr = val.toString().replace(/,/g, '');
            return parseFloat(cleanedStr) || 0;
        };

        allTcp.forEach(input => {
            tongMoi += parseNumber(input.value);
        });

        const groupCode = document.getElementById("group_code").value;
        if (groupCode === "GA") {
            let tigia = parseNumber(document.getElementById("rate").value) || 1;
            tongMoi = tongMoi / tigia;
        }

        const displayTotal = document.getElementById("thanhtien");
        if (displayTotal) {
            displayTotal.value = tongMoi.toFixed(2)
        }
    }

    function _load_phongchiuphi_1() {
        fetch(ApiEndpoints.getPhongChiuphi, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            }
        })
        .then(response => {
            if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
            return response.json();
        })
        .then(data => {
            let optionsHtml = '';
            data.forEach(item => {
                optionsHtml += `<option value="${item}">${item}</option>`;
            });

            const selectElements = document.querySelectorAll('.pcp');
            selectElements.forEach(select => {
                select.insertAdjacentHTML('beforeend', optionsHtml);
            });
        })
        .catch(error => console.error('Lỗi fetch:', error));
    }

    function _load_account_1() {
        fetch(ApiEndpoints.loadAccount, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
        })
        .then(response => {
            if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
            return response.json();
        })
        .then(data => {
            const stkSelects = document.querySelectorAll('.stk');

            stkSelects.forEach(select => {
                const currentValue = select.value;
                let optionsHtml = currentValue ? `<option selected>${currentValue}</option>` : '';

                data.forEach(account => {
                    if (account !== currentValue) {
                        optionsHtml += `<option value="${account}">${account}</option>`;
                    }
                });
                select.innerHTML = optionsHtml;
            });
        })
        .catch(error => console.error('Lỗi fetch:', error));
    }

    function _load_request(){
        const urlParams = new URLSearchParams(window.location.search);
        const iD_REQUEST = urlParams.get('iD_REQUEST');

        const params = new URLSearchParams();
        params.append('iD_REQUEST', iD_REQUEST);

        fetch(ApiEndpoints.request, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: params.toString()
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            document.getElementById("group_code").value = data[0].group_Code;
            document.getElementById("name_dept").value = data[0].cost_Center;
            document.getElementById("ngayyeucau").value = data[0].request_Date.split(' ')[0];
            document.getElementById("thoihan").value = data[0].dealine.split(' ')[0];
            document.getElementById("typee").value = data[0].typee;
            document.getElementById("thanhtien").value = data[0].total;
            document.getElementById("loaichiphi").value = data[0].declaration;
            document.getElementById("placee").value = data[0].place;

            if (data[0].urgent == true) {
                document.getElementById("gap").checked = true;
            }
             if (data[0].group_Code == "GA") {
              
                document.getElementById("modal-6").style.display = 'none';

            }
            if (data[0].group_Code == "PROD") {
               document.getElementById("modal-20").style.display = 'none';
              
            }
        })
        .catch(error => {
            console.error('There was a problem with the fetch operation:', error);
        });
    }

    function kiemTraViTriKhopNhau() {
        // 1. Lấy giá trị của ô vị trí chung (phía trên bảng)
        const viTriChung = document.getElementById("placee").value.trim();

        // 2. Lấy tất cả các thẻ select vị trí chi tiết trong bảng (có class là 'vt')
        const danhSachViTriChiTiet = document.querySelectorAll("#dynamic-table tbody .vt");

        let isValid = true;
        let cacDongLoi = [];

        // 3. Duyệt qua từng dòng để so sánh
        danhSachViTriChiTiet.forEach((selectBox, index) => {
            const viTriChiTiet = selectBox.value.trim();

            // Nếu giá trị không khớp, đánh dấu lỗi và lưu lại vị trí dòng
            if (viTriChiTiet !== viTriChung) {
                isValid = false;
                cacDongLoi.push(index + 1); // index + 1 để lấy đúng số thứ tự dòng hiển thị
            }
        });

        // 4. Hiển thị thông báo nếu có lỗi
        if (!isValid) {
            alert("Cảnh báo: Vị trí tại các dòng số " + cacDongLoi.join(", ") + " không khớp với Vị trí  ( " + (viTriChung || "Chưa nhập") + " ). Vui lòng kiểm tra lại!");
            return false; // Ngăn chặn việc gửi dữ liệu
        }

        return true; // Trạng thái hợp lệ, cho phép gửi
    }

    function check_mucdichkhac() {
        // mặc định là chi phí cố định
        if(document.getElementById("group_code").value == "GA"){

              $('#loaichiphi').val('COMMON').prop('disabled', false);
        }
        if(document.getElementById("group_code").value == "PROD"){
              $('#loaichiphi').val('EUQIMENT').change();
              $('#loaichiphi').val('EUQIMENT').prop('disabled', true);
        }

        // 1. Reset danh sách vật tư (nếu có dropdown bên ngoài)
        const lstMaterial = document.getElementById("lstMaterial");
        if (lstMaterial) lstMaterial.innerHTML = "";

        // 2. Định nghĩa dòng mẫu mới (Cột STK có thể thay đổi tùy ý ở đây)
        const tbody = document.querySelector('#dynamic-table tbody');
        const templateRow = `
            <tr class="input-row">
                <td class="row-number text-center fw-bold">1</td>
                <td>
                    <select class="form-control select2 tenhang" onchange="_load_material(this.value, this.id)" id="tenhang_1">
                        <option value=""></option>
                    </select>
                </td>
                <td>
                    <select id="stk_1" class="form-control stk" ></select>
                </td>
                <td hidden><input type="text" class="form-control kho" id="kho_1" readonly /></td>
                <td hidden><input type="text" class="form-control tk" id="tk_1" readonly /></td>
                <td><input type="number" class="form-control sl" id="sl_1" min="0" oninput="caculator(this.id)"></td>
                <td><input type="text" class="form-control dv" id="dv_1" readonly></td>
                <td><input type="number" class="form-control dg" id="dg_1" readonly></td>
                <td><input type="text" class="form-control nt" id="nt_1" readonly></td>
                <td><input type="text" class="form-control tcp" id="tcp_1" readonly></td>
                <td><input type="text" class="form-control md" id="md_1"></td>
                <td>
                    <select class="form-control pcp" onchange="_load_vitri(this.value, this.id)" id="pcp_1"></select>
                </td>
                <td>
                    <select class="form-control vt" id="vt_1"></select>
                </td>
                <td><input type="text" class="form-control gc" id="gc_1"></td>
                <td>
                    <button type="button" class="btn btn-outline-danger btn-remove" style="display: none;">&times;</button>
                </td>
            </tr>`;

        // 3. Thay thế nội dung bảng
        tbody.innerHTML = templateRow;
         let group_code = document.getElementById("group_code").value + "_CPK";
        _load_name_inv(group_code);
        _load_phongchiuphi();
        _load_account();
        // 5. Tính toán lại tổng tiền (về 0)
        tinhTongTatCa();
    }

    function uncheck_mucdichkhac() {
        // 1. Mở khóa và reset loại chi phí
        $('#loaichiphi').prop('disabled', false);
        $('#loaichiphi').val('').change(); // Hoặc set về giá trị mặc định ban đầu
        $('#loaichiphi').val('AUXILIARY').change();
        // 2. Reset danh sách vật tư (nếu cần)
        const lstMaterial = document.getElementById("lstMaterial");
        if (lstMaterial) lstMaterial.innerHTML = "";

        // 3. Load lại dữ liệu ban đầu (không có hậu tố _CPK)
        let group_code = document.getElementById("group_code").value;

        // Gọi lại các hàm load dữ liệu mặc định
        _load_name_inv(group_code);
        _load_phongchiuphi();

        // Reset tổng tiền
        tinhTongTatCa();
    }

    function mucdichkhac(el) {
        if ($(el).is(':checked')) {
            check_mucdichkhac();
        } else {
            uncheck_mucdichkhac();
        }
    }
</script>
