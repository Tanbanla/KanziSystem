@using PRJ_WAREHOUSE_BIVN.Language
@{
    ViewData["Title"] = Languages.tonkho ;
}
@* <style>
    .card .card-header .form-control {
        height: 42px;
        font-size: 13px;
        border-radius: 2px;
    }
</style> *@
<div class="row">
    <div class="col-12">
        <div class="card card-primary">
            <div class="card-header">
                <div class="form-group" style="margin : 10px 0 0 0">
                    <div class="input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text" style="height:42px"><i class="ion ion-social-codepen-outline"></i></div>
                        </div>
                        <input type="text" class="form-control" id="mnl" placeholder="@Languages.Mahang">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <div class="input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text" style="height:42px">@Languages.Kho :</div>
                        </div>
                        <select class="form-control" id="kho" onchange="_load_inv()"></select>
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <div class="input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text" style="height:41px"><i class="ion ion-lock-combination"></i></div>
                        </div>
                        <input type="text" class="form-control" id="cost" placeholder="Cost">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <div class="input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text" style="height:42px">@Languages.Khoi :</div>
                        </div>
                        <select class="form-control" id="group_code" onchange="_load_inv()">
                            <option value=""></option>
                            <option value="PROD">PROD</option>
                            <option value="GA">GA</option>
                            <option value="IT">IT</option>
                            <option value="PUR">PUR</option>
                        </select>
                    </div>
                </div>
                <button type="button" class="btn btn-primary" style=" margin-left: 30px; float:right" onclick="_load_inv()"><i class="ion ion-ios-search-strong"></i></button>
                    <a href="/Import/ExportToExcel_Log"> <button type="button" class="btn btn-success" style=" margin-left: 30px; float:right"><i class="fa fa-file-excel"></i> Xuất file excel</button></a>
                <button type="button" class="btn btn-danger" style=" margin-left: 30px; float:right" id="modal-21"><i class="ion ion-ios-arrow-thin-right"></i> Chuyển kho</button>
            </div>
            <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer" id="table-1_wrapper">
                <div class="table-responsive">
                    <div class="card-body" style="padding-top:0px">
                        <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                            <table class="table table-bordered">
                                <thead class="bg-primary">
                                    <tr>
                                        <th>@Languages.MaNVL </th>
                                        <th>@Languages.TenNVL</th>
                                        <th>@Languages.soluong</th>
                                        <th>@Languages.Toithieu</th>
                                        <th>@Languages.Toida</th>
                                        <th>@Languages.Nhom </th>
                                        <th>@Languages.Kho</th>
                                        <th>Cost</th>
                                        <th>@Languages.Ghichu</th>
                                        <th>@Languages.thoigiannhanve </th>
                                        <th class="text-center" colspan="2"></th>
                                    </tr>
                                </thead>
                                <tbody id="show_kho"></tbody>
                            </table>
                            @*   <div id="pagination-controls" class="d-flex justify-content-center mt-3 gap-1"></div> *@
                            <ul class="pagination" id="pagination-controls"></ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>   
</div>
@await Html.PartialAsync("_modal", "Import")
<button id="modal-11" hidden>chuyển kho</button>
<button id="modal-17" hidden>Log kho</button>
<script src="~/scripts/import_process.js"></script>
<script>
    window.onload = function(){
        _load_inv();
        loadListWarehouse();
        load_ma();
        _load_phongchiuphi();
    }
    function loadListWarehouse() {
            fetch('/Delivery/GetWareHouse', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
        })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                document.getElementById('kho').innerHTML = "";
                data.forEach((wh) => {
                       document.getElementById('kho').innerHTML  += `<option>${wh}</option>`;
                })
            })
            .catch(error => {
                console.error('There was a problem with the fetch operation:', error);
            });
    }

    let listLinhKien = [];
    function load_ma(){
        let us = document.getElementById("us").innerHTML;
        const params = new URLSearchParams();
        params.append('us', us);

            fetch('/Master/load_ma', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: params.toString()
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`Yêu cầu thất bại với mã trạng thái: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                listLinhKien = data;
                document.getElementById("malinhkien").innerHTML = "";
                data.forEach((item) =>{
                        document.getElementById("malinhkien").innerHTML += "<option>" + item.ma + "</option>";
                })
            })
            .catch(error => {
                console.error('Lỗi phán định:', error);
                alert("Phán định thất bại: " + error.message);
            });
    }

    let listKho = []; // Biến toàn cục để lưu trữ danh sách kho sau khi load

    function changeLinhKien(selectElement) {
        const maDuocChon = selectElement.value;
        const inputTen = document.getElementById("tenlinhkien");

        // 1. Hiển thị tên linh kiện từ list có sẵn
        const itemFound = listLinhKien.find(x => x.ma === maDuocChon);
        inputTen.value = itemFound ? itemFound.ten : "";

        if (!maDuocChon) return;

        // 2. Gọi API lấy danh sách kho theo mã linh kiện
        const params = new URLSearchParams();
        params.append('manguyenlieu', maDuocChon);

        fetch('/Master/load_kho_theo_ma', {
            method: 'POST',
            headers: {
                // Quan trọng: Sử dụng x-www-form-urlencoded nếu dùng URLSearchParams
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: params.toString()
        })
        .then(response => {
            if (!response.ok) throw new Error(`Lỗi: ${response.status}`);
            return response.json();
        })
        .then(data => {
            // GÁN DỮ LIỆU VÀO BIẾN listKho ĐỂ DÙNG CHO HÀM changeKho
            listKho = data;

            const selectKho = document.getElementById('khochuyen');
            selectKho.innerHTML = '<option value=""></option>';

            data.forEach((wh) => {
                // Phải có value="${wh.ma}" để hàm changeKho lấy được giá trị
                selectKho.innerHTML += `<option value="${wh.ma}">${wh.ma}</option>`;
            });

            // Reset ô hiển thị tên kho/số lượng khi đổi mã linh kiện
            document.getElementById("soluongkho").value = "";
        })
        .catch(error => {
            console.error('Lỗi load kho:', error);
        });
    }
    function changeKho(selectElement) {
        const maKhoChon = selectElement.value;
        const inputTenKho = document.getElementById("soluongkho");

        // Tìm trong listKho đã lưu ở bước trên
        const khoFound = listKho.find(x => x.ma === maKhoChon);

        // Đổ wh.ten vào ô input
        inputTenKho.value = khoFound ? khoFound.ten : "";
    }
    function _load_phongchiuphi() {
        fetch('/Request/_get_phongchiuphi_xuatkho', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        }
    })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
                document.getElementById('vitrichuyenkho').innerHTML = "";

                data.forEach(item => {
                     document.getElementById('vitrichuyenkho').innerHTML += `<option value="${item}">${item}</option>`;
            });
           
        })
        .catch(error => {
            console.error('There was a problem with the fetch operation:', error);
        });
}
</script>
