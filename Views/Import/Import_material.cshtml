@using PRJ_WAREHOUSE_BIVN.Language
@{
    ViewData["Title"] = Languages.tonkho ;
}
<style>
    .card .card-header .form-control {
        height: 42px;
        font-size: 13px;
        border-radius: 2px;
    }
</style>
<div class="row">
    <div class="col-12">
        <div class="card card-primary">
            <div class="card-header">
                <div class="form-group" style="margin : 10px 0 0 0">
                    <div class="input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text"><i class="ion ion-social-codepen-outline"></i></div>
                        </div>
                        <input type="text" class="form-control" id="mnl" placeholder="@Languages.Mahang">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <div class="input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text">@Languages.Kho :</div>
                        </div>
                        <select class="form-control" id="kho" onchange="_load_inv()"></select>
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <div class="input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text"><i class="ion ion-lock-combination"></i></div>
                        </div>
                        <input type="text" class="form-control" id="cost" placeholder="Cost">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <div class="input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text">@Languages.Khoi :</div>
                        </div>
                        <select class="form-control" id="group_code" onchange="_load_inv()">
                            <option value=""></option>
                            <option value="PROD">PROD</option>
                            <option value="GA">GA</option>
                            <option value="IT">IT</option>
                            <option value="PUR">PUR</option>
                        </select>
                    </div>
                </div>
                <button type="button" class="btn btn-primary" style=" margin-left: 30px; float:right" onclick="_load_inv()"><i class="ion ion-ios-search-strong"></i></button>
            </div>
            <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer" id="table-1_wrapper">
                <div class="table-responsive">
                    <div class="card-body" style="padding-top:0px">
                        <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                            <table class="table table-bordered">
                                <thead class="bg-primary">
                                    <tr>
                                        <th>@Languages.MaNVL </th>
                                        <th>@Languages.TenNVL</th>
                                        <th>@Languages.soluong</th>
                                        <th>@Languages.Toithieu</th>
                                        <th>@Languages.Toida</th>
                                        <th>@Languages.Nhom </th>
                                        <th>@Languages.Kho</th>
                                        <th>Cost</th>
                                        <th>@Languages.Ghichu</th>
                                        <th>@Languages.thoigiannhanve </th>
                                        <th class="text-center" colspan="2"></th>
                                    </tr>
                                </thead>
                                <tbody id="show_kho">
                                </tbody>
                            </table>
                            @*   <div id="pagination-controls" class="d-flex justify-content-center mt-3 gap-1"></div> *@
                            <ul class="pagination" id="pagination-controls"></ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>   
</div>
@await Html.PartialAsync("_modal", "Import")
<button id="modal-11" hidden>chuyển kho</button>
<button id="modal-17" hidden>Log kho</button>
<script src="~/scripts/import_process.js"></script>
<script>
    window.onload = function(){
        _load_inv();
        loadListWarehouse();
    }
    function loadListWarehouse() {
            fetch('/Delivery/GetWareHouse', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
        })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                document.getElementById('kho').innerHTML = "";
                console.log(data);
                data.forEach((wh) => {
                       document.getElementById('kho').innerHTML  += `<option>${wh}</option>`;
                })
            })
            .catch(error => {
                console.error('There was a problem with the fetch operation:', error);
            });

    }
</script>