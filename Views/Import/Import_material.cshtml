@{
    ViewData["Title"] = "Import";
}
<style>
    .card .card-header .form-control {
        height: 42px;
        font-size: 13px;
        border-radius: 2px;
    }
</style>
<div class="row">
    <div class="col-12">
        <div class="card card-primary">
            <div class="card-header">
                <div class="form-group" style="margin : 10px 0 0 0">
                    <div class="input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text"><i class="ion ion-social-codepen-outline"></i></div>
                        </div>
                        <input type="text" class="form-control" id="mnl" placeholder="Mã nguyên liệu">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <div class="input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text"><i class="ion ion-ios-home"></i></div>
                        </div>
                        <input type="text" class="form-control" id="kho" placeholder="Kho">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <div class="input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text"><i class="ion ion-lock-combination"></i></div>
                        </div>
                        <input type="text" class="form-control" id="cost" placeholder="Cost">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <div class="input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text"><i class="ion ion-ios-unlocked"></i></div>
                        </div>
                        <select class="form-control" id="luukho">
                            <option value="0">Không lưu kho</option>
                            <option value="1">Có lưu kho</option>
                        </select>
                    </div>
                </div>
                <button type="button" class="btn btn-primary" style="border-radius :0px; height:42px; margin-left:20px; float:right" onclick="_load_inv()"><i class="ion ion-ios-search-strong"></i></button>
            </div>
            <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer" id="table-1_wrapper">
                <div class="table-responsive">
                    <div class="card-body" style="padding-top:0px">
                        <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                            <table class="table table-bordered">
                                <thead class="bg-primary">
                                    <tr>
                                        <th>Mã nguyên liệu</th>
                                        <th>Số lượng</th>
                                        <th>Tối thiểu</th>
                                        <th>Tối đa</th>
                                        <th>Nhóm </th>
                                        <th>Kho</th>
                                        <th>Cost</th>
                                        <th width="20%">Ghi chú</th>
                                        <th>Thời gian </th>
                                        <th width="80px" class="text-center"></th>                                  
                                    </tr>
                                </thead>
                                <tbody id="show_kho">
                                </tbody>
                            </table>
                            @*   <div id="pagination-controls" class="d-flex justify-content-center mt-3 gap-1"></div> *@
                            <ul class="pagination" id="pagination-controls"></ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
   
</div>
<script src="~/scripts/import_process.js"></script>
<script>
    window.onload = function(){
        _load_inv();
    }
</script>