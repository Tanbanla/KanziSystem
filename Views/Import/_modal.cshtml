<style>
    .modal-dialog {
        max-width: 72%;
    }

</style>
<form class="modal-part" id="modal-warehouse-part">
    <div class="row  m-1">
       <div class="form-group col-12">
            <table class="table table-bordered">
                <tr>
                    <td colspan="2">Chọn người duyệt đơn :</td>
                    <td>Tổng đơn : <span id="tongtienpheduyet" class="bold"></span> $</td>
                </tr>
                <tr class="text-white">
                    <td class="bg-info">Người dự thảo</td>
                    <td class="bg-warning">Người thẩm tra</td>
                    <td class="bg-danger">Người phê duyệt</td>
                    <td class="bg-light text-dark">Đồng ý bởi</td>
                    <td class="bg-light text-dark">Người xuất kho</td>
                </tr>
                <tr>
                    <td><select class="form-control" id="ten_duthao"></select></td>
                    <td><select class="form-control" id="ten_thamtra" onchange="get_info(this.value,'thamtra')"></select></td>
                    <td><select class="form-control" id="ten_pheduyet" onchange="get_info(this.value,'pheduyet')"></select></td>
                    <td><select class="form-control" id="ten_dongy" onchange="get_useriv(this.value)"></select></td>
                    <td><select class="form-control" id="ten_xuatkho" onchange="get_useriv(this.value)"></select></td>
                </tr>
                <tr>
                    <td><input type="text" class="form-control" id="cv_duthao" readonly /></td>
                    <td><input type="text" class="form-control" id="cv_thamtra" readonly /></td>
                    <td><input type="text" class="form-control" id="cv_pheduyet" readonly /></td>
                    <td><input type="text" class="form-control" id="cv_dongy" readonly /></td>
                    <td><input type="text" class="form-control" id="cv_xuatkho" readonly /></td>
                </tr>
                <tr>
                    <td><input type="text" class="form-control" id="mail_duthao" readonly /></td>
                    <td><input type="text" class="form-control" id="mail_thamtra" readonly /></td>
                    <td><input type="text" class="form-control" id="mail_pheduyet" readonly /></td>
                    <td><input type="text" class="form-control" id="mail_dongy" readonly /></td>
                    <td><input type="text" class="form-control" id="mail_xuatkho" readonly /></td>
                </tr>
                <tr><td colspan="5"></td></tr>
                <tr>
                    <th colspan="5"> <b><i class="text-danger">+ Quy trình xin phê duyệt:</i></b></th>
                </tr>
                <tr>
                    <td colspan="5">
                        - Dưới <b>3,000 USD (66 triệu VNĐ)</b> : Người phụ trách làm dự thảo → Quản lý trung cấp thẩm tra → Phó trưởng bộ phận. <br />
                        - Dưới <b>10,000 USD (220 triệu VNĐ)</b> : Người phụ trách làm dự thảo → Quản lý trung cấp thẩm tra → Trưởng bộ phận. <br />
                        - Từ <b>10,000 USD (220 triệu VNĐ) trở lên </b> : Quản lý trung cấp làm dự thảo → Trưởng bộ phận/Phó trưởng bộ phận thẩm tra → Tổng Giám đốc/ Giám đốc phê duyệt <br />
                        - Phê duyệt xuất kho(PR1-MC): Quản lý sơ cấp/quản lý trung cấp  → Đảm nhiệm xuất kho kho Kanzai <br />
                    </td>
                </tr>
            </table>
            <br />
            <button type="button" class="btn btn-info float-right" onclick="_insert_request()">✉ Gửi yêu cầu</button>
       </div>
    </div>

</form>

<div class="modal-part" id="modal-download">
   <div class="row m-2">
       <div class="form-group col-12">
            <table class="table table-bordered">
                <tr>
                    <td colspan="2">Chọn ngày tải log :</td>
                    <td><input type="date" id="date_to" class="form-control" /></td>
                    <td><input type="date" id="date_from" class="form-control" /></td>
                </tr>
            </table>
            <br />
            <button type="submit" class="btn btn-success float-right" onclick="downloadExcel()"> <i class="fa fa-download"></i> Download</button>

       </div>
   </div>
</div>

<div class="modal-part" id="modal-xuatkho">
    <div class="row m-1">
        <div class="form-group col-12">
            <table class="table table-bordered">
                <tr hidden>
                    <td id="madon"></td>
                    <td id="donvi"></td>
                </tr>
                <tr>
                    <th width="180px">Mã hàng :</th>
                    <td colspan="3"><b class="text-danger" id="mahagg"></b></td>
                </tr>
                <tr>
                    <th>Chọn Kho :</th>
                    <td><select class="form-control" id="_lskho" onchange="_soluongtontainhamay(this.value)"></select></td>
                    <th>Tồn kho :</th>
                    <td><input type="text" class="form-control" id="sl_ton" readonly /></td>
                </tr>
                <tr>
                    <th>Cần xuất : </th>
                    <th colspan="3" class="text-danger" id="sl_canxuat"></th>

                </tr>
                <tr>
                    <th class="bg-info-subtle">Thực tế xuất :</th>
                    <td><input type="number" class="form-control" id="sl_xuat" required onblur="caculator()" /></td>
                    <th width="120px">Người nhận :</th>
                    <td><input type="text" id="nguoinhan" class="form-control" required /></td>
                </tr>
            </table>
            <br />
            <button type="submit" class="btn btn-success float-right" onclick="_xuatkho()"> <i class="fa fa-cart-plus"></i> Xuất kho</button>

        </div>
    </div>

</div>

<div class="modal-part" id="modal-chuyenkho">
    <style>
        .modal-header, .modal-body, .modal-footer {
            padding: 0px;
        }
    </style>
    <form id="form-chuyenkho" class="needs-validation" novalidate>
        <div class="card">
            <div class="card-header bg-light">
                <strong>Chuyển kho</strong>
            </div>
            <div class="card-body">
                <div class="mb-3 row align-items-center">
                    <label class="col-sm-3 col-form-label"> Mã hàng :</label>
                    <div class="col-sm-9">
                        <span id="ma_ck" class="fs-5 text-primary"></span>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label"> Kho hiện tại</label>
                        <input type="text" id="kho_hientai" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label"> Tồn kho</label>
                        <input type="number" id="tonkho" class="form-control" readonly />
                    </div>
                </div>

                <div class="row g-3 mt-3">
                    <div class="col-md-6">
                        <label class="form-label"> Nhà máy</label>
                        <select class="form-control" id="nhamay_chuyen" onchange="_SEC(this.value)"></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label"> Phòng ban</label>
                        <select class="form-control" id="phongban_chuyen" onchange="_WH()"></select>
                      @*   <input type="text" id="phongban_chuyen" class="form-control" placeholder="Tên phòng ban" /> *@
                    </div>

                 
                </div>

                <div class="row g-3 mt-3">
                    <div class="col-md-6">
                        <label class="form-label"> Đến kho</label>
                        <select id="den_kho" class="form-control"></select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label"> Nhập số lượng muốn chuyển</label>
                        <input type="number" id="sl_chuyen" class="form-control" min="1" required onblur="chekk()"
                               value="0" />
                        <i style="font-size:11px;color:red"> Số lượng hợp lệ (>=1 và <= tồn kho).</i>
                    </div>
                </div>
            </div>

            <div class="card-footer text-end">
                <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Hủy</button>
                <button type="submit" class="btn btn-outline-success" onclick="_chuyenkho()">
                    <i class="fas fa-exchange-alt"></i> Chuyển kho
                </button>
            </div>
        </div>
    </form>
</div>

<script>
    // Minimal client-side helpers: clamp quantity to available stock and show validation.
   function chekk(){
        const qty = document.getElementById('sl_chuyen');
         const stock = document.getElementById('tonkho');

          const max = parseInt(stock.value || '0', 10);
              let val = parseInt(qty.value || '0', 10);
              if (isNaN(val) || val < 1) val = 1;
              if (max > 0 && val > max) val = max;
              qty.value = val;
   }

    // Placeholder transfer function (to be implemented in page script)
    function _chuyenkho() {
        // Validate before sending
        const denKho = document.getElementById('den_kho').value;
        const nhamay = document.getElementById('nhamay_chuyen').value;
        const phongban = document.getElementById('phongban_chuyen').value;
        const sl = parseInt(document.getElementById('sl_chuyen').value || '0', 10);
        const ton = parseInt(document.getElementById('tonkho').value || '0', 10);

        if (!denKho) {
            alert('Vui lòng chọn kho nhận.');
            return;
        }
        if (sl < 1 || sl > ton) {
            alert('Số lượng không hợp lệ.');
            return;
        }

       
    }
</script>