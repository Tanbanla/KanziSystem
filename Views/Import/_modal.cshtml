<script>
    // Minimal client-side helpers: clamp quantity to available stock and show validation.
   function chekk(){
        let qty = document.getElementById('sl_chuyen').value;
        const stock = document.getElementById('tonkho').value;
        if(parseFloat(qty) > parseFloat(stock))
        {
            alert("Quá số lượng");
              document.getElementById('sl_chuyen').value = stock;
        }        
   }
     
    // Placeholder transfer function (to be implemented in page script)
    function _chuyenkho() {
    // Validate before sending
          let mahang = document.getElementById('ma_ck').innerHTML;
          let khohientai = document.getElementById('kho_hientai').value;
          let tonkho = document.getElementById('tonkho').value;

          let phongban = document.getElementById('phongban_chuyen').value;
          let denkho = document.getElementById('den_kho').value;
          let soluong = parseInt(document.getElementById('sl_chuyen').value);
          let khoi = document.getElementById('khoi').value;
          let nguoichuyen = document.getElementById('us').innerHTML;

   
            const params = new URLSearchParams();
            params.append('mahang', mahang);
            params.append('khohientai', khohientai);
            params.append('tonkho', tonkho);
            params.append('phongban', phongban);
            params.append('denkho', denkho);
            params.append('soluong', soluong);
            params.append('khoi', khoi);
            params.append('nguoichuyen', nguoichuyen);

                fetch('/Master/chuyenkho', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: params.toString()
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`Yêu cầu thất bại với mã trạng thái: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(data => {
                        alert(data);
                        document.querySelectorAll('.close').forEach(button => button.click());
                         _load_inv();
                    })
                    .catch(error => {
                        console.error('Lỗi phán định:', error);
                        alert("Phán định thất bại: " + error.message);
                    });
         
    }
   
</script>
