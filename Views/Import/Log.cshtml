@using PRJ_WAREHOUSE_BIVN.Language
@{
    ViewData["Title"] = "Log Nhập - Xuất";
}
<style>
    .card .card-header {
        min-height: 0px;
    }

        .card .card-header .form-control {
            height: 38px;
            font-size: 13px;
            border-radius: 0px;
        }
    /* Thiết lập chiều cao cho vùng cuộn và cố định header */
    .table-responsive.card {
        max-height: 800px; /* Bạn có thể thay đổi chiều cao tùy ý */
        overflow-y: auto;
    }

    .table thead th {
        position: sticky;
        top: -1px; /* Tránh khoảng hở nhỏ khi cuộn */
        z-index: 10;
        background-color: #007bff; /* Trùng với màu bg-primary của Bootstrap */
        color: white;
        border-bottom: 0;
    }
    /* Đảm bảo border không bị mất khi dùng sticky */
    .table-bordered thead th {
        border-top: 0;
    }
    .table:not(.table-sm) thead th{
        border-bottom: none;
        background-color: rgb(35 53 183);
        color: white;
    }
</style>
<div class="row">
    <div class="col-12">
        <div class="card card-primary">
            <div class="card-header">
                <div class="form-group" style="margin :0px 0 0 0px">
                    <label>@Languages.MaNVL : </label>
                    <div class="input-group mb-2">
                        <input type="text" class="form-control" id="manguyenlieu" placeholder="VD: A000452 ">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <label>@Languages.mayeucau : </label>
                    <div class="input-group mb-2">
                        <input type="text" class="form-control" id="madon" placeholder="VD: A004.20251004-1 ">
                    </div>
                </div>              
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <label>@Languages.Kho : </label>
                    <div class="input-group mb-2">
                        <input type="text" class="form-control" id="kho" placeholder="VD: F2">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <label>@Languages.Loai :</label>
                    <div class="input-group mb-2">
                      @*   <input type="text" class="form-control" id="loai" list="lst_loai" placeholder="--- Chọn ---"> *@
                        <select class="form-control" id="loai">
                            <option></option>
                            <option>XUAT</option>
                            <option>NHAP</option>
                            <option>CHUYENKHO</option>
                            <option>TAINHAP</option>
                        </select>    
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <label>@Languages.Khoi :</label>
                    <div class="input-group mb-2">
                        @*   <input type="text" class="form-control" id="loai" list="lst_loai" placeholder="--- Chọn ---"> *@
                        <select class="form-control" id="khoii">
                            <option></option>
                            <option>PROD</option>
                            <option>GA</option>
                            <option>IT</option>
                            <option>PUR</option>
                        </select>
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <label>@Languages.Tungay :</label>
                    <div class="input-group mb-2">
                        <input type="date" class="form-control" id="ngay_tu">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <label>@Languages.denngay :</label>
                    <div class="input-group mb-2">
                        <input type="date" class="form-control" id="ngay_den">
                    </div>
                </div>
                <div class="form-group" style="margin : 10px 0 0 20px">
                    <label>@Languages.phongtiepnhan : </label>
                    <div class="input-group mb-2">
                        <input type="text" class="form-control" id="phong" placeholder="VD: A004">
                    </div>
                </div>
                <button type="button" class="btn btn-info ml-3 mt-4" onclick="_load_log()"><i class="ion ion-ios-search-strong"></i> @Languages.timkiem</button>
                <button type="button" class="btn btn-success ml-3 mt-4" id="modal-9"><i class="fa fa-file-excel"></i> download log</button>
            </div>
            <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                <div class="table-responsive card">
                    <table class="table table-bordered">
                        <thead class="bg-primary">
                            <tr>
                                <th>@Languages.MaNVL</th>
                                <th>@Languages.Noidung</th>
                                <th>@Languages.soluong</th>
                                <th>@Languages.soluongdathang</th>
                                <th>@Languages.Sopo</th>
                                <th>@Languages.Donvi</th>
                                <th>@Languages.Loai</th>
                                <th>@Languages.Ngaynhapkho</th>
                                <th>@Languages.Damnhiem</th>
                                <th>@Languages.Kho</th>
                                <th>@Languages.Khoi</th>                            
                                <th>@Languages.vitri</th>
                                <th>@Languages.phongtiepnhan</th>
                            </tr>                          
                        </thead>
                        <tbody id="list_log"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_modal", "Import")
<script src="~/scripts/im_log.js"></script>
<script>
    window.onload = function(){
        _load_log();
    }
</script>
