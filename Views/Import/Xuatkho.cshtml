      let smallcheck = document.getElementById('smallcheck');
     document.addEventListener('change', function(e) {

        if (e.target && e.target.id === 'smallcheck') {
                let checkboxes = document.querySelectorAll('.itemsmall');
            checkboxes.forEach(cb => {
                cb.checked = e.target.checked;
            });
        }
        if (e.target && e.target.classList.contains('itemsmall')) {
                let allItems = document.querySelectorAll('.itemsmall');
            let checkedItems = document.querySelectorAll('.itemsmall:checked');

            // Nếu số lượng checkbox đang chọn bằng tổng số checkbox -> Check nút đầu bảng
            smallcheck.checked = (allItems.length === checkedItems.length);

            // Trạng thái lửng lơ (Gạch ngang) nếu chỉ chọn một vài ô
            smallcheck.indeterminate = (checkedItems.length > 0 && checkedItems.length < allItems.length);
        }

     });
</script>