@using PRJ_WAREHOUSE_BIVN.Language
@{
    ViewData["Title"] = "Xuất kho";
}
<style>
    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        border: 1px solid #ddd;
        padding: 12px;
        text-align: left;
    }

    th {
        background-color: #f4f4f4;
    }

    .table-responsive {
        max-height: 800px; /* Chiều cao tối đa của bảng */
        overflow-y: auto; /* Tạo cuộn dọc */
        overflow-x: auto; /* Tạo cuộn ngang nếu cột quá nhiều */
        border: 1px solid #dee2e6;
    }

        /* Giữ tiêu đề (header) đứng yên khi cuộn */
        .table-responsive table thead tr td {
            position: sticky;
            top: 0;
            background-color: #f8f9fa;
            z-index: 2;
            box-shadow: inset 0 -1px 0 #dee2e6;
        }
    /* Xóa dấu mũi tên mặc định của summary nếu muốn */
    summary {
        cursor: pointer;
        list-style: none;
        font-weight: bold;
        color: #007bff;
    }

        summary::-webkit-details-marker {
            display: none;
        }

    .detail-content {
        padding: 10px;
        background-color: #f9f9f9;
        border-top: 1px dashed #ccc;
        margin-top: 5px;
    }
</style>
<div class="row">
    <div class="col-12">
        <div class="card card-primary">
            <div class="card-header" style="padding-left: 5px">
                <h3 class="text-primary">@Languages.Xuatkho</h3>
            </div>
            <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                <div class="table-responsive card">
                    <table class="table table-bordered">
                        <thead >
                            <tr>
                                <td class="text-center"></td>
                                <td><input type="text" class="form-control" id="mayeucau" placeholder="@Languages.mayeucau "></td>
                                <td><input type="text" class="form-control" id="nguoitao" placeholder="@Languages.nguoitao"></td>
                                <td><button type="button" class="btn btn-success ml-3" onclick="_load_xuatkho()"><i class="ion ion-ios-search-strong"></i> @Languages.timkiem</button></td>
                                <td><button type="button" class="btn btn-info ml-3" onclick="resett()"><i class="ion ion-ios-refresh"></i> @Languages.Lammoi</button></td>
                            </tr>
                            <tr class="bg-primary">                          
                                <th width="80px"></th>
                                <th>@Languages.mayeucau</th>
                                <th>@Languages.Phongban</th>
                                <th>@Languages.Ngayyeucau</th>
                                <th>@Languages.loaichiphi</th>
                                <th>@Languages.Ngaymongmuonnhan</th>
                                <th>@Languages.tongtien</th>
                                <th>@Languages.tongtienthucte</th>
                                <th>@Languages.hangngoaidanhmuc/@Languages.hangtrongdanhmuc</th>
                                <th>@Languages.loaihang</th>
                                <th>@Languages.Tinhtrangdon</th>
                                <th>@Languages.ngaytao</th>
                                <th>@Languages.nguoitao</th>
                                <th>@Languages.ngayupdate</th>
                                <th>@Languages.nguoiupdate</th>
                                <th>@Languages.Khoi</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="list_xuatkho"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<button id="modal-10" hidden>Click</button>
<button id="modal-19" hidden>Click</button>
@await Html.PartialAsync("_modal", "Import")
<script src="~/scripts/xuatkho.js"></script>
<script>
    window.onload = function(){
        _load_xuatkho();
    }
    function resett(){
        document.getElementById("mayeucau").value = "";
        document.getElementById("nguoitao").value = "";
        _load_xuatkho();
    }
