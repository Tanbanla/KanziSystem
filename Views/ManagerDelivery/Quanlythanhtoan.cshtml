                        padding: 0 8px;
                        font-size: 11px;
                        line-height: 1;
                        display: inline-flex;
                        align-items: center;
                    }

                    #poDetailsModal .legend-compact {
                        font-size: 12px;
                        font-weight: bold;
                        margin-bottom: 0;
                        padding: 0 5px;
                        width: auto;
                        float: none;
                    }
                </style>
                <div class="row mb-2" style="font-size: 11px;">
                    <!-- PANEL 1: THÔNG TIN PO -->
                    <div class="col-md-7">
                        <fieldset class="border p-1 rounded h-100 d-flex flex-column">
                            <legend class="legend-compact text-primary">Thông tin PO</legend>

                            <div class="table-responsive mt-1">
                                <table class="table table-borderless table-compact mb-0" style="font-size: 11px;">
                                    <tbody>
                                        <tr>
                                            <td class="text-nowrap" style="width: 15%;">Danh mục hàng:</td>
                                            <td style="width: 35%;"><input type="text" class="form-control input-compact" id="dtDanhMucHang" readonly></td>
                                            <td class="text-nowrap ps-3" style="width: 15%;">Mã NCC:</td>
                                            <td style="width: 35%;"><input type="text" class="form-control input-compact" id="dtMaNcc" readonly></td>
                                        </tr>
                                        <tr>
                                            <td class="text-nowrap">Loại chi phí:</td>
                                            <td><input type="text" class="form-control input-compact" id="dtLoaiChiPhi" readonly></td>
                                            <td class="text-nowrap ps-3">Tên NCC:</td>
                                            <td><input type="text" class="form-control input-compact" id="dtTenNcc" readonly></td>
                                        </tr>
                                        <tr>
                                            <td class="text-nowrap">Ngày phát hành:</td>
                                            <td>
                                                <div class="d-flex">
                                                    <input type="text" class="form-control input-compact me-1" id="dtNgayPhatHanh" readonly>
                                                    <button class="btn btn-light border fw-bold btn-compact">Sửa</button>
                                                </div>
                                            </td>
                                            <td class="text-nowrap ps-3">Khu vực:</td>
                                            <td><input type="text" class="form-control input-compact" id="dtKhuVuc" readonly></td>
                                        </tr>
                                        <tr>
                                            <td class="text-nowrap">Phòng phát hành:</td>
                                            <td><input type="text" class="form-control input-compact bg-light" id="dtPhongPhatHanh" readonly></td>
                                            <td class="text-nowrap ps-3">Địa chỉ:</td>
                                            <td><input type="text" class="form-control input-compact" id="dtDiaChi" readonly></td>
                                        </tr>
                                        <tr>
                                            <td class="text-nowrap">Tên phòng:</td>
                                            <td><input type="text" class="form-control input-compact bg-light" id="dtTenPhong" readonly></td>
                                            <td class="text-nowrap ps-3">Số điện thoại:</td>
                                            <td><input type="text" class="form-control input-compact" id="dtSoDienThoai" readonly></td>
                                        </tr>
                                        <tr>
                                            <td class="text-nowrap">Mục đích:</td>
                                            <td><input type="text" class="form-control input-compact" id="dtMucDich" readonly></td>
                                            <td class="text-nowrap ps-3">Số Fax:</td>
                                            <td><input type="text" class="form-control input-compact" id="dtSoFax" readonly></td>
                                        </tr>
                                        <!-- Đã GỘP Loại tiền và Hình thức vào chung 1 dòng để tiết kiệm 1 hàng -->
                                        <tr>
                                            <td class="text-nowrap">Loại tiền:</td>
                                            <td><input type="text" class="form-control input-compact w-50" id="dtLoaiTien" readonly></td>
                                            <td class="text-nowrap ps-3">Hình thức:</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="form-check me-3 mb-0">
                                                        <input class="form-check-input mt-0" type="radio" name="hinhthuc" id="rdHangHoa" checked disabled style="transform: scale(0.85);">
                                                        <label class="form-check-label" for="rdHangHoa">Hàng hóa</label>
                                                    </div>
                                                    <div class="form-check mb-0">
                                                        <input class="form-check-input mt-0" type="radio" name="hinhthuc" id="rdDichVu" disabled style="transform: scale(0.85);">
                                                        <label class="form-check-label" for="rdDichVu">Dịch vụ</label>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Hàng nút bấm dưới form (Căn sát mép) -->
                            <div class="text-end mt-auto pt-1 border-top">
                                <button class="btn btn-light border fw-bold btn-compact">Sử dụng lại</button>
                                <button class="btn btn-light border fw-bold btn-compact">Sửa</button>
                                <button class="btn btn-light border fw-bold text-danger btn-compact">Hủy</button>
                                <button class="btn btn-light border fw-bold btn-compact">In Excel</button>
                            </div>
                        </fieldset>
                    </div>

                    <!-- PANEL 2: CHI TIẾT KHÁC -->
                    <div class="col-md-5">
                        <fieldset class="border p-1 rounded h-100 d-flex flex-column">
                            <legend class="legend-compact text-primary">Chi tiết khác</legend>

                            <div class="table-responsive mt-1">
                                <table class="table table-borderless table-compact mb-0" style="font-size: 11px;">
                                    <tbody>
                                        <tr>
                                            <td class="text-nowrap text-dark" style="width: 20%;">Mã PO:</td>
                                            <td style="width: 30%;"><strong class="text-primary" style="font-size: 13px;" id="infoMaPo"></strong></td>
                                            <td class="text-nowrap text-dark ps-2" style="width: 25%;">Tình trạng:</td>
                                            <td style="width: 25%;"><span id="infoTinhTrang"></span></td>
                                        </tr>
                                        <tr>
                                            <td class="text-nowrap text-dark">Người tạo:</td>
                                            <td><span class="text-primary" id="infoNguoiTao"></span></td>
                                            <td class="text-nowrap text-dark ps-2">Người xác nhận:</td>
                                            <td><span id="infoNguoiXacNhan"></span></td>
                                        </tr>
                                        <tr>
                                            <td class="text-nowrap text-dark">Tạo lúc:</td>
                                            <td><span class="text-primary" id="infoTaoLuc"></span></td>
                                            <td class="text-nowrap text-dark ps-2">Xác nhận lúc:</td>
                                            <td><span id="infoXacNhanLuc"></span></td>
                                        </tr>
                                        <tr>
                                            <td class="text-nowrap text-dark">Thủ tục HQ:</td>
                                            <td><span id="infoHaiQuan"></span></td>
                                            <td class="text-nowrap text-dark ps-2">Lý do:</td>
