@model IEnumerable<PRJ_WAREHOUSE_BIVN.Models.Quanlythanhtoan>

<div class="container-fluid">
    <!-- Filter and Action Bar -->
    <div class="row mb-3 align-items-end">
        <div class="col-md-8">
            <form asp-action="Quanlythanhtoan" method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Thuộc khối:</label>
                    <select class="form-control" name="cmbKhoi">
                        <option value="">PUR</option>
                        <option value="">GA</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Số PO:</label>
                    <input type="text" class="form-control" name="txtPO" value="@ViewBag.txtPO">
                </div>
               
                <div class="col-md-3">
                    <label class="form-label">Tình trạng:</label>
                    <select class="form-control" name="cmbTinhTrang">
                        <option value="">-- Chọn --</option>
                        <option>Đang chờ xác nhận</option>
                        <option>Hoàn thành xác nhận</option>
                        <option>Đang xử lý</option>
                        <option>Hoàn thành</option>
                        <option>Bị hủy, từ chối</option>
                    </select>
                </div>
                <div class="col-md-3"></div>
                <div class="col-md-3">
                    <label class="form-label">Ngày phát hành:</label>
                    <input type="date" class="form-control" name="txtPhathanh1" value="@ViewBag.txtPhathanh1">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Đến ngày:</label>
                    <input type="date" class="form-control" name="txtPhathanh2" value="@ViewBag.txtPhathanh2">
                </div>
                <div class="col-md-6 mt-3">
                    <button type="submit" class="btn btn-outline-danger fw-bold"><i class="fa fa-search"></i> Tìm kiếm</button>
                 @*    <a href="/QuanLyPO/Create" class="btn btn-outline-primary fw-bold text-decoration-none"> <i class="fa fa-envelope"></i> Phát hành</a> *@
                    <a href="/ManagerDelivery/Quanlythanhtoan" class="btn btn-light border fw-bold text-dark text-decoration-none ml-2"> <i class="fa-solid ion-ios-loop-strong me-1"></i> Refresh</a>

                    <!-- NÚT GỌI POPUP CẬP NHẬT THANH TOÁN -->
                    <button type="button" class="btn btn-success fw-bold ms-2 ml-2" onclick="openUpdateModal()">
                        <i class="fa fa-edit"></i> Cập nhật số liệu TT
                    </button>
                </div>
            </form>
        </div>

        <!-- Legend -->
        <div class="col-md-4">
            <ul class="list-unstyled mb-0" style="font-size: 0.85rem;">
                <li><span class="d-inline-block bg-danger" style="width: 15px; height: 15px;"></span> Đang chờ xác nhận (Need, No Need)</li>
                <li><span class="d-inline-block bg-primary" style="width: 15px; height: 15px;"></span> Hoàn thành xác nhận (Need, No Need và có thể in được đơn hàng)</li>
                <li><span class="d-inline-block bg-warning" style="width: 15px; height: 15px;"></span> Đang xử lý (về 1 phần)</li>
                <li><span class="d-inline-block bg-dark" style="width: 15px; height: 15px;"></span> Hoàn thành (Đã về hết)</li>
                <li><span class="d-inline-block bg-secondary" style="width: 15px; height: 15px;"></span> Bị hủy, từ chối, hoặc bị hệ thống hủy vì quá 5 ngày</li>
            </ul>
        </div>
    </div>

    <!-- Data Grid -->
    <div class="table-responsive border" style="max-height: calc(100vh - 280px); overflow-y: auto; overflow-x: auto;">
        <table class="table table-bordered table-hover text-wrap align-middle mb-0" style="font-size: 11px;">
            <thead class="bg-primary text-white" style="position: sticky; top: 0; z-index: 10;">
                <tr>
                    <th style="width:40px; text-align:center;">
                        <input type="checkbox" id="chkAll" />
                    </th>
                    <th style="min-width:60px">Chi tiết</th>
                    <th>Số PO</th>
                    <th>Tình trạng</th>
                    <th>Loại chi phí</th>
                    <th>Ngày phát hành</th>
                    <th>Mã phòng ban</th>
                    <th style="min-width:100px">Tên phòng ban</th>
                    <th>Danh mục</th>
                    <th>Mục đích</th>
                    <th>Mã NCC</th>
                    <th style="min-width:300px">Tên NCC</th>
                    <th>Khu vực NCC</th>
                    <th style="min-width:300px">Địa chỉ NCC</th>
                    <th style="min-width:120px">Số điện thoại NCC</th>
                    <th style="min-width:120px">Số Fax NCC</th>
                    <th>Người làm đơn</th>
                    <th style="min-width:120px">Ngày tạo</th>
                    <th>Hình thức</th>
                    <th>Nhóm phát hành</th>
                    <th>Thủ tục hải quan</th>
                    <th>Người xác nhận cuối cùng</th>
                    <th style="min-width:120px">Thời gian xác nhận</th>
                
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        string colorClass = item.TinhtrangPO switch
                        {
                            "DANGCHOXACNHAN" => "text-danger fw-bold",
                            "HOANTHANHXACNHAN" => "text-primary fw-bold",
                            "VE1PHAN" => "text-warning fw-bold",
                            "HOANTHANH" => "text-dark fw-bold",
                            "HUY" => "text-secondary fw-bold",
                            _ => ""
                        };
                        bool canExcel = (item.TinhtranghaiquanPO == "NEED" || item.TinhtranghaiquanPO == "NONEED");
                        <tr class="@colorClass">
                            <td class="text-center">
                                <input type="checkbox" class="chk-item" value="@item.SoPO" />
                            </td>
                            <td><a href="/QuanLyPO/Details/@item.SoPO" class="text-decoration-none">Chi tiết</a></td>
                            <td>
                                <!-- Dán đè lên thẻ <a> cũ ở cột Số PO -->
                                <a href="javascript:void(0)"
                                   onclick="viewPoDetails(this, '@item.SoPO')"
                                   data-danhmuc="@item.Danhmuc"
                                   data-loaichiphi="@item.Loaichiphi"
                                   data-ngayphathanh="@(item.Ngayphathanh?.ToString("dd/MM/yyyy") ?? "")"
                                   data-maphong="@item.Maphongban"
                                   data-tenphong="@item.Tenphongban"
                                   data-mucdich="@item.Mucdich"
                                   data-hinhthuc="@item.Hinhthuc"
                                   data-mancc="@item.MaNCC"
                                   data-tenncc="@item.TenNCC"
                                   data-khuvuc="@item.KhuvucNCC"
                                   data-diachi="@item.DiachiNCC"
                                   data-sdt="@item.SodienthoaiNCC"
                                   data-fax="@item.SofaxNCC"
                                   data-tinhtrang="@item.TinhtrangPO"
                                   data-nguoitao="@item.Nguoilamdon"
                                   data-ngaytao="@(item.Ngaytao?.ToString("dd/MM/yyyy HH:mm") ?? "")"
                                   data-nguoixacnhan="@item.Nguoixacnhan"
                                   data-ngayxacnhan="@(item.Thoigianxacnhan?.ToString("dd/MM/yyyy HH:mm") ?? "")"
                                   data-haiquan="@item.TinhtranghaiquanPO"
                                   class="text-primary fw-bold text-decoration-underline" title="Xem chi tiết">
                                    @item.SoPO
                                </a>
                            </td>
                            <td>@item.TinhtrangPO</td>
                            <td>@item.Loaichiphi</td>
                            <td>@(item.Ngayphathanh?.ToString("dd/MM/yyyy") ?? "")</td>
                            <td>@item.Maphongban</td>
                            <td>@item.Tenphongban</td>
                            <td>@item.Danhmuc</td>
                            <td>@item.Mucdich</td>
                            <td>@item.MaNCC</td>
                            <td>@item.TenNCC</td>
                            <td>@item.KhuvucNCC</td>
                            <td>@item.DiachiNCC</td>
                            <td>@item.SodienthoaiNCC</td>
                            <td>@item.SofaxNCC</td>
                            <td>@item.Nguoilamdon</td>
                            <td>@(item.Ngaytao?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                            <td>@item.Hinhthuc</td>
                            <td>@item.Group_Code</td>
                            <td>@item.TinhtranghaiquanPO</td>
                            <td>@item.Nguoixacnhan</td>
                            <td>@(item.Thoigianxacnhan?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                         
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="24" class="text-center text-muted py-3">Không có dữ liệu hiển thị.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="updateThanhToanModal" tabindex="-1" aria-hidden="true"
     style="z-index: 99999; background: rgba(0,0,0,0.5);"
     data-backdrop="false" data-bs-backdrop="false">

    <!-- Thêm class modal-dialog-centered để popup luôn nằm giữa màn hình cho đẹp -->
    <div class="modal-dialog modal-dialog-centered" style="max-width:98%">
        <div class="modal-content shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fa fa-edit"></i> Nhập số liệu thanh toán</h5>
            
            </div>
            <div class="modal-body">
                <div class="text-dark">
                    Bạn đang chọn <strong id="lblCountPo" class="text-danger">0</strong> PO để cập nhật.
                </div>
                <div class="mb-3 mt-3">
                    <label class="form-label fw-bold">Số Đề nghị thanh toán (DNTT):</label>
                    <input type="text" class="form-control" id="txtSoDntt" placeholder="Nhập số DNTT...">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Số Hóa Đơn:</label>
                    <input type="text" class="form-control" id="txtSoHoaDon" placeholder="Nhập số hóa đơn...">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="closeUpdateModal()">Hủy bỏ</button>
                <button type="button" class="btn btn-success" onclick="submitUpdate()">Lưu cập nhật</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="poDetailsModal" tabindex="-1" aria-hidden="true"
     style="z-index: 99999; background: rgba(0,0,0,0.5);"
     data-backdrop="false" data-bs-backdrop="false">
    <!-- Giữ nguyên max-width 98% để form rộng rãi chiều ngang -->
    <div class="modal-dialog modal-dialog-scrollable" style="  max-width: 95%;margin: 1.75rem auto;">
        <div class="modal-content shadow" style="height: 96vh;">
            <!-- Ép chiều cao modal để tận dụng màn hình -->
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title mb-0"><i class="fa fa-list"></i> Chi tiết Số PO: <span id="detailPoTitle" class="text-warning"></span></h6>
                <a data-bs-dismiss="modal" onclick="closeDetailsModal()" aria-label="Close" style="cursor:pointer; font-size:1.2rem; text-decoration:none;" class="text-white">x</a>
            </div>
            <div class="modal-body p-2 d-flex flex-column">
                <!-- Nhúng 1 đoạn CSS nhỏ để ép form gọn lại -->
                <style>
                    #poDetailsModal .table-compact td {
                        padding: 2px 5px !important;
