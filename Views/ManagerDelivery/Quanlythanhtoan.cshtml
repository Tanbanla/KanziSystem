                            <!-- Nút bấm dưới góc Panel 2 -->
                            <div class="mt-auto pt-1 border-top text-start">
                                <button class="btn btn-light border btn-compact">Sửa tên hàng (Đối ứng HQ)</button>
                            </div>
                        </fieldset>
                    </div>
                </div>

                <!-- KHU VỰC BẢNG DỮ LIỆU: Chiếm toàn bộ phần không gian còn lại (flex-grow-1) -->
                <div class="table-responsive flex-grow-1 border" style="min-height: 250px;">
                    <table class="table table-bordered table-striped table-hover mb-0" style="font-size: 11px;">
                        <thead class="table table-bordered bg-primary text-nowrap" style="position: sticky; top: 0; z-index: 10;">
                            <tr>
                                <th>Mã hệ thống</th>
                                <th>Được tách từ</th>
                                <th style="min-width: 200px;">Tên hàng TV</th>
                                <th style="min-width: 200px;">Tên hàng EN</th>
                                <th>Mã hàng hóa</th>
                                <th>Mã hàng</th>
                                <th class="text-end">Số lượng</th>
                                <th class="text-end">Lượng về kho</th>
                                <th>Ngày nhập kho</th>
                                <th>Đơn vị</th>
                                <th class="text-end">Đơn giá ước tính</th>
                                <th>Điều kiện giao hàng</th>
                                <th>Địa điểm giao hàng</th>
                                <th>Phương thức vận chuyển</th>
                                <th class="text-end">Số tiền</th>
                                <th>VAT(%)</th>
                                <th>Phòng ban yêu cầu</th>
                                <th style="min-width: 150px;">Tên phòng yêu cầu</th>
                                <th>Ngày giao hàng dự kiến</th>
                                <th>Nơi giao hàng dự kiến</th>
                                <th style="min-width: 200px;">Thời hạn thanh toán</th>
                                <th>Loại tiền</th>
                                <th class="text-end">Tỷ giá</th>
                            </tr>
                        </thead>
                        <tbody id="poDetailsBody">
                            <!-- Dữ liệu sẽ được load tự động qua JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-sm btn-secondary" onclick="closeDetailsModal()">Đóng</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // Đẩy modal ra body để chống lỗi chìm nền khi trang vừa load xong
        $(document).ready(function () {
            $('#poDetailsModal').appendTo("body");
            $('#updateThanhToanModal').appendTo("body");
        });

        // 2. Mở Popup Modal
        function openUpdateModal() {
            let selected = $('.chk-item:checked');
            if (selected.length === 0) {
                alert('Vui lòng check chọn ít nhất 1 PO trong bảng để cập nhật!');
                return;
            }

            // Đếm số PO đang chọn và reset form
            $('#lblCountPo').text(selected.length);
            $('#txtSoDntt').val('');
            $('#txtSoHoaDon').val('');

            // Mở modal bằng cú pháp của Bootstrap 4
            $('#updateThanhToanModal').modal('show');
        }

        // 3. Hàm chủ động đóng Modal
        function closeUpdateModal() {
            $('#updateThanhToanModal').modal('hide');
        }

        // 4. Xử lý Lưu (Gọi API)
        async function submitUpdate() {
            let selected = $('.chk-item:checked');
            let soDntt = $('#txtSoDntt').val().trim();
            let soHoaDon = $('#txtSoHoaDon').val().trim();

            if (!soDntt && !soHoaDon) {
                alert('Vui lòng nhập ít nhất Số DNTT hoặc Số Hóa Đơn!');
                return;
            }

            // Tạm thời vô hiệu hóa nút lưu
            let btnSubmit = $('#updateThanhToanModal .btn-success');
            let originalText = btnSubmit.html();
            btnSubmit.html('<i class="fa fa-spinner fa-spin"></i> Đang xử lý...').prop('disabled', true);

            let successCount = 0;
            let failCount = 0;

            // Vòng lặp gửi yêu cầu cho từng PO
            for (let i = 0; i < selected.length; i++) {
                let data = {
                    PoNumber: $(selected[i]).val(),
                    SoDntt: soDntt,
                    SoHoaDon: soHoaDon,
                    Scope: 'full',
                    PoDetailId: 0,
                    SlThucTe: 0
                };

                try {
                    let response = await fetch('/ManagerDelivery/UpdateThanhToan', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    let result = await response.json();
                    if (result.success) successCount++;
                    else failCount++;
                } catch (e) {
                    failCount++;
                }
            }

            btnSubmit.html(originalText).prop('disabled', false);

            // Ẩn modal và tải lại trang
            closeUpdateModal();
            alert(`Đã thực hiện xong!\n- Thành công: ${successCount} PO\n- Thất bại: ${failCount} PO`);
            location.reload();
        }

        // ================= CHỨC NĂNG XEM CHI TIẾT PO =================

        // Hàm đóng modal
        function closeDetailsModal() {
            $('#poDetailsModal').modal('hide');
        }

             // Hàm gọi API và load dữ liệu
        async function viewPoDetails(element, soPo) {
            // 1. Đổ dữ liệu vào phần Header (Thông tin PO & Chi tiết khác) từ thẻ <a> được click
            let $el = $(element);

            $('#dtDanhMucHang').val($el.data('danhmuc'));
            $('#dtLoaiChiPhi').val($el.data('loaichiphi'));
            $('#dtNgayPhatHanh').val($el.data('ngayphathanh'));
            $('#dtPhongPhatHanh').val($el.data('maphong'));
            $('#dtTenPhong').val($el.data('tenphong'));
            $('#dtMucDich').val($el.data('mucdich'));
            $('#dtMaNcc').val($el.data('mancc'));
            $('#dtTenNcc').val($el.data('tenncc'));
            $('#dtKhuVuc').val($el.data('khuvuc'));
            $('#dtDiaChi').val($el.data('diachi'));
            $('#dtSoDienThoai').val($el.data('sdt'));
            $('#dtSoFax').val($el.data('fax'));

            // Xử lý nút radio Hình thức (Tự động check Hàng hóa/Dịch vụ)
            let hinhThuc = $el.data('hinhthuc') || '';
            if (hinhThuc.toLowerCase().includes('dịch vụ') || hinhThuc.toLowerCase().includes('service')) {
                $('#rdDichVu').prop('checked', true);
            } else {
                $('#rdHangHoa').prop('checked', true);
            }

            // Đổ dữ liệu sang panel Chi tiết khác
            $('#infoMaPo').text(soPo);
            $('#infoTinhTrang').text($el.data('tinhtrang'));
            $('#infoNguoiTao').text($el.data('nguoitao'));
            $('#infoNguoiXacNhan').text($el.data('nguoixacnhan'));
            $('#infoTaoLuc').text($el.data('ngaytao'));
            $('#infoXacNhanLuc').text($el.data('ngayxacnhan'));
            $('#infoHaiQuan').text($el.data('haiquan'));

            // Tạm thời làm trống Loại tiền để chờ API trả về
            $('#dtLoaiTien').val('');


            // 2. Tải dữ liệu Grid Chi tiết
            $('#detailPoTitle').text(soPo);
            $('#poDetailsBody').html('<tr><td colspan="23" class="text-center py-4"><i class="fa fa-spinner fa-spin fa-2x"></i><br/>Đang tải dữ liệu...</td></tr>');
            $('#poDetailsModal').modal('show');

            try {
                let response = await fetch(`/ManagerDelivery/GetPoDetails?soPo=${encodeURIComponent(soPo)}`);
                let result = await response.json();

                if (result.success) {
                    let html = '';
                    if (result.data.length === 0) {
                        html = '<tr><td colspan="23" class="text-center text-danger py-3">Không tìm thấy dữ liệu chi tiết cho PO này.</td></tr>';
                    }
                    else {
                        // Lấy loại tiền từ mặt hàng đầu tiên trong danh sách đổ lên Header
                        $('#dtLoaiTien').val(result.data[0].loaiTien || '');

                        result.data.forEach(item => {
                            let slFormat = item.soLuong ? item.soLuong.toLocaleString('en-US') : '';
                            let luongKhoFormat = item.luongVeKho ? item.luongVeKho.toLocaleString('en-US') : '';
                            let giaFormat = item.donGiaUocTinh ? item.donGiaUocTinh.toLocaleString('en-US') : '0';
                            let tienFormat = item.soTien ? item.soTien.toLocaleString('en-US') : '0';
                            let tyGiaFormat = item.tyGia ? item.tyGia.toLocaleString('en-US') : '';

                            html += `<tr>
                                <td class="text-bg-primary">${item.maHeThong || ''}</td>
                                <td>${item.duocTachTu || ''}</td>
                                <td>${item.tenTiengViet || ''}</td>
                                <td>${item.tenTiengAnh || ''}</td>
                                <td>${item.maHangHoa || ''}</td>
                                <td>${item.maHang || ''}</td>
                                <td class="text-end fw-bold">${slFormat}</td>
                                <td class="text-end">${luongKhoFormat}</td>
                                <td>${item.ngayNhapKho || ''}</td>
                                <td>${item.donVi || ''}</td>
                                <td class="text-end">${giaFormat}</td>
                                <td>${item.dieuKienGiaoHang || ''}</td>
                                <td>${item.diaDiemGiaoHang || ''}</td>
                                <td>${item.phuongThucVanChuyen || ''}</td>
                                <td class="text-end fw-bold text-success">${tienFormat}</td>
                                <td>${item.vat || ''}</td>
                                <td>${item.phongBanYeuCau || ''}</td>
                                <td>${item.tenPhongYeuCau || ''}</td>
                                <td>${item.ngayGiaoHangDuKien || ''}</td>
                                <td>${item.noiGiaoDuKien || ''}</td>
                                <td>${item.thoiHanThanhToan || ''}</td>
                                <td class="text-center">${item.loaiTien || ''}</td>
                                <td class="text-end">${tyGiaFormat}</td>
                            </tr>`;
                        });
                    }
                    $('#poDetailsBody').html(html);
                }
                else {
                    $('#poDetailsBody').html(`<tr><td colspan="23" class="text-center text-danger">Lỗi: ${result.message}</td></tr>`);
                }
            } catch (e) {
                $('#poDetailsBody').html('<tr><td colspan="23" class="text-center text-danger">Lỗi kết nối máy chủ. Vui lòng thử lại.</td></tr>');
            }
        }
    </script>
}
