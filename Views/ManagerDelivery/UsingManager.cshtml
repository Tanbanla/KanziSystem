@using PRJ_WAREHOUSE_BIVN.Language
@{
    ViewData["Title"] = "Master Giao trả hàng";
}
<style>
    .modal-backdrop {
        z-index: 1040 !important;
    }

    .modal {
        z-index: 1050 !important;
    }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }
    /* Styling cho ô input chỉnh sửa trực tiếp trên bảng */
    .table-input-cell {
        width: 100%;
        min-width: 60px;
        border: 1px solid transparent;
        background: transparent;
        text-align: center;
        padding: 4px 2px;
        font-size: 13px;
        outline: none;
        transition: all 0.15s ease-in-out;
    }

        .table-input-cell:hover, .table-input-cell:focus {
            border: 1px solid #0d6efd;
            background-color: #fff;
            box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, .15);
            border-radius: 3px;
        }

        /* Ẩn mũi tên tăng giảm số mặc định của input number cho đẹp */
        .table-input-cell::-webkit-outer-spin-button,
        .table-input-cell::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .table-input-cell[type=number] {
            -moz-appearance: textfield;
        }
</style>

@*Hiển thị giống file excel*@

    <div class="row">
        <div class="col-md-12">
            <!-- Card Control -->
          
            <div class="card-body pt-0 pl-0">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex gap-2 flex-fill">
                        @*       <button type="button" class="btn btn-success" onclick="openModal()">
                            <i class="fa-solid fa fa-plus me-1"></i> Thêm Mới
                        </button> *@
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <!-- Ô tìm kiếm tự do -->
                            <div class="input-group input-group-sm" style="width: 200px;">
                                <input type="text" id="txtSearchMaVT" class="form-control" placeholder="Tìm theo mã VT..." onkeyup="applyFilter()" />
                            </div>

                            <select id="selectGroupMa" class="form-select form-select-sm" style="width: 140px;" onchange="applyFilter()" hidden>
                                <option value="">-- Tất cả nhóm --</option>
                                <option value="A">Nhóm mã A</option>
                                <option value="E">Nhóm mã E</option>
                            </select>

                            <!-- Nút bấm chọn nhanh -->
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-success fw-bold ml-2" onclick="quickFilterGroup('A')">
                                    <i class="fa-solid me-1"></i>Mã A
                                </button>
                                <button type="button" class="btn btn-danger fw-bold ml-2" onclick="quickFilterGroup('E')">
                                    <i class="fa-solid me-1"></i>Mã E
                                </button>
                                <button type="button" class="btn btn-outline-secondary ml-2" onclick="quickFilterGroup('')" title="Hiển thị tất cả" hidden>
                                    <i class="fa-solid fa-rotate-left"></i>
                                </button>
                            </div>
                        </div>

                    </div>

                    <!-- Cụm Tìm kiếm & Bộ lọc năm -->
                    <div class="d-flex align-items-center gap-2">
                        <a href="~/ManagerDelivery/LogChangeHistory">
                            <button type="button" class="btn btn-warning text-white ms-2">
                                <i class="fa-solid fa fa-laravel me-1"></i> Log Using
                            </button>
                        </a>
                        <input type="file" id="fileExcel" accept=".xlsx, .xls" class="d-none" onchange="uploadExcel()" />
                        <button type="button" class="btn btn-info text-white ms-2 ml-2" onclick="document.getElementById('fileExcel').click()">
                            <i class="fa-solid fa fa-file-excel me-1"></i> Import Excel
                        </button>
                        <!-- Ô TÌM KIẾM THEO MÃ -->
                        <select id="selectYear" class="form-control form-select form-select-sm ml-2" style="width: 100px;" onchange="loadData()">
                            <option value="2026">2026</option>
                        </select>
                    </div>
                </div>
            </div>
          
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span>Danh Sách Chi Tiết</span>
                    <!-- Hiển thị tổng số dòng đang lọc -->
                    <span class="badge bg-white text-primary fw-normal" id="lblRowCount">0 dòng</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 60vh;">
                        <table class="table table-bordered table-hover mb-0 text-center align-middle text-nowrap" style="font-size: 13px;">
                            <thead class="table-primary sticky-top">
                                <tr>
                                    <!-- Ghim 2 cột đầu không bị trôi khi cuộn ngang -->
                                    <th class="sticky-start bg-primary text-white" style="left: 90px; z-index: 3; min-width: 130px;">Mã VT</th>
                                    <!-- Các cột tháng theo hàng ngang -->
                                    <th>Tháng 1</th>
                                    <th>Tháng 2</th>
                                    <th>Tháng 3</th>
                                    <th>Tháng 4</th>
                                    <th>Tháng 5</th>
                                    <th>Tháng 6</th>
                                    <th>Tháng 7</th>
                                    <th>Tháng 8</th>
                                    <th>Tháng 9</th>
                                    <th>Tháng 10</th>
                                    <th>Tháng 11</th>
                                    <th>Tháng 12</th>

                                    <th class="table-warning fw-bold">Tổng Năm</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                <!-- JS load dữ liệu vào đây -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

<!-- Modal 1: Quản lý Vật Tư -->
<div class="modal fade" id="dataModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm Dữ Liệu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="txtId" value="0" />
                <div class="mb-2">
                    <label>Mã Vật Tư</label>
                    <input type="text" id="txtMaVatTu" class="form-control" />
                </div>
                <div class="mb-2">
                    <label>Tháng</label>
                    <input type="number" id="txtThang" class="form-control" />
                </div>
                <div class="mb-2">
                    <label>Năm</label>
                    <input type="number" id="txtNam" class="form-control" />
                </div>
                <div class="mb-2">
                    <label>Số Lượng</label>
                    <input type="number" step="0.01" id="txtSoLuong" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="saveData()">Lưu lại</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            loadData(); // Load Vùng 1
        });

        function loadData() {
            const selectedYear = parseInt(document.getElementById('selectYear').value) || 2026;

            // Gọi đồng thời 2 API: Lấy danh sách toàn bộ Mã Vật Tư gốc và Dữ liệu theo tháng
            Promise.all([
                fetch('/ManagerDelivery/GetMaterialData').then(res => res.json()), // API lấy Master Mã Hàng
                fetch('/ManagerDelivery/GetData').then(res => res.json())          // API lấy số liệu Using theo tháng
            ])
            .then(([materialRes, dataRes]) => {
                if (!materialRes.success || !dataRes.success) {
                    alert("Không thể tải dữ liệu từ máy chủ!");
                    return;
                }

                const allMaterials = materialRes.data || [];
                const usingData = (dataRes.data || []).filter(item => item.nam === selectedYear);

                // 1. Khởi tạo danh sách Pivot dựa trên TOÀN BỘ MÃ HÀNG (Master List)
                const pivotData = {};

                allMaterials.forEach(mat => {
                    const maVT = mat.material_Code;
                    if (maVT) {
                        pivotData[maVT] = {
                            material_Code: maVT,
                            months: Array(12).fill(0) // Mặc định 12 tháng = 0 (trắng)
                        };
                    }
                });

                // 2. Đổ số liệu của năm đang chọn vào đúng mã hàng và tháng tương ứng
                usingData.forEach(item => {
                    // Dùng mã vật tư từ bảng dữ liệu tháng (item.maVatTu hoặc item.material_Code tuỳ db)
                    const maVT = item.material_Code || item.maVatTu;
                    if (maVT) {
                        if (!pivotData[maVT]) {
                            // Trường hợp mã có trong giao dịch nhưng không còn trong bảng Master
                            pivotData[maVT] = {
                                material_Code: maVT,
                                months: Array(12).fill(0)
                            };
                        }
                        if (item.thang >= 1 && item.thang <= 12) {
                            pivotData[maVT].months[item.thang - 1] += item.soluong;
                        }
                    }
                });

                const rows = Object.values(pivotData);
                let html = '';

                if (rows.length === 0) {
                    html = `<tr>
                                <td colspan="15" class="text-center text-muted py-3">
                                    Chưa có danh sách mã hàng trong hệ thống
                                </td>
                            </tr>`;
                } else {
                    // 3. Render toàn bộ danh sách ra bảng
                    rows.forEach((row, index) => {
                        const tongNam = row.months.reduce((sum, val) => sum + val, 0);

                        // Tạo 12 ô input cho 12 tháng (nếu = 0 thì hiện trắng để gõ)
                        let monthsHtml = '';
                        row.months.forEach((qty, monthIdx) => {
                            const thang = monthIdx + 1;
                            const displayVal = qty > 0 ? Number(qty).toFixed(2) : '';

                            monthsHtml += `
                                <td class="p-1">
                                    <input type="number"
                                           step="0.01"
                                           class="table-input-cell text-primary fw-bold"
                                           value="${displayVal}"
                                           placeholder="-"
                                           data-row="${index}"
                                           data-thang="${thang}"
                                           data-mavt="${row.material_Code}"
                                           onchange="saveInlineData(this)"
                                           onkeyup="calculateRowTotal(${index})" />
                                </td>`;
                        });

                        // Format Tổng năm với 2 số sau dấu chấm + dấu phẩy hàng nghìn
                        const displayTongNam = Number(tongNam).toLocaleString('en-US', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });

                        html += `
                            <!-- Thêm class data-row và data-mavt để phục vụ tìm kiếm Realtime -->
                            <tr id="row-${index}" class="data-row" data-mavt="${row.material_Code.toLowerCase()}">

                                <!-- Cột Mã Vật Tư -->
                                <td class="sticky-start bg-white fw-bold text-dark" style="left: 90px; z-index: 1;">
                                    ${row.material_Code}
                                </td>

                                <!-- 12 Cột Tháng -->
                                ${monthsHtml}

                                <!-- Cột Tổng Năm -->
                                <td class="fw-bold table-warning text-danger" id="total-${index}">
                                    ${displayTongNam}
                                </td>
                            </tr>`;
                    });
                }

                document.getElementById('tableBody').innerHTML = html;

                // Cập nhật lại bộ lọc tìm kiếm trong trường hợp đang có từ khóa cũ trong ô search
                applyFilter();
            })
            .catch(error => {
                console.error("Lỗi khi tải dữ liệu:", error);
            });
        }

        // Tự động tính lại tổng ngang real-time và format đúng 2 chữ số thập phân
        function calculateRowTotal(rowIndex) {
            const rowEl = document.getElementById(`row-${rowIndex}`);
            const inputs = rowEl.querySelectorAll('.table-input-cell');
            let sum = 0;

            inputs.forEach(input => {
                const val = parseFloat(input.value) || 0;
                sum += val;
            });

            const totalCell = document.getElementById(`total-${rowIndex}`);
            if (totalCell) {
                totalCell.innerText = Number(sum).toLocaleString('en-US', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }
        }

        // Hàm lưu dữ liệu (Tự động format lại ô input sau khi người dùng gõ xong)
        function saveInlineData(inputElement) {
            const maVatTu = inputElement.getAttribute('data-mavt');
            const thang = parseInt(inputElement.getAttribute('data-thang'));
            const nam = parseInt(document.getElementById('selectYear').value) || 2026;
            const soluong = parseFloat(inputElement.value) || 0;

            if (soluong > 0) {
                inputElement.value = Number(soluong).toFixed(2);
            } else {
                inputElement.value = ''; // Nếu bằng 0 thì về ô trống (hiện placeholder "-")
            }

            inputElement.style.backgroundColor = '#fff3cd';

            const data = {
                ID: 0,
                MaVatTu: maVatTu,
                Thang: thang,
                Nam: nam,
                Soluong: soluong,
                Nguoiupdate: document.getElementById('us') ? document.getElementById('us').innerHTML : 'System'
            };

            fetch('/ManagerDelivery/SaveData', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    inputElement.style.backgroundColor = '#d1e7dd';
                    setTimeout(() => {
                        inputElement.style.backgroundColor = 'transparent';
                    }, 800);
                } else {
                    alert(`Lỗi khi lưu số lượng tháng ${thang} cho mã ${maVatTu}!`);
                    inputElement.style.backgroundColor = '#f8d7da';
                }
            })
            .catch(() => {
                alert("Lỗi kết nối đến máy chủ!");
                inputElement.style.backgroundColor = '#f8d7da';
            });
        }

        // Xóa dữ liệu của Mã VT trong năm được chọn
        function deleteDataByMaVT(maVatTu, nam) {
            if (confirm(`Bạn có chắc chắn muốn xóa toàn bộ dữ liệu của vật tư [${maVatTu}] trong năm ${nam}?`)) {
                fetch(`/ManagerDelivery/DeleteDataByMaVT?maVatTu=${encodeURIComponent(maVatTu)}&nam=${nam}`, {
                    method: 'POST'
                })
                .then(res => res.json())
                .then(res => {
                    if (res.success) {
                        loadData();
                    } else {
                        alert('Lỗi khi xóa dữ liệu!');
                    }
                });
            }
        }

        // Hàm bấm nút chọn nhanh nhóm A hoặc E (Tự đồng bộ luôn vào Dropdown Select)
        function quickFilterGroup(groupPrefix) {
            const selectGroup = document.getElementById('selectGroupMa');
            if (selectGroup) {
                selectGroup.value = groupPrefix; // Gán giá trị vào dropdown tương ứng
            }
            applyFilter(); // Kích hoạt bộ lọc
        }

        // Bộ lọc trung tâm: Kết hợp tìm kiếm từ khóa + Bộ lọc tiền tố (A, E)
        function applyFilter() {
            const searchInput = document.getElementById('txtSearchMaVT');
            const selectGroup = document.getElementById('selectGroupMa');

            const keyword = searchInput ? searchInput.value.trim().toLowerCase() : '';
            const groupPrefix = selectGroup ? selectGroup.value.trim().toUpperCase() : ''; // "A", "E" hoặc ""

            const rows = document.querySelectorAll('#tableBody tr.data-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const maVT = (row.getAttribute('data-mavt') || '').toUpperCase();

                // 1. Kiểm tra điều kiện nhóm prefix (A, E) - Mã phải bắt đầu bằng chữ cái được chọn
                const matchGroup = (groupPrefix === '') || maVT.startsWith(groupPrefix);

                // 2. Kiểm tra điều kiện từ khóa tìm kiếm trong ô Text
                const matchKeyword = (keyword === '') || maVT.toLowerCase().includes(keyword);

                // Thỏa mãn cả 2 điều kiện thì hiển thị
                if (matchGroup && matchKeyword) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            // Cập nhật số dòng hiển thị trên Header
            const rowCountLbl = document.getElementById('lblRowCount');
            if (rowCountLbl) {
                rowCountLbl.innerText = `${visibleCount} dòng`;
            }

            // Xử lý thông báo khi không tìm thấy dòng nào
            let noResultRow = document.getElementById('no-result-row');
            if (visibleCount === 0 && rows.length > 0) {
                if (!noResultRow) {
                    noResultRow = document.createElement('tr');
                    noResultRow.id = 'no-result-row';
                    noResultRow.innerHTML = `
                        <td colspan="15" class="text-center text-muted py-4">
                            <i class="fa fa-search-minus mb-1 d-block" style="font-size: 20px;"></i>
                            Không tìm thấy mã vật tư nào phù hợp với điều kiện lọc!
                        </td>`;
                    document.getElementById('tableBody').appendChild(noResultRow);
                }
            } else if (noResultRow) {
                noResultRow.remove();
            }
        }

        function clearSearch() {
            const searchInput = document.getElementById('txtSearchMaVT');
            const selectGroup = document.getElementById('selectGroupMa');
            if (searchInput) searchInput.value = '';
            if (selectGroup) selectGroup.value = '';
            applyFilter();
        }

        function openModal() {
            document.getElementById('txtId').value = 0;
            document.getElementById('txtMaVatTu').value = '';
            document.getElementById('txtMaVatTu').readOnly = false;
            document.getElementById('txtThang').value = '';
            document.getElementById('txtNam').value = document.getElementById('selectYear').value;
            document.getElementById('txtSoLuong').value = '';
            document.getElementById('modalTitle').innerText = "Thêm Dữ Liệu";
            $('#dataModal').appendTo("body").modal('show');
        }

        function saveData() {
            const data = {
                ID: parseInt(document.getElementById('txtId').value),
                MaVatTu: document.getElementById('txtMaVatTu').value,
                Thang: parseInt(document.getElementById('txtThang').value),
                Nam: parseInt(document.getElementById('txtNam').value),
                Soluong: parseFloat(document.getElementById('txtSoLuong').value),
                Nguoiupdate: document.getElementById('us') ? document.getElementById('us').innerHTML : 'System'
            };
            fetch('/ManagerDelivery/SaveData', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            }).then(res => res.json()).then(res => {
                if (res.success) {
                    alert('Lưu thành công!');
                    $('#dataModal').modal('hide');
                    loadData();
                } else alert('Lỗi khi lưu!');
            });
        }

        function uploadExcel() {
            const fileInput = document.getElementById('fileExcel');
            if (fileInput.files.length === 0) return;
            const formData = new FormData();
            formData.append('fileExcel', fileInput.files[0]);
            const usElement = document.getElementById("us");
            formData.append('us', usElement ? usElement.innerHTML : 'System');

            fetch('/ManagerDelivery/ImportExcel', { method: 'POST', body: formData })
            .then(res => res.json()).then(res => {
                if (res.success) { alert(res.message); fileInput.value = ''; loadData(); }
                else alert('Lỗi: ' + res.message);
            });
        }
    </script>
}
