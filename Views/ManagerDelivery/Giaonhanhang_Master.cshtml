@model IEnumerable<PRJ_WAREHOUSE_BIVN.Models.GiaoHangMasterViewModel>
@{
    ViewData["Title"] = "Quản lý đặt hàng và điểm gọi hàng";
}

<style>
    .table-master {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 13px;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
        background-color: #fff;
    }

        .table-master th, .table-master td {
            border-right: 1px solid #e0e0e0;
            border-bottom: 1px solid #e0e0e0;
            padding: 8px 12px; /* Tăng padding một chút cho thoáng */
            vertical-align: middle;
        }

            .table-master td:first-child, .table-master th:first-child {
                border-left: 1px solid #e0e0e0;
            }

        /* --- HIỆU ỨNG HEADER LÀM ĐẸP --- */
        .table-master thead th {
            color: #333;
            font-weight: 700;
            text-align: center;
            position: sticky;
            z-index: 10;
            box-shadow: 0 2px 4px -2px rgba(0, 0, 0, 0.1);
        }

        /* Dòng 1: In hoa, gradient mượt mà và viền dưới đậm */
        .table-master thead tr:nth-child(1) th {
            top: 0;
            z-index: 11;
            height: 40px;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 0.5px;
            border-top: 1px solid #d4d4d4;
        }

        /* Dòng 2: Header chi tiết */
        .table-master thead tr:nth-child(2) th {
            top: 40px;
            z-index: 10;
            height: 40px;
            font-weight: 600;
            font-size: 13px;
        }

    /* --- MÀU SẮC PHÂN NHÓM HEADER (Có Gradient) --- */
    .group-info {
        background: linear-gradient(180deg, #e2efda 0%, #d4e8c9 100%) !important;
        color: #2e4a1a !important;
        border-bottom: 3px solid #385723 !important;
    }

    .group-delivery {
        background: linear-gradient(180deg, #fff2cc 0%, #ffe699 100%) !important;
        color: #664d00 !important;
        border-bottom: 3px solid #7f6000 !important;
    }

    .group-standard {
        background: linear-gradient(180deg, #d9e1f2 0%, #c4d3eb 100%) !important;
        color: #1f3864 !important;
        border-bottom: 3px solid #2f5597 !important;
    }

    .group-status {
        background: linear-gradient(180deg, #fce4d6 0%, #f8cbad 100%) !important;
        color: #a64b00 !important;
        border-bottom: 3px solid #c65911 !important;
    }

    /* Màu sub-header (dòng 2) */
    .sub-info {
        background-color: #f6faf1 !important;
    }

    .sub-delivery {
        background-color: #fffdf5 !important;
    }

    .sub-standard {
        background-color: #f4f6fb !important;
    }

    .sub-status {
        background-color: #fff5f0 !important;
    }

    .bg-using-highlight {
        background-color: #ffeba1 !important;
        color: #b30000 !important;
        font-weight: bold;
    }

    /* --- CĂN LỀ & HIỆU ỨNG BODY --- */
    .text-end {
        text-align: right !important;
    }

    .text-center {
        text-align: center !important;
    }

    .table-master tbody tr:hover td {
        background-color: #f2f7ff !important;
    }

    .table-master tbody tr:nth-child(even) td {
        background-color: #fafafa;
    }

    /* --- CSS CỘT ĐIỂM GỌI HÀNG --- */
    .badge-status {
        display: block;
        width: 100%;
        padding: 5px;
        font-weight: 700;
        text-align: center;
        border-radius: 4px;
        box-shadow: inset 0 0 0 1px rgba(0,0,0,0.1);
    }

    .status-ok {
        background-color: #e2efda;
        color: #385723;
        border: none;
        box-shadow: none;
    }

    .status-doi-ung {
        background-color: #f8cbad;
        color: #843c0c;
        animation: blink 1.5s infinite;
    }

    .status-goi-hang {
        background-color: #ffe699;
        color: #7f6000;
    }

    .status-chua-dung {
        background-color: #f2f2f2;
        color: #7f7f7f;
        border: none;
        box-shadow: none;
    }

    @@keyframes blink  {
            opacity: 0.7;
        }
    }
</style>

<div class="container-fluid">
    <div class="card shadow border-0" style="border-radius: 8px;">
        <div class=" bg-white d-flex justify-content-between align-items-center" style="border-radius: 8px 8px 0 0; padding: 15px 20px;">
             <!-- Ô Tìm kiếm -->
                <div class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text bg-light"><i class="fa fa-search"></i></span>
                    <input type="text" id="txtSearch" class="form-control" placeholder="Tìm mã hàng, tên, NCC..." onkeyup="searchTable()">
                </div>
            <div class="d-flex align-items-center gap-2">
             
              <a href="/File/Mau_Nhaphang.xlsx" class="btn btn-info btn-sm shadow-sm text-nowrap ml-2">
                    <i class="fa fa-link"></i> File mẫu
                </a>
                <!-- Form Import Excel -->
                <form id="frmImportExcel" class="mb-0 ml-2" enctype="multipart/form-data">
                    <label for="fileImport" class="btn btn-primary btn-sm shadow-sm text-nowrap mb-0" style="cursor: pointer;">
                        <i class="fa-solid fa fa-file-import me-1"></i> Import Excel
                    </label>
                    <input type="file" id="fileImport" name="fileExcel" accept=".xlsx, .xls" class="d-none" onchange="uploadExcel()" />
                </form>
                <!-- Nút Xuất Excel -->
                <a href="@Url.Action("ExportGiaonhanhangMaster", "ManagerDelivery")" class="btn btn-success btn-sm shadow-sm text-nowrap ml-2">
                    <i class="fa-solid fa fa-file-excel me-1"></i> Xuất Excel
                </a>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 75vh; overflow: auto; border-radius: 0 0 8px 8px;">
                <table class="table-master">
                    <thead>
                        <!-- DÒNG HEADER 1: GỘP NHÓM CỘT -->
                        <tr>
                            <th colspan="6" class="group-info">I. Thông tin vật tư & NCC</th>
                            <th colspan="3" class="group-delivery">II. Quy định giao hàng</th>
                            <th colspan="3" class="group-standard">III. Tiêu chuẩn an toàn</th>
                            <th colspan="5" class="group-status">IV. Thực tế & Trạng thái</th>
                        </tr>
                        <!-- DÒNG HEADER 2: CHI TIẾT CỘT -->
                        <tr>
                            <!-- Nhóm I (Xanh lá) -->
                            <th class="sub-info">Mã hàng</th>
                            <th class="sub-info">Tên hàng</th>
                            <th class="sub-info">Đơn vị</th>
                            <th class="sub-info">Mã NCC</th>
                            <th class="sub-info">Tên NCC</th>
                            <th class="sub-info">Maker</th>

                            <!-- Nhóm II (Vàng) -->
                            <th class="sub-delivery">MOQ</th>
                            <th class="sub-delivery">Tần suất GH</th>
                            <th class="sub-delivery">Leadtime GH</th>

                            <!-- Nhóm III (Xanh dương) -->
                            <th class="sub-standard">Số ngày kho AT</th>
                            <th class="sub-standard">Tỉ lệ kho AT</th>
                            <th class="sub-standard">SL tồn kho AT</th>

                            <!-- Nhóm IV (Cam) -->
                            <th class="sub-status text-primary">Stock hiện tại</th>
                            <th class="bg-using-highlight">Using tháng HT</th>
                            <th class="sub-status">Số ngày dùng HT</th>
                            <th class="sub-status">Tỉ lệ tồn kho HT</th>
                            <th class="sub-status" style="min-width: 140px;">Điểm gọi hàng</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                string statusClass = "status-ok";
                                if (item.DiemGoiHang == "ĐỐI ỨNG GẤP") { statusClass = "status-doi-ung"; }
                                else if (item.DiemGoiHang == "GỌI HÀNG") { statusClass = "status-goi-hang"; }
                                else if (item.DiemGoiHang == "CHƯA DÙNG") { statusClass = "status-chua-dung"; }

                                <tr>
                                    <!-- Nhóm I -->
                                    <td class="fw-bold text-primary">@item.Mahang</td>
                                    <td>@item.Tenhang</td>
                                    <td class="text-center fw-semibold text-secondary">@item.Donvi</td>
                                    <td>@item.Vendor_Code</td>
                                    <td>@item.Vendor</td>
                                    <td>@item.Maker</td>

                                    <!-- Nhóm II -->
                                    <td class="text-end">@item.MOQ</td>
                                    <td class="text-end">@item.Tansuatgiaohang</td>
                                    <td class="text-end">@(item.Leadtimegiaohang?.ToString("N0") ?? "-")</td>

                                    <!-- Nhóm III -->
                                    <td class="text-end">@(item.Songaytonkhoantoan?.ToString("N0") ?? "-")</td>
                                    <td class="text-end">@(item.TiLeTonKhoAnToan.HasValue? item.TiLeTonKhoAnToan.Value.ToString("N0") + "%" : "-")</td>
                                    <td class="text-end fw-semibold text-success">@(item.Soluongtonkhoantoan?.ToString("N2") ?? "-")</td>

                                    <!-- Nhóm IV -->
                                    <td class="text-end fw-bold text-primary" style="background-color: #f0f7ff;">
                                        @(item.StockHienTai?.ToString("N0") ?? "-")
                                    </td>
                                    <td class="text-end fw-bold" style="background-color: #fffde6;">
                                        @(item.UsingThangHienTai?.ToString("N2") ?? "-")
                                    </td>
                                    <td class="text-end">@(item.SoNgaySuDungHienTai?.ToString("N2") ?? "-")</td>
                                    <td class="text-end fw-semibold">
                                        @(item.TiLeTonKhoHienTai.HasValue? item.TiLeTonKhoHienTai.Value.ToString("N0") + "%" : "-")
                                    </td>
                                    <td class="text-center p-1">
                                        <span class="badge-status @statusClass">@item.DiemGoiHang</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="17" class="text-center text-muted py-5" style="font-size: 15px;">
                                    <i class="fa-solid fa-folder-open fa-2x mb-2" style="color: #ccc;"></i><br />
                                    Không có dữ liệu hiển thị.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hàm tìm kiếm Real-time trên lưới hiện tại của bạn
        function searchTable() {
            var input = document.getElementById("txtSearch").value.toLowerCase();
            var rows = document.querySelectorAll("#tableBody tr");

            rows.forEach(function (row) {
                if (row.cells.length === 1) return;
                var rowText = row.innerText.toLowerCase();
                if (rowText.includes(input)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        // --- SỰ KIỆN NÚT IMPORT DỮ LIỆU ---
        function uploadExcel() {
            const fileInput = document.getElementById('fileImport');
            if (fileInput.files.length === 0) return;

            // Lấy thông tin file
            const formData = new FormData();
            formData.append('fileExcel', fileInput.files[0]);

            // Nếu bạn có lưu user đang đăng nhập ở thẻ html nào đó (vd: <span id="us">Admin</span>)
            // thì lấy ra, nếu không có tạm thời để 'System'
            const usElement = document.getElementById("us");
            formData.append('us', usElement ? usElement.innerHTML.trim() : 'System');

            // Gọi API bằng Fetch
            fetch('@Url.Action("ImportExcelGiaoHang", "ManagerDelivery")', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    // Nếu thành công, thông báo và tải lại trang để thấy dữ liệu mới
                    alert(" " + res.message);
                    window.location.reload();
                } else {
                    // Báo lỗi và reset lại thẻ input file
                    alert(" Lỗi: " + res.message);
                    fileInput.value = '';
                }
            })
            .catch(error => {
                alert(" Lỗi kết nối đến máy chủ!");
                console.error(error);
                fileInput.value = ''; // Reset input để có thể chọn lại file
            });
        }
    </script>
}
