@model IEnumerable<PRJ_WAREHOUSE_BIVN.Models.GiaoHangMasterViewModel>
@{
    ViewData["Title"] = "Quản lý Master Giao Hàng & Tồn Kho An Toàn";
}

<style>
    /* Tổng thể bảng */
    .table-master {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 13px;
        border-collapse: collapse;
        width: 100%;
        background-color: #fff;
    }

        .table-master th, .table-master td {
            border: 1px solid #a6a6a6 !important;
            padding: 4px 8px;
            vertical-align: middle;
            white-space: nowrap;
        }

        /* Tiêu đề giống giao diện Excel */
        .table-master thead th {
            background-color: #dbeaff; /* Xanh nhạt Excel */
            color: #000;
            font-weight: 600;
            text-align: center;
            height: 38px;
        }

            /* Màu nổi bật cho Header cột Using */
            .table-master thead th.bg-using {
                background-color: #fff2cc !important; /* Vàng nhạt */
            }

    /* Cột chữ số căn phải */
    .text-end {
        text-align: right !important;
    }

    .text-center {
        text-align: center !important;
    }

    /* Hiệu ứng hover dòng */
    .table-master tbody tr:hover {
        background-color: #f2f7ff;
    }

    /* --- TO MÀU CỘT ĐIỂM GỌI HÀNG --- */
    .badge-status {
        display: block;
        width: 100%;
        padding: 4px;
        font-weight: 600;
        text-align: center;
    }

    .status-ok {
        background-color: transparent;
        color: #000;
        text-align: left !important;
    }

    .status-doi-ung {
        background-color: #fce4d6 !important; /* Màu hồng/cam nhạt */
        color: #6c1d45 !important; /* Chữ đỏ tím thẫm */
    }

    .status-goi-hang {
        background-color: #ffff99 !important; /* Vàng sáng */
        color: #000 !important;
    }

    .status-chua-dung {
        background-color: transparent;
        color: #333;
        text-align: left !important;
    }
</style>

<div class="container-fluid py-3">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-primary fw-bold">
                <i class="fa-solid fa-table me-2"></i>THEO DÕI ĐIỂM GỌI HÀNG & MASTER TỒN KHO AN TOÀN
            </h5>
            <div>
                <button type="button" class="btn btn-sm btn-outline-success">
                    <i class="fa-solid fa-file-excel me-1"></i> Xuất Excel
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 780px; overflow-y: auto;">
                <table class="table-master">
                    <thead style="position: sticky; top: 0; z-index: 10;">
                        <tr>
                            <th>Mã hàng</th>
                            <th>Tên hàng</th>
                            <th>Vendor</th>
                            <th>Maker</th>
                            <th>MOQ</th>
                            <th>Tần suất<br />giao hàng</th>
                            <th>Leadtime<br />giao hàng</th>
                            <th>Tỉ lệ tồn<br />kho an toàn</th>
                            <th>Số ngày<br />tồn kho<br />an toàn</th>
                            <th>Đơn vị</th>
                            <th>Số lượng<br />tồn kho<br />an toàn</th>
                            <th class="bg-using">Using<br />tháng<br />hiện tại</th>
                            <th>Stock hiện<br />tại</th>
                            <th>Số ngày sử<br />dụng hiện tại</th>
                            <th>Tỉ lệ tồn<br />kho hiện<br />tại</th>
                            <th style="min-width: 130px;">Điểm gọi hàng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                // Xử lý class CSS theo trạng thái cột cuối
                                string statusClass = "status-ok";
                                if (item.DiemGoiHang == "ĐỐI ỨNG GẤP") { statusClass = "status-doi-ung"; }
                                else if (item.DiemGoiHang == "GỌI HÀNG") { statusClass = "status-goi-hang"; }
                                else if (item.DiemGoiHang == "CHƯA DÙNG") { statusClass = "status-chua-dung"; }

                                <tr>
                                    <td class="fw-semibold">@item.Mahang</td>
                                    <td>@item.Tenhang</td>
                                    <td>@item.Vendor</td>
                                    <td>@item.Maker</td>
                                    <td class="text-end">@item.MOQ</td>
                                    <td class="text-end">@(item.Tansuatgiaohang?.ToString("N0") ?? "-")</td>
                                    <td class="text-end">@(item.Leadtimegiaohang?.ToString("N0") ?? "-")</td>
                                    <td class="text-end">@(item.TiLeTonKhoAnToan.HasValue? item.TiLeTonKhoAnToan.Value.ToString("N0") + "%" : "-")</td>
                                    <td class="text-end">@(item.Songaytonkhoantoan?.ToString("N0") ?? "-")</td>
                                    <td class="text-center">@item.Donvi</td>
                                    <td class="text-end">@(item.Soluongtonkhoantoan?.ToString("N2") ?? "-")</td>

                                    <!-- Cột Using màu vàng -->
                                    <td class="text-end" style="background-color: #fffaf0;">
                                        @(item.UsingThangHienTai?.ToString("N2") ?? "-")
                                    </td>

                                    <td class="text-end">@(item.StockHienTai?.ToString("N0") ?? "-")</td>
                                    <td class="text-end">@(item.SoNgaySuDungHienTai?.ToString("N2") ?? "-")</td>
                                    <td class="text-end fw-semibold">
                                        @(item.TiLeTonKhoHienTai.HasValue? item.TiLeTonKhoHienTai.Value.ToString("N0") + "%" : "-")
                                    </td>

                                    <!-- Cột Trạng thái có màu tự động -->
                                    <td class="p-0 text-center @statusClass" style="font-weight: 600; padding-left: 8px !important;">
                                        @item.DiemGoiHang
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="16" class="text-center text-muted py-4">
                                    Không có dữ liệu hiển thị.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
