                    // --- D. XỬ LÝ CLICK NÚT THANH TOÁN ---
                    const btnPayment = e.target.closest('.btn-payment-po');
                    if (btnPayment) {
                        e.preventDefault();
                        document.getElementById('payPoNumber').textContent = btnPayment.getAttribute('data-po');
                        document.getElementById('payItemName').textContent = btnPayment.getAttribute('data-item-name');
                        document.getElementById('payItemCode').textContent = btnPayment.getAttribute('data-item-code');
                        document.getElementById('payOrderQty').textContent = btnPayment.getAttribute('data-order-qty');
                        document.getElementById('payPoDetailId').textContent = btnPayment.getAttribute('data-po-detail-id');

                        const qty = btnPayment.getAttribute('data-order-qty');
                        document.getElementById('modalPayQty').value = qty ? qty.replace(/,/g, '') : '';
                        document.getElementById('modalDnttNumber').value = '';
                        document.getElementById('modalInvoiceNumber').value = '';

                        $('#full_PO_pay').prop('checked', true);
                        $('#modalPayQty').prop('disabled', true);

                        bsPayModal.show();
                        return;
                    }

                    // --- E. XỬ LÝ CLICK NÚT NHẬP ẢNH HƯỞNG SX (BỘ PHẬN KHÁC) ---
                    const btnImpact = e.target.closest('.btn-impact-po');
                    if (btnImpact) {
                        e.preventDefault();
                        document.getElementById('impPoNumber').textContent = btnImpact.getAttribute('data-po');
                        document.getElementById('impItemCode').textContent = btnImpact.getAttribute('data-item-code');
                        document.getElementById('impPoDetailId').textContent = btnImpact.getAttribute('data-po-detail-id');

                        const curImpact = btnImpact.getAttribute('data-current-impact');
                        if (curImpact && curImpact !== "---") {
                            document.getElementById('selectImpactStatus').value = curImpact;
                        } else {
                            document.getElementById('selectImpactStatus').value = "Yes"; // Mặc định Yes khi NG
                        }

                        bsImpactModal.show();
                        return;
                    }
                });
            }

            // 3. SỰ KIỆN NGOÀI BẢNG (Import Excel, Checkbox phạm vi...)
            document.getElementById('btnOpenImportExcel')?.addEventListener('click', () => bsImportModal.show());

            document.getElementById('excelFileInput')?.addEventListener('change', function () {
                if (this.files && this.files.length > 0) {
