@* 
@using PRJ_WAREHOUSE_BIVN.Language
@using PRJ_WAREHOUSE_BIVN.Controllers
@model IEnumerable<PoDetailViewModel>
@{
    ViewData["Title"] = "Quản lý nhận hàng";
    int stt = 1; // Biến đếm số thứ tự
}

<style>
    body {
        background-color: #f8f9fa;
        font-size: 14px;
    }

    .input-group-text, select.form-control:not([size]):not([multiple]), .form-control:not(.form-control-sm):not(.form-control-lg) {
        font-size: 13px;
        padding: 15px 12px;
        height: 38px;
    }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        margin-bottom: 15px;
    }

    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .table th {
        position: sticky;
        top: 0;
        z-index: 1;
        vertical-align: middle;
    }

    .bg-pur {
        background-color: #e2f0d9 !important;
    }

    .badge-ng {
        background-color: #ff0000;
        color: white;
    }

    .badge-ok {
        background-color: #28a745;
        color: white;
    }

    .row-alert-yes {
        background-color: #fce8e6;
    }

    /* Đảm bảo khoảng cách nhỏ giữa 2 nút trong ô hành động */
    .btn-action-gap {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    /* Vùng kéo thả file Excel chuyên dụng */
    .excel-dropzone {
        border: 2px dashed #28a745;
        background-color: #f8fff9;
        border-radius: 6px;
        padding: 30px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .excel-dropzone:hover {
            background-color: #f0fdf2;
            border-color: #218838;
        }

    /* Style cho hàng hiển thị thông tin mở rộng */
    .detail-row {
        background-color: #ffffff !important;
    }

    .detail-container {
        padding: 15px;
        background: #fdfdfd;
        border: 1px solid #dee2e6;
        border-radius: 4px;
    }

    .cursor-pointer {
        cursor: pointer;
    }
</style>

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home-pane" type="button" role="tab">Hàng ngoài danh mục</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-pane" type="button" role="tab">Hàng trong danh mục</button>
    </li>
    <li style="margin-left:200px">
        <h4 class="text-primary mb-0"><i class="fa-solid ion-clipboard me-2"></i>&nbsp; THEO DÕI TIẾN ĐỘ ĐƠN HÀNG & THANH TOÁN (PO) </h4>
    </li>
</ul>

<div class="tab-content" id="myTabContent">
    <div class="tab-pane fade show active" id="home-pane" role="tabpanel" aria-labelledby="home-tab">
        <div class="container-fluid py-4" style="background-color: #efefef82; padding-top: 0.5rem !important;">        
            <div class="card">
                <div class="card-body">
                    <form class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Từ khóa tìm kiếm</label>
                            <input type="text" class="form-control" placeholder="Nhập Số PO, NCC, hoặc Mã hàng...">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Tháng yêu cầu giao hàng</label>
                            <input type="month" class="form-control" value="2026-05">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Ảnh hưởng sản xuất</label>
                            <select class="form-control" style="padding: 5px 12px;">
                                <option value="">-- Tất cả trạng thái --</option>
                                <option value="Yes">Có (Yes) - Đang cảnh báo</option>
                                <option value="No">Không (No)</option>
                                <option value="Wait">Chờ phòng ban xác nhận</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end gap-2">
                            <button type="button" class="btn btn-primary"><i class="fa-solid ion-funnel me-1"></i> Lọc dữ liệu</button>
                            <button type="reset" class="btn btn-outline-secondary"><i class="fa-solid ion-ios-loop-strong me-1"></i> Làm mới</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <div>
                        <select class="form-control" style="padding:2px 5px">
                            <option>Danh sách PO chưa giao hàng &nbsp;</option>
                            <option>Danh sách PO đã nhập hàng &nbsp;</option>
                        </select>
                    </div>
                    <div>
                        <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa fa-file-excel me-1"></i> Xuất Excel</button>
                        <button type="button" class="btn btn-sm btn-outline-success" id="btnOpenImportExcel"><i class="fa-solid fa fa-file-excel me-1"></i> Import dữ liệu Excel</button>
                    </div>
                </div>
                <div class="card-body p-0">                  
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover mb-0 align-middle">
                            <thead>
                                <tr class="text-center text-uppercase fs-7">
                                    <th class="text-dark text-dark">No.</th>
                                    <th class="bg-pur text-dark">Ngày YC</th>
                                    <th class="bg-pur text-dark">Ngày YC giao</th>
                                    <th class="bg-pur text-dark" width="80px">Số PO</th>
                                    <th class="bg-pur text-dark" width="200px">Tên hàng</th>
                                    <th class="bg-pur text-dark">Mã hàng</th>
                                    <th class="bg-pur text-dark">Số lượng</th>
                                    <th class="bg-pur text-dark">Đơn vị</th>
                                    <th class="bg-pur text-dark">Tên NCC</th>
                                    <th class="bg-pur text-dark">Time GH</th>
                                    <th class="bg-pur text-dark" width="100">ĐN phát hành PO</th>
                                    <th class="bg-white text-dark">Ngày gửi PO</th>
                                    <th class="bg-pur text-dark">ĐN Follow NCC</th>
                                    <th class="bg-white text-dark">Ngày NCC XN Giao</th>
                                    <th class="bg-white text-dark">Lịch giao (OK/NG)</th>
                                    <th class="bg-white text-dark">Ảnh hưởng SX</th>
                               
                                    <th class="bg-white text-dark">Trạng thái</th>
                                    <th class="bg-white text-dark" colspan="3">NHẬP DỮ LIỆU</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model.Where(x=> x.Danhmuc == "OUT"))
                                {
                                    <tr class="@(item.Ngayyc != null ? "row-alert-yes" : "")">
                                        <td class="text-center fw-bold">@(stt++)</td>
                                        <td class="text-center">@(item.Ngayycgiao?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td class="text-center">@(item.ngaynccxngiao?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td class="text-center fw-bold text-primary">@item.SoPO</td>
                                        <td>@item.Tentiengviet</td>
                                        <td class="text-center fw-bold">@item.Mahang</td>
                                        <td class="text-end">@item.Soluong.ToString("N0")</td>
                                        <td class="text-center">@item.Dovi</td>
                                        <td>@item.Nhacungcap</td> <td>Time GH</td> <td></td>
                                        <td class="text-center">@(item.InvoicePONgaynhap?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td>Người Follow</td> <td class="text-center fw-bold text-danger">Ngày XN Giao</td> <td class="text-center cursor-pointer toggle-detail" data-target="#info-@item.PO_Detail_Id">
                                            <span class="badge badge-ng p-2 w-100">NG <i class="fa-solid fa fa-caret-down ms-1"></i></span>
                                        </td>
                                        <td class="text-center fw-bold text-danger"><i class="fa-solid ion-alert-circled me-1"></i>Có (Yes)</td>
                        
                                        <th class="text-center @(item.LuongvethucteNgaynhap != null ? "text-success" : "text-warning")">
                                            @(item.LuongvethucteNgaynhap != null ? "Đã nhập hàng" : "Chưa giao hàng")
                                        </th>

                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-primary w-100 btn-update-po"
                                                    data-po="@item.SoPO" 
                                                    data-item-name="@item.Tentiengviet" 
                                                    data-item-code="@item.Mahang"
                                                    data-req-date="@(item.Ngaygiaohangdukien?.ToString("dd/MM/yyyy"))">
                                                <i class="fa-solid ion-compose"></i> Dự kiến
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-success w-100 btn-official-po"
                                                    data-po="@item.SoPO" 
                                                    data-item-name="@item.Tentiengviet" 
                                                    data-item-code="@item.Mahang" 
                                                    data-req-date="@(item.Ngaygiaohangdukien?.ToString("dd/MM/yyyy"))">
                                                <i class="fa-solid fa fa-pen"></i> Chính thức
                                            </button>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-info w-100 btn-payment-po"
                                                    data-po="@item.SoPO" 
                                                    data-item-name="@item.Tentiengviet" 
                                                    data-item-code="@item.Mahang" 
                                                    data-order-qty="@item.Soluong" 
                                                    data-req-date="@(item.Ngaygiaohangdukien?.ToString("dd/MM/yyyy"))">
                                                <i class="fa-solid fa fa-credit-card"></i> Thanh toán
                                            </button>
                                        </td>
                                    </tr>

                                    <tr id="info-@item.PO_Detail_Id" class="collapse detail-row">
                                        <td colspan="20">
                                            <div class="detail-container">
                                                <h6 class="text-success fw-bold mb-3"><i class="fa-solid fa fa-list-check me-2"></i>THÔNG TIN CHI TIẾT CỦA SỐ PO: @item.SoPO</h6>
                                                <div class="row g-3">
                                                    <div class="col-md-4">
                                                        <div class="p-2 border rounded bg-light">
                                                            <strong class="text-primary d-block mb-1"><i class="fa-solid fa fa-clock-rotate-left me-1"></i> 1. Dữ liệu Dự Kiến (PUR)</strong>
                                                            <span class="d-block fs-7">Ngày gửi PO: <b class="text-dark">@(item.InvoicePONgaynhap?.ToString("dd/MM/yyyy") ?? "Chưa gửi")</b></span>
                                                            </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="p-2 border rounded bg-light">
                                                            <strong class="text-success d-block mb-1"><i class="fa-solid fa fa-boxes-stacked me-1"></i> 2. Thực Tế Nhận Hàng (Warehouse)</strong>
                                                            <span class="d-block fs-7">Ngày giao thực tế: <b class="text-dark">@(item.LuongvethucteNgaynhap?.ToString("dd/MM/yyyy") ?? "--")</b></span>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="p-2 border rounded bg-light">
                                                            <strong class="text-info d-block mb-1"><i class="fa-solid fa fa-calculator me-1"></i> 3. Chứng Từ Thanh Toán (Accounting)</strong>
                                                            <span class="d-block fs-7">Tổng tiền: <b class="text-dark">@(item.Sotien?.ToString("N0") ?? "0")</b></span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="20" class="text-center text-muted py-4">Không có dữ liệu PO nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                </div>
                <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                    <span class="text-muted">Hiển thị 1-3 trong tổng số 158 dòng dữ liệu chưa giao</span>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item"><a class="page-link" href="#">Sau</a></li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <div class="tab-pane fade" id="profile-pane" role="tabpanel" aria-labelledby="profile-tab">
