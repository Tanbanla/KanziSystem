            </div>
            <div class="modal-body">
                <div class="mb-3 d-flex justify-content-between align-items-center p-2 bg-light rounded border">
                 
                    <span class="fs-7 text-muted"><i class="fa-solid fa fa-circle-info me-1"></i> File export</span>
                    <a href="#" class="btn btn-xs btn-link text-success p-0 fw-bold text-decoration-none" id="btnExportExcel" onclick="exportExcel()"><i class="fa-solid fa fa-download me-1"></i> Tải File</a>
                </div>
                <form id="importExcelForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Chọn tệp tin Excel (.xlsx, .xls)</label>
                        <div class="excel-dropzone" onclick="document.getElementById('excelFileInput').click()">
                            <i class="fa-solid fa fa-cloud-arrow-up text-success mb-2" style="font-size: 2rem;"></i>
                            <p class="mb-1 fw-semibold text-secondary" id="dropzoneText">Kéo thả file vào đây hoặc click để chọn file</p>
                            <input type="file" id="excelFileInput" class="d-none" accept=".xlsx, .xls">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" onclick="closeMyModal('importExcelModal')">Đóng</button>
                <button type="button" id="btnExecuteImport" class="btn btn-success fw-bold"><i class="fa-solid fa fa-upload me-1"></i> Thực hiện Import</button>
            </div>
        </div>
    </div>
</div>

