@using PRJ_WAREHOUSE_BIVN.Language
@using PRJ_WAREHOUSE_BIVN.Controllers
@model IEnumerable<PoDetailViewModel>
@{
    ViewData["Title"] = "Quản lý nhận hàng";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalRecords = ViewBag.TotalRecords ?? 0;
    var pageSize = ViewBag.PageSize ?? 500;
    var searchTerm = ViewBag.SearchTerm;
    var currentTab = ViewBag.CurrentTab ?? "ngoai";
    var reqMonth = ViewBag.ReqMonth as string;
    int stt = (currentPage - 1) * pageSize + 1;

    // Lấy thông tin quyền hạn của User
    var userSection = User.FindFirst("Section")?.Value;

    // ----- THÊM CODE XỬ LÝ GOM NHÓM TẠI ĐÂY -----
    // 1. Lọc ra các dòng có Lịch giao = "NG" VÀ Ảnh hưởng SX khác "No" (hoặc rỗng)
    var ngItems = Model?.Where(x =>
        !string.IsNullOrEmpty(x.lichgiao) && x.lichgiao.Trim().ToUpper() == "NG" &&
        (string.IsNullOrEmpty(x.anhuongsx) || x.anhuongsx.Trim().ToUpper() != "NO")
    ).ToList() ?? new List<PoDetailViewModel>();
}

<style>
    .badge-warning {
        background-color: #ffc107;
    }

    .badge-info {
        background-color: #17a2b8;
        color: white;
    }

    .table.table-bordered th {
        border-color: #d6d1d1;
    }

    body {
        background-color: #f8f9fa;
        font-size: 14px;
    }

    .input-group-text, select.form-control:not([size]):not([multiple]), .form-control:not(.form-control-sm):not(.form-control-lg) {
        font-size: 13px;
      
        height: 38px;
    }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        margin-bottom: 15px;
    }

    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }

    .table th {
        position: sticky;
        top: 0;
        z-index: 1;
        vertical-align: middle;
        border-color: #d6d1d1;
    }

    .table:not(.table-sm) thead th {
        color: #241b87;
    }

    .bg-pur {
        background-color: #2335b7 !important;
    }

    .badge-ng {
        background-color: #ff0000;
        color: white;
    }

    .badge-ok {
        background-color: #28a745;
        color: white;
    }

    .row-alert-yes {
        background-color: #fce8e6;
    }

    .btn-action-gap {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .excel-dropzone {
        border: 2px dashed #28a745;
        background-color: #f8fff9;
        border-radius: 6px;
        padding: 30px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .excel-dropzone:hover {
            background-color: #f0fdf2;
            border-color: #218838;
        }

    .detail-row {
        background-color: #ffffff !important;
    }

    .detail-container {
        padding: 15px;
        background: #fdfdfd;
        border: 1px solid #dee2e6;
        border-radius: 4px;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .nav-link {
        padding: .1rem 1rem;
    }

    .nav-tabs .nav-link.active {
        color: white;
        background-color: #2335b7;
    }

    .nav-tabs .nav-item .nav-link.active {
        color: #e4e4e4;
    }

    .modal.show {
        background-color: rgba(0, 0, 0, 0.5) !important;
    }

    .bg-white {
        background-color: #ebf7ff !important;
    }
   
</style>

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(currentTab == "ngoai" ? "active" : "")" onclick="changeTab('ngoai')" type="button">Hàng ngoài danh mục</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(currentTab == "trong" ? "active" : "")" onclick="changeTab('trong')" type="button">Hàng trong danh mục</button>
    </li>
    <li class="ms-auto align-self-center pe-3" style="margin-left:180px">
        <h4 class="text-primary mb-0"><i class="fa-solid ion-clipboard me-2"></i> THEO DÕI TIẾN ĐỘ ĐƠN HÀNG & THANH TOÁN (PO) </h4>
    </li>
</ul>

<div class="container-fluid py-4" style="background-color: #efefef82; padding-top: 0.5rem !important;">
    <div class="card mb-0">
        <div class="card-body">
            <form id="filterForm" asp-action="ManageDelivery" method="get" class="row g-3">
                <input type="hidden" name="tab" id="activeTab" value="@currentTab" />

                <div class="col-md-2">
                    <label class="form-label fw-semibold">Từ khóa tìm kiếm</label>
                    <input type="text" name="searchTerm" class="form-control" value="@searchTerm" placeholder="Nhập Số PO, NCC, hoặc Mã hàng...">
                </div>
                <div class="col-md-1">
                    <label class="form-label fw-semibold">Tháng yêu cầu</label>
                    <input type="month" name="reqMonth" class="form-control" value="@(!string.IsNullOrEmpty(reqMonth) ? reqMonth : DateTime.Now.ToString("yyyy-MM"))">
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Ảnh hưởng sản xuất</label>
                    <select name="impactStatus" class="form-control">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Yes">Có (Yes) - Đang cảnh báo</option>
                        <option value="No">Không (No)</option>
                        <option value="Wait">Chờ phòng ban xác nhận</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid ion-funnel me-1"></i> Lọc</button>                 
                    <a href="@Url.Action("ManageDelivery", new { tab = currentTab })" class="btn btn-secondary ml-1"><i class="fa-solid ion-ios-loop-strong me-1"></i> Refresh</a>
                    <button type="button" class="btn btn-outline-danger ml-1" onclick="exportDataExcel()">
                        <i class="fa-solid fa fa-file-excel me-1"></i> Export
                    </button>
                </div>

                <div class="col-md-5 d-flex align-items-end gap-2 justify-content-end">
                 
                    <button type="button" class="btn btn-outline-success ml-1" id="btnOpenImportExcel">
                        <i class="fa-solid fa fa-file-excel me-1"></i> Import dữ liệu Excel
                    </button>
                    @if (userSection == "3100")
                    {
                        <button type="button" class="btn btn-outline-primary ml-1" id="btnOpenSupplierNg">
                            <i class="fa-solid fa fa-envelope-open-text me-1"></i> List (NG)                           
                            <span class="badge bg-danger rounded-pill ms-1" id="demncc"></span>                          
                        </button>
                        <button type="button" class="btn btn-outline-info ml-1" id="btnOpenGateRegistration">
                            <i class="fa-solid fa fa-car-side me-1"></i> Đăng ký ra vào cổng
                            <span class="badge bg-danger rounded-pill ms-1" id="demgate" style="display:none;"></span>
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0 align-middle" style="font-size:12px">
                    <thead>
                        <tr class="text-center text-uppercase fs-7">
                            <th class="bg-white text-dark" hidden>ID</th>
                            <th class="bg-pur text-white">Ngày YC</th>
                            <th class="bg-pur text-white">Ngày YC giao</th>
                            <th class="bg-pur text-white" width="80px">Số PO</th>
                            <th class="bg-pur text-white" width="230px">Tên hàng</th>
                            <th class="bg-pur text-white">Mã hàng</th>
                            <th class="bg-pur text-white">SL</th>
                            <th class="bg-pur text-white">Đơn vị</th>
                            <th class="bg-pur text-white" width="200px">Tên NCC</th>
                            <th class="bg-pur text-white" width="60" title="Người phát hành">ĐN PH PO</th>
                            <th class="bg-white" width="80px">Ngày gửi PO</th>
                            <th class="bg-pur text-white">ĐN Follow NCC</th>
                            <th class="bg-white" width="80px">Ngày NCC giao</th>
                            <th class="bg-white" width="80px">Ngày thực tế</th>
                            <th class="bg-white" width="80px">Giờ thực tế</th>
                            <th class="bg-white">Lịch giao (OK/NG) </th>
                            @if (currentTab == "trong")
                            {
                                <th>Cảnh báo </th>
                            }                                               
                            <th class="bg-white">Ảnh hưởng SX</th>
                            <th class="bg-white" width="80px">Cửa GH Cổng GH</th>
                            <th class="bg-white">Người nhận</th>
                            <th class="bg-white">Số ĐNTT</th>
                            <th class="bg-white">Số hóa đơn</th>

                            @* --- LOGIC HEADER DỰA TRÊN USER SECTION --- *@
                            @if (userSection == "3100")
                            {
                                <th class="bg-white" colspan="3">NHẬP DỮ LIỆU</th>
                            }
                            else
                            {
                                <th class="bg-white" width="130px">ẢNH HƯỞNG SX</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var i = 1;
                            @foreach (var item in Model)
                            {
                                string rowBgClass = "";
                                // 2. Nếu có dữ liệu cả 2 ngày VÀ Ngày YC giao < Ngày NCC xác nhận (Hẹn giao trễ) -> Cảnh báo NG
                            if (item.lichgiao == "NG")
                            {                        
                                rowBgClass = "row-alert-yes"; 
                            }
                            if (item.lichgiao == "OK")
                            {

                                rowBgClass = "row-alert-ok"; 
                            }
                           
                                <tr class="main-row @rowBgClass"
                                    data-id="@item.PO_Detail_Id"
                                    data-send-date="@(string.IsNullOrEmpty(item.ngayguiPO) ? "---" : item.ngayguiPO)"
                                    data-confirm-date="@(string.IsNullOrEmpty(item.ngaynccxngiao) ? "---" : item.ngaynccxngiao)"
                                    data-impact="@(string.IsNullOrEmpty(item.anhuongsx) ? "---" : item.anhuongsx)"
                                    data-luongvekho="@(item.LuongvekhoKhonhap)"
                                    data-ngay-ghchinhthuc="@(string.IsNullOrEmpty(item.Ngay_GHchinhthuc) ? "---" : item.Ngay_GHchinhthuc)"
                                    data-gio-gh="@(string.IsNullOrEmpty(item.Gio_GH) ? "" : item.Gio_GH)"
                                    data-cua-gh="@(string.IsNullOrEmpty(item.Cua_GH) ? "---" : item.Cua_GH)"
                                    data-cong-nhanhang="@(string.IsNullOrEmpty(item.Cong_Nhanhang) ? "---" : item.Cong_Nhanhang)"
                                    data-nguoi-nhanhang="@(string.IsNullOrEmpty(item.Nguoi_Nhanhang) ? "---" : item.Nguoi_Nhanhang)"
                                    data-sl-thucte="@(string.IsNullOrEmpty(item.SL_Thucte) ? "---" : item.SL_Thucte)"
                                    data-so-dntt="@(string.IsNullOrEmpty(item.So_DNTT) ? "---" : item.So_DNTT)"
                                    data-so-hoadon="@(string.IsNullOrEmpty(item.So_hoadon) ? "---" : item.So_hoadon)">

                                    <td class="text-center fw-bold" hidden>@(item.PO_Detail_Id)</td>
                                    <td class="text-center">@item.Ngayyc</td>
                                    <td class="text-center">@item.Ngayycgiao</td>
                                    <td class="text-center fw-bold text-primary">@item.SoPO</td>
                                    <td>@item.Tentiengviet</td>
                                    <td class="text-center fw-bold">@item.Mahang</td>
                                    <td class="text-end">@item.Soluong.ToString("N0")</td>
                                    <td class="text-center">@item.Donvi</td>
                                    <td>@item.Nhacungcap</td>
                                    <td class="text-center">@(item.DNphathanhpo)</td>
                                    <td>@item.ngayguiPO</td>
                                    <td class="text-center fw-bold text-danger"></td>
                                    <td>@item.ngaynccxngiao</td>
                                    <td>@item.Ngay_GHchinhthuc</td>
                                    <td>@item.Gio_GH</td>

                                    <!-- Cột Trạng thái & Toggle -->
                                    <td class="text-center cursor-pointer toggle-detail">
                                        @if (currentTab == "trong")
                                        {
                                            if (!string.IsNullOrEmpty(item.lichgiao))
                                            {
                                                string badgeClass = "badge-secondary";
                                                string val = item.lichgiao.ToLower().Trim();
                                                if (val == "ok") badgeClass = "badge-ok";
                                                else if (val.Contains("dưới an toàn")) badgeClass = "badge-warning text-dark";
                                                else if (val.Contains("put in")) badgeClass = "badge-info";
                                                else if (val.Contains("put out")) badgeClass = "bg-pur text-white";
                                                else badgeClass = "badge-ng";

                                                <span class="badge @badgeClass p-2 w-100">
                                                    @item.lichgiao <i class="fa-solid fa fa-caret-down ms-1"></i>
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            if (!string.IsNullOrEmpty(item.lichgiao))
                                            {
                                                <span class="badge @(item.lichgiao == "OK" ? "badge-ok" : "badge-ng") p-2 w-100">
                                                    @item.lichgiao <i class="fa-solid fa fa-caret-down ms-1"></i>
                                                </span>
                                            }
                                        }
                                    </td>

                                    <td class="text-center fw-bold">
                                        @if (item.anhuongsx == "No")
                                        {
                                            <span class="text-success">@item.anhuongsx</span>
                                        }
                                        else if (item.anhuongsx == "Yes")
                                        {
                                            <span class="text-danger">⚠️@item.anhuongsx</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }
                                    </td>
                                    <td>@item.Cua_GH × @item.Cong_Nhanhang</td>
                                    <td>@item.Nguoi_Nhanhang</td>
                                    <td>@item.So_DNTT</td>
                                    <td>@item.So_hoadon</td>

                                    <!-- --- PHÂN QUYỀN HIỂN THỊ CÁC NÚT THAO TÁC --- -->
                                    @if (userSection == "3100")
                                    {
                                        <!-- Cột 1: Nút Dự kiến -->
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-primary w-100 btn-update-po"
                                                    data-po="@item.SoPO" data-item-name="@item.Tentiengviet" data-item-code="@item.Mahang"
                                                    data-req-date="@item.Ngayycgiao" data-po-detail-id="@item.PO_Detail_Id"
                                                    data-po-ncc="@item.MaNhacungcap" data-send-date="@item.ngayguiPO" data-confirm-date="@item.ngaynccxngiao"
                                                    title="Cập nhật thông tin dự kiến">
                                                <i class="fa-solid ion-compose"></i>
                                            </button>
                                        </td>

                                        <!-- Cột 2: Nút Chính thức -->
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-success w-100 btn-official-po"
                                                    data-po="@item.SoPO" data-item-name="@item.Tentiengviet" data-item-code="@item.Mahang"
                                                    data-req-date="@item.Ngayycgiao" data-po-detail-id="@item.PO_Detail_Id" data-po-ncc="@item.MaNhacungcap"
                                                    title="Nhập nhận hàng thực tế">
                                                <i class="fa-solid fa fa-pen"></i>
                                            </button>
                                        </td>

                                        <!-- Cột 3: Nút Thanh toán -->
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-info w-100 btn-payment-po"
                                                    data-po="@item.SoPO" data-item-name="@item.Tentiengviet" data-item-code="@item.Mahang"
                                                    data-order-qty="@item.Soluong" data-req-date="@item.Ngayycgiao" data-po-detail-id="@item.PO_Detail_Id"
                                                    title="Nhập hồ sơ thanh toán">
                                                <i class="fa-solid fa fa-credit-card"></i>
                                            </button>
                                        </td>
                                    }
                                    else
                                    {
                                        <!-- Cột dành cho bộ phận khác: Chỉ hiện nút khi Lịch giao cảnh báo NG -->
                                        <td class="text-center">
                                            @if (item.lichgiao == "NG")
                                            {
                                                <button class="btn btn-sm btn-danger fw-bold w-100 btn-impact-po"
                                                        data-po="@item.SoPO"
                                                        data-item-name="@item.Tentiengviet"
                                                        data-item-code="@item.Mahang"
                                                        data-po-detail-id="@item.PO_Detail_Id"
                                                        data-current-impact="@item.anhuongsx"
                                                        title="Bấm để xác nhận ảnh hưởng sản xuất">
                                                    <i class="fa-solid fa fa-triangle-exclamation me-1"></i> Nhập AH SX
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted fs-7">---</span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="23" class="text-center text-muted py-4">Không có dữ liệu PO nào phù hợp với điều kiện lọc.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="text-muted">
                Hiển thị @((currentPage - 1) * pageSize + (totalRecords > 0 ? 1 : 0))
                - @(Math.Min(currentPage * pageSize, totalRecords))
                trong tổng số @totalRecords dữ liệu
            </span>
            @if (totalPages > 1)
            {
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageDelivery", new { page = currentPage - 1, searchTerm = searchTerm, tab = currentTab, reqMonth = reqMonth })">Trước</a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("ManageDelivery", new { page = i, searchTerm = searchTerm, tab = currentTab, reqMonth = reqMonth })">@i</a>
                                </li>
                            }
                            else if (i == currentPage - 3 || i == currentPage + 3)
                            {
                                <li class="page-item disabled"><a class="page-link" href="#">...</a></li>
                            }
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageDelivery", new { page = currentPage + 1, searchTerm = searchTerm, tab = currentTab, reqMonth = reqMonth })">Sau</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- 1. Modal Cập Nhật Dự Kiến -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title text-primary"><i class="fa-solid fa fa-pen-to-square me-1"></i> Cập nhật Tiến độ PO: <span id="modalPoNumber"></span></h5>
                <button type="button" class="btn btn-secondary" onclick="closeMyModal('updateModal')">x</button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info py-2 mb-3 fs-7">
                    <strong>Mặt hàng:</strong> <span id="modalItemName"></span> (<span id="modalItemCode"></span>)
                    <span id="modalPoDetailId" style="display:none;"></span> <br>
                    <strong>Ngày YC giao trên PO:</strong> <span class="text-dark fw-bold" id="modalReqDate"></span>
                </div>
                <form id="updateForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">1. Ngày gửi PO cho NCC</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-regular fa fa-calendar"></i></span>
                            <input type="date" id="modalSendPoDate" class="form-control">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">2. Ngày NCC xác nhận giao (Dự kiến)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa-regular fa fa-calendar-check"></i></span>
                            <input type="date" id="modalConfirmDate" class="form-control">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">3. Phạm vi áp dụng</label>
                        <div class="d-flex gap-4 mt-1">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="updateScope" id="full_PO" value="full" checked>
                                <label class="form-check-label cursor-pointer text-success" for="full_PO">
                                    Áp dụng cho tất cả các mã trong PO
                                </label>
                            </div>
                            <div class="form-check ml-2">
                                <input class="form-check-input" type="radio" name="updateScope" id="single_item" value="single">
                                <label class="form-check-label cursor-pointer text-danger" for="single_item">
                                    Chỉ áp dụng cho mã dòng này
                                </label>
                            </div>
                        </div>
                    </div>
                    <hr>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" onclick="closeMyModal('updateModal')">Đóng</button>
                <button type="button" id="btnSaveInfo" class="btn btn-primary"><i class="fa-solid fa fa-floppy-disk me-1"></i> Lưu thông tin</button>
            </div>
        </div>
    </div>
</div>

<!-- 2. Modal Nhập Giao Hàng Chính Thức -->
<div class="modal fade" id="officialModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-success">
            <div class="modal-header text-success">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa fa-circle-check me-1"></i> Nhập nhận hàng thực tế PO: <span id="offPoNumber"></span></h5>
                <button type="button" class="btn btn-secondary" onclick="closeMyModal('officialModal')">x</button>
            </div>
            <div class="modal-body">
                <div class="alert alert-success py-2 mb-3 fs-7">
                    <strong>Mặt hàng:</strong> <span id="offItemName"></span> (<span id="offItemCode"></span>)
                    <span id="offPoDetailId" style="display:none;"></span><br>
