                            </tr>
                        `;
                    });

                    // Gắn HTML vào tbody
                    tbody.innerHTML = html;
                } else {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4 fw-bold fs-6">
                                <i class="fa-solid fa-circle-info me-1"></i> Không có dữ liệu đăng ký ra vào cổng.
                            </td>
                        </tr>
                    `;
                }
            } catch (error) {
                console.error("Lỗi khi tải dữ liệu Modal Gate:", error);
                tbody.innerHTML = `
                    <tr>
                        <td colspan="4" class="text-center text-danger py-4 fw-bold">
                            <i class="fa-solid fa-circle-xmark me-1"></i> Lỗi kết nối. Không thể tải dữ liệu.
                        </td>
                    </tr>
                `;
            }
        });
        async function getDemGateCount() {
            const badgeDemGate = document.getElementById('demgate');
            if (!badgeDemGate) return;

            try {
                // Gọi API NCC_Giaohang (không truyền tham số để tự động lấy ngày hiện tại)
                const response = await fetch('/ManagerDelivery/NCC_Giaohang');
                const data = await response.json();

                if (data && data.ncc_ng) {
                    // Đếm số lượng nhóm Master (số lượng lịch giao)
                    const count = data.ncc_ng.length;
                    badgeDemGate.textContent = count;

                    // Ẩn badge nếu số lượng = 0
                    if (count === 0) {
                        badgeDemGate.style.display = 'none';
                    } else {
                        badgeDemGate.style.display = 'inline-block';
                    }
                } else {
                    badgeDemGate.textContent = "0";
                    badgeDemGate.style.display = 'none';
                }
            } catch (error) {
                console.error("Lỗi khi tải số lượng Đăng ký ra vào cổng:", error);
                badgeDemGate.style.display = 'inline-block';
                badgeDemGate.textContent = "!";
            }
        }
    </script>
}
