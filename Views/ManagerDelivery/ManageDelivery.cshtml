                Hiển thị @((currentPage - 1) * pageSize + (totalRecords > 0 ? 1 : 0))
                - @(Math.Min(currentPage * pageSize, totalRecords))
                trong tổng số @totalRecords dữ liệu
            </span>
            @if (totalPages > 1)
            {
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                       <!-- Nút Trước -->
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageDelivery", new { page = currentPage - 1, searchTerm = searchTerm, tab = currentTab, reqMonth = reqMonth, impactStatus = ViewBag.ImpactStatus, pullStatus = ViewBag.PullStatus, mahang = ViewBag.Mahang, sortColumn = sortColumn, sortDirection = sortDirection, picpur = ViewBag.PicPur })">Trước</a>
                        </li>
                        <!-- Các nút số trang -->
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("ManageDelivery", new { page = i, searchTerm = searchTerm, tab = currentTab, reqMonth = reqMonth, impactStatus = ViewBag.ImpactStatus, pullStatus = ViewBag.PullStatus, mahang = ViewBag.Mahang, sortColumn = sortColumn, sortDirection = sortDirection, picpur = ViewBag.PicPur })">@i</a>
                                </li>
                            }
                            else if (i == currentPage - 3 || i == currentPage + 3)
                            {
                                <li class="page-item disabled"><a class="page-link" href="#">...</a></li>
                            }
                        }
                        <!-- Nút Sau -->
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("ManageDelivery", new { page = currentPage + 1, searchTerm = searchTerm, tab = currentTab, reqMonth = reqMonth, impactStatus = ViewBag.ImpactStatus, pullStatus = ViewBag.PullStatus, mahang = ViewBag.Mahang, sortColumn = sortColumn, sortDirection = sortDirection, picpur = ViewBag.PicPur })">Sau</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

