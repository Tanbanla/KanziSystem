@using PRJ_WAREHOUSE_BIVN.Controllers
@model IEnumerable<PoViewModel>

<div class="card">
    <div class="card-header bg-white pb-0 d-flex justify-content-between align-items-end border-bottom">
        <ul class="nav nav-tabs border-bottom-0" id="poTabs" role="tablist">
        </ul>
    </div>

    <div class="card-body p-0">
        <div class="tab-content" id="poTabsContent">

            <div class="tab-pane fade show active" id="pending" role="tabpanel">
                @await Html.PartialAsync("_PoTablePartial", Model.Where(x => x.Status == "Pending"))
            </div>

            <div class="tab-pane fade" id="received" role="tabpanel">
                @await Html.PartialAsync("_PoTablePartial", Model.Where(x => x.Status == "Received"))
            </div>
        </div>
    </div>
</div>
