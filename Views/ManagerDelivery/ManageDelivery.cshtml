@using PRJ_WAREHOUSE_BIVN.Language
@using PRJ_WAREHOUSE_BIVN.Controllers
@model IEnumerable<PoDetailViewModel>
@{
    ViewData["Title"] = "Quản lý nhận hàng";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalRecords = ViewBag.TotalRecords ?? 0;
    var pageSize = ViewBag.PageSize ?? 500;
    var searchTerm = ViewBag.SearchTerm;
    var currentTab = ViewBag.CurrentTab ?? "ngoai";
    var reqMonth = ViewBag.ReqMonth as string;

    var sortColumn = ViewBag.SortColumn as string ?? "";
    var sortDirection = ViewBag.SortDirection as string ?? "asc";

    int stt = (currentPage - 1) * pageSize + 1;
    var div_layout = "col-md-6";
    // Lấy thông tin quyền hạn của User
    var userSection = User.FindFirst("Section")?.Value;

    //Lọc ra các dòng có Lịch giao = "NG" VÀ Ảnh hưởng SX khác "No" (hoặc rỗng)
    var ngItems = Model?.Where(x =>
        !string.IsNullOrEmpty(x.lichgiao) && x.lichgiao.Trim().ToUpper() == "NG" &&
        (string.IsNullOrEmpty(x.anhuongsx) || x.anhuongsx.Trim().ToUpper() != "NO")
    ).ToList() ?? new List<PoDetailViewModel>();

    string currentImpact = ViewBag.ImpactStatus as string ?? "";
    string CheckDate(string inputDate)
    {
        if (string.IsNullOrWhiteSpace(inputDate)) return "";
        // Nếu chứa các chuỗi năm 1900 hoặc 0001 (default DateTime)
        if (inputDate.Contains("1900-01-01") || inputDate.Contains("01/01/1900") || inputDate.Contains("1/1/1900") ||
            inputDate.Contains("0001-01-01") || inputDate.Contains("01/01/0001"))
        {
            return "";
        }
        return inputDate.Trim();
    }

    Microsoft.AspNetCore.Html.IHtmlContent RenderSortHeader(string column, string title, string cssClass, string width = "")
    {
        var icon = "ion-arrow-down-b text-muted opacity-50"; // Mặc định hiển thị mờ
        if (sortColumn == column)
        {
            icon = sortDirection == "asc" ? "ion-arrow-down-b text-muted opacity-50" : "ion-arrow-down-b text-muted opacity-50"; // Hiển thị mũi tên
        }
        var wAttr = string.IsNullOrEmpty(width) ? "" : $"width='{width}'";
        return Html.Raw($"<th class='{cssClass} cursor-pointer' {wAttr} onclick=\"sortData('{column}')\">{title} <i class='fa-solid {icon} ms-1'></i></th>");
    }
}
<style>
    .badge-warning {
        background-color: #ffc107;
    }

    .badge-info {
        background-color: #17a2b8;
        color: white;
    }

    .table.table-bordered th {
        border-color: #d6d1d1;
    }

    body {
        zoom: 93%;
        background-color: #f8f9fa;
        font-size: 14px;
    }

    .input-group-text, select.form-control:not([size]):not([multiple]), .form-control:not(.form-control-sm):not(.form-control-lg) {
        font-size: 13px;
      
        height: 38px;
    }

    .card {
    
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        margin-bottom: 15px;
    }

    .table-responsive {
        max-height: calc(100vh - 330px);
        overflow-y: auto;
        overflow-x: auto; /* Thêm dòng này để tạo thanh cuộn ngang */
    }

    .table th, .table td {
        white-space: nowrap; /* Ngăn text tự động rớt dòng, ép bảng rộng ra */
    }

    .text-wrap-col {
        white-space: normal !important;
        min-width: 250px; 
    }
    .table th {
        position: sticky;
        top: 0;
        z-index: 1;
        vertical-align: middle;
        border-color: #d6d1d1;
    }

    .table:not(.table-sm) thead th {
        color: #241b87;
    }

    .bg-pur {
        background-color: #2335b7 !important;
    }

    .badge-ng {
        background-color: #ff0000;
        color: white;
    }

    .badge-ok {
        background-color: #28a745;
        color: white;
    }

    .row-alert-yes {
        background-color: #fce8e6;
    }

    .btn-action-gap {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .excel-dropzone {
        border: 2px dashed #28a745;
        background-color: #f8fff9;
        border-radius: 6px;
        padding: 30px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .excel-dropzone:hover {
            background-color: #f0fdf2;
            border-color: #218838;
        }

    .detail-row {
        background-color: #ffffff !important;
    }

    .detail-container {
        padding: 15px;
        background: #fdfdfd;
        border: 1px solid #dee2e6;
        border-radius: 4px;
    }

    .cursor-pointer {
        cursor: pointer;
    }

    .nav-link {
        padding: .1rem 1rem;
    }

    .nav-tabs .nav-link.active {
        color: white;

        background-color: #2335b7;
    }

    .nav-tabs .nav-item .nav-link.active {
        color: #e4e4e4;
    }

    .modal.show {
        background-color: rgba(0, 0, 0, 0.5) !important;
    }

    .bg-white {
        background-color: #ebf7ff !important;
    }

    /* --- CSS CHO CÁC CỘT ĐƯỢC FREEZE --- */
    .sticky-td {
        background-color: #ffffff; /* Nền trắng mặc định để chữ không đè lên nhau */
    }
    
    /* Hover mặc định cho các dòng bình thường (không OK, không NG) */
    .table-hover tbody tr.main-row:hover .sticky-td {
        background-color: #e4e4e4 !important;
    }

    /* 1. Xử lý màu nền cho các dòng cảnh báo NG */
    .row-alert-yes,
    .row-alert-yes .sticky-td {
        background-color: #fce8e6 !important; /* Đỏ nhạt cảnh báo */
    }
    .table-hover tbody tr.row-alert-yes:hover,
    .table-hover tbody tr.row-alert-yes:hover .sticky-td {
        background-color: #f5d6d2 !important; /* Đỏ đậm hơn khi hover để dễ nhận biết */
    }

    /* 2. Xử lý màu nền cho các dòng OK */
    .row-alert-ok,
    .row-alert-ok .sticky-td {
        background-color: #e8f5e9 !important; /* Xanh lá nhạt an toàn */
    }
    .table-hover tbody tr.row-alert-ok:hover,
    .table-hover tbody tr.row-alert-ok:hover .sticky-td {
        background-color: #c8e6c9 !important; /* Xanh lá đậm hơn khi hover */
    }

    /* Đường kẻ phân cách để dễ phân biệt vùng đã Freeze */
    .sticky-boundary {
        border-right: 1px solid #a6a6a6 !important;
        box-shadow: 1px 0 5px -2px rgba(0,0,0,0.15);
    }
</style>

<ul class="nav nav-tabs" id="myTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(currentTab == "ngoai" ? "active" : "")" onclick="changeTab('ngoai')" type="button">Hàng ngoài danh mục</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(currentTab == "trong" ? "active" : "")" onclick="changeTab('trong')" type="button">Hàng trong danh mục</button>
    </li>
    <li class="ms-auto align-self-center pe-3" style="margin-left:180px">
        <h4 class="text-primary mb-0"><i class="fa-solid ion-clipboard me-2"></i> THEO DÕI TIẾN ĐỘ ĐƠN HÀNG & THANH TOÁN (PO) </h4>
    </li>
</ul>

<div class="container-fluid py-4" style="background-color: #efefef82; padding-top: 0.5rem !important;">
    <div class="card mb-0">
        <div class="card-body">
            <form id="filterForm" asp-action="ManageDelivery" method="get" class="row g-3">
                <input type="hidden" name="tab" id="activeTab" value="@currentTab" />
                <input type="hidden" name="sortColumn" id="sortColumn" value="@sortColumn" />
                <input type="hidden" name="sortDirection" id="sortDirection" value="@sortDirection" />
                <div class="col-md-2">
                    <label class="form-label fw-semibold">Từ khóa tìm kiếm</label>
                    <input type="text" name="searchTerm" class="form-control" value="@searchTerm" placeholder="Nhập Số PO, NCC, hoặc Mã hàng...">
                </div>
                <div class="col-md-1">
                    <label class="form-label fw-semibold">Tháng yêu cầu</label>
                 <input type="month" name="reqMonth" class="form-control">
                </div>
                <div class="col-md-1">
                <label class="form-label fw-semibold">Ảnh hưởng SX</label>
                    <select name="impactStatus" class="form-control">
                        <option value="" selected="@(string.IsNullOrEmpty(currentImpact))">-- Tất cả --</option>
                        <option value="NG" selected="@(currentImpact == "NG")">Lịch giao NG</option>
                        <option value="OK" selected="@(currentImpact == "OK")">Lịch giao OK</option>                      
                    </select>
                </div>
                @if (currentTab == "trong")
                {
                    div_layout = "col-md-4";
                    <div class="col-md-1">
                        <label class="form-label fw-semibold">PullIn/PullOut</label>
                        <select name="pullStatus" class="form-control">
                            <option value="" selected="@(string.IsNullOrEmpty(ViewBag.PullStatus as string))">-- Tất cả --</option>
                            <option value="in" selected="@((ViewBag.PullStatus as string) == "in")">PullIn</option>
                            <option value="out" selected="@((ViewBag.PullStatus as string) == "out")">PullOut</option>
                        </select>

                    </div>
                    <div class="col-md-1">
                        <label class="form-label fw-semibold">Mã hàng</label>
                        <select name="mahang" class="form-control">
                            <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Mahang as string))">-- Tất cả --</option>
                            <option value="A" selected="@((ViewBag.Mahang as string) == "A")">Mã A</option>
                            <option value="E" selected="@((ViewBag.Mahang as string) == "E")">Mã E</option>
                        </select>
                    </div>
                }
                
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fa-solid ion-funnel me-1"></i> Lọc</button>                 
                    <a href="@Url.Action("ManageDelivery", new { tab = currentTab })" class="btn btn-secondary ml-1"><i class="fa-solid ion-ios-loop-strong me-1"></i> Refresh</a>
                    <button type="button" class="btn btn-outline-danger ml-1" onclick="exportDataExcel()">
                        <i class="fa-solid fa fa-file-excel me-1"></i> Xuất Excel
                    </button>
                </div>               
                <div class="@div_layout d-flex align-items-end gap-2 justify-content-end">
               
                    <button type="button" class="btn btn-outline-success ml-1" id="btnOpenImportExcel">
                        <i class="fa-solid fa fa-file-excel me-1"></i> Nhập Excel
                    </button>
                    @if (userSection == "3100" || userSection == "1100")
                    {
                        <button type="button" class="btn btn-outline-primary ml-1" id="btnOpenSupplierNg">
                            <i class="fa-solid fa fa-envelope-open-text me-1"></i> List (NG)                           
                            <span class="badge bg-danger rounded-pill ms-1 text-white" id="demncc"></span>                          
                        </button>
                        <button type="button" class="btn btn-outline-info ml-1" id="btnOpenGateRegistration">
                            <i class="fa-solid fa fa-car-side me-1"></i> Đăng ký ra vào cổng
                            <span class="badge bg-danger rounded-pill ms-1 text-white" id="demgate" style="display:none;"></span>
                        </button>
                    }
                </div>
                <div class="col-md-1 mt-2">
                    <label class="form-label fw-semibold">Pic PUR :</label>
                    <select id="damnhiemDropdown" class="form-control" name="picpur" onchange="load_ncc()">
                        <option value="">-- Chọn --</option>
                        <!-- Dữ liệu được đổ từ hàm List_DamnhiemNCC ở câu trước -->
                    </select>
                </div>
                <div class="col-md-2 mt-2">
                    <label class="form-label fw-semibold">Nhà cung cấp :</label>
                    <select id="nccDropdown" class="form-control" disabled name="tenncc">
                        <option value="">-- Vui lòng chọn Đảm nhiệm trước --</option>
                    </select>
                </div>
            </form>
        </div>
    </div>
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0 align-middle" style="font-size:12px">
                    <thead>
                        <tr class="text-center text-uppercase fs-7">
                            @if (userSection == "3100" || userSection == "1100")
                            {
                                <th class="bg-pur"></th>
                            }
                            <th class="bg-white text-dark" hidden>ID</th>
                            <!-- DÙNG HÀM TẠO HEADER CÓ SẮP XẾP -->
                            @RenderSortHeader("Ngayyc", "Ngày YC", "bg-pur text-white")                                                  
                            @RenderSortHeader("SoPO", "Số PO", "bg-pur text-white", "80px")
                            @if (currentTab == "ngoai")
                            {
                                <th class="bg-pur text-white"width="100px">Code Request</th>
                                <th class="bg-pur text-white" width="80px">Good Code</th>
                            }

                            @RenderSortHeader("Tentiengviet", "Tên hàng", "bg-pur text-white", "230px")
                            @RenderSortHeader("Mahang", "Mã hàng", "bg-pur text-white")
                            @RenderSortHeader("Soluong", "SL", "bg-pur text-white")
                            @RenderSortHeader("Donvi", "Đơn vị", "bg-pur text-white")
                            @RenderSortHeader("Nhacungcap", "Tên NCC", "bg-pur text-white", "200px")
                            @RenderSortHeader("ngayguiPO", "Ngày gửi PO", "bg-white", "80px")
                            @RenderSortHeader("PicPur", "Pic Pur", "bg-pur text-white")
                             <th class="bg-pur text-white" width="80px">Người yêu cầu</th>
                            @RenderSortHeader("Ngayycgiao", "Ngày YC giao", "bg-pur text-white")                       
                            @if (userSection == "2500")
                            {
                                <th class="bg-pur text-white" colspan="2" width="120px">Điều chỉnh</th>
                            }
                            else
                            {
                                <th class="bg-pur text-white" width="120px">Điều chỉnh</th>
                            }

                          
                            @RenderSortHeader("ngaynccxngiao", "Ngày GH dự kiến", "bg-white", "80px")                          
                            <th class="bg-white" width="100px">Ngày GH Chính thức</th>
                            <th class="bg-white" width="80px">Giờ chính thức</th>
                            @RenderSortHeader("lichgiao", "Lịch giao (OK/NG)", "bg-white")
                            <th class="bg-white" width="80px">Ảnh hưởng SX</th>
                            @if (currentTab == "trong")
                            {
                                <th style="background-color: white ; color:red">Cảnh báo </th>
                            }                         

                            @if (userSection == "3100" || userSection == "1100")
                            {
                                <th class="bg-white" width="80px">Cửa GH Cổng GH</th>
                                <th class="bg-white">Người nhận</th>
                             @*    <th class="bg-white">Số ĐNTT</th>
                                <th class="bg-white">Số HĐ</th> *@
                                <th class="bg-white" colspan="2">NHẬP DỮ LIỆU</th>
                            }
                            else
                            {
                                <th class="bg-white" width="130px">Nhập Yes/No</th>
                            }

                            <th colspan="2" class="bg-white" w  >Note</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var i = 1;
                            @foreach (var item in Model)
                            {
                                string rowBgClass = "";
                                // 2. Nếu có dữ liệu cả 2 ngày VÀ Ngày YC giao < Ngày NCC xác nhận (Hẹn giao trễ) -> Cảnh báo NG
                            if (item.lichgiao == "NG")
                            {                        
                                rowBgClass = "row-alert-yes"; 
                            }
                            if (item.lichgiao == "OK")
                            {
                                rowBgClass = "row-alert-ok"; 
                            }
                                <tr class="main-row @rowBgClass"
                                    data-id="@item.PO_Detail_Id"
                                    data-send-date="@(string.IsNullOrEmpty(CheckDate(item.ngayguiPO!)) ? "---" : CheckDate(item.ngayguiPO!))"
                                    data-confirm-date="@(string.IsNullOrEmpty(CheckDate(item.ngaynccxngiao!)) ? "---" : CheckDate(item.ngaynccxngiao!))"
                                    data-impact="@(string.IsNullOrEmpty(item.anhuongsx) ? "---" : item.anhuongsx)"
                                    data-luongvekho="@(item.LuongvekhoKhonhap)"
                                    data-ngay-ghchinhthuc="@(string.IsNullOrEmpty(CheckDate(item.Ngay_GHchinhthuc!)) ? "---" : CheckDate(item.Ngay_GHchinhthuc!))"
                                    data-gio-gh="@(string.IsNullOrEmpty(item.Gio_GH) ? "" : item.Gio_GH)"
                                    data-cua-gh="@(string.IsNullOrEmpty(item.Cua_GH) ? "---" : item.Cua_GH)"
                                    data-cong-nhanhang="@(string.IsNullOrEmpty(item.Cong_Nhanhang) ? "---" : item.Cong_Nhanhang)"
                                    data-nguoi-nhanhang="@(string.IsNullOrEmpty(item.Nguoi_Nhanhang) ? "---" : item.Nguoi_Nhanhang)"
                                    data-sl-thucte="@(string.IsNullOrEmpty(item.SL_Thucte) ? "---" : item.SL_Thucte)"
                                    data-so-dntt="@(string.IsNullOrEmpty(item.So_DNTT) ? "---" : item.So_DNTT)"
                                    data-so-hoadon="@(string.IsNullOrEmpty(item.So_hoadon) ? "---" : item.So_hoadon)">
                                    @if (userSection == "3100" || userSection == "1100")
                                    {
                                        @if (item.Soluong > 1 )
                                        {
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-danger w-100 btn-split-po"
                                                        data-po="@item.SoPO"
                                                        data-item-name="@item.Tentiengviet"
                                                        data-item-code="@item.Mahang"
                                                        data-order-qty="@item.Soluong"
                                                        data-po-detail-id="@item.PO_Detail_Id"
                                                        title="Tách dòng PO">
                                                    <i class="fa-solid fa fa-code-branch"></i>
                                                </button>
                                            </td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                    }
                                   

                                    <td class="text-center fw-bold" hidden>@(item.PO_Detail_Id)</td>
                                    <td class="text-center">@CheckDate(item.Ngayyc!)</td>                                  
                                   
                                    <td class="text-center fw-bold text-primary">@item.SoPO</td>
                                    @if (currentTab == "ngoai")
                                    {
                                        <td class="text-center fw-bold text-primary">@item.Code_Request</td>
                                        <td class="text-center fw-bold text-primary text-wrap-col">@item.Good_Code</td>
                                    }
                                    <td class="text-wrap-col">@item.Tentiengviet</td>
                                    <td class="text-center fw-bold">@item.Mahang</td>
                                    <td class="text-end">@item.Soluong.ToString("N0")</td>
                                    <td class="text-center">@item.Donvi</td>
                                    <td class="text-wrap-col">@item.Nhacungcap</td>
                                    <td>@CheckDate(item.ngayguiPO!)</td>
                                    @if (item.khoi == "GA")
                                    {
                                        <td></td>
                                    }
                                    else
                                    {
                                        <td class="text-center fw-bold text-danger">@item.picpur</td>
                                    }
                                    <td class="text-center">@item.DNphathanhpo</td>
                                    <td class="text-center">@CheckDate(item.Ngayycgiao!)</td>
                                    <td class="text-center">@CheckDate(item.Dieuchinhlichgiao!)</td>
                                    @if (userSection == "2500")
                                    {
                                        <td class="text-center text-info cursor-pointer" width="25px" title="Bấm để điều chỉnh lịch giao">
                                            <i class="fa fa-calendar-check btn-adjust-date fs-6 hover-primary"
                                               data-po="@item.SoPO"
                                               data-item-name="@item.Tentiengviet"
                                               data-item-code="@item.Mahang"
                                               data-po-detail-id="@item.PO_Detail_Id"
                                               data-current-date="@CheckDate(item.Dieuchinhlichgiao!)">
                                            </i>
                                        </td>
                                    }
                                    <td>@CheckDate(item.ngaynccxngiao!)</td>
                                    <td>@CheckDate(item.Ngay_GHchinhthuc!)</td>
                                    <td>@item.Gio_GH</td>                               
                                    <!-- Cột Trạng thái & Toggle -->
                                    <td class="text-center cursor-pointer toggle-detail">
                                    @if (currentTab == "trong")
                                        {
                                            if (!string.IsNullOrEmpty(item.lichgiao))
                                            {
                                                string badgeClass = "badge-secondary";
                                                string val = item.lichgiao.ToLower().Trim();
                                                if (val == "ok") badgeClass = "badge-ok";
                                                else if (val.Contains("dưới an toàn")) badgeClass = "badge-warning text-dark";
                                                else if (val.Contains("put in")) badgeClass = "badge-info";
                                                else if (val.Contains("put out")) badgeClass = "bg-pur text-white";
                                                else badgeClass = "badge-ng";
                                                <span class="badge @badgeClass p-2 w-100">
                                                    @item.lichgiao <i class="fa-solid fa fa-caret-down ms-1"></i>
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            if (!string.IsNullOrEmpty(item.lichgiao))
                                            {
                                                <span class="badge @(item.lichgiao == "OK" ? "badge-ok" : "badge-ng") p-2 w-100">
                                                    @item.lichgiao <i class="fa-solid fa fa-caret-down ms-1"></i>
                                                </span>
                                            }
                                        }

                                    </td>
                                   
                                    <td class="text-center fw-bold">
                                    @if (item.anhuongsx == "No")
                                        {
                                            <span class="text-success">@item.anhuongsx</span>
                                        }
                                        else if (item.anhuongsx == "Yes")
                                        {
                                            <span class="text-danger">⚠️@item.anhuongsx</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">---</span>
                                        }

                                    </td>
                                    @if (currentTab == "trong")
                                    {
                                        <td class="text-center align-middle">
                                            @if (!string.IsNullOrEmpty(item.canhbao))
                                            {
                                                string bgClass = "";
                                                string val = item.canhbao.ToUpper();

                                                if (val.Contains("IN"))
                                                {
                                                    bgClass = "bg-warning text-white";
                                                }
                                                else if (val.Contains("OUT"))
                                                {
                                                    bgClass = "bg-info text-white";
                                                }
                                                else if (val.Contains("AT"))
                                                {
                                                    bgClass = "bg-success text-white";
                                                }
                                                <span class="badge @bgClass p-2 w-100">
                                                    @item.canhbao
                                                </span>
                                            }

                                        </td>
