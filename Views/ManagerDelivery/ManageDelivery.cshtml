                        });
                        tbody.innerHTML = html;
                    } else {
                        tbody.innerHTML = `<tr><td colspan="3" class="text-center text-success py-4 fw-bold fs-6"><i class="fa-solid fa-circle-check me-1"></i> Tuyệt vời! Không có mặt hàng nào bị cảnh báo NG.</td></tr>`;
                    }
                } catch (error) {
                    console.error("Lỗi khi tải dữ liệu Modal NCC_NG:", error);
                    tbody.innerHTML = `<tr><td colspan="3" class="text-center text-danger py-4 fw-bold"><i class="fa-solid fa-circle-xmark me-1"></i> Lỗi kết nối. Không thể tải dữ liệu.</td></tr>`;
                }
            });

            // Mở Modal Đăng ký ra vào cổng
            document.getElementById('btnOpenGateRegistration')?.addEventListener('click', async function () {
                bsGateModal.show();
                const tbody = document.getElementById('gateRegistrationTableBody');
                tbody.innerHTML = '<tr><td colspan="4" class="text-center text-info py-4"><i class="fa-solid fa-spinner fa-spin me-2"></i>Đang tải dữ liệu...</td></tr>';

                try {
                    const response = await fetch('/ManagerDelivery/NCC_Giaohang');
                    const data = await response.json();

                    const masterList = data.ncc_ng;
                    const detailList = data.ncc_ng_dt;

                    if (masterList && masterList.length > 0) {
                        let html = '';
                        let gateIdx = 0;

                        masterList.forEach(ncc => {
                            gateIdx++;
                            const details = detailList.filter(d => d.mancc === ncc.mancc && d.tenncc === ncc.tenncc && d.giogiao === ncc.giogiao);

                            html += `
                                <tr class="cursor-pointer bg-white fw-bold text-dark" onclick="toggleSupplierDetail('gateRow_${gateIdx}')" title="Click để xem chi tiết">
                                    <td class="text-center align-middle">${ncc.mancc || 'N/A'}</td>
                                    <td class="align-middle text-primary">
                                        ${ncc.tenncc || 'Không xác định'}
                                        <i class="fa-solid fa fa-caret-down float-end mt-1 text-muted"></i>
                                    </td>
                                    <td class="text-center align-middle text-danger">${ncc.giogiao || 'Chưa có giờ'}</td>
                                    <td class="text-center align-middle">
                                        <span class="badge bg-info rounded-pill fs-7 py-1 px-3 text-white">${details.length} </span>
                                    </td>
                                </tr>
                                <tr id="gateRow_${gateIdx}" class="d-none" style="background-color: #f8fbff;">
                                    <td colspan="4" class="p-3">
                                        <table class="table table-sm table-bordered bg-white mb-0 shadow-sm">
                                            <thead class="bg-secondary text-white text-center">
                                                <tr>
                                                    <th width="120px">Số PO</th>
                                                    <th width="100px">Mã hàng</th>
                                                    <th width="150px">Tên hàng</th>
                                                    <th width="80px">Số lượng</th>
                                                    <th width="80px">Ngày NCC giao</th>
                                                    <th width="120px">Cửa / Cổng giao</th>
                                                    <th width="150px">Người nhận</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                            `;

                            details.forEach(item => {
                                const qtyFormat = parseFloat(item.soluong || 0).toLocaleString();
                                html += `
                                    <tr>
                                        <td class="text-center fw-bold text-dark align-middle">${item.sopo}</td>
                                        <td class="text-center align-middle">${item.mahang}</td>
                                        <td class="align-middle">${item.tenhang}</td>
                                        <td class="text-end align-middle">${qtyFormat} ${item.donvi}</td>
                                        <td class="text-end align-middle"> ${item.ngaygiaochinhthuc}</td>
                                        <td class="text-center align-middle fw-bold text-success">${item.cuagiao} / ${item.congnhanhang}</td>
                                        <td class="text-center align-middle">${item.nguoinhanhang}</td>
                                    </tr>
                                `;

                            });

                            html += `</tbody></table></td></tr>`;
                        });
                        tbody.innerHTML = html;
                    } else {
                        tbody.innerHTML = `<tr><td colspan="4" class="text-center text-muted py-4 fw-bold fs-6"><i class="fa-solid fa-circle-info me-1"></i> Không có dữ liệu đăng ký ra vào cổng.</td></tr>`;
                    }
                } catch (error) {
                    console.error("Lỗi khi tải dữ liệu Modal Gate:", error);
                    tbody.innerHTML = `<tr><td colspan="4" class="text-center text-danger py-4 fw-bold"><i class="fa-solid fa-circle-xmark me-1"></i> Lỗi kết nối. Không thể tải dữ liệu.</td></tr>`;
                }
            });

            // Khởi chạy đếm số lượng
            getDemNccCount();
            getDemGateCount();
        });

        // Hàm Đếm Số NCC
        async function getDemNccCount() {
            const badgeDemNcc = document.getElementById('demncc');
            if (!badgeDemNcc) return;
            try {
                const response = await fetch('/ManagerDelivery/NCC_NG');
                const data = await response.json();
                if (data && data.ncc_ng) {
                    const count = data.ncc_ng.length;
                    badgeDemNcc.textContent = count;
                    badgeDemNcc.style.display = (count === 0) ? 'none' : 'inline-block';
                } else {
                    badgeDemNcc.textContent = "0";
                    badgeDemNcc.style.display = 'none';
                }
            } catch (error) {
                console.error("Lỗi khi tải số lượng NCC_NG:", error);
                badgeDemNcc.textContent = "!";
            }
        }

        // Hàm Đếm Số Gate
        async function getDemGateCount() {
            const badgeDemGate = document.getElementById('demgate');
            if (!badgeDemGate) return;
            try {
                const response = await fetch('/ManagerDelivery/NCC_Giaohang');
                const data = await response.json();
                if (data && data.ncc_ng) {
                    const count = data.ncc_ng.length;
                    badgeDemGate.textContent = count;
                    badgeDemGate.style.display = (count === 0) ? 'none' : 'inline-block';
                } else {
                    badgeDemGate.textContent = "0";
                    badgeDemGate.style.display = 'none';
                }
            } catch (error) {
                console.error("Lỗi khi tải số lượng Đăng ký ra vào cổng:", error);
                badgeDemGate.style.display = 'inline-block';
                badgeDemGate.textContent = "!";
            }
        }

        // Hàm xử lý khi bấm vào Header để Sort
        function sortData(column) {
            const currentSortCol = document.getElementById('sortColumn').value;
            let currentSortDir = document.getElementById('sortDirection').value;

            // Nếu bấm lại vào cột đang được sort, đổi chiều (asc -> desc -> asc)
            if (currentSortCol === column) {
                currentSortDir = (currentSortDir === 'asc') ? 'desc' : 'asc';
            } else {
                // Nếu bấm sang cột mới, mặc định là chiều tăng dần (asc)
                currentSortDir = 'asc';
            }

            // Gán giá trị vào form ẩn
            document.getElementById('sortColumn').value = column;
            document.getElementById('sortDirection').value = currentSortDir;

            // Submit form (gọi lại request về server để lấy data mới)
            document.getElementById('filterForm').submit();
        }

                // Hàm tự động cố định cột từ trái sang phải đến hết cột "Tên NCC"
        function applyStickyColumns() {
            const table = document.querySelector('.table-responsive table');
            if (!table) return;

            const theadTr = table.querySelector('thead tr');
            if (!theadTr) return;
            const ths = Array.from(theadTr.children);

            // 1. Tìm vị trí (index) của cột "Tên NCC"
            let targetIndex = -1;
            for (let i = 0; i < ths.length; i++) {
                if (ths[i].textContent.trim().includes('Tên NCC')) {
                    targetIndex = i;
                    break;
                }
            }

            if (targetIndex === -1) return; // Không tìm thấy cột

            let currentLeft = 0;
            const leftOffsets = [];

            // 2. Tính toán độ rộng cộng dồn (offset left) của từng cột
            for (let i = 0; i <= targetIndex; i++) {
                leftOffsets.push(currentLeft);
                // Lấy chiều rộng thực tế (kể cả với cột có thuộc tính hidden sẽ = 0)
                const w = ths[i].getBoundingClientRect().width;
                currentLeft += w;
            }

            // 3. Set sticky cho Thead (Th)
            for (let i = 0; i <= targetIndex; i++) {
                ths[i].style.position = 'sticky';
                ths[i].style.left = leftOffsets[i] + 'px';
                ths[i].style.zIndex = '4'; // Đảm bảo nổi lên trên
                if (i === targetIndex) {
                    ths[i].classList.add('sticky-boundary');
                }
            }

            // 4. Set sticky cho Tbody (Td)
            const tbodyTrs = table.querySelectorAll('tbody tr:not(.detail-row)');
            tbodyTrs.forEach(tr => {
                const tds = tr.children;
                // Bỏ qua nếu là dòng "Không có dữ liệu"
                if (tds.length === 1 && tds[0].colSpan > 1) return;

                for (let i = 0; i <= targetIndex; i++) {
                    if (tds[i]) {
                        tds[i].classList.add('sticky-td');
                        tds[i].style.position = 'sticky';
                        tds[i].style.left = leftOffsets[i] + 'px';
                        tds[i].style.zIndex = '2'; // Nổi lên trên dữ liệu cuộn, nhưng dưới thead
                        if (i === targetIndex) {
                            tds[i].classList.add('sticky-boundary');
                        }
                    }
                }
            });
        }
        function load_ncc(){
            let damnhiemDropdown = document.getElementById('damnhiemDropdown').value;
            let nccDropdown = document.getElementById('nccDropdown');

                nccDropdown.disabled = true;

                // Nối tham số vào URL query string
                let url = `/ManagerDelivery/List_NCCtheodamnhiem?tendamnhiem=${encodeURIComponent(damnhiemDropdown)}`;

                fetch(url)
                    .then(response => response.json())
                    .then(data => {
                        nccDropdown.innerHTML = '<option value="">-- Chọn Nhà cung cấp --</option>';

                        data.forEach(item => {
                            let option = document.createElement('option');
                            option.value = item;
                            option.text = item;
                            nccDropdown.appendChild(option);
                        });

                        nccDropdown.disabled = false;
                    })
                    .catch(error => {
                        console.error('Lỗi:', error);
                        nccDropdown.innerHTML = '<option value="">Lỗi tải dữ liệu</option>';
                    });
            }

        
    </script>
