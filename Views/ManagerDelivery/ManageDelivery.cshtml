                        }
                        return;
                    }

                    // --- B. XỬ LÝ CLICK NÚT DỰ KIẾN ---
                    const btnUpdate = e.target.closest('.btn-update-po');
                    if (btnUpdate) {
                        e.preventDefault();
                        document.getElementById('modalPoNumber').textContent = btnUpdate.getAttribute('data-po');
                        document.getElementById('modalItemName').textContent = btnUpdate.getAttribute('data-item-name');
                        document.getElementById('modalItemCode').textContent = btnUpdate.getAttribute('data-item-code');
                        document.getElementById('modalReqDate').textContent = btnUpdate.getAttribute('data-req-date');
                        document.getElementById('modalPoDetailId').textContent = btnUpdate.getAttribute('data-po-detail-id');

                        const sendDate = btnUpdate.getAttribute('data-send-date');
                        const confirmDate = btnUpdate.getAttribute('data-confirm-date');

                        document.getElementById('modalSendPoDate').value = (sendDate && sendDate !== "---") ? sendDate : '';
                        document.getElementById('modalConfirmDate').value = (confirmDate && confirmDate !== "---") ? confirmDate : '';

                        bsEstModal.show();
