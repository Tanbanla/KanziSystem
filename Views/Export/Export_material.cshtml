@{
    ViewData["Title"] = "Export";
}
<div class="card">
    <div class="card-header">Xuất dữ liệu Excel</div>
    <div class="card-body">
        <p>Nhấn vào nút dưới đây để tải danh sách hiện tại.</p>
        <a asp-controller="Export" asp-action="Export" class="btn btn-success">
            <i class="fas fa-file-excel"></i> Tải xuống Excel (.xlsx)
        </a>
    </div>
</div>
<div class="card mt-4">
    <div class="card-header">Nhập dữ liệu từ Excel</div>
    <div class="card-body">
        <form asp-controller="Export" asp-action="Import" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="fileExcel" class="form-label">Chọn file Excel mẫu (.xlsx)</label>
                <input class="form-control" type="file" id="fileExcel" name="file" accept=".xlsx, .xls">
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-upload"></i> Upload và Xử lý
            </button>
        </form>
    </div>
</div>