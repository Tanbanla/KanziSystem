<form class="modal-part" id="modal-vender-add">
    <div class="row">
        <div class="form-group col-6">
            <label for="employee_code">Mã nhà cung cấp</label>
            <input id="ed_employee_code" type="text" class="form-control" name="frist_name" autofocus>
        </div>
        <div class="form-group col-6">
            <label for="employee_name">Tên nhà cung cấp</label>
            <input id="ed_employee_name" type="text" class="form-control" name="last_name">
        </div>
        <div class="form-group col-6">
            <label for="employee_adid">Địa chỉ</label>
            <input id="ed_employee_adid" type="text" class="form-control" name="frist_name" autofocus>
        </div>
        <div class="form-group col-3">
            <label for="employee_mail">Số điện thoại :</label>
            <input id="ed_employee_mail" type="number" class="form-control" name="last_name">
        </div>
        <div class="form-group col-3">
            <label for="employee_mail">Fax :</label>
            <input id="ed_employee_mail" type="number" class="form-control" name="last_name">
        </div>
    </div>
    <div class="row">
        <div class="form-group col-3">
            <label>Khu vực</label>
            <input type="text" class="form-control" id="ed_employee_dept" />          
        </div>
        <div class="form-group col-6">
            <label>Ghi chú</label>
            <input type="text"  class="form-control" id="ed_employee_role" />           
        </div>
        <div class="form-group col-3">
            <label>Khai hải quan</label>
            <input type="text" class="form-control" id="ed_employee_dept" />
            <datalist hidden>
                <option>NEED</option>
                <option>NONEED</option>
            </datalist>
        </div>
    </div>
</form>

<form class="modal-part" id="modal-wh-add">
    <div class="row">
        <div class="form-group col-6">
            <label>Nhà máy</label>
            <select class="form-control" id="CHR_FACTORY">
                <option>F1</option>
                <option>F2</option>
                <option>F3</option>
                <option>F4</option>
                <option>F5</option>
                <option>TTF</option>
            </select>           
        </div>
        <div class="form-group col-6">
            <label>Phòng ban sử dụng</label>          
            <select id="CHR_DEPT_USE" class="form-control"></select>
        </div>
        <div class="form-group col-6">
            <label>Tên Kho</label>
            <input id="CHR_WAREHOUSE" type="text" class="form-control" required>
        </div>
        <div class="form-group col-6">
            <label>Ghi chú</label>
            <input id="CHR_NOTE" type="text" class="form-control" required>
        </div>
        <div class="form-group col-6">
            <button class="btn btn-outline-success" onclick="add_wh()">+ Thêm</button>
        </div>
      
    </div>
  
</form>