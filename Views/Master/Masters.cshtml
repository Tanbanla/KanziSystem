@{
    ViewData["Title"] = "Warehouse";
}
<style>
    .card .card-header {
        min-height: 0px;
    }

    .card .card-header .form-control {
        height: 38px;
        font-size: 13px;
        border-radius: 0px;
    }

    .modal-dialog{
        max-width : 800px;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body p-0">
                @* Toolbar (merged) - keep IDs/classes so existing JS continues to work *@
                <div class="input-group mb-2" style="padding-left: 0px;">
                    <div class="col-4 input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text"><i class="ion ion-ios-paper"></i></div>
                        </div>
                        <input type="text" class="form-control" id="vd_name" placeholder="Phòng ban" aria-label="Phòng ban" />
                    </div>

                    <div class="col-2 input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text"><i class="ion ion-home"></i></div>
                        </div>
                        <select class="form-control" aria-label="Nhà máy">
                            <option value="">ALL</option>
                            <option value="F1">F1</option>
                            <option value="F2">F2</option>
                            <option value="F3">F3</option>
                            <option value="F4">F4</option>
                            <option value="F5">F5</option>
                            <option value="TTF">TTF</option>
                        </select>
                    </div>

                    <button type="button" class="btn btn-primary" style="border-radius:0; height:42px; margin-left:20px" onclick="_load_vender()" title="Tìm kiếm">
                        <i class="ion ion-ios-search-strong"></i>
                    </button>

                    <button type="button" class="btn btn-success" style="border-radius:0; height:42px; margin-left:20px" title="Thêm mới" id="modal-12" onclick="load_section()">+ Thêm</button>
                </div>

                @* Table card (merged) - preserve IDs so JS populates rows and paging *@
                <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                    <div class="table-responsive">
                        <table class="table table-bordered" aria-label="Warehouse table">
                            <thead class="bg-primary">
                                <tr>
                                    <th scope="col">Kho</th>
                                    <th scope="col">Phòng ban sử dụng</th>
                                    <th scope="col">Nhà máy</th>
                                    <th scope="col">Thời gian cập nhật</th>
                                    <th scope="col">Người cập nhật</th>
                                    <th scope="col" colspan="2"></th>
                                </tr>
                            </thead>
                            <tbody id="show_wh">
                            </tbody>
                        </table>
                    </div>

                    @* Keep pagination container id so existing JS can render controls *@
                    <ul class="pagination" id="pagination-controls"></ul>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_modal", "Master")
<script src="~/scripts/wh_process_2.js"></script>
<script>
    window.onload = function(){
        _load_warehouse();
    }
</script>