@{
    ViewData["Title"] = "Material";
}
<style>
    .card .card-header {
        min-height: 0px;
    }
    .card .card-header .form-control {
        height: 42px;
        font-size: 13px;
        border-radius: 0px;
    }
</style>

<div class="col-12 col-sm-12 col-lg-12"> 
    <ul class="nav nav-pills" id="myTab3" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" id="home-tab3" data-toggle="tab" href="#home3" role="tab" aria-controls="home" aria-selected="true"><i class="ion-ios-home"></i> Master</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="profile-tab3" data-toggle="tab" href="#profile3" role="tab" aria-controls="profile" aria-selected="false"><i class="ion-plus"></i> Tạo mã</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="profile-tab4" data-toggle="tab" href="#profile4" role="tab" aria-controls="profile4" aria-selected="false"><i class="ion-checkmark-round"></i> Phê duyệt mã</a>
        </li>
    </ul>
    <div class="tab-content" id="myTabContent2">
        @*Master material*@
        <div class="tab-pane fade show active" id="home3" role="tabpanel" aria-labelledby="home-tab3">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="form-group" style="margin-bottom:0px ; margin-top:10px">
                                <div class="input-group mb-2">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text"><i class="ion ion-ios-barcode"></i></div>
                                    </div>
                                    <input type="text" class="form-control" id="Material_Code" placeholder="Material_Code">
                                </div>
                            </div>
                            <div class="form-group" style="margin : 10px 0 0 20px">
                                <div class="input-group mb-2">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text"><i class="ion ion-ios-paper"></i></div>
                                    </div>
                                    <input type="text" class="form-control" id="Material_Name_VN" placeholder="Material_Name_VN">
                                </div>
                            </div>
                            <div class="form-group" style="margin : 10px 0 0 20px">
                                <div class="input-group mb-2">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text"><i class="ion ion-key"></i></div>
                                    </div>
                                    <input type="text" class="form-control" id="Account_Name_VN" placeholder="Account_Name_VN">
                                </div>
                            </div>
                            <div class="form-group" style="margin : 10px 0 0 20px">
                                <div class="input-group mb-1">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text">Chọn khối</div>
                                    </div>
                                    <select class="form-control" id="lst_gc" onchange="_load_material()">
                                        <option value=""></option>
                                        <option value="PROD">PROD</option>
                                        <option value="GA">GA</option>
                                        <option value="IT">IT</option>
                                        <option value="PUR">PUR</option>
                                    </select>
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary" style="border-radius :5px; height:42px; margin-left:20px" onclick="_load_material()"><i class="ion ion-ios-search-strong"></i></button>
                            <button type="button" class="btn btn-success" style="border-radius :5px; height:42px; margin-left:30%"><i class="fa fa-file-excel"></i> Export</button>
                        </div>
                        <div>
                        <div class="card-body p-0">
                            <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                                <table class="table table-bordered">
                                    <thead class="bg-primary">
                                        <tr>
                                            <th>Material_Code</th>
                                            <th>Material_Name_VN</th>
                                            <th>Material_Name_EN</th>
                                            <th>Material_Name_JP</th>
                                            <th>Account_Code</th>
                                            <th>Account_Name_VN</th>
                                            <th>Account_Name_EN</th>
                                            <th>Unit</th>
                                            <th>Unit_Note </th>
                                            <th>Price </th>
                                            <th>Currency </th>
                                            <th>Group_Code </th>
                                            <th>GoodKind </th>
                                            <th colspan="2"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="show_material">
                                    </tbody>
                                </table>
                                <ul class="pagination" id="pagination-controls"></ul>
                            </div>
                        </div>
                    </div>
                </div>              
            </div>
            </div>
        </div>
        <div class="tab-pane fade" id="profile3" role="tabpanel" aria-labelledby="profile-tab3">
         
            <div class="col-lg-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Tạo mã nguyên vật liệu</h5>
                        <small class="text-white-50">Please fill required fields</small>
                    </div>
                    <div class="card-body">
                        <form id="materialForm" class="needs-validation" novalidate>
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label for="MaterialCode" class="font-weight-bold">Material Code <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="MaterialCode" name="MaterialCode" placeholder="e.g. MAT-0001" required aria-required="true">
                                    <div class="invalid-feedback">Material Code is required.</div>
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="MaterialNameVN" class="font-weight-bold">Material Name (VN) <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="MaterialNameVN" name="MaterialNameVN" placeholder="Tên nguyên vật liệu" required>
                                    <div class="invalid-feedback">Vietnamese name is required.</div>
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label for="MaterialNameEN">Material Name (EN)</label>
                                    <input type="text" class="form-control" id="MaterialNameEN" name="MaterialNameEN" placeholder="English name">
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="MaterialNameJP">Material Name (JP)</label>
                                    <input type="text" class="form-control" id="MaterialNameJP" name="MaterialNameJP" placeholder="Japanese name">
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label for="AccountCode">Account Code</label>
                                    <input type="text" class="form-control" id="AccountCode" name="AccountCode" placeholder="Account code">
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="AccountNameEN">Account Name (EN)</label>
                                    <input type="text" class="form-control" id="AccountNameEN" name="AccountNameEN" placeholder="Account name in English">
                                </div>
                            </div>

                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label for="AccountNameVN">Account Name (VN)</label>
                                    <input type="text" class="form-control" id="AccountNameVN" name="AccountNameVN" placeholder="Account name in Vietnamese">
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="Unit">Unit</label>
                                    <input type="text" class="form-control" id="Unit" name="Unit" placeholder="e.g. kg, pcs">
                                </div>
                            </div>

                            <div class="form-row align-items-end">
                                <div class="form-group col-md-3">
                                    <label for="UnitNote">Unit Note</label>
                                    <input type="text" class="form-control" id="UnitNote" name="UnitNote" placeholder="Optional note">
                                </div>

                                <div class="form-group col-md-3">
                                    <label for="Price">Price</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" id="Price" name="Price" placeholder="0.00" step="0.01" min="0">
                                        <div class="input-group-append">
                                            <span class="input-group-text">VND</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group col-md-2">
                                    <label for="Currency">Currency</label>
                                    <select id="Currency" name="Currency" class="form-control">
                                        <option value="VND" selected>VND</option>
                                        <option value="USD">USD</option>
                                        <option value="EUR">EUR</option>
                                    </select>
                                </div>

                                <div class="form-group col-md-2">
                                    <label for="GroupCode">Group Code</label>
                                    <select id="GroupCode" name="GroupCode" class="form-control">
                                        <option value="">-- Select --</option>
                                        <option value="GRP1">GRP1</option>
                                        <option value="GRP2">GRP2</option>
                                    </select>
                                </div>

                                <div class="form-group col-md-2">
                                    <label for="GoodKind">Good Kind</label>
                                    <input type="text" class="form-control" id="GoodKind" name="GoodKind" placeholder="Type">
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mt-3">
                                <button type="button" class="btn btn-secondary mr-2" onclick="history.back()">Cancel</button>
                                <button type="submit" id="submitBtn" class="btn btn-primary">
                                    <span id="btnText">Submit</span>
                                    <span id="btnSpinner" class="spinner-border spinner-border-sm ml-2 d-none" role="status" aria-hidden="true"></span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
                <small class="form-text text-muted mt-2">Fields marked with <span class="text-danger">*</span> are required.</small>
            </div>

          
        </div>
        <div class="tab-pane fade" id="profile4" role="tabpanel" aria-labelledby="profile-tab4">
          
        </div>
    </div>
</div>
<script src="~/scripts/material_process.js"></script>
<script>
    window.onload = function(){
        _load_material();
    }
     
</script>
<script>
    (function () {
        'use strict';
        var form = document.getElementById('materialForm');
        var submitBtn = document.getElementById('submitBtn');
        var btnText = document.getElementById('btnText');
        var btnSpinner = document.getElementById('btnSpinner');

        form.addEventListener('submit', function (event) {
            if (!form.checkValidity()) {
                event.preventDefault();
                event.stopPropagation();
            } else {
                // Show spinner and let form submit (or perform AJAX here)
                btnText.textContent = 'Saving...';
                btnSpinner.classList.remove('d-none');
                // If you want to prevent real submit for demo, uncomment:
                // event.preventDefault();
            }
            form.classList.add('was-validated');
        }, false);
    })();
</script>