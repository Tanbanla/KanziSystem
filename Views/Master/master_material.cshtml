@{
    ViewData["Title"] = "Material";
}
<style>
    .card .card-header {
        min-height: 0px;
    }
    .card .card-header .form-control {
        height: 42px;
        font-size: 13px;
        border-radius: 0px;
    }
</style>

<div class="col-12 col-sm-12 col-lg-12"> 
    <ul class="nav nav-pills" id="myTab3" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" id="home-tab3" data-toggle="tab" href="#home3" role="tab" aria-controls="home" aria-selected="true"><i class="ion-ios-home"></i> Master</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="profile-tab3" data-toggle="tab" href="#profile3" role="tab" aria-controls="profile" aria-selected="false"><i class="ion-plus"></i> Tạo mã</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" id="profile-tab4" data-toggle="tab" href="#profile4" role="tab" aria-controls="profile4" aria-selected="false"><i class="ion-checkmark-round"></i> Phê duyệt mã</a>
        </li>
    </ul>
    <div class="tab-content" id="myTabContent2">
        @*Master material*@
        <div class="tab-pane fade show active" id="home3" role="tabpanel" aria-labelledby="home-tab3">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="form-group" style="margin-bottom:0px ; margin-top:10px">
                                <div class="input-group mb-2">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text"><i class="ion ion-ios-barcode"></i></div>
                                    </div>
                                    <input type="text" class="form-control" id="Material_Code" placeholder="Material_Code">
                                </div>
                            </div>
                            <div class="form-group" style="margin : 10px 0 0 20px">
                                <div class="input-group mb-2">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text"><i class="ion ion-ios-paper"></i></div>
                                    </div>
                                    <input type="text" class="form-control" id="Material_Name_VN" placeholder="Material_Name_VN">
                                </div>
                            </div>
                            <div class="form-group" style="margin : 10px 0 0 20px">
                                <div class="input-group mb-2">
                                    <div class="input-group-prepend">
                                        <div class="input-group-text"><i class="ion ion-key"></i></div>
                                    </div>
                                    <input type="text" class="form-control" id="Account_Name_VN" placeholder="Account_Name_VN">
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary" style="border-radius :5px; height:42px; margin-left:20px" onclick="_load_material()"><i class="ion ion-ios-search-strong"></i></button>
                            <button type="button" class="btn btn-success" style="border-radius :5px; height:42px; margin-left:50%"><i class="fa fa-file-excel"></i> Export</button>
                        </div>
                        <div>
                        <div class="card-body p-0">
                            <div class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                                <table class="table table-bordered">
                                    <thead class="bg-primary">
                                        <tr>
                                            <th>Material_Code</th>
                                            <th>Material_Name_VN</th>
                                            <th>Material_Name_EN</th>
                                            <th>Material_Name_JP</th>
                                            <th>Account_Code</th>
                                            <th>Account_Name_VN</th>
                                            <th>Account_Name_EN</th>
                                            <th>Unit</th>
                                            <th>Unit_Note </th>
                                            <th>Price </th>
                                            <th>Currency </th>
                                            <th>Group_Code </th>
                                            <th>GoodKind </th>
                                            <th colspan="2"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="show_material">
                                    </tbody>
                                </table>
                                <ul class="pagination" id="pagination-controls"></ul>
                            </div>
                        </div>
                    </div>
                </div>
               
            </div>
            </div>
        </div>
        <div class="tab-pane fade" id="profile3" role="tabpanel" aria-labelledby="profile-tab3">
            <div class="row">
                <div class="col-9">
                    <div class="card">
                        <div class="card-header bg-primary">
                            <h4 class="text-white">Tạo mã nguyên vật liệu thủ công</h4>
                        </div>
                        <div class="card-body">
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label for="inputEmail4">Material_Code</label>
                                    <input type="email" class="form-control" id="inputEmail4">
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="inputPassword4">Material_Name_VN</label>
                                    <input type="text" class="form-control" id="inputPassword4">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label for="inputEmail4">Material_Name_EN</label>
                                    <input type="email" class="form-control" id="inputEmail4">
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="inputPassword4">Material_Name_JP</label>
                                    <input type="text" class="form-control" id="inputPassword4">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label for="inputEmail4">Account_Code</label>
                                    <input type="email" class="form-control" id="inputEmail4">
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="inputPassword4">Account_Name_EN</label>
                                    <input type="text" class="form-control" id="inputPassword4">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label for="inputEmail4">Account_Name_VN</label>
                                    <input type="email" class="form-control" id="inputEmail4">
                                </div>
                                <div class="form-group col-md-6">
                                    <label for="inputPassword4">Unit</label>
                                    <input type="text" class="form-control" id="inputPassword4">
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-3">
                                    <label for="inputEmail4">Unit_Note</label>
                                    <input type="email" class="form-control" id="inputEmail4">
                                </div>
                                <div class="form-group col-md-2">
                                    <label for="inputPassword4">Price</label> <code style="float:right"><b>VND</b></code>
                                    <input type="text" class="form-control" id="inputPassword4">
                                </div>
                                <div class="form-group col-md-2">
                                    <label for="inputAddress">Currency</label>
                                    <input type="number" class="form-control" id="inputAddress">
                                </div>
                                <div class="form-group col-md-3">
                                    <label for="inputAddress2">Group_Code</label>
                                    <input type="number" class="form-control" id="inputAddress">
                                </div>
                                <div class="form-group col-md-2">
                                    <label for="inputCity">GoodKind</label>
                                    <input type="text" class="form-control" id="inputCity">
                                </div>
                            </div>

                            <button class="btn btn-primary">Submit</button>
                        </div>

                    </div>
                </div>
                <div class="col-3">
                    <div class="card">
                        <div class="card-header bg-primary">
                            <h4 class="text-white">Tạo mã nguyên vật liệu file excel</h4>
                        </div>
                        <div class="card-body">
                            <i class="text-danger"> Tải file excel mẫu : <a href="">>> LINK << </a> </i>
                            <div class="form-row pt-3">
                                <div class="form-group col-md-12">
                                    <label for="inputEmail4">Chọn file upload :</label>
                                    <input type="file" class="form-control" id="inputEmail4">
                                </div>

                              
                                <button class="btn btn-success"><i class="fa fa-upload"></i> Upload</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tab-pane fade" id="profile4" role="tabpanel" aria-labelledby="profile-tab4">
          
        </div>
    </div>
</div>
<script src="~/scripts/material_process.js"></script>
<script>
    window.onload = function(){
        _load_material();
    }
</script>