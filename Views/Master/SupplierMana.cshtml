@{
    ViewData["Title"] = "Quản lý nhà cung cấp";
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
    <link rel="stylesheet" href="~/css/supplierMana.css" />
</head>
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h5 class="mb-3">Quản lý nhà cung cấp</h5>
        </div>
        <div class="btn-toolbar" role="toolbar" aria-label="Toolbar">
            <div class="btn-group me-2 mb-2" role="group">
                <button type="button" class="btn btn-outline-success" id="btnExportExcel"><i class="fas fa-file-excel"></i> Download Excel</button>
                <button type="button" class="btn btn-outline-primary" id="btnImportExcel"><i class="fas fa-upload"></i> Upload Excel</button>
            </div>
        </div>
    </div>
    <!-- Search Bar -->
    <form id="supplier-search-form" class="row g-2 align-items-end mb-3">
        <div class="col-md-3">
            <label for="searchMa" class="form-label">Mã</label>
            <input type="text" id="searchMa" name="ma" class="form-control" placeholder="Nhập mã nhà cung cấp">
        </div>
        <div class="col-md-4">
            <label for="searchTen" class="form-label">Tên nhà cung cấp</label>
            <input type="text" id="searchTen" name="ten" class="form-control" placeholder="Nhập tên nhà cung cấp">
        </div>
        <div class="col-md-5 d-flex gap-3 align-items-center">
            <button type="button" id="btnReset" class="btn btn-secondary"><i class="fas fa-undo"></i> Làm mới</button>
            <div style="width: 6px"></div>
            <button type="button" id="btnSearch" class="btn btn-primary"><i class="fas fa-search"></i> Tìm kiếm</button>
            <div style="width: 6px"></div>
            <button type="button" id="btnAddSupplier" class="btn btn-success"><i class="fas fa-plus"></i> Thêm</button>
        </div>
    </form>

    <!-- Suppliers Grid -->
    <div class="table-responsive border rounded" style="max-height:550px;height:550px;overflow:auto;">
        <table class="table table-sm table-hover table-bordered align-middle" id="suppliersTable">
            <thead class="table-light">
                <tr class="text-center align-middle">
                    <th style="width: 80px">ID</th>
                    <th style="width: 140px">Mã</th>
                    <th>Tên</th>
                    <th>Địa chỉ</th>
                    <th>SĐT</th>
                    <th>Khu vực</th>
                    <th>Nhóm</th>
                    <th style="width: 220px" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
               
            </tbody>
        </table>
    </div>
    <div class="p-2 d-flex justify-content-between align-items-center">
        <div>
            <label class="me-2">Số hàng mỗi trang:</label>
            <select id="pageSizeSelect" class="form-select d-inline-block" style="width:80px">
                <option value="10">10</option>
                <option value="20" selected>20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-primary" id="btnPrevPage">&laquo; Trước</button>
            <span id="pageInfo" class="mx-2">Trang 1</span>
            <button class="btn btn-sm btn-outline-primary" id="btnNextPage">Tiếp &raquo;</button>
        </div>
    </div>
</div>
<!-- Modals -->
<div class="cm-dialog-overlay" id="supplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Nhà cung cấp</h6>
                <button type="button" class="btn btn-sm btn-outline-danger border-0" title="Đóng" id="btnCloseEdit_1" role="button" data-bs-dismiss="modal" aria-label="Đóng">
                    <i class="fas fa-times fa-sm"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="supplierForm">
                    <input type="hidden" id="nccId" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Mã</label>
                            <input id="ma" class="form-control" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Tên</label>
                            <input id="ten" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Địa chỉ</label>
                            <input id="diachi" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">SĐT</label>
                            <input id="sodienthoai" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Fax</label>
                            <input id="fax" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Khu vực</label>
                            <input id="khuvuc" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Nhóm</label>
                            <input id="nhom" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Mã số thuế</label>
                            <input id="masothue" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">NV Kinh doanh</label>
                            <input id="nhanvienkinhdoand" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">NV Kế toán</label>
                            <input id="nhanvienketoan" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Ghi chú</label>
                            <input id="ghichu" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Hình thức mở TK</label>
                            <input id="hinhthucmotk" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Điều kiện thanh toán</label>
                            <input id="dieukienthanhtoan" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label w-100">Thủ tục mở hải quan</label>
                            <select id="thuTucMoHaiQuan" class="form-select d-inline-block" style="width:100px; height: 40px;">
                                <option value="NONEED" selected>Không cần</option>
                                <option value="NEED">Cần</option>
                                <option value="CONFIRM">Xác nhận</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btnCloseEdit_2" role="button" data-bs-dismiss="modal" aria-label="Đóng">Đóng</button>
                <button type="button" id="btnSaveSupplier" class="btn btn-primary">Lưu</button>
            </div>
        </div>
    </div>
</div>
<!-- Dialogs mặt hàng nhà cung cấp -->
<div class="modal fade" id="itemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center w-100 justify-content-between">
                    <div>
                        <h6 class="modal-title">Mặt hàng nhà cung cấp</h6>
                        <small class="text-muted d-block">NCC: <span id="selectedNccCode"></span> - <span id="selectedNccName"></span></small>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-danger border-0" title="Đóng" id="btnCloseItem_top" role="button" data-bs-dismiss="modal" aria-label="Đóng">
                            <i class="fas fa-times fa-sm"></i>
                        </button>
                    </div>
                </div>
            </div>
            @* style="max-height:300px;overflow:auto;" *@
            <div class="modal-body">
                <div style="margin-bottom: 12px;">
                    <button type="button" class="btn btn-outline-success btn-sm" id="btnImportItemsExcel"><i class="fas fa-file-excel"></i> Nhập Excel</button>
                    <input type="file" id="itemsExcelFileInput" accept=".xlsx,.xls" style="display:none" />
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnExportTemplateExcel"><i class="fas fa-download"></i> File mẫu</button>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <div class="table-responsive border rounded" >
                            <table class="table table-sm table-hover table-bordered align-middle" id="supplierItemsTable" style="max-height:300px;overflow:auto;">
                                <thead class="table-light">
                                    <tr class="text-center align-middle">
                                        <th style="width:140px">Chủng loại</th>
                                        <th style="min-width:100px">Made In</th>
                                        <th style="min-width:100px">Status</th>
                                        <th style="min-width:100px">PIC</th>
                                        <th style="min-width:100px">Mail</th>
                                        <th style="width:120px" class="text-end">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-start">
                <button type="button" class="btn btn-secondary" id="btnCloseItem_bottom" role="button" data-bs-dismiss="modal" aria-label="Đóng">Đóng</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnSaveItemHeader" style="min-height:37px; min-width: 55px;"> Lưu</button>
                <small class="text-muted ms-2">Chỉ cần nhập dữ liệu ở ô đầu tiên (Mã hàng). Các ô khác có thể bỏ trống.</small>
            </div>
        </div>
    </div>
</div>
<!-- Dialogs reused from Quote -->
<div id="cmDialogOverlay" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmDialogTitle">
        <div class="cm-dialog-header">
            <h6 id="cmDialogTitle" class="cm-dialog-title">Thông báo</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="close" aria-label="Đóng">✕</button>
        </div>
        <div id="cmDialogBody" class="cm-dialog-body"></div>
        <div id="cmDialogFooter" class="cm-dialog-footer"></div>
    </div>
    <div class="cm-dialog-backdrop" data-cm-action="overlay"></div>
</div>
<!-- Custom confirm dialog -->
<div id="cmConfirmDialog" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmConfirmTitle">
        <div class="cm-dialog-header">
            <h6 id="cmConfirmTitle" class="cm-dialog-title cm-confirm-title">Xác nhận</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="cancel" aria-label="Đóng">✕</button>
        </div>
        <div class="cm-dialog-body cm-confirm-body">Bạn có chắc chắn?</div>
        <div class="cm-dialog-footer">
            <button type="button" class="cm-btn cm-btn-primary" data-cm-action="ok">Đồng ý</button>
        </div>
    </div>
</div>
<!-- Import Excel input (hidden) -->
<input type="file" id="excelFileInput" accept=".xlsx,.xls" style="display:none" />

<script src="~/js/SupplierMana.js"></script>
