@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    var listSteps = Model.baoGiaSteps;
    var listSections = Model.NhomViTris;
}
<head>
    <link rel="stylesheet" href="~/css/Quote.css" />
</head>
<div class="container-fluid mt-3">
    <h3>@ViewData["Title"]</h3>
    <!-- Global loading overlay -->
    <div id="globalLoading" aria-hidden="true">
        <div class="loader-box">
            <div class="spinner" aria-hidden="true"></div>
            <div class="loader-msg">Đang xử lý...</div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">@Localizer["SearchAndAddTitle"]</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label">@Localizer["SectionName"]</label>
                            <select id="searchSection" name="searchSection" class="form-select searchSection searchable-select">
                                <option value="">@Localizer["All"]</option>
                                @foreach (var item in listSections)
                                {
                                     <option value="@item.Mahangmuctheovitri">@item.Mahangmuctheovitri - @item.Tenhangmuctheovitri</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">@Localizer["Step"]</label>
                            <select id="searchStep" class="form-control form-control-sm">
                                <option value="">@Localizer["All"]</option>
                                @foreach (var item in listSteps)
                                {
                                    <option value="@item.INT_StepNumber">@item.CHR_StepName</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">@Localizer["Adid"]</label>
                            <input id="searchAdid" class="form-control" placeholder="@Localizer["EnterAdid"]" />
                        </div>

                        <div class="col-12 mt-3">
                            <div class="d-grid gap-2">
                                <button id="btnSearch" class="btn btn-primary">
                                    <i class="fas fa-search me-1"></i> @Localizer["Search"]
                                </button>
                                <button id="btnAddNew" class="btn btn-success">
                                    <i class="fas fa-plus-circle me-1"></i> @Localizer["AddNew"]
                                </button>
                                <button id="btnClear" class="btn btn-outline-secondary">
                                    <i class="fas fa-broom me-1"></i> @Localizer["ClearSearch"]
                                </button>
                                <button type="button" class="btn btn-success" id="ImportExcelBtn">
                                    <i class="fas fa-file-excel"></i> @Localizer["ImportExcel"]
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form Add/Edit (inline thay vì modal) -->
            <div class="card shadow-sm" id="formContainer" style="display: none;">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0" id="formTitle">@Localizer["AddApproverTitle"]</h5>
                </div>
                <div class="card-body">
                    <form id="approverForm">
                        <input type="hidden" id="approverId" value="0" />

                        <div class="mb-3">
                            <label class="form-label">@Localizer["Adid"] <span class="text-danger">*</span></label>
                            <input id="modalAdid" class="form-control" required />
                            <div id="modalLookupStatus" class="small text-muted mt-1"></div>
                            <div class="invalid-feedback">@Localizer["ValidateEnterAdid"]</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["UserName"] <span class="text-danger">*</span></label>
                            <input id="modalName" class="form-control" required />
                            <div class="invalid-feedback">@Localizer["ValidateEnterName"]</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["Position"]</label>
                            <input id="modalPosition" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["Section"] <span class="text-danger">*</span></label>
                            <select id="modalSectionCode" name="modalSectionCode" class="form-select modalSectionCode searchable-select">
                                <option value="">@Localizer["All"]</option>
                                @foreach (var item in listSections)
                                {
                                     <option value="@item.Mahangmuctheovitri">@item.Mahangmuctheovitri - @item.Tenhangmuctheovitri</option>
                                }
                            </select>
                            <div class="invalid-feedback">@Localizer["ValidateSelectSection"]</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@Localizer["Step"] <span class="text-danger">*</span></label>
                            <select id="modalStep" class="form-control form-control-sm" required>
                                <option value="">@Localizer["SelectStep"]</option>
                                @foreach (var st in listSteps)
                                {
                                    <option value="@st.INT_StepNumber">@st.CHR_StepName</option>
                                }
                            </select>
                            <div class="invalid-feedback">@Localizer["ValidateSelectStep"]</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" id="saveApprover" class="btn btn-primary flex-grow-1" style="margin-right: 8px;">
                                <i class="fas fa-save me-1"></i> @Localizer["Save"]
                            </button>
                            <button type="button" id="cancelForm" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i> @Localizer["Cancel"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-project-diagram me-2"></i>@Localizer["ApprovalFlow"]
                    </h5>
                    <span class="badge bg-light text-dark" id="totalCount">@Localizer["TotalApprovers", "0"].Value</span>
                </div>
                <div class="card-body" style="overflow-y: auto; max-height: 600px;">
                    <div id="flowContainer">
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-search fa-3x mb-3"></i>
                            <p>@Localizer["UseFiltersHint"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    // Expose server-side steps to external JS file (no external libraries)
    window.approvalSteps = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(listSteps));
</script>
<link rel="stylesheet" href="/css/sendApprover.css" />
<!-- Custom dialog root -->
<div id="cmDialogOverlay" class="cm-dialog-overlay" aria-hidden="true">
    <div class="cm-dialog" role="dialog" aria-modal="true" aria-labelledby="cmDialogTitle">
        <div class="cm-dialog-header">
            <h6 id="cmDialogTitle" class="cm-dialog-title">@Localizer["Notification"]</h6>
            <button type="button" class="cm-btn cm-btn-outline" data-cm-action="close" aria-label="@Localizer["Close"]">✕</button>
        </div>
        <div id="cmDialogBody" class="cm-dialog-body"></div>
        <div id="cmDialogFooter" class="cm-dialog-footer">
            <!-- Buttons injected by JS -->
        </div>
    </div>
    <!-- Make overlay clickable to close for info dialogs -->
    <div class="cm-dialog-backdrop" data-cm-action="overlay"></div>
</div>
@section Scripts {
    <script src="/js/sendApprover.js"></script>
    <script>
        window.i18nSendApprover = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            SearchAndAddTitle = Localizer["SearchAndAddTitle"].Value,
            SectionName = Localizer["SectionName"].Value,
            All = Localizer["All"].Value,
            Step = Localizer["Step"].Value,
            Adid = Localizer["Adid"].Value,
            EnterAdid = Localizer["EnterAdid"].Value,
            Search = Localizer["Search"].Value,
            AddNew = Localizer["AddNew"].Value,
            ClearSearch = Localizer["ClearSearch"].Value,
            AddApproverTitle = Localizer["AddApproverTitle"].Value,
            ValidateEnterAdid = Localizer["ValidateEnterAdid"].Value,
            UserName = Localizer["UserName"].Value,
            ValidateEnterName = Localizer["ValidateEnterName"].Value,
            Position = Localizer["Position"].Value,
            Section = Localizer["Section"].Value,
            SelectSection = Localizer["SelectSection"].Value,
            ValidateSelectSection = Localizer["ValidateSelectSection"].Value,
            SelectStep = Localizer["SelectStep"].Value,
            ValidateSelectStep = Localizer["ValidateSelectStep"].Value,
            Save = Localizer["Save"].Value,
            Cancel = Localizer["Cancel"].Value,
            ApprovalFlow = Localizer["ApprovalFlow"].Value,
            TotalApprovers = Localizer["TotalApprovers", "{0}"].Value,
            UseFiltersHint = Localizer["UseFiltersHint"].Value,
            Notification = Localizer["Notification"].Value,
            Close = Localizer["Close"].Value,
            // JS texts
            LookupSearching = Localizer["LookupSearching"].Value,
            LookupNotFound = Localizer["LookupNotFound"].Value,
            LookupFound = Localizer["LookupFound", "{0}", "{1}"].Value,
            EmptyTitle = Localizer["EmptyTitle"].Value,
            EmptyMessage = Localizer["EmptyMessage"].Value,
            ErrorLoading = Localizer["ErrorLoading"].Value,
            ErrorConnection = Localizer["ErrorConnection"].Value,
            EditApproverTitle = Localizer["EditApproverTitle"].Value,
            AddToThisStep = Localizer["AddToThisStep"].Value,
            NoName = Localizer["NoName"].Value,
            NoPosition = Localizer["NoPosition"].Value,
            NoSection = Localizer["NoSection"].Value,
            Edit = Localizer["Edit"].Value,
            Delete = Localizer["Delete"].Value,
            TotalApproverBadge = Localizer["TotalApprovers", "{0}"].Value,
            ConfirmDeleteTitle = Localizer["ConfirmDeleteTitle"].Value,
            ConfirmDeleteMessage = Localizer["ConfirmDeleteMessage"].Value,
            ConfirmDeleteConfirm = Localizer["ConfirmDeleteConfirm"].Value,
            ConfirmDeleteCancel = Localizer["ConfirmDeleteCancel"].Value,
            DeleteSuccessTitle = Localizer["DeleteSuccessTitle"].Value,
            DeleteSuccessMessage = Localizer["DeleteSuccessMessage"].Value,
            DeleteErrorTitle = Localizer["DeleteErrorTitle"].Value,
            DeleteErrorMessage = Localizer["DeleteErrorMessage"].Value,
            DialogOk = Localizer["OK"].Value,
            UpdateSuccess = Localizer["UpdateSuccess"].Value,
            GenericError = Localizer["GenericError"].Value
        }));
    </script>
}
